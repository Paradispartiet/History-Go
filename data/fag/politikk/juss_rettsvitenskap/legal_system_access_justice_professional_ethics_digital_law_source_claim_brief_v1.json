OV-1980-06-13-35","publisher":"Lovdata","type":"current-statute","url":"https://lovdata.no/nav/lov/1980-06-13-35","retrieval_status":"verified_2026_09_02"},{"id":"sys05-menneskerettsloven","title":"Menneskerettsloven – LOV-1999-05-21-30","publisher":"Lovdata","type":"current-statute","url":"https://lovdata.no/nav/lov/1999-05-21-30","retrieval_status":"verified_2026_09_02"},{"id":"sys06-advokatloven","title":"Advokatloven – LOV-2022-05-12-28","publisher":"Lovdata","type":"current-statute","url":"https://lovdata.no/nav/lov/2022-05-12-28","retrieval_status":"verified_2026_09_02"},{"id":"sys07-advokatforskriften","title":"Advokatforskriften – FOR-2024-10-22-2546","publisher":"Lovdata","type":"current-regulation","url":"https://lovdata.no/SF/forskrift/2024-10-22-2546","retrieval_status":"verified_2026_09_02"},{"id":"sys08-personopplysningsloven","title":"Personopplysningsloven – LOV-2018-06-15-38","publisher":"Lovdata","type":"current-statute","url":"https://lovdata.no/nav/lov/2018-06-15-38","retrieval_status":"verified_2026_09_02"},{"id":"sys09-datatilsynet-automatiserte-avgjorelser","title":"Datatilsynet: automatiserte avgjørelser","publisher":"Datatilsynet","type":"institutional-guidance","url":"https://www.datatilsynet.no/rettigheter-og-plikter/personvernprinsippene/automatiserte-avgjorelser/","retrieval_status":"verified_2026_09_02"},{"id":"sys10-elektroniske-tillitstjenester","title":"Lov om elektroniske tillitstjenester – LOV-2018-06-15-44","publisher":"Lovdata","type":"current-statute","url":"https://lovdata.no/nav/lov/2018-06-15-44","retrieval_status":"verified_2026_09_02"},{"id":"sys11-eforvaltningsforskriften","title":"eForvaltningsforskriften – FOR-2004-06-25-988","publisher":"Lovdata","type":"current-regulation","url":"https://lovdata.no/nav/forskrift/2004-06-25-988","retrieval_status":"verified_2026_09_02"},{"id":"sys12-ekomloven","title":"Ekomloven – LOV-2024-12-13-76","publisher":"Lovdata","type":"current-statute","url":"https://lovdata.no/nav/lov/2024-12-13-76","retrieval_status":"verified_2026_09_02"},{"id":"sys13-offentleglova","title":"Offentleglova – LOV-2006-05-19-16","publisher":"Lovdata","type":"current-statute","url":"https://lovdata.no/nav/lov/2006-05-19-16","retrieval_status":"verified_2026_09_02"}],"topic_briefs":[{"id":"domstoler-uavhengighet-habilitet-og-offentlighet","title":"Domstoler, uavhengighet, habilitet og offentlighet","method_ids":["met_court_structure","met_impartiality_publicity"],"boundary":"Domstolenes institusjonelle uavhengighet, den enkelte dommers habilitet og offentlighet i rettergangen er ulike rettssikkerhetsmekanismer. En uavhengig domstol kan fortsatt ha et konkret habilitetsspørsmål, og offentlighet kan begrenses bare med eget rettsgrunnlag.","claim_ids":["system-01","system-02","system-03","system-04"]},{"id":"sivilprosess-straffeprosess-og-rettferdig-rettergang","title":"Sivilprosess, straffeprosess og rettferdig rettergang","method_ids":["met_civil_criminal_process","met_fair_trial"],"boundary":"Sivilprosess og straffeprosess har forskjellige partsroller, formål, beviskrav og tvangsmidler. EMK artikkel 6 gir overordnede rettferdighetskrav, men erstatter ikke de nasjonale prosesslovene eller gjør sivile og strafferettslige standarder like.","claim_ids":["system-05","system-06","system-07","system-08"]},{"id":"rettshjelp-rettstilgang-og-selvrepresentasjon","title":"Rettshjelp, rettstilgang og selvrepresentasjon","method_ids":["met_access_to_justice","met_legal_aid"],"boundary":"Rett til domstolsadgang, offentlig finansiert rettshjelp og praktisk evne til å føre egen sak er forskjellige spørsmål. Fri rettshjelp følger lovbestemte vilkår og betyr ikke at saken er vunnet eller at alle kostnader dekkes.","claim_ids":["system-09","system-10","system-11","system-12"]},{"id":"advokatrolle-uavhengighet-fortrolighet-og-interessekonflikt","title":"Advokatrolle, uavhengighet, fortrolighet og interessekonflikt","method_ids":["met_professional_role","met_confidentiality_conflict"],"boundary":"Advokatens uavhengighet, lojalitet til klienten, fortrolighet og plikt til å unngå interessekonflikt er beslektede, men selvstendige profesjonsetiske krav. Klientlojalitet betyr ikke plikt til å fremme ulovlige eller villedende handlinger.","claim_ids":["system-13","system-14","system-15","system-16"]},{"id":"juridisk-bistand-tilsyn-disiplin-og-klientvern","title":"Juridisk bistand, tilsyn, disiplin og klientvern","method_ids":["met_legal_services_regulation","met_professional_oversight"],"boundary":"Adgang til å yte rettslig bistand, krav til advokatbevilling, tilsyn og disiplinærreaksjoner regulerer profesjonen, mens domstolene avgjør rettstvister. Tilsyns- eller disiplinærsak er ikke en ny prøving av klientens hovedsak.","claim_ids":["system-17","system-18","system-19","system-20"]},{"id":"personvern-automatiserte-avgjorelser-og-rettslig-digitalisering","title":"Personvern, automatiserte avgjørelser og rettslig digitalisering","method_ids":["met_data_protection","met_automated_decision"],"boundary":"Behandling av personopplysninger, profilering, automatisert beslutningsstøtte og helautomatiserte avgjørelser er ikke identiske kategorier. Rettslig digitalisering må skille behandlingsgrunnlag, transparens, menneskelig ansvar og særreglene for avgjørelser med rettsvirkning eller tilsvarende betydelig virkning.","claim_ids":["system-21","system-22","system-23","system-24"]},{"id":"elektronisk-kommunikasjon-identitet-signatur-og-bevis","title":"Elektronisk kommunikasjon, identitet, signatur og bevis","method_ids":["met_electronic_communication","met_eid_signature_evidence"],"boundary":"Elektronisk identifikasjon, autentisering, elektronisk signatur, sikker kommunikasjon og bevisverdi er forskjellige spørsmål. En sikker teknisk løsning kan dokumentere identitet eller integritet uten automatisk å avgjøre om den underliggende disposisjonen er materiellrettslig gyldig.","claim_ids":["system-25","system-26","system-27","system-28"]},{"id":"digital-rettsinformasjon-innsyn-kommunikasjonsvern-og-ansvarlig-bruk","title":"Digital rettsinformasjon, innsyn, kommunikasjonsvern og ansvarlig bruk","method_ids":["met_access_information","met_digital_legal_responsibility"],"boundary":"Offentlig innsyn, tilgang til rettskilder, kommunikasjonsvern og ansvarlig bruk av digitale rettsverktøy fremmer ulike hensyn. Åpenhet gir ikke fri adgang til alle personopplysninger, og maskinell tilgang til rettsinformasjon erstatter ikke kildekritikk, versjonskontroll eller juridisk ansvar.","claim_ids":["system-29","system-30","system-31","system-32"]}],"planned_assessments":[{"id":"assess-system-01","claim_ids":["system-01","system-02","system-03","system-04"]},{"id":"assess-system-02","claim_ids":["system-05","system-06","system-07","system-08"]},{"id":"assess-system-03","claim_ids":["system-09","system-10","system-11","system-12"]},{"id":"assess-system-04","claim_ids":["system-13","system-14","system-15","system-16"]},{"id":"assess-system-05","claim_ids":["system-17","system-18","system-19","system-20"]},{"id":"assess-system-06","claim_ids":["system-21","system-22","system-23","system-24"]},{"id":"assess-system-07","claim_ids":["system-25","system-26","system-27","system-28"]},{"id":"assess-system-08","claim_ids":["system-29","system-30","system-31","system-32"]}],"decision_scenarios":[{"id":"case-system-01","title":"Habilitet og digitalt rettsmøte","source_ids":["sys01-domstolloven","sys02-tvisteloven","sys05-menneskerettsloven"]},{"id":"case-system-02","title":"Fri rettshjelp og selvprosedyre","source_ids":["sys04-rettshjelploven","sys02-tvisteloven","sys05-menneskerettsloven"]},{"id":"case-system-03","title":"Advokatens interessekonflikt","source_ids":["sys06-advokatloven","sys07-advokatforskriften"]},{"id":"case-system-04","title":"Automatisert rettighetsavgjørelse","source_ids":["sys08-personopplysningsloven","sys09-datatilsynet-automatiserte-avgjorelser","sys11-eforvaltningsforskriften"]},{"id":"case-system-05","title":"Elektronisk signatur og avtaletvist","source_ids":["sys10-elektroniske-tillitstjenester","sys02-tvisteloven","sys08-personopplysningsloven"]},{"id":"case-system-06","title":"Innsyn, personvern og kommunikasjon","source_ids":["sys13-offentleglova","sys08-personopplysningsloven","sys12-ekomloven"]}],"fulltext_requirements":{"modules":4,"sections":8,"paragraphs":32,"verified_claims":32,"assessments":8,"decision_scenarios":6},"claimsFile":"data/fag/politikk/juss_rettsvitenskap/legal_system_access_justice_professional_ethics_digital_law_source_claims_v1.json"}
