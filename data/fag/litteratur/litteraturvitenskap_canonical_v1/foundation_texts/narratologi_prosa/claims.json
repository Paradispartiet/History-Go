        "sna03",
        "sna07"
      ],
      "classification": "narratologi_prosa",
      "status": "verified"
    },
    {
      "id": "nar-04",
      "claim": "«Emma» organiserer begrenset kunnskap og korrigerende ironi gjennom skiftende narrativ nærhet.",
      "source_ids": [
        "sna04",
        "sna07"
      ],
      "classification": "narratologi_prosa",
      "status": "verified"
    },
    {
      "id": "nar-05",
      "claim": "Tekstlig perspektiv dokumenterer ikke alene faktiske leseres oppmerksomhet eller reaksjon.",
