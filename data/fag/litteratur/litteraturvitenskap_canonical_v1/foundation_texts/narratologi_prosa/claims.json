        "sna02",
        "sna03"
      ],
      "classification": "narratologi_prosa",
      "status": "verified"
    },
    {
      "id": "nar-18",
      "claim": "Upålitelighet kan gjelde fakta, kunnskap eller verdier og trenger en rekonstruert målestokk.",
