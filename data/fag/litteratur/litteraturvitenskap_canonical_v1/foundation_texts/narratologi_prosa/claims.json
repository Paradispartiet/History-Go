        "sna01",
        "sna03"
      ],
      "classification": "narratologi_prosa",
      "status": "verified"
    },
    {
      "id": "nar-02",
      "claim": "Grammatisk person avgjør ikke alene hvilken figur fortellingen begrenser kunnskapen til.",
      "source_ids": [
        "sna01",
        "sna06"
      ],
      "classification": "narratologi_prosa",
      "status": "verified"
    },
    {
      "id": "nar-03",
      "claim": "Fri indirekte diskurs kan kombinere fortellerens grammatikk med figurens evaluative språk.",
