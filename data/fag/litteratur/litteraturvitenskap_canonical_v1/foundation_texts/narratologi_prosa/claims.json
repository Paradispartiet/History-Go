      ],
      "classification": "narratologi_prosa",
      "status": "verified"
    },
    {
      "id": "nar-20",
      "claim": "«The Tell-Tale Heart» undergraver fortellerens fornuftsforsvar gjennom gjentakelse og selvmotsigelse.",
