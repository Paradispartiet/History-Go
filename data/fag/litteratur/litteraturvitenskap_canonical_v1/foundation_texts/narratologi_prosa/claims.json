        "sna05"
      ],
      "classification": "narratologi_prosa",
      "status": "verified"
    },
    {
      "id": "nar-12",
      "claim": "Darcy-brevet i «Pride and Prejudice» reorganiserer forståelsen av tidligere hendelser.",
