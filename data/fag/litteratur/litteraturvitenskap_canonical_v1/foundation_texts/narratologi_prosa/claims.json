        "sna01",
        "sna06"
      ],
      "classification": "narratologi_prosa",
      "status": "verified"
    },
    {
      "id": "nar-08",
      "claim": "Prousts madeleinescene organiserer nåtidig sansning og retrospektiv erindring på ulike tidsskalaer.",
      "source_ids": [
        "sna12"
      ],
      "classification": "narratologi_prosa",
      "status": "verified"
    },
    {
      "id": "nar-09",
      "claim": "Narrativ frekvens skiller antall hendelser fra antall framstillinger av dem.",
