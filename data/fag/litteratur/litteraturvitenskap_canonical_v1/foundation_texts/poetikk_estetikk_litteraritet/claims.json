  "claims": [
    {
      "id": "poe-01",
      "claim": "Platons og Aristoteles’ drøftinger av mimesis stiller ulike spørsmål om diktningens kunnskap, følelser og form.",
      "source_ids": [
        "spo01",
        "spo02"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-02",
      "claim": "Mimesis i poetikkhistorien kan ikke reduseres til fotografisk kopiering.",
      "source_ids": [
        "spo01",
        "spo02"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-03",
      "claim": "Aristoteles prioriterer handlingskomposisjonen i tragedieanalysen.",
      "source_ids": [
        "spo01"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-04",
      "claim": "Omslag og gjenkjennelse analyseres som deler av handlingens organiserte forløp.",
      "source_ids": [
        "spo01"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-05",
      "claim": "Tekstlig representasjon, historisk referent og faktisk leservirkning er ulike evidensnivåer.",
      "source_ids": [
        "spo03",
        "spo04"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-06",
      "claim": "Form og materiale står i en gjensidig relasjon og kan ikke behandles som fullstendig uavhengige lag.",
      "source_ids": [
        "spo03",
        "spo08"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-07",
      "claim": "«To the Lighthouse» organiserer ulike tidsskalaer og perspektiver gjennom sin tredelte komposisjon.",
      "source_ids": [
        "spo10"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-08",
      "claim": "Historiske påstander om form krever sammenlignings- eller kontekstkilder utover ett verk.",
      "source_ids": [
        "spo03"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-09",
      "claim": "Litteraritet er historisk og situert og kan ikke defineres som én tidløs egenskap i all litteratur.",
      "source_ids": [
        "spo03"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-10",
      "claim": "Fiksjonalitet er en kommunikativ praksis med særlige referensielle konvensjoner.",
      "source_ids": [
        "spo04",
        "spo05"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-11",
      "claim": "Forfatter, forteller og figur utfører ulike talehandlinger og bærer ulike referensielle ansvar.",
      "source_ids": [
        "spo05"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-12",
      "claim": "«Robinson Crusoe» bruker dokumentariske og redaksjonelle sannhetsmarkører innenfor tidlig romanfiksjon.",
      "source_ids": [
        "spo12"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-13",
      "claim": "Teksten kan organisere en mulig estetisk erfaring uten å dokumentere alle faktiske leseres reaksjon.",
      "source_ids": [
        "spo03",
        "spo07"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-14",
      "claim": "En estetisk dom tilbyr grunner og gjør krav på vurderbar delbarhet.",
      "source_ids": [
        "spo06"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-15",
      "claim": "Kants formålstjenlighet uten bestemt formål inngår i analysen av estetisk dom.",
      "source_ids": [
        "spo06"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-16",
      "claim": "«The Picture of Dorian Gray» setter estetisk program, skjønnhet og moralsk vurdering i et spenningsforhold.",
      "source_ids": [
        "spo11"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-17",
      "claim": "Poetikk kan være normativ, deskriptiv og knyttet til forfatteres arbeidsprogrammer.",
      "source_ids": [
        "spo01",
        "spo03"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-18",
      "claim": "Aristoteles’ «Poetikken» fikk ulike fortolkninger gjennom oversettelse og resepsjon.",
      "source_ids": [
        "spo01",
        "spo09"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-19",
      "claim": "Arabisk poetikk omformet aristoteliske begreper innenfor andre logiske og retoriske systemer.",
      "source_ids": [
        "spo09"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-20",
      "claim": "Et poetikkprogram og faktiske verk må behandles som ulike kilder.",
      "source_ids": [
        "spo03"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-21",
      "claim": "Kunstautonomi er et historisk og institusjonelt krav og ikke faktisk fravær av samfunnsforbindelser.",
      "source_ids": [
        "spo03",
        "spo08"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-22",
      "claim": "Estetiske institusjoner er med på å ramme inn hva som gjenkjennes og vurderes som kunst.",
      "source_ids": [
        "spo07",
        "spo08"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-23",
      "claim": "Baudelaires «Les Fleurs du mal» viser historisk konflikt mellom poetisk formkrav og juridisk regulering.",
      "source_ids": [
        "spo08"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    },
    {
      "id": "poe-24",
      "claim": "Formell selvorganisering i ett verk beviser ikke kunstens generelle samfunnsuavhengighet.",
      "source_ids": [
        "spo03",
        "spo08"
      ],
      "classification": "poetikk_estetikk",
      "status": "verified"
    }
  ]
}
