  "claims": [
    {
      "id": "lyr-01",
      "claim": "Det lyriske jeget er en tekstlig taleposisjon og ikke automatisk den biografiske dikteren.",
      "source_ids": [
        "sly01",
        "sly02"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-02",
      "claim": "Lyrisk adresse rekonstrueres gjennom pronomen, deiksis, tid og sjanger.",
      "source_ids": [
        "sly01",
        "sly02"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-03",
      "claim": "«Ode to the West Wind» organiserer apostrofe og imperativ gjennom fem deler.",
      "source_ids": [
        "sly07"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-04",
      "claim": "Apostrofen gjør en fraværende eller ikke-menneskelig adressat virksom i diktets tale.",
      "source_ids": [
        "sly01",
        "sly05"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-05",
      "claim": "Biografisk identifikasjon krever kilder utover diktets førsteperson.",
      "source_ids": [
        "sly01",
        "sly02"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-06",
      "claim": "Meter er et abstrahert mønster, mens rytme omfatter konkrete språklige og framførte variasjoner.",
      "source_ids": [
        "sly02",
        "sly03"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-07",
      "claim": "Metriske systemer må analyseres i forhold til språkets prosodi og historiske tradisjon.",
      "source_ids": [
        "sly03",
        "sly05"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-08",
      "claim": "«Paradise Lost» bruker blankvers med syntaktiske og rytmiske variasjoner mot jambisk forventning.",
      "source_ids": [
        "sly08"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-09",
      "claim": "Tekstlig skandering og faktisk framføringsrytme er relaterte, men forskjellige evidensnivåer.",
      "source_ids": [
        "sly02",
        "sly03"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-10",
      "claim": "Rim og klang må beskrives fonologisk, posisjonelt og historisk før semantisk fortolkning.",
      "source_ids": [
        "sly01",
        "sly05"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-11",
      "claim": "Lydlikhet er ikke alene bevis på en bestemt symbolsk forbindelse.",
      "source_ids": [
        "sly02",
        "sly05"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-12",
      "claim": "Dickinson-diktets bindestreker, ballademeter og skrårim varierer med utgavegrunnlaget.",
      "source_ids": [
        "sly09"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-13",
      "claim": "Enjambement setter syntaktisk fortsettelse i relasjon til linjegrensen uten å pålegge én pause.",
      "source_ids": [
        "sly01",
        "sly02"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-14",
      "claim": "Sonetten er en familie av historisk variable fjortenlinjers former.",
      "source_ids": [
        "sly01",
        "sly05"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-15",
      "claim": "Volta betegner en formell eller argumentativ vending som ikke har én obligatorisk plassering.",
      "source_ids": [
        "sly01",
        "sly05"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-16",
      "claim": "Sonett 130 omvurderer sammenligningskatalogen gjennom den avsluttende kupletten.",
      "source_ids": [
        "sly10"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-17",
      "claim": "Formbrudd kan bare fastslås mot en dokumentert språk- og periodebestemt forventning.",
      "source_ids": [
        "sly01",
        "sly02"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-18",
      "claim": "Fritt vers organiseres gjennom variable linjer, syntaks, gjentakelse, klang og typografi.",
      "source_ids": [
        "sly02",
        "sly04"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-19",
      "claim": "Modernistisk poesi kan bruke både bundne og frie versformer.",
      "source_ids": [
        "sly04"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-20",
      "claim": "«The Waste Land» organiserer sitat, stemmeskift, flerspråklighet og typografiske seksjoner som montasje.",
      "source_ids": [
        "sly11"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-21",
      "claim": "Historisk kontekst må kobles til lokaliserbare formtrekk og kan ikke erstatte tekstanalysen.",
      "source_ids": [
        "sly02",
        "sly04"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-22",
      "claim": "Framført poesi fordeler verket mellom tekst, stemme, kropp, rom, teknologi og publikum.",
      "source_ids": [
        "sly01",
        "sly02"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-23",
      "claim": "Trykk og opptak av «Howl» muliggjør sammenligning av linje, pust, tempo og gjentakelse.",
      "source_ids": [
        "sly12"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    },
    {
      "id": "lyr-24",
      "claim": "Digital poesi krever dokumentasjon av kode, grensesnitt, versjon og kjøreomgivelser.",
      "source_ids": [
        "sly06"
      ],
      "classification": "lyrikk_poetiske_former",
      "status": "verified"
    }
  ]
}
