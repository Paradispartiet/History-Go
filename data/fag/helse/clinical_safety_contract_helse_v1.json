{
  "schema": "history_go_health_education_safety_contract_v1",
  "version": "1.0.0",
  "status": "blocking",
  "subject_id": "helse",
  "allowed": [
    "generell undervisning om sykdom, behandling, forebygging, evidens og helsetjenester",
    "historiske, systemiske og populasjonsbaserte analyser",
    "generelle forklaringer av kliniske metoder, tester og usikkerhet"
  ],
  "forbidden": [
    "individuell diagnose eller differensialdiagnose",
    "individuell prognose, triage eller risikoklassifisering",
    "personlig dose-, behandlings- eller seponeringsanbefaling",
    "påstander som erstatter akuttjeneste eller autorisert helsepersonell"
  ],
  "required_content_controls": [
    "population_and_scope_boundary",
    "evidence_strength_and_uncertainty",
    "association_not_individual_prediction",
    "education_not_personal_medical_advice",
    "urgent_help_signposting_when_relevant"
  ]
}
