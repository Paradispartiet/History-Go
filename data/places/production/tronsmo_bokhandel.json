    {
      "id": "claim_tronsmo_desc_01",
      "claim": "Tronsmo Bokhandel ble grunnlagt i 1973 som en uavhengig og radikal bokhandel og holder siden 2015 til i Universitetsgata 12. Bokhandelen er kjent for et tydelig kuratert utvalg, en sterk tegneserieavdeling og litteratur som ikke bare følger bestselgerlogikk. Stedet viser hvordan en bokhandel kan være både butikk, formidler og litterær offentlighet.",
      "sourceUrl": "https://www.tronsmo.no/om-tronsmo/",
      "sourceLocation": "Om Tronsmo og kontaktopplysninger",
      "sourceType": "primary",
      "verifiedAt": "2026-09-10",
      "status": "verified",
      "claimKind": "identity",
      "evidenceMode": "direct",
      "temporalStatus": "current"
    },
