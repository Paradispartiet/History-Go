  "reviews": {
    "factual": {
      "status": "passed",
      "reviewedAt": "2026-10-09",
      "reviewer": "Codex",
      "notes": "Kontrollert mot åpnet brødtekst i fire kilder. Kapasitet er ikke opplag; 1964 er dokumentert i byleksikonet og artikkelens hovedtekst. Returen til nr. 55 i 2014 er utelatt fra denne stedspakkens hendelser; den er fortsatt eksplisitt utelukket i identitetsavgrensningen og omtalt som ekstern Leksikon-kontekst. Ny kontroll av jubileumsartikkelens brødtekst: 1876-pressens type er ikke dokumentert. Rotasjonspresse omtales først i sammenheng med produksjonspresset fra 1885."
    },
    "editorial": {
      "status": "passed",
      "reviewedAt": "2026-10-09",
      "reviewer": "Codex",
      "introducedNewFacts": false,
      "notes": "Konkrete hendelser og produksjonsfunksjoner. Intern kartforklaring, udokumentert årsakstolkning og nåtidsstatus er fjernet."
    }
  },
