      "verifiedAt": "2026-10-13",
      "status": "verified",
      "claimKind": "disputed",
      "evidenceMode": "direct",
      "temporalStatus": "historical",
      "notes": "Beckers uttrykkelige posisjon, ikke en nøytral fasit om Bourdieu eller dokumentasjon på konflikt ved teatret."
    },
