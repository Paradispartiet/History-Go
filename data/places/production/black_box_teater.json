  "reviews": {
    "factual": {
      "status": "passed",
      "reviewedAt": "2026-10-11",
      "reviewer": "History Go – historisk kildegranskning",
      "notes": "Black Box egen historikk, Sceneweb, Oslo byleksikon og SNL er gjennomgått. Scenen flyttet i februar 2004, institusjonen startet i 1985; 1991-dateringen av Nettverk for Scenekunst følger teatrets egen historikk og Sceneweb, mens enkelte senere sekundærkilder oppgir 1994. 2018–2019-hendelsene er nøkternt gjengitt uten udokumentert skyldtilskrivelse."
    },
    "editorial": {
      "status": "passed",
      "reviewedAt": "2026-10-11",
      "reviewer": "History Go – historisk redaksjon",
