{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "history_go_place_fagverk_v2",
  "title": "History Go Place Fagverk v2",
  "description": "Place-eid, stedsspesifikt læringsinnhold. Registryet kan indeksere blokken, men eier aldri innholdet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "level",
    "status",
    "intro",
    "article",
    "subject_ids",
    "emne_ids",
    "chapter_ids",
    "lenses",
    "guiding_questions",
    "concepts",
    "observable_traces",
    "source_urls",
    "verified_at"
  ],
  "properties": {
    "schema": { "const": "history_go_place_fagverk_v2" },
    "level": { "enum": ["full", "standard", "micro"] },
    "status": { "enum": ["curated", "in_production"] },
    "intro": { "type": "string", "minLength": 1 },
    "article": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "subject_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "emne_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "chapter_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "lenses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/lens" }
    },
    "guiding_questions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "\\?$" }
    },
    "concepts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "observable_traces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/trace" }
    },
    "source_urls": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https?://" }
    },
    "verified_at": { "type": "string", "format": "date" }
  },
  "$defs": {
    "lens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "prompt", "subject_id", "emne_id", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1, "pattern": "\\?$" },
        "subject_id": { "type": "string", "minLength": 1 },
        "emne_id": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "observation", "interpretation_boundary", "source_urls"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 },
        "interpretation_boundary": { "type": "string", "minLength": 1 },
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https?://" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "curated" }, "level": { "const": "full" } }, "required": ["status", "level"] },
      "then": {
        "properties": {
          "intro": { "minLength": 100 },
          "article": { "minItems": 5 },
          "emne_ids": { "minItems": 3 },
          "chapter_ids": { "minItems": 1 },
          "lenses": { "minItems": 3, "maxItems": 5 },
          "guiding_questions": { "minItems": 4, "maxItems": 6 },
          "concepts": { "minItems": 6 },
          "observable_traces": { "minItems": 2 },
          "source_urls": { "minItems": 4 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "curated" }, "level": { "const": "standard" } }, "required": ["status", "level"] },
      "then": {
        "properties": {
          "intro": { "minLength": 70 },
          "article": { "minItems": 1 },
          "lenses": { "minItems": 3, "maxItems": 5 },
          "guiding_questions": { "minItems": 4, "maxItems": 6 },
          "concepts": { "minItems": 3 },
          "observable_traces": { "minItems": 1 },
          "source_urls": { "minItems": 2 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "curated" }, "level": { "const": "micro" } }, "required": ["status", "level"] },
      "then": {
        "properties": {
          "intro": { "minLength": 40 },
          "guiding_questions": { "minItems": 1, "maxItems": 2 },
          "concepts": { "minItems": 1 },
          "observable_traces": { "minItems": 1 },
          "source_urls": { "minItems": 1 }
        }
      }
    }
  ]
}
