{
  "schema": "history_go_place_description_templates_v4_2",
  "version": "4.2.0",
  "status": "canonical_claim_first_sentence_traceable",
  "purpose": "Sikre identitetsavklaring, claim-first research, full setningssporbarhet, separate reviews og versjonert ferdigstatus for desc og popupDesc.",
  "canonicalDocument": "data/places/regler/PLACE_DESCRIPTION_CANONICAL.md",
  "productionSchema": "data/places/regler/place_description_production_v4_2.schema.json",
  "productionDirectory": "data/places/production",
  "categoryAliases": {
    "popkultur": "populaerkultur"
  },
  "informationHierarchy": {
    "desc": "Konsentrert faktasammendrag: hva stedet er, når, hvem, hva som skjedde, og hva som gjør det spesielt.",
    "popupDesc": "Fullverdig, selvstendig stedartikkel med dokumentert kronologi, aktører, bruk, fysiske detaljer, endringer og minneverdige fakta.",
    "merInfo": "Ytterligere fordypning, konkurrerende tolkninger, forbindelser, kildeapparat og videre lesning.",
    "peoplePopup": "Full biografi og forbindelser utenfor den aktuelle stedstilknytningen.",
    "productionPacket": "Internt claim-register, identitetsport, setningsdekning, reviews, quiz-readiness og ferdigstatus. Skal aldri gjengis i brukerinnholdet."
  },
  "global": {
    "desc": {
      "targetWords": [40, 80],
      "targetSentences": [2, 4],
      "rangeType": "soft_normal_range",
      "minimumConcreteFacts": 4,
      "mustDifferFromPopupDesc": true
    },
    "popupDesc": {
      "minimumWords": 300,
      "recommendedWords": [300, 600],
      "hardMaximumWords": null,
      "targetSentences": [12, 30],
      "minimumParagraphs": 3,
      "fixedParagraphCount": null,
      "paragraphRule": "organic_structure_from_documented_material",
      "rangeType": "hard_minimum_when_sources_are_sufficient",
      "minimumConcreteFacts": 12,
      "minimumNewInformationShare": 0.6667,
      "mustAddNewInformation": true,
      "insufficientSourceOutcome": "blocked_insufficient_sources"
    },
    "identityGate": {
      "required": true,
      "requiredStatus": "resolved",
      "requiredFields": ["represents", "period", "excludes"],
      "distinctions": [
        "building_vs_institution",
        "current_vs_historic_operation",
        "construction_year_vs_foundation_year",
        "area_vs_single_building",
        "author_vs_fictional_character",
        "memorial_site_vs_event_site",
        "historic_address_vs_current_visitor_address"
      ]
    },
    "claimsGate": {
      "requiredForNewOrRevisedDescriptions": true,
      "stableClaimIds": true,
      "allFactualComponentsNeedVerifiedClaims": true,
      "allowedClaimStatuses": ["verified", "rejected", "superseded", "needs_research"],
      "readyStatusRequires": "verified",
      "requiredClaimFields": [
        "id",
        "claim",
        "sourceUrl",
        "sourceLocation",
        "sourceType",
        "verifiedAt",
        "status"
      ],
      "allowedSourceTypes": [
        "primary",
        "official",
        "institutional",
        "archive",
        "catalogue",
        "scholarly",
        "reputable_secondary"
      ],
      "identitySourceTypes": ["primary", "official", "institutional", "archive", "catalogue"],
      "sourceLocationRequired": true,
      "inspectableHttpsRequired": true
    },
    "sentenceClaimParity": {
      "required": true,
      "appliesTo": ["desc", "popupDesc"],
      "everySentenceNeedsClaimIds": true,
      "textHashAlgorithm": "sha256",
      "rejectPartialSupport": true,
      "rejectUnclaimedCause": true,
      "rejectUnclaimedEvaluation": true,
      "rejectSyntheticConclusion": true
    },
    "strongClaims": {
      "requiresExplicitEvidence": true,
      "requiresStrongClaimFlag": true,
      "requiresEvidenceMode": "explicit",
      "terms": [
        "første",
        "eldste",
        "største",
        "minste",
        "eneste",
        "viktigste",
        "ledende",
        "særlig kjent for",
        "avgjørende",
        "førte til",
        "på grunn av",
        "derfor",
        "dermed",
        "revolusjonerte",
        "endret for alltid"
      ],
      "minimumIndependentSourcesForDisputedOrStrongClaims": 2
    },
    "temporalClaims": {
      "requiresTemporalStatus": true,
      "currentStatusValue": "current",
      "maximumVerificationAgeDays": 180,
      "markers": [
        "i dag",
        "nå",
        "holder til",
        "drives av",
        "brukes som",
        "er under bygging",
        "skal åpne",
        "planlegges",
        "forventes ferdig"
      ],
      "futurePlansMustRemainQualified": true,
      "outdatedFuturePlansAreErrors": true
    },
    "productionStatuses": [
      "ready_v4_2",
      "needs_research",
      "source_conflict",
      "identity_unresolved",
      "blocked_insufficient_sources",
      "metadata_correction_required"
    ],
    "reviews": {
      "factual": {
        "required": true,
        "requiredStatusForReady": "passed",
        "checks": [
          "names",
          "dates",
          "roles",
          "causes",
          "quotes",
          "numbers",
          "current_status",
          "claim_coverage",
          "source_quality",
          "metadata_consistency"
        ],
        "languageEditingAllowed": false
      },
      "editorial": {
        "required": true,
        "requiredStatusForReady": "passed",
        "checks": [
          "flow",
          "repetition",
          "variation",
          "clarity",
          "interest",
          "unnecessary_jargon",
          "generic_openings",
          "generic_endings"
        ],
        "mayIntroduceNewFacts": false
      }
    },
    "quizReadiness": {
      "minimumDirectQuestions": 8,
      "minimumNormalKnowledgeQuestions": 5,
      "minimumQuestionTypes": 4,
      "allowedQuestionTypes": [
        "hvem",
        "når",
        "hva",
        "hvor",
        "hvilket_verk_eller_objekt",
        "hva_skjedde",
        "hva_ble_bygget_produsert_eller_endret"
      ],
      "answerMustBeUnambiguous": true
    },
    "metadataConsistency": {
      "required": true,
      "fields": [
        "name",
        "year",
        "period",
        "category",
        "address",
        "coordinates",
        "externalLinks",
        "operationStatus",
        "placeType"
      ],
      "failureStatus": "metadata_correction_required"
    },
    "batchDiversification": {
      "maxSameOpeningPatternInTen": 2,
      "maximumNormalizedTextJaccard": 0.75,
      "maximumRepeatedSentenceWords": 8,
      "rejectSameOpening": true,
      "rejectSameEnding": true,
      "rejectPortableParagraphs": true,
      "allowedRepeatedSentenceReasons": [
        "official_title",
        "necessary_proper_name",
        "fixed_source_wording"
      ]
    },
    "prIsolation": {
      "requireProductionPacketForChangedDescription": true,
      "forbidRulesAndPlaceContentInSamePr": true,
      "forbidCoordinateAndDescriptionChangesInSamePr": true,
      "forbidGeneratedIndexChangesInDescriptionPr": true,
      "requireCanonicalSourceForIndexChange": true
    },
    "completion": {
      "currentStandard": "4.2",
      "requiredCompletedUnder": "4.2",
      "requiredCurrentStatus": "current",
      "legacyCurrentStatus": "requires_4_2_review",
      "requiredFields": [
        "completedUnder",
        "currentStatus",
        "sourceVerifiedAt",
        "claimsVerified",
        "factualReview",
        "editorialReview",
        "validatorVersion"
      ]
    },
    "antiFormula": {
      "doNotUseAsDefaultOpenings": [
        "Stedet viser hvordan",
        "Stedet forteller historien om",
        "Stedet gjør det mulig å forstå",
        "Stedet knytter ... sammen",
        "Stedet er et symbol på",
        "Stedet gir et innblikk i",
        "Stedet spiller en viktig rolle i"
      ],
      "watchWords": [
        "identitet",
        "samfunnsutvikling",
        "transformasjon",
        "tyngdepunkt",
        "knutepunkt",
        "lesbart",
        "lesbarhet",
        "symbol",
        "betydning",
        "rolle",
        "sammenheng",
        "møteplass",
        "spenning"
      ],
      "rule": "Abstrakte ord er tillatt når de forklarer et konkret, kildebelagt faktum, men ikke som erstatning for fakta."
    },
    "forbiddenEditorialLanguage": [
      "History Go kan bruke stedet til",
      "I History Go",
      "Se hvordan",
      "Husk at",
      "spilleren skal forstå",
      "spilleren bør forstå",
      "kartpunktet er et områdeanker",
      "autoritative kartidentiteten",
      "markør for hele området",
      "må holdes adskilt fra",
      "skal ikke reduseres til én samlet markør",
      "stabil nok til å romme videre utvikling"
    ]
  },
  "categories": {
    "by": {
      "label": "By & arkitektur",
      "factPriorities": ["bygg eller område", "byggeår", "arkitekt eller planlegger", "funksjon", "materiale og mål", "ombygging og bruk"]
    },
    "historie": {
      "label": "Historie",
      "factPriorities": ["hendelse", "dato", "aktør", "handling", "gjenstand", "bevarte spor"]
    },
    "kunst": {
      "label": "Kunst",
      "factPriorities": ["verk", "kunstner", "år", "materiale", "størrelse", "teknikk og plassering"]
    },
    "litteratur": {
      "label": "Litteratur",
      "factPriorities": ["forfatter", "verk", "stedstilknytning", "arbeidsperiode", "utgivelse", "dokumentert episode"]
    },
    "musikk": {
