{
  "schema": "history_go_place_description_templates_v4_2",
  "version": "4.2.0",
  "policyRevision": "4.2.2-editorial-ingress",
  "status": "canonical_claim_first_sentence_traceable_source_led_length_editorial_ingress",
  "purpose": "Sikre identitetsavklaring, claim-first research, full setningssporbarhet, en fokusert leksikalsk ingress, separate reviews, stoffstyrt lengde og versjonert ferdigstatus for desc og popupDesc.",
  "canonicalDocument": "data/places/regler/PLACE_DESCRIPTION_CANONICAL.md",
  "productionSchema": "data/places/regler/place_description_production_v4_2.schema.json",
  "productionDirectory": "data/places/production",
  "categoryAliases": {
    "popkultur": "populaerkultur"
  },
  "informationHierarchy": {
    "desc": "Leksikalsk ingress med én styrende idé: identifiser stedet, prioriter ett hovedpoeng og utsett detaljkronologi, navnelister og støttefakta til popupDesc.",
    "popupDesc": "Fullverdig, selvstendig stedartikkel med dokumentert kronologi, aktører, bruk, fysiske detaljer, endringer og minneverdige fakta. Lengden bestemmes av dokumentert stoff.",
    "merInfo": "Ytterligere fordypning, konkurrerende tolkninger, forbindelser, kildeapparat og videre lesning.",
    "peoplePopup": "Full biografi og forbindelser utenfor den aktuelle stedstilknytningen.",
    "productionPacket": "Internt claim-register, identitetsport, setningsdekning, reviews, quiz-readiness og ferdigstatus. Skal aldri gjengis i brukerinnholdet."
  },
  "global": {
    "desc": {
      "guidanceWords": [
        35,
        90
      ],
      "guidanceSentences": [
        1,
        3
      ],
      "wordCountIsValidationGate": false,
      "rangeType": "editorial_guidance_only",
      "minimumConcreteFacts": null,
      "factSelectionRule": "only_facts_serving_one_controlling_idea",
      "role": "encyclopedic_lead_not_compressed_table_of_contents",
      "controllingIdeaRequired": true,
      "knownNewFlowPreferred": true,
      "detailsDeferredToPopupDesc": true,
      "mustDifferFromPopupDesc": true,
      "avoid": [
        "chronology_inventory",
        "name_and_year_pileup",
        "from_a_via_b_to_c_construction_with_multiple_new_topics",
        "one_new_epoch_per_sentence",
        "syntax_overloaded_by_fact_density",
        "abstract_significance_without_concrete_place_focus"
      ],
      "editorialTests": [
        "main_point_can_be_paraphrased_in_one_simple_sentence",
        "sentence_two_continues_sentence_one",
        "every_name_and_date_is_necessary_to_the_controlling_idea",
        "movable_details_are_deferred_to_popupDesc",
        "read_aloud_sounds_like_prose_not_keywords",
        "lead_promises_content_the_popupDesc_delivers"
      ]
    },
    "popupDesc": {
      "minimumWords": null,
      "guidanceWords": [
        300,
        1200
      ],
      "maximumWords": null,
      "wordCountIsValidationGate": false,
      "guidanceSentences": [
        12,
        60
      ],
      "minimumParagraphs": 3,
      "fixedParagraphCount": null,
      "paragraphRule": "organic_structure_from_documented_material",
      "rangeType": "editorial_guidance_only_source_led",
      "lengthDecisionRule": "source_availability_place_complexity_identity_scope_and_documented_time_layers",
      "shorterThanGuidanceAllowedWhen": [
        "limited_but_sufficient_documented_material",
        "narrow_place_identity",
        "high_information_density_without_omission"
      ],
      "longerThanGuidanceAllowedWhen": [
        "many_documented_time_layers",
        "multiple_function_changes",
        "complex_institutional_or_social_history",
        "source_material_supports_additional_non_repetitive_facts"
      ],
      "neverLengthenWith": [
        "repetition",
        "generic_analysis",
        "portable_paragraphs",
        "uncited_context",
        "production_meta_text"
      ],
      "minimumConcreteFacts": 12,
      "minimumNewInformationShare": 0.6667,
      "mustAddNewInformation": true,
      "insufficientSourceOutcome": "blocked_insufficient_sources"
    },
    "identityGate": {
      "required": true,
      "requiredStatus": "resolved",
      "requiredFields": [
        "represents",
        "period",
        "excludes"
      ],
      "distinctions": [
        "building_vs_institution",
        "current_vs_historic_operation",
        "construction_year_vs_foundation_year",
        "area_vs_single_building",
        "author_vs_fictional_character",
        "memorial_site_vs_event_site",
        "historic_address_vs_current_visitor_address"
      ]
    },
    "claimsGate": {
      "requiredForNewOrRevisedDescriptions": true,
      "stableClaimIds": true,
      "allFactualComponentsNeedVerifiedClaims": true,
      "allowedClaimStatuses": [
        "verified",
        "rejected",
       "superseded",
        "needs_research"
      ],
      "readyStatusRequires": "verified",
      "requiredClaimFields": [
        "id",
        "claim",
        "sourceUrl",
        "sourceLocation",
        "sourceType",
        "verifiedAt",
        "status"
      ],
      "allowedSourceTypes": [
        "primary",
      "official",
      "institutional",
        "archive",
        "catalogue",
        "scholarly",
        "reputable_secondary"
      ],
      "identitySourceTypes": [
        "primary",
        "official",
        "institutional",
        "archive",
        "catalogue"
      ],
      "sourceLocationRequired": true,
      "inspectableHttpsRequired": true
    },
    "sentenceClaimParity": {
      "required": true,
      "appliesTo": [
        "desc",
        "popupDesc"
      ],
      "everySentenceNeedsClaimIds": true,
      "textHashAlgorithm": "sha256",
      "rejectPartialSupport": true,
      "rejectUnclaimedCause": true,
      "rejectUnclaimedEvaluation": true,
      "rejectSyntheticConclusion": true
    },
    "strongClaims": {
      "requiresExplicitEvidence": true,
      "requiresStrongClaimFlag": true,
      "requiresEvidenceMode": "explicit",
      "terms": [
        "første",
        "eldste",
        "største",
        "minste",
        "eneste",
        "viktigste",
        "ledende",
        "særlig kjent for",
        "avgjørende",
        "førte til",
        "på grunn av",
        "derfor",
        "dermed",
        "revolusjonerte",
        "endret for alltid"
      ],
      "minimumIndependentSourcesForDisputedOrStrongClaims": 2
    },
    "temporalClaims": {
      "requiresTemporalStatus": true,
      "currentStatusValue": "current",
      "maximumVerificationAgeDays": 180,
      "markers": [
        "i dag",
        "niå",
       "holder til",
        "drives av",
        "brukes som",
        "er under bygging",
        "skal åpne",
        "planlegges",
        "forventes ferdig"
      ],
      "futurePlansMustRemainQualified": true,
      "outdatedFuturePlansAreErrors": true
    },
    "productionStatuses": [
      "ready_v4_2",
      "needs_research",
      "source_conflict",
      "identity_unresolved",
      "blocked_insufficient_sources",
      "metadata_correction_required"
    ],
    "reviews": {
      "factual": {
        "required": true,
        "requiredStatusForReady": "passed",
        "checks": [
          "names",
          "dates",
          "roles",
          "causes",
          "quotes",
          "numbers",
          "current_status",
          "claim_coverage",
          "source_quality",
          "metadata_consistency"
        ],
        "languageEditingAllowed": false
      },
      "editorial": {
        "required": true,
        "requiredStatusForReady": "passed",
        "checks": [
          "flow",
          "repetition",
          "variation",
          "clarity",
          "interest",
          "unnecessary_jargon",
          "generic_openings",
          "generic_endings",
          "historical_balance",
          "source_led_length",
          "ingress_single_focus",
          "known_new_information_flow",
          "no_chronology_inventory",
          "no_name_or_year_pileup"
        ],
        "mayIntroduceNewFacts": false
      }
    },
    "quizReadiness": {
      "minimumDirectQuestions": 8,
      "minimumNormalKnowledgeQuestions": 5,
      "minimumQuestionTypes": 4,
      "allowedQuestionTypes": [
        "hvem",
        "nar",
        "hva",
        "hvor",
        "hvilket_verk_eller_objekt",
        "hva_skjedde",
        "hva_ble_bygget_produsert_eller_endret"
      ],
      "answerMustBeUnambiguous": true
    },
    "metadataConsistency": {
      "required": true,
      "fields": [
        "name",
        "year",
        "period",
        "category",
        "address",
        "coordinates",
        "externalLinks",
        "operationStatus",
        "placeType"
      ],
      "failureStatus": "metadata_correction_required"
    },
    "batchDiversification": {
      "maxSameOpeningPatternInTen": 2,
      "maximumNormalizedTextJaccard": 0.75,
      "maximumRepeatedSentenceWords": 8,
      "rejectSameOpening": true,
      "rejectSameEnding": true,
      "rejectPortableParagraphs": true,
      "allowedRepeatedSentenceReasons": [
        "official_title",
        "necessary_proper_name",
        "fixed_source_wording"
      ]
    },
    "prIsolation": {
      "requireProductionPacketForChangedDescription": true,
      "forbidRulesAndPlaceContentInSamePr": true,
      "forbidCoordinateAndDescriptionChangesInSamePr": true,
      "forbidGeneratedIndexChangesInDescriptionPr": true,
      "requireCanonicalSourceForIndexChange": true
    },
    "completion": {
      "currentStandard": "4.2",
      "requiredCompletedUnder": "4.2",
      "requiredCurrentStatus": "current",
      "legacyCurrentStatus": "requires_4_2_review",
      "requiredFields": [
        "completedUnder",
        "currentStatus",
        "sourceVerifiedAt",
        "claimsVerified",
        "factualReview",
        "editorialReview",
        "validatorVersion"
      ],
      "wordCountIsCompletionCriterion": false
    },
    "antiFormula": {
      "doNotUseAsDefaultOpenings": [
        "Stedet viser hvordan",
        "Stedet forteller historien om",
        "Stedet gjør det mulig å forstå",
