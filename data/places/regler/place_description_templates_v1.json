      "factPriorities": ["bedrift", "grunnlegger", "produkt", "etableringsår", "produksjon", "marked og omstilling"]
    },
    "natur": {
      "label": "Natur",
      "factPriorities": ["arter", "naturtype", "geologi", "habitat", "sesong", "atferd og kjennetegn"]
    },
    "politikk": {
      "label": "Politikk",
      "factPriorities": ["institusjon", "beslutning", "møte eller aksjon", "aktører", "konflikt", "resultat"]
    },
    "populaerkultur": {
      "label": "Populærkultur",
      "factPriorities": ["verk eller produksjon", "skaper", "utgivelse", "stedsscene", "mottakelse", "dokumentert etterliv"]
    },
    "psykologi": {
      "label": "Psykologi",
      "factPriorities": ["institusjon eller praksis", "fagperson", "metode", "hendelse", "dokumentert resultat", "etisk eller historisk endring"]
    },
    "sport": {
      "label": "Sport",
      "factPriorities": ["lag eller utøver", "kamp", "turnering", "rekord", "resultat", "arena og rivalisering"]
    },
    "subkultur": {
      "label": "Subkultur",
      "factPriorities": ["miljø", "aktører", "stedlig praksis", "arrangement", "uttrykk", "konflikt eller endring"]
    },
    "vitenskap": {
      "label": "Vitenskap",
