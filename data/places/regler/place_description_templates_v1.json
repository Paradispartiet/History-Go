{
  "schema": "history_go_place_description_templates_v1",
  "version": "1.0.0",
  "status": "canonical_foundation",
  "purpose": "Gi desc og popupDesc kategorispesifikk fortellerkraft uten at tekstene blir mekaniske varianter av samme akademiske formel.",
  "categoryAliases": {
    "popkultur": "populaerkultur"
  },
  "global": {
    "desc": {
      "targetWords": [28, 58],
      "targetSentences": [1, 3],
      "job": "Gi en konkret, minneverdig inngang til stedet og én tydelig grunn til å åpne det.",
      "minimumConcreteElements": 2,
      "mustDifferFromPopupDesc": true
    },
    "popupDesc": {
      "targetWords": [75, 155],
      "targetSentences": [3, 7],
      "job": "Utvid stedet til en liten fortelling med personer, handling, fysisk detalj, bruk, konflikt, endring eller overraskelse.",
      "minimumConcreteElements": 4,
      "mustAddNewInformation": true
    },
    "concreteElementTypes": [
      "navngitt person eller gruppe",
      "årstall eller tidsrom",
      "hendelse eller beslutning",
      "materiale, form, lyd, art eller fysisk detalj",
      "lokal bruk eller hverdagsaktivitet",
      "før-og-nå-endring",
      "konflikt, risiko eller omstridt valg",
      "uventet eller minneverdig detalj",
      "konsekvens for mennesker eller sted"
    ],
    "antiFormula": {
      "doNotUseAsDefaultOpenings": [
        "Stedet viser hvordan",
        "Stedet er et viktig spor etter",
        "Stedet er et institusjonelt tyngdepunkt",
        "Stedet gjør ... lesbart",
        "Stedet representerer overgangen fra",
        "Stedet er et møte mellom"
      ],
      "watchWords": [
        "lesbarhet",
        "lesbart",
        "akse",
        "spor",
        "overgang",
        "tyngdepunkt",
        "knutepunkt",
        "identitet",
        "transformasjon",
        "samfunnsutvikling"
      ],
      "rule": "Ordene er ikke forbudt, men skal bare brukes når de er presise og ikke allerede dominerer batchen. Konkrete verb og stedlige detaljer skal komme før abstrakte etiketter."
    },
    "batchDiversification": {
      "maxSameOpeningPatternInTen": 2,
      "maxIdenticalWatchWordInTen": 3,
      "requirements": [
        "Varier åpningstype mellom person, handling, fysisk trekk, lyd, konflikt, hendelse og overraskelse.",
        "Ikke la alle popupDesc følge kronologisk før-så-nå-struktur.",
        "Ikke bruk kategorinavnet som konklusjon i hver tekst.",
        "Ingen tekst skal kunne flyttes til et annet sted ved bare å bytte egennavnet."
      ]
    }
  },
