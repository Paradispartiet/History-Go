{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history-go.example/schemas/place-card-profile-v2.json",
  "title": "History GO canonical PlaceCard collection profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "collection_ids", "reason", "verifiedAt"],
  "properties": {
    "schema": { "const": "history_go_place_card_profile_v2" },
    "collection_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "people",
          "objects",
          "brands",
          "map",
          "flora",
          "fauna",
          "productions",
          "structures",
          "competitions",
          "related",
          "destinations",
          "reuse",
          "materials",
          "environment",
          "systems"
        ]
      },
      "contains": {
        "enum": ["productions", "structures", "competitions", "related", "destinations"]
      },
      "minContains": 0,
      "maxContains": 1
    },
    "reason": { "type": "string", "minLength": 20 },
    "verifiedAt": { "type": "string", "format": "date" }
  }
}
