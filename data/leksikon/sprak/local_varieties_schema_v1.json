{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history-go.local/schemas/sprak-lokale-talemaal-v1.json",
  "title": "History Go lokale talemålsprofiler v1",
  "type": "object",
  "required": [
    "schema",
    "title",
    "verified_at",
    "scope",
    "relation_to_atlas",
    "macro_labels",
    "editorial_principles",
    "profiles"
  ],
  "properties": {
    "schema": {
      "const": "history_go_language_local_varieties_v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scope": {
      "const": "Norge"
    },
    "relation_to_atlas": {
      "const": "local_extension_of_norge_atlas_v1"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "macro_labels": {
      "type": "object",
      "required": ["austlandsk", "vestlandsk", "trondersk", "nordnorsk"],
      "additionalProperties": false,
      "properties": {
        "austlandsk": { "type": "string", "minLength": 1 },
        "vestlandsk": { "type": "string", "minLength": 1 },
        "trondersk": { "type": "string", "minLength": 1 },
        "nordnorsk": { "type": "string", "minLength": 1 }
      }
    },
    "editorial_principles": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "profiles": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "macro_region_id",
          "profile_status",
          "summary",
          "variation_note",
          "feature_labels"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "const": "local_speech" },
          "macro_region_id": {
            "enum": ["austlandsk", "vestlandsk", "trondersk", "nordnorsk"]
          },
          "regional_orientation_id": { "type": "string", "minLength": 1 },
          "profile_status": {
            "enum": ["documented_seed", "local_research_required"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "variation_note": { "type": "string", "minLength": 1 },
          "feature_labels": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sources": {
            "type": "array",
            "items": { "$ref": "#/$defs/link" }
          },
          "research_leads": {
            "type": "array",
            "items": { "$ref": "#/$defs/link" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
