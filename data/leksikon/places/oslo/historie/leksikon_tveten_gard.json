    "id": "tveten_gard_bygninger_artikkel",
    "place_id": "tveten_gard",
    "title": "Bygningene på Tveten gård",
    "version": 1,
    "popupDesc": "Brenneri, stabbur og drengestue som materielle spor etter gårdsarbeidet.",
    "summary": {
      "one_liner": "Husene på tunet forteller om produksjon, oppbevaring og ombygginger.",
      "themes": [
        "gårdsarkitektur",
        "materielle spor",
        "arbeidsliv"
      ],
      "tone": [
