[{"chronology":[{"confidence":"high","desc":"Året blir virksomhetens offisielle grunnleggingsår.","id":"chrono_schous_1821_1","sources":[{"title":"Store norske leksikon – Schous Bryggeri","url":"https://snl.no/Schous_Bryggeri"}],"title":"Jørgen Young overtar","year":1821},{"confidence":"high","desc":"Bryggeriet får Schou-navnet.","id":"chrono_schous_1837_2","sources":[{"title":"Store norske leksikon – Schous Bryggeri","url":"https://snl.no/Schous_Bryggeri"}],"title":"Christian Schou kjøper","year":1837},{"confidence":"high","desc":"Undergjæret øl produseres med kontrollert kjøling.","id":"chrono_schous_1843_3","sources":[{"title":"Store norske leksikon – Schous Bryggeri","url":"https://snl.no/Schous_Bryggeri"}],"title":"Bayerøl lykkes","year":1843},{"confidence":"high","desc":"Produksjonen samles i Trondheimsveien 2.","id":"chrono_schous_1873_4","sources":[{"title":"Store norske leksikon – Schous Bryggeri","url":"https://snl.no/Schous_Bryggeri"}],"title":"Flytting til Schousløkken","year":1873},{"confidence":"high","desc":"Direksjons- og portbygningen ferdigstilles.","id":"chrono_schous_1897_5","sources":[{"title":"Store norske leksikon – Schous Bryggeri","url":"https://snl.no/Schous_Bryggeri"}],"title":"Portbygningen oppføres","year":1897},{"confidence":"high","desc":"Bryggeriet tar i bruk kjøretøyet som regnes som Norges første lastebil.","id":"chrono_schous_1899_6","sources":[{"title":"Store norske leksikon – Schous Bryggeri","url":"https://snl.no/Schous_Bryggeri"}],"title":"Daimler-varebilen kjøpes","year":1899},{"confidence":"high","desc":"Schous og Frydenlund inngår i samme selskap.","id":"chrono_schous_1962_7","sources":[{"title":"Store norske leksikon – Schous Bryggeri","url":"https://snl.no/Schous_Bryggeri"}],"title":"De Sammensluttede Bryggerier","year":1962},{"confidence":"high","desc":"Brygging og Schous-navnet som aktivt merke avsluttes.","id":"chrono_schous_1981_8","sources":[{"title":"Store norske leksikon – Schous Bryggeri","url":"https://snl.no/Schous_Bryggeri"}],"title":"Produksjonen legges ned","year":1981},{"confidence":"high","desc":"Noen bygg omformes til kontor- og undervisningsformål.","id":"chrono_schous_1982_9","sources":[{"title":"Oslo byleksikon – Schouskvartalet","url":"https://oslobyleksikon.no/side/Schouskvartalet"}],"title":"Ombygging starter","year":1982},{"confidence":"high","desc":"Statlige og kommunale kulturfunksjoner etableres i området.","id":"chrono_schous_2007_10","sources":[{"title":"Oslo byleksikon – Schouskvartalet","url":"https://oslobyleksikon.no/side/Schouskvartalet"}],"title":"Kulturkvartalet utvikles","year":2007}],"externalLinks":[{"label":"Store norske leksikon – Schous Bryggeri","type":"source","url":"https://snl.no/Schous_Bryggeri","verifiedAt":"2026-08-27"},{"label":"Oslo byleksikon – Schous Bryggeri","type":"source","url":"https://oslobyleksikon.no/side/Schous_Bryggeri","verifiedAt":"2026-08-27"},{"label":"Oslo byleksikon – Schouskvartalet","type":"source","url":"https://oslobyleksikon.no/side/Schouskvartalet","verifiedAt":"2026-08-27"},{"label":"Store norske leksikon – Christian Schou","type":"source","url":"https://snl.no/Christian_Schou","verifiedAt":"2026-08-27"},{"label":"KLP Eiendom – Trondheimsveien 2","type":"official","url":"https://www.klpeiendom.no/oslo/ledige-lokaler/kontor-og-naeringslokaler/trondheimsveien-2","verifiedAt":"2026-08-27"},{"label":"Oslo kulturskole – Schous kulturstasjon","type":"official","url":"https://www.oslo.kommune.no/natur-kultur-og-fritid/kunst-og-kultur/oslo-kulturskole/om-kulturskolen/kontakt-kulturskolen/","verifiedAt":"2026-08-27"},{"label":"Schouskjelleren","type":"official","url":"https://www.schouskjelleren.no/english","verifiedAt":"2026-08-27"},{"label":"Wikimedia Commons – Schous bryggeri","type":"image_source","url":"https://commons.wikimedia.org/wiki/File:Schous_bryggeri_Oslo.jpg","verifiedAt":"2026-08-27"},{"label":"Oslo Museum – Nybrua mot Schous Bryggeri, 1961","type":"historical_image","url":"https://digitaltmuseum.no/011014674287/nybrua-mot-schous-bryggeri","verifiedAt":"2026-08-27"},{"label":"Norsk Teknisk Museum – Daimler-varebil 1899","type":"object_source","url":"https://digitaltmuseum.no/011014273526/norges-forste-varebil-daimler-1899-tilhorende-schous-bryggeri","verifiedAt":"2026-08-27"}],"facts":[{"confidence":"high","desc":"1821 ble virksomhetens offisielle grunnleggingsår.","id":"fact_schous_1821","label":"Grunnleggingsåret","sources":[{"title":"Store norske leksikon","url":"https://snl.no/Schous_Bryggeri"}]},{"confidence":"high","desc":"Produksjonen flyttet til Schousløkken i 1873.","id":"fact_schous_1873","label":"Flyttingen","sources":[{"title":"Oslo byleksikon","url":"https://oslobyleksikon.no/side/Schous_Bryggeri"}]},{"confidence":"high","desc":"Produksjonen og merkenavnet ble lagt ned i 1981.","id":"fact_schous_1981","label":"Nedleggelsen","sources":[{"title":"Store norske leksikon","url":"https://snl.no/Schous_Bryggeri"}]}],"interpretation":{"counterpoints":["1837 er Schous overtakelsesår, ikke bryggeriets offisielle grunnleggingsår.","1873 er flyttingen til Schousløkken, ikke starten på virksomheten.","Riksscenen er en selvstendig institusjon og et eget Place selv om den ligger i kvartalet."],"sources":[{"url":"https://snl.no/Schous_Bryggeri","verifiedAt":"2026-08-27"},{"url":"https://oslobyleksikon.no/side/Schous_Bryggeri","verifiedAt":"2026-08-27"},{"url":"https://oslobyleksikon.no/side/Schouskvartalet","verifiedAt":"2026-08-27"},{"url":"https://www.klpeiendom.no/oslo/ledige-lokaler/kontor-og-naeringslokaler/trondheimsveien-2","verifiedAt":"2026-08-27"}],"what_to_notice":["Portbygningen fra 1897 mot Trondheimsveien.","Ulike bygningsvolumer som røper at komplekset ble utvidet over tid.","Bryggerinavn og nye kultur- og serveringsfunksjoner i samme kvartal."],"why_it_matters":["Stedet viser hvordan produksjon, kjøling, lagring og distribusjon ble samlet i et industrielt system.","Ombruken etter 1981 viser at et produksjonsanlegg kan skifte funksjon uten at alle fysiske spor forsvinner.","Navnet Schous brukes både om et historisk bryggeri, et bygningsmiljø og nyere virksomheter, og krever presis avgrensning."]},"place_id":"schous_bryggeri","popupDesc":"Et bryggeri grunnlagt i 1821, flyttet til Schousløkken i 1873 og ombrukt som kultur- og næringskvartal etter nedleggelsen i 1981.","sources":[{"label":"Store norske leksikon – Schous Bryggeri","type":"source","url":"https://snl.no/Schous_Bryggeri","verifiedAt":"2026-08-27"},{"label":"Oslo byleksikon – Schous Bryggeri","type":"source","url":"https://oslobyleksikon.no/side/Schous_Bryggeri","verifiedAt":"2026-08-27"},{"label":"Oslo byleksikon – Schouskvartalet","type":"source","url":"https://oslobyleksikon.no/side/Schouskvartalet","verifiedAt":"2026-08-27"},{"label":"Store norske leksikon – Christian Schou","type":"source","url":"https://snl.no/Christian_Schou","verifiedAt":"2026-08-27"},{"label":"KLP Eiendom – Trondheimsveien 2","type":"official","url":"https://www.klpeiendom.no/oslo/ledige-lokaler/kontor-og-naeringslokaler/trondheimsveien-2","verifiedAt":"2026-08-27"},{"label":"Oslo kulturskole – Schous kulturstasjon","type":"official","url":"https://www.oslo.kommune.no/natur-kultur-og-fritid/kunst-og-kultur/oslo-kulturskole/om-kulturskolen/kontakt-kulturskolen/","verifiedAt":"2026-08-27"},{"label":"Schouskjelleren","type":"official","url":"https://www.schouskjelleren.no/english","verifiedAt":"2026-08-27"},{"label":"Wikimedia Commons – Schous bryggeri","type":"image_source","url":"https://commons.wikimedia.org/wiki/File:Schous_bryggeri_Oslo.jpg","verifiedAt":"2026-08-27"},{"label":"Oslo Museum – Nybrua mot Schous Bryggeri, 1961","type":"historical_image","url":"https://digitaltmuseum.no/011014674287/nybrua-mot-schous-bryggeri","verifiedAt":"2026-08-27"},{"label":"Norsk Teknisk Museum – Daimler-varebil 1899","type":"object_source","url":"https://digitaltmuseum.no/011014273526/norges-forste-varebil-daimler-1899-tilhorende-schous-bryggeri","verifiedAt":"2026-08-27"}],"summary":{"one_liner":"Fra industrielt bryggeri til ombrukt kultur- og næringskvartal.","themes":["bryggeri","industrialisering","logistikk","omstilling","ombruk"],"tone":["nøktern","stedsspesifikk"]},"title":"Schous Bryggeri","type":"main","version":1,"visual":{"designCode":"article_place_essay_miniature"},"wikiText":["Bryggeriet førte sitt offisielle grunnleggingsår tilbake til Jørgen Youngs overtakelse i 1821. Christian Julius Schou kjøpte virksomheten i 1837, moderniserte den og ga den navn.","Undergjæret bayerøl fra 1843 krevde kjøling, kontrollert gjæring og lagring. Flyttingen til Schousløkken i 1873 samlet produksjonen i et voksende industrikompleks med bryggeri, gjærhus, portbygning, tappehall og malteri.","Produksjonen ble lagt ned i 1981. Deler av bygningsmassen ble revet eller bygd om, mens bevarte industribygg fikk kontor-, undervisnings-, kultur- og serveringsfunksjoner."]},{"date":"2025-12-05","date_type":"announcement","id":"schous_bryggeri_news_brygghuset_rehabilitering","location":"Trondheimsveien 2","place_id":"schous_bryggeri","popupDesc":"KLP Eiendom har rammetillatelse til oppgradering og ombygging av kontorbygget Schous Brygghuset. Vann- og avløpsetaten avslutter leieforholdet i 2026, og planene omfatter innvendig ombygging, bruksendringer og fasadefornyelse.","sources":[{"label":"KLP Eiendom","url":"https://www.klpeiendom.no/oslo/nyhetsarkiv/schous-brygghuset-oppgraderes-for-fremtiden"}],"status":"current_plan","summary":{"one_liner":"Et nyere kontorbygg i Schouskvartalet er planlagt rehabilitert etter 2026.","themes":["rehabilitering","kontor","ombruk"]},"tags":["news_note","Schouskvartalet","planned"],"title":"Schous Brygghuset skal rehabiliteres","type":"news_note","valid_through":"2027-12-31","verifiedAt":"2026-08-27","version":1}]
