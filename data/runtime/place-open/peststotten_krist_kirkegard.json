.wikimedia.org/wiki/File:KristKirkeg%C3%A5rdOslo2025krgA.jpg","verifiedAt":"2026-09-10"},"kind":"site_change","name":"Pestkirkegården tas i bruk","source_urls":["https://oslobyleksikon.no/side/Krist_kirkeg%C3%A5rd","https://lokalhistoriewiki.no/wiki/Krist_kirkeg%C3%A5rd"],"title":"Pestkirkegården tas i bruk","type":"historical_event","year":1654},{"desc":"Gravplassen stenges.","id":"peststotten_krist_kirkegard_stenging_1924","image":"bilder/kort/historical_events/peststotten_krist_kirkegard_stenging_1924.webp","imageMeta":{"creator":"Krg","credit":"Krg / Wikimedia Commons","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/","note":"Foto fra 2025, ikke hendelsesbilde.","source":"wikimedia_commons","sourcePage":"https://commons.wikimedia.org/wiki/File:KristKirkeg%C3%A5rdOslo2025krgA.jpg","verifiedAt":"2026-09-10"},"kind":"site_change","name":"Gravplassen stenges","source_urls":["https://oslobyleksikon.no/side/Krist_kirkeg%C3%A5rd","https://lokalhistoriewiki.no/wiki/Krist_kirkeg%C3%A5rd"],"title":"Gravplassen stenges","type":"historical_event","year":1924},{"desc":"Minneparken gjenåpnes.","id":"peststotten_krist_kirkegard_minnepark_1999","image":"bilder/kort/historical_events/peststotten_krist_kirkegard_minnepark_1999.webp","imageMeta":{"creator":"Krg","credit":"Krg / Wikimedia Commons","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/","note":"Foto fra 2025, ikke hendelsesbilde.","source":"wikimedia_commons","sourcePage":"https://commons.wikimedia.org/wiki/File:KristKirkeg%C3%A5rdOslo2025krgA.jpg","verifiedAt":"2026-09-10"},"kind":"site_change","name":"Minneparken gjenåpnes","source_urls":["https://oslobyleksikon.no/side/Krist_kirkeg%C3%A5rd","https://lokalhistoriewiki.no/wiki/Krist_kirkeg%C3%A5rd"],"title":"Minneparken gjenåpnes","type":"historical_event","year":1999}],"id":"peststotten_krist_kirkegard","image":"bilder/places/peststotten_krist_kirkegard.webp","imageCard":"bilder/kort/places/peststotten_krist_kirkegard.webp","imageMeta":{"creator":"Paalso","credit":"Paalso / Wikimedia Commons","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0/","source":"wikimedia_commons","sourcePage":"https://commons.wikimedia.org/wiki/File:Pestst%C3%B8tten_p%C3%A5_Krist_Kirkeg%C3%A5rd_i_Oslo.JPG","verifiedAt":"2026-09-10"},"lat":59.917469,"locatorType":"poi","lon":10.746586,"module_audit":{"chronology":{"status":"produced"},"dialect":{"status":"not_applicable"},"for_na":{"status":"source_bounded_holdback"},"language":{"status":"produced"},"news":{"status":"not_applicable"},"reading_tracks":{"status":"produced"},"stories":{"status":"produced"}},"name":"Peststøtten – Krist kirkegård","objects":[{"collectable":true,"desc":"Kalksteinsstøtten med kors ble reist i 1654.","id":"peststotten_krist_kirkegard_peststotten","image":"bilder/kort/objects/peststotten_krist_kirkegard_peststotten.webp","imageMeta":{"creator":"Paalso","credit":"Paalso / Wikimedia Commons","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0/","source":"wikimedia_commons","sourcePage":"https://commons.wikimedia.org/wiki/File:Pestst%C3%B8tten_p%C3%A5_Krist_Kirkeg%C3%A5rd_i_Oslo.JPG","verifiedAt":"2026-09-10"},"kind":"historical_physical_object","name":"Peststøtten","physicalObject":true,"placeSpecific":true,"placeSpecificReason":"Direkte dokumentert ved Krist kirkegård.","source_urls":["https://oslobyleksikon.no/side/Pestst%C3%B8tten"],"title":"Peststøtten","type":"minnestøtte","unlock":"Finn innskriften uten å berøre monumentet.","whereToFind":"På Krist kirkegård.","why_here":"Viser det samtidige pestminnet.","year":1654},{"collectable":true,"desc":"Minnesmerket over Krebs ble avduket i 1879.","id":"peststotten_krist_kirkegard_krebsmonumentet","image":"bilder/kort/objects/peststotten_krist_kirkegard_krebsmonumentet.webp","imageMeta":{"creator":"Anne-Sophie Ofrim","credit":"Anne-Sophie Ofrim / Wikimedia Commons","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/","source":"wikimedia_commons","sourcePage":"https://commons.wikimedia.org/wiki/File:Andreas_Samuel_Krebs,_gravminne_p%C3%A5_Krist_kirkeg%C3%A5rd,_Oslo.jpg","verifiedAt":"2026-09-10"},"kind":"historical_physical_object","name":"Krebsmonumentet","physicalObject":true,"placeSpecific":true,"placeSpecificReason":"Direkte dokumentert ved Krist kirkegård.","source_urls":["https://oslobyleksikon.no/side/Krist_kirkeg%C3%A5rd","https://snl.no/Andreas_Samuel_Krebs"],"title":"Krebsmonumentet","type":"minnestøtte","unlock":"Finn navn og datering uten å berøre monumentet.","whereToFind":"På Krist kirkegård.","why_here":"Viser et senere minnelag.","year":1879}],"place_card_profile":{"category_collection_label":"Historiske hendelser","collection_ids":["people","objects","brands","historical_events"],"production_profile":"focused","reason":"To personer, to monumenter, kommunal forvalter og tre hendelser.","schema":"history_go_place_card_profile_v2","verifiedAt":"2026-09-10"},"popupDesc":"Peststøtten står ved Krist kirkegård på Hammersborg. Den ble reist i 1654, er hogd i kalkstein og kronet av et kors. Oslo Byleksikon omtaler den som Oslos eldste offentlige monument.\n\nKrist kirkegård var i bruk før 1654, men ble utvidet som pestkirkegård dette året. Arne Sivardsøn oppgis som den første gravlagte ved støtten. Monumentet er dermed både gravminne og samtidig materiell kilde.\n\nGravplassen ble utvidet i 1835, 1840 og 1856. Andreas Samuel Krebs og Niels Treschow er blant de gravlagte. Krebs fikk et eget monument avduket i 1879.\n\nKirkegården ble stengt som ordinær gravplass i 1924. Området ble minnepark i 1960, fikk gjerde i 1971 og ble rehabilitert og gjenåpnet omkring 1999–2000.\n\nStedet må leses i flere tidssjikt. Peststøtten dokumenterer 1654-laget, andre gravminner viser senere bruk, og dagens parkpreg er et resultat av senere bevaring og omforming.\n\nEn vandring gjennom gravplassen er derfor en øvelse i periodisering. Årstallet 1654, Krebs dødsår 1818, monumentåret 1879 og minneparken fra 1960 tilhører forskjellige hendelser. Når datoene holdes fra hverandre, blir stedet mer presist enn en generell fortelling om gamle graver.\n\nKildene har ulike oppgaver. Byleksikonet bærer monument- og gravplasshistorien, SNL dokumenterer personene, og kommunens side dokumenterer dagens forvaltning. Fotografiene identifiserer bevarte objekter, men kan ikke erstatte tekstkildene for eldre hendelser.\n\nMan kan observere materiale, plassering, navn og dateringer. Man kan ikke lese et sikkert samlet dødstall, alle beslutninger eller de gravlagtes følelser direkte ut av landskapet. Historisk kunnskap bygges her av flere ufullstendige spor.\n\nFormidlingen skal være nøktern. Kildene støtter monumentets alder, materialitet, navngitte gravlagte og gravplassens endringer; de gir ikke grunnlag for å rekonstruere alle ofrenes erfaringer eller gjøre epidemien til underholdning.\n\nBesøkende kan kontrollere denne tolkningen ved å sammenholde støttens innskrift og materiale med daterte gravminner og parkens nyere utforming. Slik blir forskjellen mellom samtidig spor, senere minnesmerke og moderne forvaltning synlig uten at kildene tillegges mer enn de faktisk dokumenterer.","production_profile":"focused","production_status":"complete","production_verified_at":"2026-09-10","profile_reason":"Fire reelle samlinger uten filler.","profile_status":"confirmed","quizCardImage":"bilder/QuizCards/Peststøtten – Krist kirkegård.webp","quiz_profile":{"avoid_angles":["generisk_pesthistorie","sensasjonell_dodshistorie"],"contrast_targets":["var_frelsers_gravlund","gamlebyen_gravlund","oslo_hospital"],"must_include":["koblingen mellom pestutbruddet i 1654 og den nye gravplassen","monumentet som fysisk minne om epidemi og dødelighet"],"notes":"Spør som konkret epidemihistorie og minnekultur, ikke som løs kuriositet.","place_type":"minnesmerke","primary_angles":["historie","minnekultur","sosialhistorie","materialitet"],"question_families":["historisk_hendelse","minnested","tidslag","saertrekk"],"signature_features":["gravstøtte reist i forbindelse med pestutbruddet i 1654","står ved Krist kirkegård på Hammersborg","regnes som Oslos eldste offentlige monument"],"subtype":"pestmonument_ved_historisk_kirkegard"},"r":70,"related_people_ids":["andreas_samuel_krebs","niels_treschow"],"rounds":["people","objects","brands","historical_events"],"secondaryBadgeIds":["sosialhistorie","kulturminner_og_bevaring"],"sourceFile":"places/historie/oslo/places_historie_added_batch_01/peststotten_krist_kirkegard.json","sourceObjectId":"atlasobscura:black-death-monument-peststotten","sourceProvider":"manual_research","story_ids":["st_peststotten_krist_kirkegard_fra_pestgrav_til_minnepark"],"underbadge_ids":["sosialhistorie","kulturminner_og_bevaring"],"visual":{"designCode":"monument_miniature"},"year":1654},"relations":[],"schema":"history-go-place-open-v1","stories":[{"arc":{"end":"Minnepark.","middle":"Nye minnelag.","start":"Pestgrav."},"episode":{"action":"Stedet ble brukt, stengt og omformet.","actors":["gravplassmyndigheter","Oslo kommune"],"consequence":"Flere minnelag ble bevart.","date":"1654–2000"},"id":"st_peststotten_krist_kirkegard_fra_pestgrav_til_minnepark","next_scenes":[],"place_id":"peststotten_krist_kirkegard","quality_profile":"episode_v1","related_people":["andreas_samuel_krebs","niels_treschow"],"related_places":[],"score":{"historical":4,"narrative":3,"originality":3,"play_value":3,"source":4,"total":17},"sources":[{"title":"Oslo Byleksikon","url":"https://oslobyleksikon.no/side/Krist_kirkeg%C3%A5rd"}],"story":"I 1654 ble gravplassen utvidet og Peststøtten reist. Senere fikk stedet nye gravminner. Etter stengingen i 1924 ble området minnepark og gjenåpnet omkring 1999–2000.","summary":"Gravstedet ble utvidet under pesten, stengt i 1924 og bevart som minnepark.","tags":["pest","minnekultur"],"title":"Fra pestgrav til minnepark","type":"site_transformation","year":1654}],"wonderkammer":[]}
