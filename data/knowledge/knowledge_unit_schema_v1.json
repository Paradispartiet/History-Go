{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "history-go://schemas/knowledge-unit-v1",
  "title": "History Go canonical knowledge unit v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "knowledge_unit_id",
    "subject_id",
    "emne_ids",
    "unit_type",
    "title",
    "summary",
    "canonical_claim",
    "concept_ids",
    "term_ids",
    "delivery_surfaces",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "history_go_knowledge_unit_v1"
    },
    "version": {
      "const": 1
    },
    "knowledge_unit_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ku_[a-z0-9_]+$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "emne_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unit_type": {
      "enum": [
        "definition",
        "fact",
        "process",
        "cause_effect",
        "relation",
        "comparison",
        "method",
        "event",
        "biography",
        "place_reading",
        "story_fragment",
        "interpretation"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "canonical_claim": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "string"
    },
    "significance": {
      "type": "string"
    },
    "concept_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "term_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term_id",
          "label",
          "definition"
        ],
        "properties": {
          "term_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "synonyms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "delivery_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "place_page",
          "person_page",
          "emne_page",
          "story_page",
          "wonderkammer",
          "quiz",
          "knowledge_page",
          "curated_external_source"
        ]
      }
    },
    "delivery_notes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "story_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "method_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "chronology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "end_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "period_label": {
          "type": "string"
        },
        "sequence_index": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "place_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "person_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "institution_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "learning_objective_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quiz_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quiz_delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "may_embed_full_explanation": {
          "type": "boolean"
        },
        "required_feedback_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "summary",
              "explanation",
              "why_it_matters",
              "term_definitions",
              "story_fragment",
              "relations",
              "source_note"
            ]
          }
        },
        "reading_evidence_enabled": {
          "type": "boolean"
        },
        "mastery_requires_correct_answer": {
          "type": "boolean"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "title",
          "claim_basis"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "claim_basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "canonical",
        "deprecated"
      ]
    }
  }
}
