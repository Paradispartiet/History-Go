      "decisions": [
        "No active quiz manifest target for museumsleiligheten_grabein or name variant; complete main repository tree contains no legacy quiz file for Gråbein.",
        "Keep 1888 as Tøyengata 38B's dated building; the different northern 13-gårds complex has separate chronology and must not be conflated.",
        "Preserved dwelling is not Arbeidermuseet, other tenements, or evidence that every displayed object belonged to the Bjørklund family."
      ],
      "knowledge_migration": {
        "status": "not_applicable",
        "reason": "No active or legacy quiz for this apartment ID, and no previously linked Knowledge units."
      }
