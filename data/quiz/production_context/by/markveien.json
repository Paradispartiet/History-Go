  "claim_bank": [
    {
      "claim_id": "claim_markveien_quiz_1",
      "order": 1,
      "planned_phase": "opening",
      "family": "fact",
      "statement": "Oslo byleksikon beskriver Markveien som todelt: nederst en tydelig handlegate, øverst en roligere gate dominert av 1800-talls leiegårder. Nettopp dette skillet gjør at Markveien kan oppleves som både destinasjonsgate og nabolagsgate.",
      "source_ids": [
        "Oslo byleksikon – Markveien"
      ],
      "source_origin": "external",
      "emne_id": "em_by_kommersielle_gater"
    },
    {
      "claim_id": "claim_markveien_quiz_2",
      "order": 2,
      "planned_phase": "opening",
      "family": "fact",
      "statement": "Navnet er et spor etter landskapet før murgårdene og handellivet. Det peker tilbake på markene mellom Akerselva og Trondheimsveien før området ble tett bygd ut.",
      "source_ids": [
        "Lokalhistoriewiki – Markveien (Oslo)",
        "Oslo byleksikon – Markveien"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_markveien_quiz_3",
      "order": 3,
      "planned_phase": "opening",
      "family": "fact",
      "statement": "Markveien ble innlemmet i byen ved byutvidelsen 1. januar 1859. Det plasserer gata i den store fasen der Christiania skjøv grensene utover og gjorde tidligere randsoner til by.",
      "source_ids": [
        "Oslo byleksikon – Markveien"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_markveien_quiz_4",
      "order": 4,
      "planned_phase": "opening",
      "family": "fact",
      "statement": "Markveien er en av de gatene der husnummereringen bryter med det mange forventer. Det er en liten detalj, men nettopp slike ting gjør at en gate blir lettere å huske og lese.",
      "source_ids": [
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_romlig_orden"
    },
    {
      "claim_id": "claim_markveien_quiz_5",
      "order": 5,
      "planned_phase": "opening",
      "family": "fact",
      "statement": "Grünerstubben er et lite, men viktig byromsgrep. Slike korte forbindelser gjør gatenettet mer porøst og bidrar til at Markveien oppleves som vevd inn i et større nabolag, ikke som en isolert handlegate.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Oslo byleksikon – Grünerstubben"
      ],
      "source_origin": "external",
      "emne_id": "em_by_gangstrommer_snarveier"
    },
    {
      "claim_id": "claim_markveien_quiz_6",
      "order": 6,
      "planned_phase": "opening",
      "family": "fact",
      "statement": "Markveien går fra Sannergata til Søndre gate. Det høres tørt ut, men slike start- og endepunkter hjelper deg å lese hvorfor gata binder sammen flere litt ulike deler av Grünerløkka.",
      "source_ids": [
        "Oslo byleksikon – Markveien"
      ],
      "source_origin": "external",
      "emne_id": "em_by_barrierer_forbindelser"
    },
    {
      "claim_id": "claim_markveien_quiz_7",
      "order": 7,
      "planned_phase": "opening",
      "family": "fact",
      "statement": "Olaf Ryes plass ligger tett inntil Markveien og er en viktig grunn til at strøket ikke bare leses som handlegate. Gata henger sammen med et større møtested av park, uterestauranter og gjennomgangstrafikk.",
      "source_ids": [
        "Oslo byleksikon – Olaf Ryes plass"
      ],
      "source_origin": "external",
      "emne_id": "em_by_offentlige_rom_motesteder"
    },
    {
      "claim_id": "claim_markveien_quiz_8",
      "order": 8,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Markveien 25 er et av punktene der krigshistorien er lagt rett inn i fortauet. Snublesteinene gjør en privat adresse til et offentlig minne om deportasjonene av jøder fra Oslo.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "snublestein.no – Philip Sam Watchman",
        "snublestein.no – Florence Watchman",
        "snublestein.no – Arthur Watchman"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_markveien_quiz_9",
      "order": 9,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Watchman-familien var ikke bare knyttet til adressen som privat hjem. Philip Sam Watchman drev også kunst- og antikvitetshandel, først i tilknytning til leiligheten i Markveien 25.",
      "source_ids": [
        "snublestein.no – Philip Sam Watchman",
        "snublestein.no – Florence Watchman"
      ],
      "source_origin": "external",
      "emne_id": "em_by_kommersielle_gater"
    },
    {
      "claim_id": "claim_markveien_quiz_10",
      "order": 10,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Markveien 28 viser at gata ikke bare har handlet om dagens kafé- og nisjebutikkliv. Den rommet også kooperativ handel og forsyningsøkonomi for folk i nabolaget.",
      "source_ids": [
        "Lokalhistoriewiki – Markveien (Oslo)",
        "Oslo byleksikon – Markveien"
      ],
      "source_origin": "external",
      "emne_id": "em_by_kommersielle_gater"
    },
    {
      "claim_id": "claim_markveien_quiz_11",
      "order": 11,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Disse gårdene gjør arbeiderhistorien i Markveien konkret. De binder gata til fabrikkbyen rundt Akerselva og viser at dagens byliv hviler på eldre lag av arbeid, bolig og industri.",
      "source_ids": [
        "Oslo byleksikon – Markveien"
      ],
      "source_origin": "external",
      "emne_id": "em_by_boligstruktur"
    },
    {
      "claim_id": "claim_markveien_quiz_12",
      "order": 12,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Bakgården i Markveien 42 rommer et sjeldent gammelt spor midt i en gate som ellers leses gjennom kafeer og murgårder. At huset både er gammelt og hadde bakeri så lenge, gjør det til et presist minne om hverdagsarbeid i strøket.",
      "source_ids": [
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_markveien_quiz_13",
      "order": 13,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Markveien 57 viser en annen side av gatehistorien enn kaféene og butikkene: kommunal velferds- og boligpolitikk. Bygningen ble reist som et losjihus for menn og var del av en idé om at også vanskeligstilte skulle ha bedre og sunnere boliger.",
      "source_ids": [
        "Lokalhistoriewiki – Markveien 57 (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_boligpolitikk_affordability"
    },
    {
      "claim_id": "claim_markveien_quiz_14",
      "order": 14,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "At et kommunalt losjihus fikk Houens diplom, gjør bygningen ekstra interessant. Den viser at sosialhistorie og arkitektonisk kvalitet ikke trenger å stå mot hverandre i byen.",
      "source_ids": [
        "Lokalhistoriewiki – Markveien 57 (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_bygningstyper_og_typologier"
    },
    {
      "claim_id": "claim_markveien_quiz_15",
      "order": 15,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Historien om Markveien 9 viser at gata lenge var rigget for hverdagsforsyning, ikke bare for destinasjonsforbruk. Før kafé- og barpreget fantes det travle hjørnebutikker som bar mye av nabolagets daglige rytme.",
      "source_ids": [
        "Oslohistorie – Butikken i Markveien 9"
      ],
      "source_origin": "external",
      "emne_id": "em_by_kommersielle_gater"
    },
    {
      "claim_id": "claim_markveien_quiz_16",
      "order": 16,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Det er ikke alltid de store monumentene som forteller mest om en gate. I Markveien 9 er et lite trappetrinn nok til å avsløre en eldre butikklogikk i første etasje.",
      "source_ids": [
        "Oslohistorie – Butikken i Markveien 9"
      ],
      "source_origin": "external",
      "emne_id": "em_by_butikkfasader_vindusutstillinger"
    },
    {
      "claim_id": "claim_markveien_quiz_17",
      "order": 17,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Markveien er ikke entydig. Nedre del trekker til seg folk gjennom butikker, kafeer og restauranter, mens øvre del fortsatt leses mer som bolig- og leiegårdsstrøk.",
      "source_ids": [
        "Oslo byleksikon – Markveien"
      ],
      "source_origin": "external",
      "emne_id": "em_by_kommersielle_gater"
    },
    {
      "claim_id": "claim_markveien_quiz_18",
      "order": 18,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Historien om «Ny York» viser hvor improvisert og raskt området rundt Markveien kunne vokse før murbyen tok over. Den minner om at Grünerløkka ikke begynte som ferdig, tung 1800-talls murby, men også hadde en rå og rask forstadsfase.",
      "source_ids": [
        "Oslo byleksikon – Ny York"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_markveien_quiz_19",
      "order": 19,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Små forbindelser betyr mye i en bydel som brukes til fots. Grünerstubben gjør Markveien mindre lineær og mer porøs, noe som styrker både gjennomgangstrafikk og lokal bruk.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Oslo byleksikon – Grünerstubben"
      ],
      "source_origin": "external",
      "emne_id": "em_by_gangstrommer_snarveier"
    },
    {
      "claim_id": "claim_markveien_quiz_20",
      "order": 20,
      "planned_phase": "middle",
      "family": "context",
      "statement": "Det spesielle med Markveien er ikke bare at den har endret seg, men at flere tidslag fortsatt ligger synlig side om side. Gata kan leses som både arbeiderhistorie, velferdshistorie, krigshistorie og samtidsbyliv.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien 57 (Oslo)",
        "snublestein.no – Philip Sam Watchman"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_markveien_quiz_21",
      "order": 21,
      "planned_phase": "middle",
      "family": "context",
      "statement": "Markveien og Olaf Ryes plass fungerer som et lite system: folk går gjennom, men de stopper også opp. Kombinasjonen av plassrom, sidegater, butikker og uteservering gjør at stedet får mer enn én rytme.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Oslo byleksikon – Olaf Ryes plass"
      ],
      "source_origin": "external",
      "emne_id": "em_by_opphold_vs_gjennomgang"
    },
    {
      "claim_id": "claim_markveien_quiz_22",
      "order": 22,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Grünerbygg er et nøkkelnavn i Markveiens nyere historie fordi bygget står på et sted der byfornyelse, rivning og protester kolliderte direkte.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_byidealer_og_plantradisjoner"
    },
    {
      "claim_id": "claim_markveien_quiz_23",
      "order": 23,
      "planned_phase": "middle",
      "family": "context",
      "statement": "Markveien ble et sted der byfornyelsens konflikt fikk konkrete politiske følger. Protestene rundt rivingen endret ikke bare ett kvartal, men påvirket hvordan hele bydelen senere ble behandlet.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_styring_forvaltning_planmakt"
    },
    {
      "claim_id": "claim_markveien_quiz_24",
      "order": 24,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Markveien 35 var ikke bare et hverdagssted i bydelen. Under krigen ble adressen knyttet til et dramatisk Gestapo-bakhold mot folk fra Oslogjengen.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_markveien_quiz_25",
      "order": 25,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Det blå skiltet gjør en krigshistorisk hendelse til et lesbart byspor i dagens gatebilde. Slik bindes fortid og nåtid sammen uten at hele stedet blir et museum.",
      "source_ids": [
        "Oslo byleksikon – Markveien"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_markveien_quiz_26",
      "order": 26,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Brannen i Markveien 39 er et hardt minne i gatehistorien. Den minner om at byens leiegårder og forretningsgårder også har rommet sårbarhet, fare og tap.",
      "source_ids": [
        "Lokalhistoriewiki – Markveien (Oslo)",
        "Oslo byleksikon – Branner"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_markveien_quiz_27",
      "order": 27,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Bakgårdshuset i Markveien 42 viser hvor lenge hverdagsarbeid kan sitte igjen i en gate. En så lang bakerihistorie gjør at huset kan leses som mer enn bare gammelt: det er også et arbeidsminne.",
      "source_ids": [
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_kommersielle_gater"
    },
    {
      "claim_id": "claim_markveien_quiz_28",
      "order": 28,
      "planned_phase": "middle",
      "family": "fact",
      "statement": "Historien om Markveien 67 viser at forfølgelsen av jøder også rammet byens næringsliv og gateøkonomi. Beslagleggingen gjorde en vanlig handelsadresse til del av okkupasjonsmaktens økonomiske vold.",
      "source_ids": [
        "Oslo byleksikon – Markveien"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_markveien_quiz_29",
      "order": 29,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Konflikten rundt Markveien 35–37 handlet ikke bare om ett kvartal. Den handlet om hvor langt sanering og nybygging kunne gå før et strøk mistet karakteren som gjorde det gjenkjennelig og brukbart for folk som allerede bodde der.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_styring_forvaltning_planmakt"
    },
    {
      "claim_id": "claim_markveien_quiz_30",
      "order": 30,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Markveien kan leses som en økonomisk tidslinje: fra samvirke, kolonial og bakeri til kaféer, barer og nisjehandel. Det er ikke et totalt brudd, men en tydelig forskyvning i hva slags forbruk og sosial profil gata inviterer til.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Oslohistorie – Butikken i Markveien 9",
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_kommersielle_gater"
    },
    {
      "claim_id": "claim_markveien_quiz_31",
      "order": 31,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Det interessante med Markveien er at mange lag fortsatt er lesbare uten spesialkunnskap: navnet peker bakover, murbyen står der, krigsminnene ligger i fortauet og velferdshistorien er synlig i Markveien 57.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien 57 (Oslo)",
        "snublestein.no – Philip Sam Watchman"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_markveien_quiz_32",
      "order": 32,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Markveien 57 viser at et bygg kan være viktig både som arkitektur og som sosialt program. Det er nettopp kombinasjonen av kommunal boligpolitikk, 77 plasser og prisbelønt utforming som gjør bygningen så analytisk skarp.",
      "source_ids": [
        "Lokalhistoriewiki – Markveien 57 (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_boligpolitikk_affordability"
    },
    {
      "claim_id": "claim_markveien_quiz_33",
      "order": 33,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Markveien er et godt eksempel på at sosial og kommersiell omforming kan skje uten at hele den fysiske gata forsvinner. Det er nettopp samspillet mellom gammel bygningsmasse og ny bruk som gjør forandringen synlig.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_gentrifisering_eiendom"
    },
    {
      "claim_id": "claim_markveien_quiz_34",
      "order": 34,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Markveien blir mindre glatt og entydig enn en ren luksushandlegate fordi den fortsatt har et tydelig boliglag og en tung historie i vegger, bakgårder og minnespor.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_bydelsforskjeller_segregering"
    },
    {
      "claim_id": "claim_markveien_quiz_35",
      "order": 35,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Det er denne dobbeltheten som gjør Markveien interessant: gata lever fortsatt av at den kjennes lokal, men den tiltrekker seg også folk nettopp fordi den har blitt en merkevare for en viss type byliv.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_kommersielle_gater"
    },
    {
      "claim_id": "claim_markveien_quiz_36",
      "order": 36,
      "planned_phase": "final",
      "family": "concept_theory",
      "statement": "Gentrifisering blir konkret i Markveien fordi endringen ikke bare handler om pris, men også om hvem gata er til for, hvordan den ser ut, og hva slags virksomheter som får plass.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_gentrifisering_eiendom"
    },
    {
      "claim_id": "claim_markveien_quiz_37",
      "order": 37,
      "planned_phase": "final",
      "family": "concept_theory",
      "statement": "I Markveien blir «egenart» ikke et abstrakt honnørord, men noe som handler om konkrete hus, gatebredde, bruksmønstre og forholdet mellom gammel bebyggelse og dagligliv.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_byidealer_og_plantradisjoner"
    },
    {
      "claim_id": "claim_markveien_quiz_38",
      "order": 38,
      "planned_phase": "final",
      "family": "concept_theory",
      "statement": "I Markveien kan man se dette begrepet i praksis: folk er ikke enten på vei eller i ro. Gata er bygd og brukt på en måte som hele tiden lar de to rytmene overlappe.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Oslo byleksikon – Olaf Ryes plass",
        "Oslo byleksikon – Grünerstubben"
      ],
      "source_origin": "external",
      "emne_id": "em_by_opphold_vs_gjennomgang"
    },
    {
      "claim_id": "claim_markveien_quiz_39",
      "order": 39,
      "planned_phase": "final",
      "family": "concept_theory",
      "statement": "Snublesteinene gjør byens historie bokstavelig talt tråkkbar. De flytter minnet fra arkiv og bok inn i den daglige ruten gjennom gata.",
      "source_ids": [
        "snublestein.no – Philip Sam Watchman",
        "Oslo byleksikon – Markveien"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_markveien_quiz_40",
      "order": 40,
      "planned_phase": "final",
      "family": "concept_theory",
      "statement": "I Markveien er «arbeiderstrøk» ikke bare en etikett. Det kan leses i boligtypene, i den kooperative butikkhistorien og i koblingen til fabrikkbyen rundt Akerselva.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_boligstruktur"
    },
    {
      "claim_id": "claim_markveien_quiz_41",
      "order": 41,
      "planned_phase": "final",
      "family": "concept_theory",
      "statement": "Selv om Markveien har endret bruk og profil, er det fortsatt mye stoff igjen å lese i vegger, bakgårder, minnespor og gateforløp. Gata har altså forandret seg, men ikke blitt nullstilt.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien (Oslo)",
        "Lokalhistoriewiki – Markveien 57 (Oslo)"
      ],
      "source_origin": "external",
      "emne_id": "em_by_byidealer_og_plantradisjoner"
    },
    {
      "claim_id": "claim_markveien_quiz_42",
      "order": 42,
      "planned_phase": "final",
      "family": "concept_theory",
      "statement": "Dette er kjernen i Markveien som case: ikke at alt gammelt er borte, men at det gamle og det nye ligger friksjonsfylt oppå hverandre. Nettopp derfor er gata så god å lære av.",
      "source_ids": [
        "Oslo byleksikon – Markveien",
        "Lokalhistoriewiki – Markveien (Oslo)",
        "Oslohistorie – Butikken i Markveien 9"
      ],
      "source_origin": "external",
      "emne_id": "em_by_gentrifisering_eiendom"
    }
  ],
