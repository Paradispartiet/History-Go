      "work": "The Social Life of Small Urban Spaces"
    },
    {
      "claim_id": "claim_birkelunden_q35",
      "order": 35,
      "planned_phase": "final",
      "family": "concept_theory",
      "statement": "De tre verkene ligger i parken, men peker mot ulike temaer og tidspunkter. Dateringen gjør dem til konkrete, adskilte historiske lag.",
