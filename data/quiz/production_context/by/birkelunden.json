        "oslo_byleksikon"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_birkelunden_q21",
      "order": 21,
      "planned_phase": "middle",
      "family": "context",
      "statement": "Paviljongen fra 1926 er et gjenkjennelig fysisk anker i den historiske ca. 1930-dokumentasjonen og det daterte nyere parkbildet.",
      "source_ids": [
        "oslo_museum_before",
        "commons_after",
