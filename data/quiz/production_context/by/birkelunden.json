    },
    {
      "claim_id": "claim_birkelunden_q22",
      "order": 22,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Kildegrunnlaget skiller mellom starten på fredningsprosessen i 1996 og selve fredningen av det større kulturmiljøet i 2006.",
      "source_ids": [
        "oslo_byleksikon",
        "riksantikvaren"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_birkelunden_q23",
      "order": 23,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Parken er 16,3 dekar. Omtrent 116 dekar gjelder en større fredet bystruktur som også omfatter bebyggelse og andre elementer rundt parken.",
      "source_ids": [
        "oslo_kommune",
        "riksantikvaren"
      ],
      "source_origin": "external",
      "emne_id": "em_by_parker_som_sosial_infrastruktur"
    },
    {
      "claim_id": "claim_birkelunden_q24",
      "order": 24,
      "planned_phase": "bridge",
      "family": "fact",
      "statement": "Riksantikvaren beskriver et større kulturmiljø der parken inngår sammen med murbykvartaler og offentlige bygg. Det betyr ikke at disse eies av park-place som structures.",
      "source_ids": [
        "riksantikvaren"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_birkelunden_q25",
      "order": 25,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Den nåværende paviljongen fra 1926 er fortsatt en sentral struktur i parken og brukes som orienteringspunkt i historiske og nyere bilder.",
      "source_ids": [
        "oslo_byleksikon",
        "oslo_kommune"
      ],
      "source_origin": "external",
      "emne_id": "em_by_parker_som_sosial_infrastruktur"
    },
    {
      "claim_id": "claim_birkelunden_q26",
      "order": 26,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Birkelundens historie omfatter både gamle plantinger og senere fornyelse. Et historisk parkrom trenger derfor ikke bestå av uendrede enkelttrær for å ha kontinuitet.",
      "source_ids": [
        "oslo_byleksikon",
        "riksantikvaren"
      ],
      "source_origin": "external",
      "emne_id": "em_by_parker_som_sosial_infrastruktur"
    },
    {
      "claim_id": "claim_birkelunden_q27",
      "order": 27,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Det større fredede kulturmiljøet binder flere steder sammen, men parkens canonical innhold må fortsatt holde own-place-grensen.",
      "source_ids": [
        "riksantikvaren"
      ],
      "source_origin": "external",
      "emne_id": "em_by_historiske_lag_i_hverdagsrom"
    },
    {
      "claim_id": "claim_birkelunden_q28",
      "order": 28,
      "planned_phase": "bridge",
      "family": "context",
      "statement": "Bildene støtter visuelle sammenligninger av synlige parkankre. De dokumenterer ikke alene sosial sammensetning, boligpriser eller årsaker til endring.",
      "source_ids": [
        "oslo_museum_before",
        "commons_after"
