    },
    {
      "claim_id": "claim_birkelunden_q33",
      "order": 33,
      "planned_phase": "final",
      "family": "concept_theory",
      "statement": "Meyer anla parken, men 1882-overføringen plasserte den i kommunal forvaltning under et uttrykkelig arealvilkår.",
      "source_ids": [
        "oslo_byleksikon",
        "riksantikvaren"
