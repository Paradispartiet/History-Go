      "source_origin": "external",
      "emne_id": "em_his_historiske_lag_i_byrom"
    },
    {
      "claim_id": "claim_garmanngarden_quiz_17",
      "order": 17,
      "planned_phase": "final",
      "family": "fact",
      "statement": "En hvelvkjeller ble brukt som vinstue under Johan Piper. Den samme historiske gården har rommet både offentlige og kommersielle funksjoner.",
      "source_ids": [
        "oslo_byleksikon"
