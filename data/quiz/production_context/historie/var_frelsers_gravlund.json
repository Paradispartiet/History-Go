    {
      "candidate": "Napoleonskrigene som direkte årsak til etableringen",
      "reason": "Den kontrollerte kilden dokumenterer reform, hygiene og plassering, men ikke denne entydige årsakskjeden."
    },
    {
      "candidate": "Gravlunden ble stengt for nye graver i 1952",
      "reason": "Påstanden motsies av dagens urnegravtilbud og er ikke støttet i de valgte kildene."
    },
    {
      "candidate": "Alle kjente personer ligger i Æreslunden",
      "reason": "Kommunens separate kart viser at mange historiske personer ligger utenfor feltet."
    },
    {
      "candidate": "Bestemte arter dokumentert av parkpreget alene",
      "reason": "Generisk vegetasjon eller nærhet er ikke artsbelegg."
    }
  ],
