{
  "version": 1,
  "id": "arbeidsledig",
  "navn": "Arbeidsledig",
  "kjernefantasi": "Du er uten formell jobb, men livet ditt består av mer enn venting. Søknader og praktiske plikter går ved siden av selvvalgte prosjekter, miljøer og livsroller. Den første uka lar en kontakt bli til en egen historie; det du har sagt, gjort eller takket nei til, følger deg videre.",
  "arbeidsoppgaver": [
    "holde meldekort og dokumentasjon i orden",
    "avklare søknader uten å gjøre dem til hele identiteten",
    "bygge en egen rytme med plass til hvile og mennesker",
    "utforske prosjekter, fellesskap og livsroller gjennom konkrete valg"
  ],
  "personer": [
    {
      "id": "nav_veileder",
      "navn": "NAV-veilederen",
      "beskrivelse": "Følger opp meldekort og dokumentasjon. Systemet er firkantet; hun er ikke."
    },
    {
      "id": "bekjent",
      "navn": "Bekjenten",
      "beskrivelse": "Kjenner folk. Spør hver gang: «Har du hørt noe?»"
    },
    {
      "id": "venn",
      "navn": "Jonas",
      "beskrivelse": "Vennen din. Har kjent deg lenge nok til å høre forskjell på «det går bra» og «det går bra»."
    },
    {
      "id": "familie",
      "navn": "Søsteren din",
      "beskrivelse": "Ringer om hverdagslige ting som aldri bare er hverdagslige."
    },
    {
      "id": "mira",
      "navn": "Mira",
      "beskrivelse": "Jonas kjenner henne fra musikkmiljøet. Hun trenger en medspiller til en prøve, ikke en ansatt."
    },
    {
      "id": "amir",
      "navn": "Amir",
      "beskrivelse": "Bekjentens gamle kjenning. Tilbyr plass i et miljø der tjenester og forventninger må avklares."
    },
    {
      "id": "booker",
      "navn": "Kveldens booker",
      "beskrivelse": "Avklarer en mulig liten spillejobb. En forespørsel er ikke en bekreftet booking."
    },
    {
      "id": "lea",
      "navn": "Lea",
      "beskrivelse": "Bygger små prototyper på biblioteket. Spør etter én ting som kan prøves, og tåler at et prosjekt foreløpig ikke skal selges."
    },
    {
      "id": "elin",
      "navn": "Elin",
      "beskrivelse": "Deler atelierplass og går i skrivegruppe. Hun spør før hun leser, låner materialer eller viser andres arbeid."
    },
    {
      "id": "sara",
      "navn": "Sara",
      "beskrivelse": "Holder orden på klubbkvelder og et lokalt initiativ. Hun vil dele oppgaver, men vet at ledig tid ikke betyr ubegrenset kapasitet."
    },
    {
      "id": "ivar",
      "navn": "Ivar",
      "beskrivelse": "Går gjennom byen med gamle bilder og egne notater. Skiller minner fra det kildene faktisk kan vise."
    },
    {
      "id": "nora",
      "navn": "Nora",
      "beskrivelse": "Registrerer natur sammen med andre og bruker verkstedet til enkle modeller. Vil heller beholde et usikkert funn enn å pynte på resultatet."
    },
    {
      "id": "daniel",
      "navn": "Daniel",
      "beskrivelse": "Er med i filmklubb, bokgruppe og på konserter. Vil at nye folk skal kunne delta uten å kjenne alle referansene eller ta alle vaktene."
    }
  ],
  "hovedkonflikter": [
    "systemkrav vs verdighet",
    "ærlighet vs selvpresentasjon",
    "struktur vs dager som flyter",
    "søke bredt vs bygge på det du kan"
  ],
  "endings": [
    {
      "id": "kom_i_jobb",
      "navn": "Søknadssporet lever",
      "tekst": "Du har sendt søknader og brukt nettverket. Det er fortsatt ikke en ansettelse: et faktisk jobbtilbud må komme gjennom karriereflaten og aksepteres der. Søknadssporet kan leve videre mens en annen historie tar mer plass.",
      "kriterier": {
        "meters": {
          "synlighet": {
            "min": 24
          }
        },
        "flagg": {
          "sokte_tre_nye": true,
          "delte_lista_med_bekjenten": true,
          "ba_om_referanse": true
        }
      }
    },
    {
      "id": "bygget_kompetanse",
      "navn": "En retning for læringen",
      "tekst": "Du har valgt et kunnskapshull og satt av tid til å arbeide med det. Lista er mer konkret enn da uka begynte. Det er et arbeid du kan følge videre, selv mens du venter på svar fra arbeidsgivere.",
      "kriterier": {
        "meters": {
          "handlingsrom": {
            "min": 42
          }
        },
        "flagg": {
          "begynte_aa_tette_hullet": true,
          "la_laeringsplan": true,
          "satser_paa_kunnskap": true
        }
      }
    },
    {
      "id": "mistet_rytmen",
      "navn": "Mistet rytmen",
      "tekst": "Dagene fløt i hverandre og rammen forsvant. Uten et sted å møte opp ble det lett å skyve alt til «i morgen» — og i morgen ble til flere dager som lignet på hverandre.",
      "kriterier": {
        "meters": {
          "psyke": {
            "max": 46
          }
        },
        "flagg": {
          "lot_dagen_skli": true,
          "utsatte_igjen": true,
          "utsatte_avslaget": true
        }
      }
    },
    {
      "id": "sto_i_det",
      "navn": "Sto i det",
      "tekst": "Ingen formell jobb ennå. Du har kommet gjennom den første uka, tatt valg og møtt det som kom. Noe er ryddet, noe er fortsatt åpent. Du har et sted å fortsette fra.",
      "kriterier": {
        "flagg": {
          "sendte_meldekortet": true,
          "aerlig_om_hullet": true,
          "pustet_ut": true
        }
      },
      "standard": true
    }
  ],
