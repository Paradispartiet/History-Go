            "meters": {
              "energi": -1,
              "integritet": -2
            },
            "flagg": {
              "aapnet_raskt": true
            },
            "threads": {
              "prisfeilen_i_koen": {
                "stepDelta": 1
              }
            }
          },
          "konsekvensTekst": "Døra går opp på slaget. Butikken ser våken ut. Du håper det den ikke rakk å bli, ikke synes.",
          "laaserOpp": [
            "prisfeil_02_koen"
          ]
        },
        {
          "id": "spor_amir",
          "tekst": "Spør Amir hva som pleier å ryke på kampanjedager",
          "tone": "lærende",
          "effekter": {
            "relasjoner": {
              "erfaren_kollega": 6
            },
            "meters": {
              "energi": -2,
              "handlingsrom": 2
            },
            "flagg": {
              "spurte_amir_om_kampanje": true
            },
            "threads": {
              "prisfeilen_i_koen": {
                "stepDelta": 1
              }
            }
          },
          "konsekvensTekst": "«Kaffen,» sier Amir uten å nøle. «Plakaten sier alltid noe annet enn kassa første dagen. Sjekk den før kø nummer én.»",
          "laaserOpp": [
            "prisfeil_02_koen"
          ]
        }
      ]
    },
