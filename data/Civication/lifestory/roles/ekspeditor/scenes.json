      "prioritet": 10,
      "tittel": "Første ordentlige kasseøkt",
      "tekst": "Lene skriver: «Du får første ordentlige kasseøkt i dag. Det viktigste er å holde flyt uten å miste nøyaktighet. Og åpningen er din: kundene skal aldri merke hva som måtte fikses før døra gikk opp.»",
      "valg": [
        {
          "id": "sjekk_plakatene",
          "tekst": "Gå en runde og sjekk hylleplakatene mot kassa før åpning",
          "tone": "grundig",
          "effekter": {
            "meters": {
              "integritet": 4,
              "energi": -3
            },
            "flagg": {
              "sjekket_priser_foer_aapning": true
            },
            "threads": {
              "prisfeilen_i_koen": {
                "stepDelta": 1
              }
            }
          },
          "konsekvensTekst": "Du finner to plakater som ikke stemmer og retter dem før noen ser det. Ingen vil noensinne vite. Det er litt av poenget.",
          "laaserOpp": [
            "prisfeil_02_koen"
          ]
        },
        {
          "id": "aapne_raskt",
          "tekst": "Åpne presis og ta det som kommer",
          "tone": "effektiv",
          "effekter": {
            "relasjoner": {
              "butikksjef": 2
