    },
    {
      "id": "erfaren_kollega",
      "navn": "Amir, erfaren kollega",
      "beskrivelse": "Kan kassa og kundene. «Det tar lengre tid å rette en feil du latet som du visste.»"
    },
    {
      "id": "ny_kollega",
      "navn": "Vikaren",
      "beskrivelse": "Ny på gulvet. Spør deg — midt i køen."
    },
    {
