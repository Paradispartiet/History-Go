{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Civication – C01–C24 oversikt med reell produksjonsstatus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "legacy_register",
    "status_note",
    "updated_date",
    "types"
  ],
  "properties": {
    "schema": {
      "const": "civication_story_coverage_inventory_v1"
    },
    "legacy_register": {
      "type": "string",
      "minLength": 3
    },
    "status_note": {
      "type": "string",
      "minLength": 10
    },
    "updated_date": {
      "type": "string",
      "format": "date"
    },
    "types": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type_id",
          "name",
          "legacy_synopsis_id",
          "role_candidate",
          "book_selection",
          "film_identity",
          "film_analysis",
          "synopsis",
          "blueprint",
          "runtime",
          "evidence_refs",
          "literary_track_ids",
          "plot_lens_ids",
          "film_imdb_id",
          "film_producer_scenario_id",
          "role_adaptations"
        ],
        "properties": {
          "type_id": {
            "type": "string",
            "pattern": "^C(0[1-9]|1[0-9]|2[0-4])$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "legacy_synopsis_id": {
            "type": "string",
            "pattern": "^C(0[1-9]|1[0-9]|2[0-4])$"
          },
          "role_candidate": {
            "type": "string",
            "minLength": 3
          },
          "book_selection": {
            "enum": [
              "goodreads_not_checked",
              "read_four_plus_verified",
              "not_eligible"
            ]
          },
          "film_identity": {
            "enum": [
              "not_matched",
              "matched_imdb_film_producer"
            ]
          },
          "film_analysis": {
            "enum": [
              "not_reviewed",
              "reviewed_with_evidence"
            ]
          },
          "synopsis": {
            "enum": [
              "not_started",
              "legacy_candidate",
              "editorially_approved"
            ]
          },
          "blueprint": {
            "enum": [
              "missing",
              "candidate",
              "approved"
            ]
          },
          "runtime": {
            "enum": [
              "no_new_scenes",
              "authored_unregistered",
              "registered_playable"
            ]
          },
          "blueprint_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtime_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "literary_track_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^L[0-9]{2}$"
            },
            "uniqueItems": true
          },
          "plot_lens_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P0[1-7]$"
            },
            "uniqueItems": true
          },
          "film_imdb_id": {
            "type": "string",
            "pattern": "^tt[0-9]+$"
          },
          "film_producer_scenario_id": {
            "type": "string",
            "pattern": "^scenario_[a-z0-9_]+$"
          },
          "role_adaptations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role_id",
                "applicability",
                "reason",
                "blueprint_ids",
                "runtime_paths"
              ],
              "properties": {
                "role_id": {
                  "type": "string",
                  "minLength": 3
                },
                "applicability": {
                  "enum": [
                    "candidate",
                    "appropriate",
                    "not_appropriate"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 10
                },
                "blueprint_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^blueprint-[a-z0-9-]+$"
                  }
                },
                "runtime_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 3
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "types": {
          "items": {
            "if": {
              "properties": {
                "runtime": {
                  "const": "registered_playable"
                }
              },
              "required": [
                "runtime"
              ]
            },
            "then": {
              "required": [
                "runtime_path"
              ],
              "properties": {
                "runtime_path": {
                  "type": "string",
                  "minLength": 4
                },
                "blueprint": {
                  "const": "approved"
                },
                "synopsis": {
                  "const": "editorially_approved"
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "types": {
          "items": {
            "if": {
              "properties": {
                "blueprint": {
                  "const": "approved"
                }
              },
              "required": [
                "blueprint"
              ]
            },
            "then": {
              "required": [
                "blueprint_id"
              ],
              "properties": {
                "blueprint_id": {
                  "type": "string",
                  "minLength": 4
                }
              }
            }
          }
        }
      }
    }
  ]
}
