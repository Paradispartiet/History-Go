dri brukes som juridisk, profesjonell eller arbeidsgiverbasert autorisasjon."],"career_axis":["arrangementsdrift","program_og_koordinering","produksjon_og_prosjekt","produksjonsledelse","kulturarena_ledelse"],"sources":{"utdanning_arrangementsplanlegger":{"publisher":"Utdanning.no","title":"Arrangementsplanlegger","url":"https://utdanning.no/yrker/beskrivelse/arrangementsplanlegger","checked_at":"2026-08-14","supports":["Arrangementsplanlegger","Prosjektleder (kulturarrangement)"],"note":"Gjennomgått i samarbeid med Faglig råd for salg, service og reiseliv 17. september 2025. Beskriver planlegging, koordinering og gjennomføring, budsjett, avtaler og administrasjon; siden oppgir ingen særskilte utdanningskrav."},"nav_munch_arrangementscrew":{"publisher":"NAV Arbeidsplassen / MUNCH","title":"Arrangementscrew - deltid","url":"https://arbeidsplassen.nav.no/stillinger/stilling/c7973920-50f5-4aae-a62e-32f14779ce9c","supports":["Arrangementscrew","Produksjonsassistent"],"note":"Dokumenterer rigg, teknisk utstyr, adgang, kø/publikumslogistikk og funksjon som produksjonsassistent."},"nav_kulturhusvert":{"publisher":"NAV Arbeidsplassen","title":"Kulturhusvert","url":"https://arbeidsplassen.nav.no/stillinger/stilling/d30e9cfb-d8b9-4c49-a6dd-430506d5e601","supports":["Kulturhusvert"]},"nav_kulturmedarbeider":{"publisher":"NAV Arbeidsplassen","title":"Kulturmedarbeider","url":"https://arbeidsplassen.nav.no/stillinger/stilling/7b36cc14-8161-44cd-82af-7c1298dba86e","supports":["Kulturmedarbeider"]},"nav_kulturkonsulent":{"publisher":"NAV Arbeidsplassen","title":"Kulturkonsulent","url":"https://arbeidsplassen.nav.no/stillinger/stilling/afac75ac-cb3e-46f3-bffd-9c7fd01e41db","supports":["Kulturkonsulent"]},"nav_booking_innholdskoordinator":{"publisher":"NAV Arbeidsplassen","title":"Booking- og innholdskoordinator","url":"https://arbeidsplassen.nav.no/stillinger/stilling/a580b55f-6227-4e0c-91ed-60cad9c3105d","supports":["Booking- og innholdskoordinator"]},"nav_kulturhus_produsent":{"p