  },
  "title": "Teatergjenganger",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å bygge teatererfaring gjennom mange forestillinger, hus og repertoarer uten å gjøre vane, ansiennitet, smak eller mengde til gatekeeping, sosial rang eller profesjonell kritiker- og bransjemyndighet",
    "description": "Teatergjenganger-verdenen undersøker repertoarerfaring, familiaritet med teaterhus, sammenligning mellom oppsetninger, kulturvaner, abonnement, gjest–arbeidsplass-grenser, etikette, tilgjengelighet, rollebesetningsendringer, klassikere og nytolkninger, det å gå i pausen, å ta med nykommere, institusjonslojalitet og rollegrenser. Teatergjenganger er en hobby_identity. Rollen gir ingen automatisk myndighet som kritiker, dramaturg, kurator, produsent, kunstnerisk leder eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "professional_culture",
    "social_mask",
    "status_anxiety",
    "shame_reputation",
    "care_vs_efficiency",
    "local_knowledge_vs_system",
    "public_private_leakage",
    "loyalty_up_down"
  ],
  "social_environments": [
    "teatersaler der gjentatt besøk gjør sjanger- og repertoarmønstre synlige",
    "foajeer der erfarne og nye gjester møtes under ulike uskrevne koder",
    "abonnements- og repertoarsituasjoner der kontinuitet kan bli identitet og status",
    "samtaler etter forestilling der tidligere oppsetninger brukes som sammenligningsgrunnlag",
    "situasjoner med tilgjengelighetsbehov der egen rutine ikke kan tas som universell",
    "teaterhus som både er kulturarenaer for gjester og arbeidsplasser for ansatte"
  ],
  "recurring_people_archetypes": [
    {
      "id": "teaterkameraten",
      "social_function": "deler forestillinger og sammenligninger uten å gjøre smak til fasit",
      "class_position": "likestilt teatergjenger",
      "status": "erfaren sosial ledsager uten formell myndighet",
      "power_over_player": "kan gjøre sammenligning og vane sosialt sterke",
      "wants": "å dele teateropplevelser over tid",
      "conceals": "at egen smak har blitt mer fastlåst enn han liker å innrømme",
      "speech_style": "engasjert, refererende og konkret",
      "teaches_player": "at erfaring kan skjerpe blikket uten å lukke det"
    },
    {
      "id": "repertoarvennen",
      "social_function": "holder oversikt over tidligere oppsetninger og gjør forskjeller synlige",
      "class_position": "aktiv teatergjenger",
      "status": "høy erfaringskunnskap, ingen fagmyndighet",
      "power_over_player": "kan gjøre sammenligning til rangering",
      "wants": "å se utvikling mellom verk og oppsetninger",
      "conceals": "at nostalgi påvirker vurderingene",
      "speech_style": "sammenlignende, detaljorientert og minnebasert",
      "teaches_player": "at sammenligning er et verktøy, ikke en domstol"
    },
    {
      "id": "abonnenten",
      "social_function": "viser hvordan kontinuitet, rutine og institusjonstilhørighet formes",
      "class_position": "langvarig betalende gjest",
      "status": "høy tilhørighet, lav formell myndighet",
      "power_over_player": "kan gjøre ansiennitet og faste plasser til status",
      "wants": "å holde teater som fast del av hverdagen",
      "conceals": "at abonnementet også fungerer som identitetsmarkør",
      "speech_style": "rolig, rutinert og institusjonsnær",
      "teaches_player": "at kontinuitet ikke gir rang"
    },
    {
      "id": "nykommeren",
      "social_function": "synliggjør terskler, uskrevne regler og behovet for åpen inngang",
      "class_position": "uerfaren gjest",
      "status": "lav kulturkapital i rommet, full rett til egen opplevelse",
      "power_over_player": "kan utfordre spillerens vaner og selvbilde som erfaren",
      "wants": "å forstå nok til å føle seg fri i opplevelsen",
      "conceals": "usikkerhet på om egne reaksjoner er riktige",
      "speech_style": "spørrende, direkte og lite kodet",
      "teaches_player": "at kunnskap kan deles uten gatekeeping"
    },
    {
      "id": "foajeverten",
      "social_function": "representerer husets praktiske drift og den konkrete kveldens rammer",
      "class_position": "ansatt vert med situasjonsmyndighet",
      "status": "høy praktisk myndighet, ingen kunstkritisk myndighet",
      "power_over_player": "kan sette grenser for adgang, flyt og praktiske rutiner",
      "wants": "at gjester følger den faktiske kveldens beskjeder",
      "conceals": "at faste gjester ofte tror de kjenner rutinene bedre enn personalet",
      "speech_style": "vennlig, tydelig og kort",
      "teaches_player": "at gjestefamiliaritet ikke erstatter arbeidsplassens ansvar"
    },
    {
      "id": "kritikkleseren",
      "social_function": "setter publikumspraksis i dialog med profesjonell kritikk uten å blande rollene",
      "class_position": "aktiv leser og teatergjenger",
      "status": "analytisk samtalepartner uten redaksjonell rolle",
      "power_over_player": "kan gjøre erfaringsmengde til påstått ekspertise",
      "wants": "å finne presise språk for sceniske erfaringer",
      "conceals": "at profesjonelle formuleringer lett blir lånt som egne",
      "speech_style": "analytisk, kildebevisst og nyansert",
      "teaches_player": "at profesjonell kritikk kan leses uten at leseren blir kritiker"
    }
  ],
