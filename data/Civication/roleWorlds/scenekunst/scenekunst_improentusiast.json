    "label": "Improentusiast"
  },
  "title": "Improentusiast",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å tåle spontanitet, feil og sceneangst i kollektiv improvisasjon uten å gjøre ja-og til grenseløshet, initiativ til dominans eller hobbypraksis til profesjonell scenekunstmyndighet",
    "description": "Improentusiast-verdenen undersøker ja-og mot grenser, lytting mot egen vits, sceneangst og første handling, reparasjon av svake premisser, initiativ og plass, feil som materiale, publikumsforslag, interne koder, scenisk status, feedback, trygghet, latterjakt, privat materiale og rollegrenser. Improentusiast er en practice_identity. Rollen gir ingen automatisk myndighet som skuespiller, regissør, scenekunstpedagog, terapeut eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "social_mask",
    "shame_reputation",
    "status_anxiety",
    "care_vs_efficiency",
    "professional_culture",
    "public_private_leakage",
    "local_knowledge_vs_system",
    "loyalty_up_down"
  ],
  "social_environments": [
    "improworkshops der deltakere må etablere trygghet uten manus",
    "små scener der publikum gir forslag og umiddelbar respons",
    "øvingsrom der interne koder og gamle gruppemønstre møter nye deltakere",
    "scener der rollehierarki og personlig rang lett kan blandes sammen",
    "feedbackrunder der én svak scene kan kjennes som dom over hele personen",
    "sosiale etterprater der privat materiale, konkurranse og fellesskap glir inn i hverandre"
  ],
  "recurring_people_archetypes": [
    {
      "id": "spillepartneren",
      "social_function": "gjør lytting, tilbud og reparasjon synlig i selve scenen",
      "class_position": "likestilt deltaker uten instruktørmyndighet",
      "status": "troverdig gjennom faktisk samarbeid",
      "power_over_player": "kan åpne eller lukke sceniske muligheter med sine valg",
      "wants": "at begge spiller det som faktisk skjer, ikke hver sin plan",
      "conceals": "egen uro for å bli overkjørt",
      "speech_style": "rask, konkret og samarbeidsorientert",
      "teaches_player": "at impro bygges mellom spillere, ikke inne i én persons idé"
    },
    {
      "id": "workshopvennen",
      "social_function": "oversetter feil og feedback til konkrete neste forsøk",
      "class_position": "erfaren hobbydeltaker uten profesjonell pedagogrolle",
      "status": "høy i gruppen når øvelser skal forstås",
      "power_over_player": "kan gjøre feedback trygg eller identitetstruende",
      "wants": "at gruppen lærer uten å rangere mennesker",
      "conceals": "at egen erfaring noen ganger blir presentert for sikkert",
      "speech_style": "rolig, presis og opptatt av ett grep om gangen",
      "teaches_player": "at feil er materiale for læring"
    },
    {
      "id": "nybegynneren",
      "social_function": "viser hvor inkluderende gruppens språk, tempo og normer faktisk er",
      "class_position": "ny deltaker med lav intern status men full rett til grenser",
      "status": "lav erfaringsstatus, høy relevans for inngangsterskelen",
      "power_over_player": "kan synliggjøre ekskluderende vaner gruppen ikke lenger ser",
      "wants": "å delta uten å måtte kjenne alle kodene først",
      "conceals": "frykt for å virke vanskelig",
      "speech_style": "forsiktig, ærlig og konkret",
      "teaches_player": "at fellesskap må fungere for den som ikke allerede kan systemet"
    },
    {
      "id": "lagkameraten",
      "social_function": "holder balansen mellom initiativ, scenisk plass og faktisk gruppehierarki",
      "class_position": "fast gruppemedlem uten profesjonell rang",
      "status": "bygget gjennom gjensidig tillit",
      "power_over_player": "kan utfordre dominans og synliggjøre hvem som får definere scenene",
      "wants": "at flere faktisk eier spillet",
      "conceals": "egen konkurransefølelse",
      "speech_style": "direkte, kameratslig og lite pompøs",
      "teaches_player": "at scenisk status ikke bør bli sosial rang"
    },
    {
      "id": "fasilitatoren",
      "social_function": "setter rammer for øvelser, stoppregler og trygghet uten å skrive scenene",
      "class_position": "lokal workshopfasilitator; kan ha erfaring, men representerer ikke automatisk profesjonell utdanning",
      "status": "situasjonsmyndighet i rommet",
      "power_over_player": "kan stoppe øvelser og definere praktiske rammer",
      "wants": "et rom der folk tør å prøve og si stopp",
      "conceals": "at fasilitatorrollen også kan bli for styrende",
      "speech_style": "klar, rolig og prosessorientert",
      "teaches_player": "at trygghet og spontanitet kan eksistere samtidig"
    },
    {
      "id": "publikummeren",
      "social_function": "viser at respons og forslag påvirker scenen uten å eie den",
      "class_position": "publikumsdeltaker uten kontroll over spillerne",
      "status": "kollektiv oppmerksomhet mer enn individuell autoritet",
      "power_over_player": "latter og forslag kan trekke gruppen mot sikre mønstre",
      "wants": "å bli overrasket og tatt på alvor",
      "conceals": "at responsen kan belønne repetisjon mer enn utvikling",
      "speech_style": "umiddelbar, enkel og reaksjonsdrevet",
      "teaches_player": "at publikum gir signaler, ikke kommandoer"
    }
  ],
