  "title": "Premieregjenger",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å oppleve og diskutere første forestillingskveld med forventning, sosial energi og rask respons uten å gjøre premierehype til fasit, premieredeltakelse til status eller publikumspraksis til kritiker- og bransjemyndighet",
    "description": "Premieregjenger-verdenen undersøker premierehype, forventning, premiereknekk, applaus, foajéprat, anmeldelser, første-kveld-suksess, relasjoner til utøvere, FOMO og status, rykter, offentlig deling, arbeidsplassgrenser, samtale med kunstnere, revisjon av førsteinntrykk og rollegrenser. Premieregjenger er en hobby_identity. Rollen gir ingen automatisk myndighet som kritiker, journalist, kurator, produsent, kunstnerisk leder eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "public_attention",
    "status_anxiety",
    "social_mask",
    "shame_reputation",
    "professional_culture",
    "public_private_leakage",
    "local_knowledge_vs_system",
    "care_vs_efficiency"
  ],
  "social_environments": [
    "premierefoajeer der forventning, nettverk og publikumssnakk oppstår raskt",
    "salrom der kollektiv respons kan farge den enkeltes vurdering",
    "etterprater der venner og fremmede prøver å sette ord på en fersk opplevelse",
    "morgenen etter der anmeldelser og sosiale medier setter nye rammer rundt kvelden",
    "situasjoner der man kjenner noen på scenen og støtte, ærlighet og lojalitet møtes",
    "arbeidsplasser rundt forestillingen der feststemning ikke opphever vanlige grenser"
  ],
