  "title": "Publikum",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å være del av et kollektivt scenekunstpublikum gjennom oppmerksomhet, respons, praktiske hensyn og egen vurdering uten å gjøre billett, smak eller erfaring til kunstnerisk, kritisk, organisatorisk eller profesjonell myndighet",
    "description": "Publikum er en employment-independent audience_status og den brede grunnrollen for å møte scenekunst som gjest. Verden undersøker nærvær, forventning, tilgjengelighet, situerte publikumskoder, kollektiv respons, opptak, retten til å forlate salen, innholdsinformasjon, etterprat, vennskap til utøvere, nykommere og gjest–arbeidsplass-grensen. Rollen er ikke Scenehenger, som handler om sosial nærhet til scenekunstmiljøet; ikke Premieregjenger, som handler om første-kveld, hype og status; ikke Teatergjenganger, som bygger på gjentatt repertoar- og hus-erfaring; og ikke Utøver. Publikumserfaring gir heller ikke automatisk kritikerrolle, dramaturgisk mandat, kuratorisk eller produksjonsmessig bransjemyndighet."
  },
  "theme_ids": [
    "public_attention",
    "social_mask",
    "shame_reputation",
    "care_vs_efficiency",
    "local_knowledge_vs_system",
    "public_private_leakage",
    "status_anxiety",
    "professional_culture"
  ],
  "social_environments": [
    "salrom der mange enkeltreaksjoner blir til en kollektiv stemning uten at flertallet blir kvalitetsfasit",
    "foajeer og innslipp der billett, kø, plassering, tilgjengelighet og vertskap gjør gjesterollen konkret",
    "før-forestilling-situasjoner der markedsføring, programtekst og forventning rammer inn møtet med verket",
    "etterprater der publikum formulerer egne vurderinger og lett kan låne kritiker- eller bransjespråk",
    "situasjoner der en publikummer kjenner noen på scenen og støtte, lojalitet og vurdering må holdes adskilt",
    "publikumsfellesskap med både førstegangsgjester og erfarne gjester der uskrevne koder kan bli støtte eller gatekeeping"
  ],
  "recurring_people_archetypes": [
    {
      "id": "salverten",
      "social_function": "viser hvordan publikumsrommet har situerte regler, hensyn og praktiske grenser",
      "class_position": "front-of-house-arbeider med ansvar for gjester og salflyt",
      "status": "høy på lokal publikumskontekst",
      "power_over_player": "kan avklare regler for plassering, ro, mobilbruk og utgang",
      "wants": "at gjester løser behov uten å overta driften",
      "conceals": "at synlige regler ofte dekker flere sikkerhets- og tilgjengelighetshensyn samtidig",
      "speech_style": "rolig, konkret og løsningsorientert",
      "teaches_player": "at billett gir adgang, ikke arbeidsledelse eller frie unntak"
    },
    {
      "id": "programleseren",
      "social_function": "holder forventning, informasjon og faktisk erfaring adskilt",
      "class_position": "interessert publikummer med høy oppmerksomhet på formidlingstekst",
      "status": "høy på kontekst og forhåndsrammer",
      "power_over_player": "kan vise når markedsføring eller innholdsinformasjon blir gjort til fasit",
      "wants": "at tekst brukes som orientering uten å lukke opplevelsen",
      "conceals": "at også nøytral informasjon påvirker hva publikum legger merke til",
      "speech_style": "presis, forberedende og nysgjerrig",
      "teaches_player": "å skille ramme fra selve møtet med forestillingen"
    },
    {
      "id": "etterprateren",
      "social_function": "gjør publikumsreaksjoner konkrete uten å opphøye dem til profesjonell kritikk",
      "class_position": "sosial og reflektert publikummer uten redaksjonelt oppdrag",
      "status": "høy på begrunnet førstepersonsrespons",
      "power_over_player": "kan utfordre både tom ros og kategoriske dommer",
      "wants": "at meninger knyttes til faktiske øyeblikk og egen erfaring",
      "conceals": "at gruppesamtalen også former hva som senere huskes som egen reaksjon",
      "speech_style": "utforskende, konkret og uformell",
      "teaches_player": "at vurdering ikke krever lånt fagautoritet"
    },
    {
      "id": "forstegangsgjesten",
      "social_function": "viser hvordan kulturkoder kan bli terskler når erfarne gjester gjør dem til opptakskrav",
      "class_position": "ny publikummer uten innarbeidet scenekunstvane",
      "status": "lav på institusjonell familiaritet, høy på ferskt blikk",
      "power_over_player": "kan avsløre gatekeeping i råd som virker hjelpsomme",
      "wants": "å få praktisk hjelp uten å bli instruert i riktig smak",
      "conceals": "at usikkerhet om koder kan gjøre små hendelser uforholdsmessig store",
      "speech_style": "direkte, spørrende og lite jargongpreget",
      "teaches_player": "å gjøre publikumsrommet tilgjengelig uten smakskontroll"
    },
    {
      "id": "den_erfarne_gjesten",
      "social_function": "viser forskjellen mellom erfaring som praktisk orientering og erfaring som sosial rang",
      "class_position": "hyppig publikummer uten bransjeposisjon",
      "status": "høy på sal- og husrutine",
      "power_over_player": "kan både hjelpe og ubevisst etablere hierarki mellom publikum",
      "wants": "at erfaring brukes praktisk fremfor som medlemskort",
      "conceals": "at egen vane lett føles som allmenn etikette",
      "speech_style": "trygg, hverdagslig og sammenlignende",
      "teaches_player": "at ansiennitet i salen ikke gir profesjonell myndighet"
    },
    {
      "id": "grensevokteren",
      "social_function": "holder Publikum adskilt fra Scenehenger, Premieregjenger, Teatergjenganger, Utøver og bransjeroller",
      "class_position": "metodisk rolleavklarer uten kunstnerisk mandat",
      "status": "høy på ansvar og rolleklarhet",
      "power_over_player": "kan stoppe erfaringsinflasjon før publikumsperspektivet blir yrkespåstand",
      "wants": "at hver rolle beholder sitt eget bevisgrunnlag",
      "conceals": "at presise grenser fortsatt må tåle reell overlapp i erfaring",
      "speech_style": "nøktern, kontrasterende og grensemarkerende",
      "teaches_player": "at et informert publikumsperspektiv er legitimt uten å bli Utøver eller kritiker"
    }
  ],
