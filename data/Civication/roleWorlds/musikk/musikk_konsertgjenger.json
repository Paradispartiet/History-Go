{"schema":"civication_role_world_v1","version":1,"category":"musikk","role_scope":"musikk_konsertgjenger","subject_type":"life_position","life_position_ref":{"badge_id":"musikk","id":"konsertgjenger","label":"Konsertgjenger"},"title":"Konsertgjenger","status":"role_world_complete","sociological_core":{"main_problem":"å gjøre live-musikk til en meningsfull publikumspraksis uten at billettforbruk, fanrang, dokumentasjon, publikumskoder eller konsertmengde blir sosial plikt, og uten at lytteerfaring blir lånt artist-, venue- eller produksjonsmyndighet","description":"Konsertgjenger-verdenen undersøker billettøkonomi, køstatus, delt publikumsrom, telefonbruk, support acts, hørsel og kropp, allsang, merch, solokonserter, setlistforventning, liveoppdagelser, festivalvalg, etterprat om lyd og grensen mellom erfaren publikumspraksis og profesjonelt livearbeid. Rollen gir ingen artist-, booker-, manager-, crew-, sikkerhets-, lydtekniker-, venue- eller programmyndighet, og introduserer ingen ny runtime."},"theme_ids":["status_anxiety","consumption","body_discipline","professional_culture","public_attention","shame_reputation","care_vs_efficiency","social_mask"],"social_environments":["billettslipp","kø før innslipp","stå- og sitteområder","hovedsett med telefonbruk","support acts","sterkt lydnivå","allsang og publikumsenergi","merchbord","solokonsert","setlistprat","hjemreise etter liveoppdagelse","festivalprogram med kollisjoner","etterprat om lyd og produksjon"],"recurring_people_archetypes":[{"id":"fast_konsertvenn","social_function":"gjør fanfellesskap og sosial rang synlig","class_position":"annen erfaren publikummer uten produksjonsmandat","status":"høy relasjonell nærhet","power_over_player":"kan forsterke FOMO og rangering gjennom felles konsertvaner","wants":"å dele sterke liveopplevelser","conceals":"hvor ofte egen status avhenger av å ha vært der","speech_style":"entusiastisk og referanserik","teaches_player":"at fellesskap ikke trenger fanhierarki"},{"id":"forsteg