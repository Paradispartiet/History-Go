  "title": "Omsorgsetiker",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å undersøke autonomi, omsorg, skade, rettferdighet og makt i vanskelige avveiinger uten å gjøre etisk refleksjon til klinisk beslutningsmyndighet over andre",
    "description": "Omsorgsetiker-verdenen handler om etisk refleksjon i hverdagslige og institusjonelle dilemmaer: samtykke, verdighet, personvern, risiko, fordeling, pårørendestemmer og makt. Spilleren lærer å synliggjøre legitime hensyn og vanskelige avveiinger, men får ingen klinisk behandlerrolle, ingen myndighet til å avgjøre behandling og ingen ny runtime."
  },
  "theme_ids": [
    "care_vs_efficiency",
    "professional_culture",
    "local_knowledge_vs_system",
    "social_mask",
    "shame_reputation",
    "status_anxiety",
    "public_attention",
    "institutional_pressure"
  ],
  "social_environments": [
    "vennesamtalen der gode intensjoner lett glir over i å bestemme på andres vegne",
    "refleksjonsgruppen der flere legitime hensyn må holdes samtidig uten en enkel fasit",
    "institusjonssamtalen der effektivitet, regler og ressursbruk møter verdighet og selvbestemmelse",
    "pårørendesamtalen der nærhet gir viktig kunnskap, men ikke automatisk eierskap til en annens stemme",
    "den offentlige debatten der rettferdighet og omsorg ofte reduseres til slagord om likhet eller trygghet",
    "etterkantssituasjonen der moralsk ubehag må undersøkes uten å gjøres til personlig autoritet"
  ],
  "recurring_people_archetypes": [
    {
      "id": "handlekraftig_hjelper",
      "social_function": "vil løse problemer raskt og oppfatter ofte handling som den mest omsorgsfulle responsen",
      "class_position": "ressurssterk nærperson uten formell beslutningsmyndighet",
      "status": "høy fordi initiativ og ansvarlighet verdsettes sosialt",
      "power_over_player": "kan gjøre grensesetting og autonomihensyn til tegn på passivitet",
      "wants": "å sikre at noen blir hjulpet før situasjonen blir verre",
      "conceals": "hvor ofte behovet for kontroll også gjør egen hverdag enklere",
      "speech_style": "praktisk, rask og orientert mot hva vi må gjøre nå",
      "teaches_player": "at gode intensjoner fortsatt må undersøkes for makt og overstyring"
    },
    {
      "id": "egenstemme",
      "social_function": "insisterer på at personen det gjelder må høres som subjekt, ikke bare omtales som mottaker av omsorg",
      "class_position": "person med direkte erfaring av å bli vurdert av andre",
      "status": "varierende og ofte avhengig av hvor mye andre anerkjenner egen beslutningsevne",
      "power_over_player": "kan utfordre spilleren når etiske argumenter blir abstrakte og mister personens perspektiv",
      "wants": "å bli tatt på alvor også når egne valg gjør andre urolige",
      "conceals": "at det kan være vanskelig å formulere egne ønsker under press",
      "speech_style": "konkret, personlig og oppmerksom på hvem som faktisk får bestemme",
      "teaches_player": "at autonomi ikke bare er et prinsipp, men en sosial praksis"
    },
    {
      "id": "systemforvalter",
      "social_function": "representerer regler, kapasitet og krav om lik behandling i en organisasjon",
      "class_position": "institusjonell mellomposisjon med ansvar for både ressurser og prosedyrer",
      "status": "høy i formelle prosesser fordi personen kjenner systemets kriterier",
      "power_over_player": "kan gjøre eksisterende rutiner til standard for hva som fremstår mulig eller rimelig",
      "wants": "forutsigbare regler som kan forsvares på tvers av enkeltsaker",
      "conceals": "at standardisering også fordeler byrder og fordeler ulikt",
      "speech_style": "saklig, regelorientert og opptatt av konsekvens og presedens",
      "teaches_player": "at prosedyrer aldri er helt uten verdier"
    },
    {
      "id": "parorendestemme",
      "social_function": "bringer lang relasjonserfaring, omsorgsansvar og bekymring inn i etiske diskusjoner",
      "class_position": "nærperson med mye uformelt omsorgsarbeid og begrenset formell myndighet",
      "status": "høy når relasjonell kunnskap verdsettes, men kan også bli overhørt av systemet",
      "power_over_player": "kan presse spilleren til å likestille nærhet med rett til å bestemme",
      "wants": "at erfaring, belastning og bekymring ikke skal ignoreres",
      "conceals": "hvor vanskelig det er å skille egne behov fra den andres ønsker",
      "speech_style": "engasjert, detaljert og preget av lang historie",
      "teaches_player": "å verdsette relasjonell kunnskap uten å erstatte personens egen stemme"
    },
    {
      "id": "prinsippdebattant",
      "social_function": "løfter ett etisk prinsipp frem som løsningen på nesten alle situasjoner",
      "class_position": "kunnskapssterk deltaker med høy verbal og kulturell kapital",
      "status": "høy i diskusjoner fordi prinsippfasthet oppleves konsistent",
      "power_over_player": "kan få komplekse avveiinger til å se svake ut sammenlignet med en ren regel",
      "wants": "en konsistent norm som reduserer tvil og skjønn",
      "conceals": "hvilke konsekvenser som forsvinner når ett prinsipp får absolutt prioritet",
      "speech_style": "konsekvent, begrepsstyrt og glad i klare grenser",
      "teaches_player": "at prinsipper trenger anvendelse, kontekst og avveiing"
    },
    {
      "id": "grensebevisst_fagperson",
      "social_function": "skiller etisk refleksjon fra formell profesjons- og behandlingsmyndighet",
      "class_position": "kvalifisert profesjonell med ansvar i relevante institusjonelle rammer",
      "status": "høy, men eksplisitt bundet av rolle, kompetanse og prosedyre",
      "power_over_player": "kan korrigere når spilleren bruker etisk språk som om det gir rett til å avgjøre andres behandling",
      "wants": "at etiske spørsmål tas på alvor uten at ansvarslinjer og personens rettigheter forsvinner",
      "conceals": "hvor ofte profesjonell praksis også innebærer uløselig moralsk ubehag",
      "speech_style": "rolig, avgrenset og tydelig på hvem som har hvilket ansvar",
      "teaches_player": "at etisk innsikt ikke automatisk gir klinisk myndighet"
    }
  ],
