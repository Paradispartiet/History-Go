  "title": "Helseutforsker",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å bygge bred forståelse av kropp, helse og helsetjenester uten å gjøre generell læring til individuell diagnose, behandling eller uformell klinisk myndighet",
    "description": "Helseutforsker-verdenen følger en kunnskapsidentitet i hverdagen: spilleren lærer om anatomi, normalvariasjon, risiko, målinger, screening, behandling og helsetjenester, men må stadig holde kildekritikk og autoritetsskranke synlige. Verden gir ingen diagnosemyndighet, behandlerrolle eller individuell medisinsk rådgivning og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "professional_culture",
    "numerical_control",
    "public_attention",
    "care_vs_efficiency",
    "local_knowledge_vs_system",
    "social_mask",
    "status_anxiety",
    "shame_reputation"
  ],
  "social_environments": [
    "lesestunden der generelle beskrivelser av kropp og sykdom lett kan gli over i personlige konklusjoner",
    "vennesamtalen der økt helsekunnskap skaper forventning om raske råd om konkrete mennesker",
    "helseinformasjonsstrømmen der fagord, grafer og autoritativ tone konkurrerer om troverdighet",
    "hverdagen med klokker, apper og målinger som gjør kroppslige tall tilgjengelige uten klinisk kontekst",
    "samtalen om helsetjenesten der systemforståelse må holdes adskilt fra profesjonell behandlingsmyndighet",
    "etterkantssituasjonen der en tidligere forklaring må revideres når bedre kunnskap endrer forståelsen"
  ],
  "recurring_people_archetypes": [
    {
      "id": "spørrelysten_venn",
      "social_function": "ber spilleren oversette helsebegreper til vanlig språk og presser noen ganger læring over i personlig rådgivning",
      "class_position": "ressurssterk hverdagsbruker uten medisinsk profesjonsrolle",
      "status": "middels sosial status, men høy tillit i vennegruppen",
      "power_over_player": "kan gjøre det sosialt vanskelig å si at et konkret spørsmål krever kvalifisert individuell vurdering",
      "wants": "et klart og praktisk svar med en gang",
      "conceals": "hvor mye trygghet personen søker fra spilleren snarere enn generell kunnskap",
      "speech_style": "direkte, personlig og rask til å spørre hva noe betyr for meg",
      "teaches_player": "at omsorg også kan være å markere grensen for egen myndighet"
    },
    {
      "id": "fagtekstformidleren",
      "social_function": "gjør medisinsk kunnskap tilgjengelig, men velger hvilke forbehold og detaljer som får plass",
      "class_position": "kunnskapsformidler med høy kulturell kapital, men ikke nødvendigvis behandlingsansvar",
      "status": "høy når komplekse temaer kan forklares enkelt",
      "power_over_player": "kan etablere begreper og forklaringsrammer spilleren senere bruker ukritisk",
      "wants": "at komplisert kunnskap skal bli forståelig uten å bli feil",
      "conceals": "hvor vanskelig det er å forenkle uten at grensene for kunnskapen forsvinner",
      "speech_style": "pedagogisk, strukturert og presis på definisjoner",
      "teaches_player": "at en god forklaring må bevare viktige forbehold"
    },
    {
      "id": "måleentusiasten",
      "social_function": "samler kroppstall fra apper og sensorer og elsker trender, grafer og sammenligninger",
      "class_position": "teknologivant forbruker med høy tilgang til selvsporing",
      "status": "moderat, men øker når tallene gir inntrykk av kontroll",
      "power_over_player": "kan presse spilleren til å tolke forbrukermålinger som mer medisinsk presise enn de er",
      "wants": "å gjøre kroppen målbar og forbedringsbar",
      "conceals": "hvor mye usikkerhet som ligger mellom sensorverdi og medisinsk betydning",
      "speech_style": "tallrik, entusiastisk og orientert mot avvik og rekorder",
      "teaches_player": "at måling uten kontekst lett blir overtolkning"
    },
    {
      "id": "erfaringsstemmen",
      "social_function": "bringer levd erfaring inn i samtaler som ellers blir dominert av abstrakte modeller og fagbegreper",
      "class_position": "person med sterk erfaringskunnskap, men uten krav på universell representativitet",
      "status": "varierende; høy når noen faktisk lytter, lav når erfaring avvises som anekdote",
      "power_over_player": "kan utfordre modeller som mangler hverdagskonsekvenser",
      "wants": "at erfaringen skal tas alvorlig uten å bli redusert til et datapunkt",
      "conceals": "at én erfaring ikke alltid kan avgjøre hvordan andre vil oppleve samme fenomen",
      "speech_style": "konkret, situert og opptatt av hva som skjer i hverdagen",
      "teaches_player": "å respektere erfaringskunnskap uten å generalisere den grenseløst"
    },
    {
      "id": "autoritetssikre_debattant",
      "social_function": "bruker medisinske ord og sikre formuleringer som retorisk styrke i diskusjoner",
      "class_position": "offentlig eller sosial deltaker med mer selvsikkerhet enn faglig mandat",
      "status": "høy i raske diskusjoner fordi personen sjelden viser tvil",
      "power_over_player": "kan gjøre tydelige kunnskapsgrenser til et tegn på svakhet",
      "wants": "en konklusjon som avslutter diskusjonen",
      "conceals": "hvor ofte sikkerheten bæres av språk og identitet snarere enn relevant ekspertise",
      "speech_style": "kategorisk, jargonpreget og rask til å rangere kilder",
      "teaches_player": "at autoritativ tone ikke erstatter kildekritikk"
    },
    {
      "id": "grensebevisst_fagperson",
      "social_function": "viser hvordan profesjonell kunnskap kombineres med eksplisitte grenser for hva som kan vurderes uten kontekst",
      "class_position": "kvalifisert helsepersonell med formell profesjonsmyndighet i riktig setting",
      "status": "høy, men bevisst avgrenset til relevant kompetanse og situasjon",
      "power_over_player": "kan korrigere når spilleren gjør læringskunnskap om til individuell medisinsk vurdering",
      "wants": "at generell helseforståelse skal øke uten at profesjonsgrenser viskes ut",
      "conceals": "hvor krevende det er å kommunisere usikkerhet til mennesker som ønsker et ja-nei-svar",
      "speech_style": "rolig, avgrenset og tydelig på hva som krever individuell vurdering",
      "teaches_player": "at faglig autoritet også består i å vite når man ikke kan konkludere"
    }
  ],
