  "title": "Evidensleser",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å kalibrere helsepåstander etter studiedesign, datagrunnlag og usikkerhet uten å gjøre skepsis til enten blind autoritetstro eller total handlingslammelse",
    "description": "Evidensleser-verdenen handler om hverdagslig evidenskompetanse: å skille funn fra overskrift, utvalg fra befolkning, sammenheng fra årsak og presisjon fra sikkerhet. Spilleren møter lenker, venner, offentlige diskusjoner og egne tidligere påstander, men får ingen klinisk rolle, diagnostisk myndighet eller behandlingsansvar. Verden trener kildevurdering og revisjon gjennom eksisterende narrative flater uten ny runtime."
  },
  "theme_ids": [
    "numerical_control",
    "public_attention",
    "professional_culture",
    "status_anxiety",
    "shame_reputation",
    "social_mask",
    "care_vs_efficiency",
    "local_knowledge_vs_system"
  ],
  "social_environments": [
    "gruppechatten der én studie raskt blir brukt som argument for en mye større påstand",
    "nyhetsstrømmen der overskrift, grafikk og delingstempo konkurrerer med metode og forbehold",
    "kjøkkenbordet der venner vil vite hva en studie betyr uten at samtalen blir til individuell medisinsk rådgivning",
    "den offentlige kommentaren der status, sikker tone og lenker fungerer som sosial kapital",
    "lesestunden der tabeller, utvalg og utfall må oversettes til forståelig språk uten å miste grensene sine",
    "etterkantssamtalen der en tidligere påstand må korrigeres når bedre data endrer kunnskapsbildet"
  ],
  "recurring_people_archetypes": [
    {
      "id": "lenkevenn",
      "social_function": "sender studier og ber om en rask vurdering før hele grunnlaget er lest",
      "class_position": "ressurssterk hverdagsleser med god tilgang til informasjon, men uten særskilt faglig myndighet",
      "status": "middels sosial status og høy påvirkning i vennegruppen fordi personen deler mye og tidlig",
      "power_over_player": "kan presse spilleren til raske ja-nei-svar og gjøre forbehold sosialt kostbare",
      "wants": "et forståelig svar som kan brukes i samtalen med en gang",
      "conceals": "hvor ofte ønsket om et tydelig svar kommer før interessen for metode og usikkerhet",
      "speech_style": "direkte, lenkedrevet og utålmodig med lange forbehold",
      "teaches_player": "at omsorg for en venn ikke krever at usikkerhet skjules"
    },
    {
      "id": "overskriftsformidler",
      "social_function": "gjør komplekse funn om til korte budskap som sprer seg raskt",
      "class_position": "synlig formidler med større rekkevidde enn kontroll over forskningsgrunnlaget",
      "status": "høy oppmerksomhetsstatus fordi klare budskap belønnes mer enn metodiske nyanser",
      "power_over_player": "kan definere hvilke deler av en studie alle andre diskuterer",
      "wants": "en formulering som både er sann nok og enkel nok til å få respons",
      "conceals": "hvor mye sikkerhet som legges til når et forsiktig funn blir en overskrift",
      "speech_style": "kort, sikker og orientert mot kontrast og tydelige poenger",
      "teaches_player": "at offentlig oppmerksomhet kan forsterke avstanden mellom data og konklusjon"
    },
    {
      "id": "metodevenn",
      "social_function": "spør om utvalg, sammenligningsgrunnlag og hva studien faktisk var designet for å undersøke",
      "class_position": "kunnskapsorientert deltaker uten formell behandlerrolle",
      "status": "lavmælt, men økende status når diskusjonen trenger presisjon fremfor retorisk sikkerhet",
      "power_over_player": "kan bremse spillerens raske konklusjoner ved å kreve eksplisitte begrunnelser",
      "wants": "at påstander skal kunne spores tilbake til hvordan kunnskapen ble produsert",
      "conceals": "at egen forkjærlighet for metode også kan bli en måte å unngå vanskelige vurderinger på",
      "speech_style": "spørrende, konkret og opptatt av hva som faktisk ble målt",
      "teaches_player": "at metodekritikk også trenger proporsjon og relevans"
    },
    {
      "id": "fagperson_med_grenser",
      "social_function": "viser hvordan ekspertise kan være sterk og samtidig avgrenset til et bestemt fagområde",
      "class_position": "formelt utdannet person med høy kulturell kapital, men ikke universell autoritet",
      "status": "høy fordi andre tillegger tittelen større rekkevidde enn fagområdet nødvendigvis gir",
      "power_over_player": "kan legitimere eller overskygge argumenter før kildene vurderes",
      "wants": "at relevante faglige vurderinger tas alvorlig uten at tittelen brukes som snarvei i andre spørsmål",
      "conceals": "hvor vanskelig det er å markere egne kunnskapsgrenser når andre forventer sikkerhet",
      "speech_style": "presis, avgrensende og tydelig på hvilket grunnlag utsagnet hviler på",
      "teaches_player": "at respekt for ekspertise krever like stor respekt for ekspertisens grenser"
    },
    {
      "id": "sikker_debattant",
      "social_function": "belønner entydige standpunkter og framstiller usikkerhet som svakhet",
      "class_position": "deltaker med høy retorisk selvsikkerhet og varierende tilgang til primærgrunnlaget",
      "status": "høy i raske diskusjoner fordi personen sjelden nøler offentlig",
      "power_over_player": "kan gjøre kalibrert språk sosialt dyrt ved å kreve enkle konklusjoner",
      "wants": "å vinne definisjonen av hva funnet betyr før diskusjonen flytter seg videre",
      "conceals": "hvor ofte sikkerheten kommer fra identitet og gruppeposisjon snarere enn datakvalitet",
      "speech_style": "kategorisk, kontrasterende og rask til å kreve ja eller nei",
      "teaches_player": "at epistemisk ydmykhet kan kreve sosial motstand mot overdrevet sikkerhet"
    },
    {
      "id": "rolig_kildejeger",
      "social_function": "finner originalgrunnlag, sammenligner versjoner og følger rettelser over tid",
      "class_position": "uformell kunnskapsarbeider med tid og ferdigheter til å gå bak sekundærformidlingen",
      "status": "moderat og ofte usynlig fordi arbeidet skjer før samtalen får et klart svar",
      "power_over_player": "kan endre hele diskusjonen ved å finne hva kilden faktisk sier eller senere har korrigert",
      "wants": "at kunnskapsstatus skal være sporbar nok til at andre kan etterprøve den",
      "conceals": "hvor lett grundighet kan bli en endeløs jakt på én siste kilde",
      "speech_style": "rolig, dokumenterende og villig til å si at noe fortsatt er uavklart",
      "teaches_player": "at etterprøvbarhet er en praksis, ikke et tegn på permanent tvil"
    }
  ],
