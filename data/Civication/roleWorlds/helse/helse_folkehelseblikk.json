  "title": "Folkehelseblikk",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å forstå helseforskjeller som samspill mellom individuelle liv, levekår, fordeling og institusjonelle systemvalg uten å redusere mennesker til statistiske grupper eller gjøre befolkningsperspektivet til klinisk autoritet",
    "description": "Folkehelseblikk-verdenen undersøker hvordan bolig, arbeid, transport, nærmiljø, tilgang, forebygging og ressursfordeling former helse på befolkningsnivå. Spilleren lærer å se gjennomsnitt sammen med fordeling, universelle tiltak sammen med ulike barrierer og systemmål sammen med levd erfaring. Rollen gir ingen diagnostisk, klinisk eller behandlende myndighet og materialiseres gjennom eksisterende narrative flater uten ny runtime."
  },
  "theme_ids": [
    "class_power",
    "bureaucratic_power",
    "numerical_control",
    "care_vs_efficiency",
    "local_knowledge_vs_system",
    "public_attention",
    "status_anxiety",
    "shame_reputation"
  ],
  "social_environments": [
    "nabolaget der transport, bolig, møteplasser og uteområder fordeler hverdagsmuligheter ulikt",
    "gruppechatten der individuelle råd kolliderer med ulike arbeidstider, omsorgsoppgaver og økonomiske rammer",
    "lokalmøtet der statistiske områdemål møter beboernes erfaringer og kunnskap om stedet",
    "budsjettmøtet der begrensede ressurser må fordeles mellom behov som ikke er like store eller like synlige",
    "den offentlige debatten der gjennomsnittstall kan skjule ulikhet og målrettede tiltak kan skape stigma",
    "etterkantssamtalen der man må vurdere om et forebyggende tiltak faktisk nådde dem som hadde størst barrierer"
  ],
  "recurring_people_archetypes": [
    {
      "id": "pendlernabo",
      "social_function": "gjør transporttid, arbeidstid og praktiske hverdagsrammer synlige i diskusjoner om helsevalg",
      "class_position": "lønnsmottaker med lite kontroll over arbeidstid og lang reisevei",
      "status": "middels lokal status, men lav definisjonsmakt i formelle helse- og plansamtaler",
      "power_over_player": "kan avsløre når spillerens generelle råd forutsetter mer tid og fleksibilitet enn mange faktisk har",
      "wants": "at tiltak og råd skal ta høyde for hvordan hverdagen faktisk er organisert",
      "conceals": "hvor ofte egen tidsmangel blir tolket som dårlig motivasjon av andre",
      "speech_style": "konkret, tidsorientert og rask til å teste om en løsning fungerer mandag morgen",
      "teaches_player": "at handlingsrom må analyseres før atferd forklares som prioritering"
    },
    {
      "id": "omsorgsforelder",
      "social_function": "viser hvordan tid, penger, barn og omsorgsansvar gjør samme tilbud ulikt tilgjengelig",
      "class_position": "husholdning med stram tidsøkonomi og begrenset fleksibilitet",
      "status": "lav formell status, men høy erfaringskompetanse på praktiske barrierer",
      "power_over_player": "kan gjøre det tydelig når et universelt tilbud i praksis krever ressurser noen ikke har",
      "wants": "løsninger som kan brukes uten at hele familiens logistikk må bygges om",
      "conceals": "hvor ofte manglende deltakelse egentlig er et spørsmål om kapasitet fremfor vilje",
      "speech_style": "praktisk, detaljert og opptatt av åpningstider, reise og faktisk gjennomføring",
      "teaches_player": "at formell tilgang ikke er det samme som reell tilgang"
    },
    {
      "id": "statistikkvenn",
      "social_function": "holder fast i måling, sammenligning og usikkerhet når samtalen blir anekdotisk",
      "class_position": "ressurssterk kunnskapsbruker med høy tallkompetanse, men uten klinisk rolle",
      "status": "høy når diskusjonen krever oversikt og dokumentasjon",
      "power_over_player": "kan korrigere for sterke enkelthistorier, men også trekke oppmerksomhet bort fra lokal kontekst",
      "wants": "at prioriteringer skal kunne begrunnes med etterprøvbare befolkningsdata",
      "conceals": "hvor lett gode indikatorer kan bli behandlet som komplette beskrivelser av levd liv",
      "speech_style": "presis, sammenlignende og opptatt av nevner, fordeling og tidsserie",
      "teaches_player": "at gode tall blir bedre når man også vet hva de ikke måler"
    },
    {
      "id": "lokal_arrangor",
      "social_function": "kobler formelle tiltak til lokale nettverk, steder og tillit",
      "class_position": "uformell mellomposisjon med mye sosial kapital i nærmiljøet og lite formell beslutningsmakt",
      "status": "høy lokalt fordi personen vet hvem som faktisk møter opp og hvorfor",
      "power_over_player": "kan avgjøre om et sentralt utformet tiltak oppleves relevant eller fremmed",
      "wants": "at beboere skal bli deltakere i utformingen, ikke bare målgruppe for kommunikasjon",
      "conceals": "hvor mye ekstra ubetalt arbeid som kreves for å reparere dårlig tilpassede systemløsninger",
      "speech_style": "nettverksorientert, stedsspesifikk og skeptisk til generelle kategorier",
      "teaches_player": "at implementering er sosialt arbeid, ikke bare distribusjon"
    },
    {
      "id": "systemplanlegger",
      "social_function": "må oversette mange behov til regler, budsjetter, indikatorer og gjennomførbare tiltak",
      "class_position": "formell administrativ posisjon med større systemmakt enn lokal nærhet",
      "status": "høy i institusjonen fordi personen kan fordele ressurser og definere kriterier",
      "power_over_player": "kan gjøre enkelte behov målbare og prioriterbare mens andre faller utenfor styringsspråket",
      "wants": "tiltak som kan finansieres, skaleres og evalueres på en etterprøvbar måte",
      "conceals": "hvor ofte styrbarhet påvirker hvilke problemer som blir ansett som viktigst",
      "speech_style": "saklig, kriteriebasert og orientert mot rammer, kapasitet og indikatorer",
      "teaches_player": "at systemvalg alltid inneholder prioriteringer selv når de presenteres teknisk"
    },
    {
      "id": "forebyggingsskeptiker",
      "social_function": "krever synlige og raske bevis for tiltak som ofte virker over lang tid",
      "class_position": "deltaker med liten tålmodighet for diffuse gevinster og sterk preferanse for konkrete resultater",
      "status": "middels offentlig status fordi kritikken er enkel å forstå og vanskelig å avvise raskt",
      "power_over_player": "kan presse analysen mot kortsiktige mål og enkeltstående hendelser",
      "wants": "at ressurser ikke skal bindes i tiltak som ingen kan forklare effekten av",
      "conceals": "hvor vanskelig det er å verdsette problemer som aldri oppstår fordi forebygging faktisk virket",
      "speech_style": "direkte, kostnadsorientert og rask til å spørre hva man konkret fikk igjen",
      "teaches_player": "at forebygging må kunne evalueres uten å late som alle gevinster er umiddelbart synlige"
    }
  ],
