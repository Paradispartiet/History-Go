  "title": "Læringsutforsker",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å undersøke hvordan mennesker lærer på tvers av forkunnskap, forklaringsform, øving, tid, miljø, språk, motivasjon, alder og situasjon uten at nysgjerrighet blir lærer-, diagnose- eller behandlingsmyndighet",
    "description": "Læringsutforsker-verdenen undersøker forklaringsvariasjon, skjulte forkunnskaper, gjenkjenning og gjenhenting, spacing, transfer, egenforklaring, tidspunkt for tilbakemelding, feilklima, motivasjon, språk og terminologi, kognitiv kapasitet, selvsikkerhet, aldersantakelser og profesjonsgrenser. Læringsutforsker er en knowledge_identity life position. Rollen gir ingen automatisk lærerrolle, psykologrolle, behandlingsansvar, diagnosemyndighet eller spesialpedagogisk kvalifikasjon, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "care_vs_efficiency",
    "status_anxiety",
    "social_mask",
    "shame_reputation",
    "local_knowledge_vs_system",
    "professional_culture",
    "invisible_work",
    "numerical_control"
  ],
  "social_environments": [
    "studie- og hobbyfellesskap der mennesker prøver ulike måter å forstå og huske på",
    "verksted og praksissituasjoner der transfer og læring gjennom handling blir synlig",
    "samtaler mellom nybegynnere og mer erfarne der skjulte forkunnskaper kommer fram",
    "situasjoner med repetisjon, pauser og tidsfrister der innsats og faktisk læring ikke alltid følger hverandre",
    "grupper der feil, sammenligning og sosialt press påvirker hva folk tør å prøve",
    "møter med fagpersoner der læringsobservasjon må skilles fra profesjonell utredning og behandling"
  ],
  "recurring_people_archetypes": [
    {
      "id": "laeringsvennen",
      "social_function": "undersøker forklaringer, øving og selvsikkerhet sammen med spilleren uten å bli lærer",
