  "title": "Utdanningskritiker",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å granske institusjoner, reformer, ulikhet, måltall, adgang, ressursvalg og makt i utdanning på en etterprøvbar måte uten at offentlig analyse blir profesjons- eller beslutningsmyndighet",
    "description": "Utdanningskritiker-verdenen undersøker gjennomsnitt og fordeling, anekdoter og systempåstander, reformintensjon og implementering, endringskapasitet, måltall, sammenlignbarhet, praktisk adgang, strukturelle betingelser, alternativkostnad, medvirkning, korrelasjon og årsak, kildeinteresser, totalforklaringer og formell myndighet. Utdanningskritiker er en public_education_analysis life position. Rollen gir ingen automatisk lærerrolle, forskerstatus, embetsmyndighet, skoleledermandat eller politisk beslutningsmyndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "bureaucratic_power",
    "numerical_control",
    "class_power",
    "public_attention",
    "status_anxiety",
    "local_knowledge_vs_system",
    "professional_culture",
    "shame_reputation"
  ],
  "social_environments": [
    "offentlige diskusjoner der utdanningstall og enkelterfaringer konkurrerer om oppmerksomhet",
    "institusjoner der reformer møter eksisterende rutiner, ressurser og profesjonskultur",
    "sammenligninger mellom skoler eller tilbud med ulike startbetingelser og lokal kontekst",
    "adgangs- og ressursdiskusjoner der formelle regler og praktiske barrierer ikke er identiske",
    "medvirkningsprosesser der det må skilles mellom å bli hørt og å ha beslutningsmakt",
    "møter med forsknings-, forvaltnings-, leder- og politiske roller som faktisk bærer formelt mandat"
  ],
  "recurring_people_archetypes": [
    {
      "id": "analysevennen",
      "social_function": "gjør statistikk, fordeling, indikatorer og årsaksspørsmål konkrete uten å late som tall taler alene",
      "class_position": "kunnskapsinteressert deltaker uten forsker- eller utredningsmandat",
      "status": "middels uformell metodeautoritet",
      "power_over_player": "kan gjøre tekniske mål til det eneste legitime språket for kvalitet",
      "wants": "at kritikken skal kunne etterprøves og ikke falle på enkle metodefeil",
      "conceals": "at valget av hva som måles også er en normativ prioritering",
      "speech_style": "presis, tallbevisst og spørsmålende",
      "teaches_player": "at tall må leses sammen med definisjoner, fordeling og kausal usikkerhet"
    },
    {
      "id": "erfaringsstemmen",
      "social_function": "bærer konkrete erfaringer fra elever og familier inn i systemanalysen",
      "class_position": "berørt deltaker uten plikt til å representere alle med lignende erfaring",
      "status": "høy erfaringsnær troverdighet, ingen automatisk representasjonsmyndighet",
      "power_over_player": "kan gjøre en sterk historie følelsesmessig vanskelig å avgrense metodisk",
      "wants": "at erfaringer ikke forsvinner bak gjennomsnitt og institusjonsspråk",
      "conceals": "at egen historie ikke sier hvor utbredt mekanismen er",
      "speech_style": "konkret, personlig og konsekvensorientert",
      "teaches_player": "at anekdoter kan være viktige data uten å være prevalensmål"
    },
    {
      "id": "institusjonsvennen",
      "social_function": "viser hvordan reformer, ressursvalg og implementering ser ut innenfra en organisasjon",
      "class_position": "institusjonsnær deltaker uten toppledermandat",
      "status": "middels systemkunnskap og høy lokalkunnskap",
      "power_over_player": "kan normalisere institusjonens egne forklaringer og kapasitetsgrenser",
      "wants": "at analyser tar hensyn til hva gjennomføring faktisk krever",
      "conceals": "at interne rutiner også kan beskytte gamle prioriteringer",
      "speech_style": "praktisk, prosessorientert og nyansert",
      "teaches_player": "at reformtekst og implementert praksis er to forskjellige analysenivåer"
    },
    {
      "id": "laererstemmen",
      "social_function": "gjør endringstakt, målepress og hverdagskonsekvenser synlige fra profesjonsnært nivå",
      "class_position": "yrkesutøver med profesjonelt ansvar i egen rolle, men ikke systemeier",
      "status": "høy situert praksiskunnskap",
      "power_over_player": "kan gjøre egen arbeidshverdag til hovedmål for hele systemanalysen",
      "wants": "at endringer skal være faglig forståelige og praktisk gjennomførbare",
      "conceals": "at profesjonsinteresser og elevhensyn ikke alltid peker samme vei",
      "speech_style": "erfaringsbasert, konkret og kapasitetsbevisst",
      "teaches_player": "at implementering har reelle arbeids- og læringskostnader"
    },
    {
      "id": "debattvennen",
      "social_function": "tester offentlige argumenter, moteksempler og konkurrerende forklaringer",
      "class_position": "likestilt offentlig debattdeltaker uten beslutningsmandat",
      "status": "varierende symbolsk status gjennom argumentasjon og synlighet",
      "power_over_player": "kan belønne bastante totalforklaringer fordi de er enklere å kommunisere",
      "wants": "at kritikken skal være tydelig nok til å diskuteres og vanskelig nok til å avvise",
      "conceals": "at offentlig klarhet ofte presser usikkerhet ut av argumentet",
      "speech_style": "spiss, kontrasterende og motspørrende",
      "teaches_player": "at god kritikk må tåle alternativer og vite hva som ville svekke den"
    },
    {
      "id": "fagpersonen",
      "social_function": "markerer skillet mellom offentlig kritikk og formell forskning, forvaltning, ledelse eller politisk beslutning",
      "class_position": "kvalifisert eller mandatbærende fagrolle med avgrenset ansvar",
      "status": "høy situert myndighet i eget fag- eller beslutningsområde",
      "power_over_player": "kan kreve klarere dokumentasjon og stoppe rolleoverskridelser",
      "wants": "at offentlig analyse er skarp uten å bli forvekslet med formelt mandat",
      "conceals": "at også ekspert- og institusjonsroller har interesser, usikkerhet og avgrensninger",
      "speech_style": "presis, kildebevisst og tydelig om mandat",
      "teaches_player": "at kritikk kan informere beslutninger uten å eie dem"
    }
  ],
