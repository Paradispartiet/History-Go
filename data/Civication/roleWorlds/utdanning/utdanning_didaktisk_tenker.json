  "title": "Didaktisk tenker",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å se sammenhengen mellom mål, innhold, arbeidsmåter og vurdering i hverdagslæring uten at god refleksjon blir lærer-, sensor- eller spesialpedagogmyndighet",
    "description": "Didaktisk tenker-verdenen undersøker målprioritering, stoffutvalg, forkunnskaper, aktivitetsdesign, synlige kriterier, læringsrettet tilbakemelding, tempo, gruppedeltakelse, måling, eksempler, digitale hjelpemidler, feilmønstre, redesign og profesjonsgrenser. Didaktisk tenker er en didactic_reflection life position. Rollen gir ingen automatisk lærerrolle, sensorfunksjon, spesialpedagogisk myndighet, elevansvar eller profesjonskvalifikasjon, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "care_vs_efficiency",
    "numerical_control",
    "status_anxiety",
    "shame_reputation",
    "invisible_work",
    "professional_culture",
    "local_knowledge_vs_system",
    "bureaucratic_power"
  ],
  "social_environments": [
    "studiegrupper der mål, kriterier og arbeidsmåter forhandles mellom likestilte",
    "frivillig formidling der komplekst innhold må prioriteres innen reelle tidsrammer",
    "verksted og hobbylæring der aktivitet, produkt og faktisk læring kan trekke i ulike retninger",
    "gruppearbeid der arbeidsdeling og tempo former hvem som får øve og forstå",
    "digitale læringssituasjoner der verktøy kan støtte eller skjule selve læringsprosessen",
    "møter med kvalifiserte fagroller der refleksjon må skilles fra profesjonelt ansvar"
  ],
  "recurring_people_archetypes": [
    {
      "id": "studievennen",
      "social_function": "gjør mål, kriterier og arbeidsmåter til konkrete valg i uformell læring",
      "class_position": "likestilt deltaker uten formell undervisningsmyndighet",
      "status": "høy nærhet og praktisk innsikt i egen studieprosess",
      "power_over_player": "kan normalisere overarbeid, skjulte forventninger eller produktjag",
      "wants": "at gruppa faktisk lærer uten å drukne i opplegg",
      "conceals": "at egne styrker gjør noen arbeidsmåter lettere enn de er for andre",
      "speech_style": "direkte, nysgjerrig og praktisk",
      "teaches_player": "at didaktiske valg også finnes i læring mellom likestilte"
    },
    {
      "id": "deltakeren",
      "social_function": "synliggjør hvordan forkunnskaper, tempo, eksempler og respons oppleves fra mottakersiden",
      "class_position": "deltaker uten plikt til å mestre på én bestemt måte eller i ett tempo",
      "status": "varierende situert trygghet i gruppa",
      "power_over_player": "kan avsløre at et opplegg som virker logisk for avsenderen ikke er tilgjengelig i praksis",
      "wants": "å forstå hva som forventes og få en reell vei videre",
      "conceals": "at usikkerhet ofte gjør det vanskelig å si nøyaktig hvor forståelsen brøt sammen",
      "speech_style": "konkret, forsiktig og ærlig",
      "teaches_player": "at mottakerens erfaring er data om arbeidsmåten, ikke bare om mottakeren"
    },
    {
      "id": "formidlingsvennen",
      "social_function": "kobler stoffutvalg, forklaring og tidsrammer i frivillig eller offentlig formidling",
      "class_position": "erfaren formidler uten automatisk lærer- eller sensorrolle",
      "status": "middels uformell autoritet gjennom presentasjonserfaring",
      "power_over_player": "kan gjøre tempo og stoffmengde til prestisje",
      "wants": "at komplekst stoff blir interessant uten å bli trivialisert",
      "conceals": "at det er vanskelig å gi slipp på materiale man selv liker",
      "speech_style": "energisk, komprimerende og idéorientert",
      "teaches_player": "at innholdsvalg alltid er et didaktisk valg"
    },
    {
      "id": "verkstedvennen",
      "social_function": "representerer læring gjennom aktivitet, prøving, verktøy og feil",
      "class_position": "likestilt praktikant eller hobbyutøver",
      "status": "høy praktisk troverdighet i konkrete aktiviteter",
      "power_over_player": "kan få aktivitet og sluttprodukt til å overskygge hva som faktisk trenes",
      "wants": "at folk lærer ved å gjøre noe virkelig",
      "conceals": "at gode produkter noen ganger blir laget av de mest erfarne mens andre ser på",
      "speech_style": "handlingsorientert, uformell og løsningsrask",
      "teaches_player": "at aktivitet må kobles til mål og deltakelse"
    },
    {
      "id": "gruppemedlemmet",
      "social_function": "gjør arbeidsdeling, tempo og deltakelse synlig i kollektive læringsformer",
      "class_position": "likestilt gruppedeltaker med ulik kapasitet og forkunnskap",
      "status": "avhenger av oppgave og sosial trygghet",
      "power_over_player": "kan forsterke eller utfordre uformelle hierarkier i gruppa",
      "wants": "at samarbeidet både fungerer og føles rettferdig",
      "conceals": "at effektivitet ofte gjør det fristende å la de sterkeste gjøre mest",
      "speech_style": "hverdagslig, samarbeidsorientert og noen ganger tilbakeholden",
      "teaches_player": "at gruppearbeid må vurderes etter hvem som faktisk lærer og deltar"
    },
    {
      "id": "fagpersonen",
      "social_function": "markerer grensen mellom generell didaktisk refleksjon og profesjonelt undervisnings-, vurderings- eller spesialpedagogansvar",
      "class_position": "kvalifisert fagperson med avgrenset profesjonsansvar",
      "status": "høy situert myndighet når formelle vurderinger eller profesjonsbeslutninger kreves",
      "power_over_player": "kan avklare når refleksjon ikke er tilstrekkelig grunnlag for myndighetsutøvelse",
      "wants": "at didaktisk interesse brukes godt uten rolleforvirring",
      "conceals": "at profesjonelle systemer også kan ha dårlige vaner og trenger kritisk refleksjon",
      "speech_style": "presis, begrunnende og tydelig om ansvar",
      "teaches_player": "at god didaktisk tenkning og profesjonsmyndighet er to ulike ting"
    }
  ],
