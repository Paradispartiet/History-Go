  "title": "Klasseromsobservatør",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å se hvordan rom, relasjoner, oppgaver, forventninger og rytmer former deltakelse uten at observasjon blir personmerking, overvåking eller profesjonell vurderingsmyndighet",
    "description": "Klasseromsobservatør-verdenen undersøker romorganisering, synlig og usynlig deltakelse, oppgavers startforutsetninger, uformelt samspill, ventetid, grupperoller, forventningssignaler, hjelpefordeling, endring over tid, uttrykksformer, tidsrytmer, personvern, skillet mellom beskrivelse og fortolkning og profesjonsgrenser. Klasseromsobservatør er en observation_identity life position. Rollen gir ingen automatisk lærer-, inspektør-, sensor-, diagnose- eller spesialpedagogmyndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "social_mask",
    "status_anxiety",
    "shame_reputation",
    "invisible_work",
    "care_vs_efficiency",
    "professional_culture",
    "bureaucratic_power"
  ],
  "social_environments": [
    "undervisningsrom der møblering, siktlinjer og bevegelse påvirker hvem som blir synlige",
    "plenumsamtaler der taletid, ventetid og forventningssignaler fordeler deltakelse",
    "gruppearbeid der oppgaver og uformelle roller gir ulik tilgang til aktivitet",
    "arbeidsøkter der hjelp, uttrykksformer og tempo skifter hva som blir mulig å observere",
    "observasjonsnotater der personvern og dataminimering avgrenser nyttige detaljer",
    "møter med kvalifiserte fagroller der observasjon må skilles fra personvurdering og tiltak"
  ],
  "recurring_people_archetypes": [
    {
      "id": "observasjonsvennen",
      "social_function": "deler blikket på situasjoner og gjør forskjellen mellom registrering og fortolkning synlig",
      "class_position": "likestilt observatør uten formell vurderingsmyndighet",
      "status": "middels uformell troverdighet gjennom oppmerksomhet og sammenligning over tid",
      "power_over_player": "kan bekrefte eller utfordre spillerens tolkning av det samme som ble sett",
      "wants": "at observasjonene blir konkrete nok til å være nyttige uten å bli persondommer",
      "conceals": "at egne forventninger også styrer hva som blir lagt merke til",
      "speech_style": "presis, spørrende og opptatt av hva som faktisk ble sett",
      "teaches_player": "at flere observatører kan dele beskrivelse og likevel være uenige om forklaring"
    },
    {
      "id": "medeleven",
      "social_function": "viser hvordan deltakelse, forventninger og rytme oppleves fra innsiden av undervisningssituasjonen",
      "class_position": "deltaker uten ansvar for å representere hele gruppa",
      "status": "varierende situert trygghet og synlighet",
      "power_over_player": "kan korrigere et utenfrablikk som overser hva situasjonen føles som for deltakere",
      "wants": "å kunne delta uten at synlighet blir eneste mål på innsats eller forståelse",
      "conceals": "at noen spørsmål eller usikkerheter holdes tilbake når forventningspresset er høyt",
      "speech_style": "hverdagslig, konkret og situasjonsnær",
      "teaches_player": "at lav synlighet ikke automatisk betyr lav deltakelse"
    },
    {
      "id": "gruppemedlemmet",
      "social_function": "gjør arbeidsdeling, oppgavestart og uttrykksformer synlige i gruppearbeid",
      "class_position": "likestilt deltaker med ulike forkunnskaper og måter å bidra på",
      "status": "skifter med oppgaven og gruppedynamikken",
      "power_over_player": "kan synliggjøre hvem som faktisk får øve på hvilke deler av arbeidet",
      "wants": "at oppgaver fordeles slik at flere får reell deltakelse",
      "conceals": "at effektivitet ofte gjør det behagelig å la den erfarne ta styringen",
      "speech_style": "praktisk, samarbeidsorientert og noen ganger tilbakeholden",
      "teaches_player": "at sluttproduktet alene ikke viser hvordan deltakelsen var fordelt"
    },
    {
      "id": "fagpersonen",
      "social_function": "markerer metode-, personvern- og profesjonsgrensen for observasjon",
      "class_position": "kvalifisert profesjonsutøver med ansvar som observatøren ikke automatisk har",
      "status": "høy situert myndighet når personvurdering, tiltak eller formelle beslutninger berøres",
      "power_over_player": "kan kreve at observasjoner skilles fra diagnoser, persondommer og myndighetsavgjørelser",
      "wants": "at situasjonsobservasjon brukes nøkternt og etisk",
      "conceals": "at profesjonelle vurderinger også kan påvirkes av forventninger og institusjonelle rutiner",
      "speech_style": "rolig, presis og eksplisitt om grunnlag, ansvar og usikkerhet",
      "teaches_player": "at godt observasjonsarbeid ikke er det samme som mandat til å vurdere personer"
    },
    {
      "id": "veilederen",
      "social_function": "gjør fordeling av hjelp, kontakt og oppmerksomhet synlig uten å være objekt for motivspekulasjon",
      "class_position": "undervisende eller veiledende rolle med situert ansvar",
      "status": "høy funksjonell status i læringssituasjonen",
      "power_over_player": "kan forme hvem som får hjelp og hvordan rommet beveger seg, men observatøren kjenner ikke automatisk begrunnelsene",
      "wants": "å hjelpe flere innen begrenset tid og informasjon",
      "conceals": "at respons ofte styres av hvem som spør tydeligst eller befinner seg nærmest",
      "speech_style": "kort, responsiv og oppgaveorientert",
      "teaches_player": "at observerbar ulikhet i kontakt ikke alene beviser årsaken til den"
    },
    {
      "id": "personvernvennen",
      "social_function": "representerer grensen mellom situasjonsdata og unødvendig identifiserende informasjon",
      "class_position": "likestilt deltaker med særlig oppmerksomhet på hva som faktisk trenger å registreres",
      "status": "ingen formell myndighet, men høy normativ relevans når notater blir personlige",
      "power_over_player": "kan utfordre antakelsen om at mer detalj alltid betyr bedre observasjon",
      "wants": "at nyttige mønstre kan beskrives uten å samle private detaljer uten behov",
      "conceals": "at også anonymiserte beskrivelser noen ganger kan være gjenkjennelige i små miljøer",
      "speech_style": "nøktern, konkret og dataminimerende",
      "teaches_player": "at observasjon blir bedre når formålet styrer hva som faktisk noteres"
    }
  ],
