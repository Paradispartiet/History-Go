  },
  "title": "Kommentarfeltveteran",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å bruke lang erfaring fra offentlige kommentarfelt til mer presis og ansvarlig deltakelse uten at rytmekunnskap, synlighet, konfliktvana eller sosial gjenkjennelse blir journalistisk, redaksjonell, faktasjekkende eller modererende myndighet",
    "description": "Kommentarfeltveteran-verdenen undersøker reaktivitet, tone og ironi, offentlig persona, kildekjeder, gamle motparter, likerklikk, skjermbilder, nykommerterskler, moderering, private meldinger, gamle arkivspor, gjentakende strider, korreksjon og ydmykelse samt grensen mellom praksiskunnskap og institusjonell makt. Rollen gir ingen journalist-, redaktør-, moderator-, faktasjekker-, kildeansvarlig- eller plattformmyndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "public_attention",
    "shame_reputation",
    "social_mask",
    "public_private_leakage",
    "professional_culture",
    "care_vs_efficiency",
    "class_power",
    "alienation"
  ],
  "social_environments": [
    "åpne kommentarfelt under nyhetssaker",
    "forumtråder med faste brukere",
    "varslinger og svarrekker",
    "private meldinger etter offentlige ordskifter",
    "skjermbilder i vennechatter",
    "arkiverte tråder",
    "modererte diskusjonsrom",
    "sosiale medier med synlige reaksjonstall",
    "kommentarfelt rundt gjentakende konfliktsaker",
    "mobilbruk sent på kvelden",
    "tråder med nye deltakere",
    "diskusjoner der kilder forsvinner i svarrekkene"
  ],
  "recurring_people_archetypes": [
