      "power_over_player": "kan endre gruppedynamikken uten å kjenne kodene",
      "wants": "å forstå rommet uten å bli gjort til prøveklut",
      "conceals": "usikkerheten bak en hard formulering",
      "speech_style": "direkte og litt famlende",
      "teaches_player": "at veteraner også produserer terskler"
