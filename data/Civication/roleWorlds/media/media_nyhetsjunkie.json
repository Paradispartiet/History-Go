  "title": "Nyhetsjunkie",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å følge nyheter tett nok til å være godt orientert uten at kontinuerlig oppdatering, varsler, ryktetempo, synlige tall eller informasjonsstatus gjør hverdagen reaktiv eller leserrollen til lånt redaksjonell myndighet",
    "description": "Nyhetsjunkie-verdenen undersøker morgenvarsler, liveblogger, kildesammenligning, ubekreftede rykter, repetitiv publisering, tall og metode, overmetning, sosial kunnskapsstatus, rettelser, varslingsmengde, ekspertuttalelser, søvn, oppmerksomhetssykluser og grensen mellom intensiv nyhetslesing og profesjonelt mediearbeid. Rollen gir ingen journalist-, redaktør-, faktasjekker-, moderator-, kildeansvarlig- eller publiseringsmyndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "public_attention",
    "numerical_control",
    "shame_reputation",
    "professional_culture",
    "care_vs_efficiency",
    "alienation",
    "public_private_leakage",
    "status_anxiety"
  ],
  "social_environments": [
    "morgenens pushvarsler",
    "liveblogger under hendelser",
    "forsider fra flere redaksjoner",
    "meldingsapper med ubekreftede påstander",
    "nyhetsfeed med repeterte vinkler",
    "grafikker og statistikkbokser",
    "kveldens tunge nyhetsstrøm",
    "samtaler med venner som følger mindre",
    "oppdaterte artikler med rettelser",
    "varslingsinnstillinger",
    "ekspertintervjuer",
    "telefonen ved sengetid",
    "saker som faller ut av forsiden"
  ],
  "recurring_people_archetypes": [
    {
      "id": "den_rolige_vennen",
      "social_function": "gjør ulikt nyhetskonsum synlig uten å være uinformert",
      "class_position": "venn med lavere nyhetsfrekvens",
      "status": "høy relasjonell betydning, lav mediestatus",
      "power_over_player": "kan utfordre spillerens idé om hva alle bør vite",
      "wants": "å være orientert nok uten å leve i strømmen",
      "conceals": "at mindre frekvens noen ganger gir bedre hukommelse",
      "speech_style": "rolig og spørsmålsorientert",
      "teaches_player": "at nyhetsfrekvens ikke er moralsk rang"
    },
    {
      "id": "den_hurtige_deleren",
      "social_function": "gjør tidlig deling og ryktepress konkret",
      "class_position": "annen intensiv nyhetsbruker uten redaksjonelt mandat",
      "status": "høy synlighet i vennegruppen",
      "power_over_player": "kan forsterke tempo og FOMO",
      "wants": "å være først med det viktige",
      "conceals": "hvor ofte kilden kommer etter påstanden",
      "speech_style": "kort, rask og varslingsdrevet",
      "teaches_player": "at førsthet og bekreftelse er forskjellige verdier"
    },
    {
      "id": "journalisten",
      "social_function": "representerer faktisk innhenting og publiseringsansvar",
      "class_position": "profesjonell journalist med redaksjonelle plikter",
      "status": "formell yrkesstatus",
      "power_over_player": "kan forklare publisert metode, men skylder ikke spilleren interne beslutninger",
      "wants": "å rapportere under tidspress uten å love mer sikkerhet enn kildene gir",
      "conceals": "hvor mye arbeid som ligger bak korte oppdateringer",
      "speech_style": "presis og kildebevisst",
      "teaches_player": "at leserkompetanse ikke gir journalistrolle"
    },
    {
      "id": "fageksperten",
      "social_function": "gjør avgrenset ekspertise og usikkerhet konkret",
