      "status": "høy fagstatus innen avgrenset område",
      "power_over_player": "kan gi forklaring som må tolkes innen fagfeltets grenser",
      "wants": "å bli gjengitt presist",
      "conceals": "hvor ofte forbehold forsvinner i korte formater",
      "speech_style": "nyansert og avgrensende",
      "teaches_player": "at ekspertstatus er spesifikk"
    },
    {
      "id": "redaktoren",
      "social_function": "representerer faktisk prioritering og publiseringsmyndighet",
      "class_position": "redaksjonell leder med mandat over egen flate",
      "status": "høy institusjonell myndighet",
      "power_over_player": "kan prioritere, endre og korrigere publisering",
      "wants": "å fordele begrenset oppmerksomhet under skiftende nyhetsverdi",
      "conceals": "at forsiden alltid er et valg under knapphet",
      "speech_style": "kort, prioriterende og ansvarsbærende",
      "teaches_player": "at forsidefravær ikke kan leses direkte som motiv"
    },
    {
      "id": "den_stille_leseren",
      "social_function": "representerer publikum som orienterer seg uten kontinuerlig reaksjon",
      "class_position": "leser uten offentlig medieidentitet",
      "status": "lav synlighet",
      "power_over_player": "kan vise at nyhetsbruk også kan være langsom og selektiv",
      "wants": "å forstå nok til å handle eller samtale når det trengs",
      "conceals": "hvor lite av feeden som faktisk er nødvendig",
      "speech_style": "selektiv og ettertenksom",
      "teaches_player": "at mindre volum ikke nødvendigvis betyr mindre forståelse"
    }
