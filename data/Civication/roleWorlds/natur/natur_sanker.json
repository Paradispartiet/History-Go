    "badge_id": "natur",
    "id": "sanker",
    "label": "Sanker"
  },
  "title": "Sanker — artskunnskap, høsting og feltansvar",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å høste fra naturen med glede og kunnskap uten at mengde, matsug, status, apper, lokale hierarkier eller økonomisk fristelse gjør usikre funn til sikre råvarer eller fritidserfaring til profesjonell myndighet",
    "description": "Sanker-verdenen undersøker artsusikkerhet, høstemengde, deling av gode steder, digitale artsforslag, voksestedets kvalitet, sårbare områder, uformell ekspertise, adgang, potensielt farlige forvekslinger, smak og status, konservering, ansvar for nybegynnere, salg og grensen mot faglig myndighet. Sanker er en practice_identity og selvvalgt natur- og matpraksis. Rollen gir ingen automatisk myndighet som botaniker, mykolog, naturforvalter, matsikkerhetsekspert eller kommersiell mataktør, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "care_vs_efficiency",
    "consumption",
    "class_power",
    "status_anxiety",
    "shame_reputation",
    "public_attention",
    "professional_culture"
  ],
  "social_environments": [
    "skogkant, eng og park der artskunnskap, tilgjengelighet og ønsket om et godt funn møtes",
    "sankegrupper og gruppechatter der gode lokaliteter, mengde og erfaring får sosial verdi",
    "kjøkken og middagsbord der sankede råvarer blir mat, identitet og ansvar overfor andre",
    "digitale artsverktøy og oppslagsflater der forslag kan se sikrere ut enn feltgrunnlaget er",
    "private, vernede eller sårbare områder der adgang og naturhensyn begrenser hva som bør tas med",
    "lagring, videreforedling og mulig salg der hobbypraksis møter andre sikkerhets- og ansvarsgrenser"
  ],
  "recurring_people_archetypes": [
    {
      "id": "turkamerat",
      "social_function": "deler sankeøkter og gjør mengde, hemmelige steder og risikovilje sosialt synlig",
      "class_position": "likestilt fritidsutøver uten formell myndighet",
      "status": "høy relasjonell betydning når turer og måltider planlegges sammen",
      "power_over_player": "kan forsterke tempo, høstemengde eller sosialt press om å dele lokaliteter",
      "wants": "gode turer, nyttige funn og noe å ta med hjem",
      "conceals": "at ønsket om et godt utbytte ofte påvirker hvor sikker vurderingen føles",
      "speech_style": "praktisk, stedsspesifikk og opptatt av hva som faktisk havner i kurven",
      "teaches_player": "at fellesskap kan skjerpe både omsorg og samlepress"
    },
    {
      "id": "erfaren_sanker",
      "social_function": "representerer uformell feltkompetanse som kan brukes til læring eller gatekeeping",
      "class_position": "erfaren amatør eller frivillig med høy kunnskapsstatus, men uten automatisk profesjonelt mandat",
      "status": "høy uformell autoritet i sankemiljøet",
      "power_over_player": "kan bekrefte funn, definere lokale normer og påvirke hvem som føler seg kompetent",
      "wants": "presise vurderinger og respekt for håndverket",
      "conceals": "at raske svar også kan bygge på vane, status og forventning",
      "speech_style": "artsorientert, konkret og full av lokal erfaring",
      "teaches_player": "at erfaring blir mest verdifull når begrunnelsen kan deles og etterprøves"
    },
    {
      "id": "ny_sanker",
      "social_function": "gjør terskler, språk og sikkerhetskultur synlige fra perspektivet til en som fortsatt lærer",
      "class_position": "ny deltaker med lav uformell status og ingen myndighet",
      "status": "avhengig av om miljøet gir plass til tvil og spørsmål",
      "power_over_player": "kan speile om spillerens egen erfaring brukes omsorgsfullt eller som rang",
      "wants": "å lære uten å bli presset til å spise, plukke eller late som de forstår",
      "conceals": "at usikkerhet ofte skjules når andre virker svært sikre",
      "speech_style": "spørrende, konkret og forsiktig med bastante identifikasjoner",
      "teaches_player": "at god sankekultur krever synlig usikkerhet og reell plass til å avstå"
    },
    {
      "id": "grunneier",
      "social_function": "gjør adgang, drift og lokal stedskunnskap konkret rundt attraktive sankeområder",
      "class_position": "lokal rettighetshaver med situert kontroll over egen eiendom",
      "status": "formell lokal posisjon i spørsmål om bruk av privat område",
      "power_over_player": "kan avklare eller avvise adgang der sanking ellers framstår fristende",
      "wants": "respekt for eiendom, drift og steder som ikke tåler ekstra trafikk",
      "conceals": "at lokalkunnskapen om sesong, ferdsel og natur ofte er større enn besøkende antar",
      "speech_style": "jordnær, stedsorientert og tydelig på praktiske grenser",
      "teaches_player": "at et interessant funn aldri i seg selv gir adgang"
    },
    {
      "id": "naturforvaltningskontakt",
      "social_function": "representerer stedsspesifikk kunnskap om vern, sårbarhet og naturforvaltning",
      "class_position": "fagperson eller offentlig kontakt med relevant mandat innen eget ansvarsområde",
      "status": "høy formell autoritet når lokale naturhensyn og regler skal avklares",
      "power_over_player": "kan forklare hvorfor et område, en art eller en praksis trenger andre rammer enn generelle antakelser tilsier",
      "wants": "minst mulig skade og tydelige skiller mellom friluftsliv og forvaltningsbeslutninger",
      "conceals": "at også forvaltning arbeider med prioriteringer og ufullstendig kunnskap",
      "speech_style": "presis, regelbevisst og stedsorientert",
      "teaches_player": "at sankerens erfaring ikke erstatter naturforvaltningsmyndighet"
    },
    {
      "id": "matsikkerhetskontakt",
      "social_function": "gjør grensen mellom privat sankeerfaring og kvalifisert vurdering av mattrygghet tydelig",
      "class_position": "fagkyndig person eller tjeneste med relevant kompetanse innen eget mandat",
      "status": "høy situert autoritet når identifikasjon, mattrygghet eller konservering krever mer enn hobbyerfaring",
      "power_over_player": "kan kreve at et usikkert funn kasseres eller at en metode ikke brukes",
      "wants": "at tvil håndteres før maten serveres eller lagres",
      "conceals": "at heller ikke fagkyndighet gjør alle feltfunn enkle uten godt materiale og kontekst",
      "speech_style": "rolig, presis og tydelig på når et svar ikke er sikkert nok",
      "teaches_player": "at erfaring med sanking ikke automatisk gir botaniker-, mykolog- eller matsikkerhetsmyndighet"
    }
  ],
