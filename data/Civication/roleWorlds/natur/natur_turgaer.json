  "role_scope": "natur_turgaer",
  "subject_type": "life_position",
  "life_position_ref": {
    "badge_id": "natur",
    "id": "turgaer",
    "label": "Turgåer"
  },
  "title": "Turgåer — ferdsel, fellesskap og situasjonsblikk",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å bruke naturen som fri og meningsfull hverdagsarena uten at distansetall, utstyr, fart, sosiale mål eller ønsket om å fullføre gjør situerte forhold usynlige eller fritidserfaring til profesjonell myndighet",
    "description": "Turgåer-verdenen undersøker ruteplanlegging, værendring, gruppetempo, utstyr og status, stislitasje, turmåling, lokale ild- og ferdselsrammer, fellesrom, stedstilhørighet, press om å fullføre, digitale ruter, tidsmarginer, fotopress og grensen mot profesjonell turkompetanse. Turgåer er en hobby_identity og selvvalgt friluftspraksis. Rollen gir ingen automatisk myndighet som profesjonell guide, redningspersonell, naturforvalter eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "care_vs_efficiency",
    "body_discipline",
    "consumption",
    "status_anxiety",
    "shame_reputation",
    "public_attention",
    "social_mask"
  ],
  "social_environments": [
    "nærskog, mark og turveier der distanse, underlag, vær og dagslys gjør samme rute forskjellig fra dag til dag",
    "turfølger der tempo, pauser og beslutningen om å snu fordeler sosial makt i gruppen",
    "turapper og treningsflater der fart, høydemeter og segmenter kan bli både informasjon og rangering",
    "rasteplasser og sårbare stipartier der komfort møter regler, erosjon og naturhensyn",
    "populære utsiktspunkt og delte naturrom der tilhørighet, hunder, foto og andre brukere må få plass samtidig",
    "private veier og lokale grenser der digitale spor ikke alltid beskriver faktisk adgang eller bruk"
  ],
  "recurring_people_archetypes": [
    {
      "id": "turvenn",
      "social_function": "deler turer og gjør tempo, mål, lojalitet og beslutningen om å snu sosialt synlig",
      "class_position": "likestilt fritidsutøver uten formell myndighet",
      "status": "høy relasjonell betydning i planlegging og gjennomføring",
      "power_over_player": "kan øke tempo, prestasjonspress eller tryggheten ved å gjøre vurderinger sammen",
      "wants": "gode turer, delte mål og følelsen av framdrift",
      "conceals": "at ønsket om å fullføre noen ganger påvirker vurderingen av forholdene",
      "speech_style": "praktisk, oppmuntrende og opptatt av rute og tid",
      "teaches_player": "at fellesskap både kan beskytte og presse"
    },
    {
      "id": "erfaren_turgaer",
      "social_function": "representerer uformell turkompetanse som kan åpne læring eller bli gatekeeping",
      "class_position": "erfaren amatør uten automatisk profesjonelt mandat",
      "status": "høy uformell autoritet i turmiljøet",
      "power_over_player": "kan definere hva som anses lett, nødvendig utstyr og riktig turkultur",
      "wants": "gode vurderinger og folk som tar forholdene på alvor",
      "conceals": "at egen erfaring kan gjøre terskelen for nybegynnere usynlig",
      "speech_style": "kortfattet, erfaringsbasert og full av rute- og værreferanser",
      "teaches_player": "at erfaring bør oversettes til begrunnelse, ikke rang"
    },
    {
      "id": "ny_turgaer",
      "social_function": "gjør terskler, tempo, utstyr og språk synlige fra perspektivet til en som fortsatt lærer",
      "class_position": "ny deltaker med lav uformell status og ingen myndighet",
      "status": "avhengig av om turfølget tåler spørsmål og lavere tempo",
      "power_over_player": "kan speile om spillerens erfaring brukes inkluderende eller som målestokk",
      "wants": "å være med uten å måtte kjøpe identitet eller skjule usikkerhet",
      "conceals": "at spørsmål ofte holdes tilbake når alle andre virker sikre",
      "speech_style": "spørrende, konkret og forsiktig med å stoppe gruppen",
      "teaches_player": "at en inkluderende tur krever mer enn en åpen invitasjon"
    },
    {
      "id": "grunneier_eller_lokalbruker",
      "social_function": "gjør adgang, drift og lokal bruk av stier og veier konkret",
      "class_position": "lokal rettighetshaver eller bruker med situert kunnskap om området",
      "status": "formell eller praktisk lokal posisjon rundt konkrete adgangsspørsmål",
      "power_over_player": "kan avklare at kartspor, snarveier eller vaner ikke samsvarer med faktisk bruk eller adgang",
      "wants": "respekt for drift, grenser og sameksistens mellom ulike brukere",
      "conceals": "at lokale normer ikke alltid er synlige for besøkende",
      "speech_style": "stedsorientert, direkte og praktisk",
      "teaches_player": "at et digitalt spor aldri alene etablerer rett til ferdsel"
    },
    {
      "id": "naturforvaltningskontakt",
      "social_function": "representerer situert kunnskap om sårbar natur, ferdselsregler og belastning",
      "class_position": "fagperson eller offentlig kontakt med relevant mandat innen eget ansvarsområde",
      "status": "høy formell autoritet når lokale naturhensyn og regler skal avklares",
      "power_over_player": "kan forklare hvorfor en praksis, trasé eller sesong krever andre hensyn enn vanlig",
      "wants": "robust ferdsel, minst mulig unødig skade og tydelig regelgrunnlag",
      "conceals": "at forvaltning også må balansere flere legitime brukerinteresser",
      "speech_style": "presis, regelbevisst og stedsorientert",
      "teaches_player": "at turerfaring ikke erstatter naturforvaltningsmyndighet"
    },
    {
      "id": "guide_eller_redningskontakt",
      "social_function": "gjør grensen mellom fritidserfaring og profesjonell tur-, rednings- eller sikkerhetsrolle tydelig",
      "class_position": "fagperson med relevant opplæring eller mandat innen egen rolle",
      "status": "høy situert autoritet når planlegging eller hendelser går utover vanlig fritidspraksis",
      "power_over_player": "kan kreve andre marginer, avbryte planer eller korrigere falsk sikkerhet",
      "wants": "at risiko, kompetanse og ansvar beskrives realistisk",
      "conceals": "at også profesjonelle må arbeide med usikkerhet og endrede forhold",
      "speech_style": "rolig, situasjonsorientert og tydelig på rollegrenser",
      "teaches_player": "at mange turer ikke automatisk gir guide-, rednings- eller forvaltningsfullmakt"
    }
  ],
