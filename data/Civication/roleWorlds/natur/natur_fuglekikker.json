  "life_position_ref": {
    "badge_id": "natur",
    "id": "fuglekikker",
    "label": "Fuglekikker"
  },
  "title": "Fuglekikker — oppmerksomhet, sjeldenhet og feltansvar",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å lære fugler gjennom lyd, blikk, sted og gjentakelse uten at sjeldenhetsjakt, utstyr, digitale forslag, gruppehierarki eller ønsket om dokumentasjon gjør usikker observasjon til sikkerhet eller fritidskompetanse til profesjonell myndighet",
    "description": "Fuglekikker-verdenen undersøker lydgjenkjenning, sjeldenhetsvarsler, hekkefred, optikk og status, artsapper, trekk og sesong, deling av sensitive lokaliteter, uformell ekspertise, avspilling av fuglelyd, fellesturens tempo, privat grunn, skadde fugler, artslister og grensen mot profesjonell ornitologi. Fuglekikker er en practice_identity og selvvalgt feltpraksis. Rollen gir ingen automatisk myndighet som ornitolog, biolog, naturforvalter, viltbehandler, veterinær eller offentlig fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "professional_culture",
    "care_vs_efficiency",
    "local_knowledge_vs_system",
    "shame_reputation",
    "status_anxiety",
    "public_attention",
    "social_mask",
    "numerical_control"
  ],
  "social_environments": [
    "morgenstien der lyd, korte glimt og forventning gjør usikker identifikasjon til et sosialt og kunnskapsmessig spørsmål",
    "fuglechatten der varsler om sjeldenheter sprer seg raskere enn alle detaljer kan verifiseres",
    "hekke- og rasteområder der ønsket om bedre observasjon møter behovet for avstand og ro",
    "utsiktspunktet og fellesturen der optikk, erfaring, tempo og språk skaper uformelle statusforskjeller",
    "digitale artsapper og registreringsflater der forslag, kryss og kart kan se sikrere ut enn feltgrunnlaget er",
    "private og sensitive lokaliteter der adgang, lokal kunnskap og deling av koordinater må veies mot interessen for å se mer"
  ],
  "recurring_people_archetypes": [
    {
      "id": "turkamerat",
      "social_function": "deler feltøkter og gjør forventning, tempo og sjeldenhetsjakt sosialt synlig",
      "class_position": "likestilt fritidsutøver uten formell myndighet",
      "status": "høy relasjonell betydning når turer planlegges sammen",
      "power_over_player": "kan øke tempoet, forsterke jakten på sjeldenheter eller gjøre en bomtur sosialt lettere å tåle",
      "wants": "gode turer, delte observasjoner og følelsen av at det skjer noe",
      "conceals": "at eget ønske om nye kryss ofte påvirker hvor sikkert et funn føles",
      "speech_style": "ivrig, kortfattet og full av steds- og lydreferanser",
      "teaches_player": "at fellesskap kan skjerpe både oppmerksomhet og prestasjonspress"
    },
    {
      "id": "erfaren_fuglekikker",
      "social_function": "representerer uformell feltkompetanse som kan åpne læring eller bli gatekeeping",
      "class_position": "erfaren amatør eller frivillig med høy kunnskapsstatus, men uten automatisk profesjonelt mandat",
      "status": "høy uformell autoritet i fuglemiljøet",
      "power_over_player": "kan bekrefte eller utfordre identifikasjoner og påvirke hvem som føler seg kompetent i gruppa",
      "wants": "presise observasjoner og et miljø som tar feltkunnskap på alvor",
      "conceals": "at rask sikkerhet også kan bygge på vane, hierarki og forventning",
      "speech_style": "artsrik, detaljorientert og vant til å peke ut kjennetegn raskt",
      "teaches_player": "at ekspertise blir bedre når begrunnelsen kan deles og etterprøves"
    },
    {
      "id": "ny_fuglekikker",
      "social_function": "gjør terskler, tempo, utstyr og språk synlige fra perspektivet til en som fortsatt lærer",
      "class_position": "ny deltaker med lav uformell status og ingen myndighet",
      "status": "avhengig av om miljøet gir plass til spørsmål og langsommere observasjon",
      "power_over_player": "kan speile om spillerens egen erfaring brukes inkluderende eller som rang",
      "wants": "å lære arter uten å føle at hvert spørsmål avslører manglende verdi",
      "conceals": "at usikkerhet ofte skjules når gruppa beveger seg fort",
      "speech_style": "spørrende, konkret og forsiktig med bastante artsnavn",
      "teaches_player": "at et åpent fuglemiljø krever mer enn at alle formelt får være med"
    },
    {
      "id": "lokal_grunneier",
      "social_function": "gjør ferdsel, eiendomsgrenser og lokal kunnskap synlig rundt attraktive observasjonssteder",
      "class_position": "lokal rettighetshaver med situert kontroll over egen eiendom",
      "status": "formell lokal posisjon i spørsmål om adgang på privat område",
      "power_over_player": "kan tillate eller avvise adgang selv når fuglen er sjelden",
      "wants": "respekt for eiendom, drift, dyr og steder som ikke tåler stor trafikk",
      "conceals": "at lokalkunnskapen om fugleliv kan være større enn besøkende antar",
      "speech_style": "jordnær, stedsorientert og tydelig på praktiske grenser",
      "teaches_player": "at interesse og sjeldenhet aldri i seg selv gir adgang"
    },
    {
      "id": "ornitologkontakt",
      "social_function": "gjør grensen mellom amatørens feltpraksis og profesjonell ornitologisk eller biologisk vurdering tydelig",
      "class_position": "fagperson med relevant kompetanse innen eget profesjonelt mandat",
      "status": "høy faglig autoritet når observasjoner skal tolkes utover selve feltfunnet",
      "power_over_player": "kan kreve bedre dokumentasjon, korrigere overtolkning og avgrense hva observasjonen faktisk viser",
      "wants": "etterprøvbare data, tydelig usikkerhet og minst mulig forstyrrelse",
      "conceals": "at også fagfolk må arbeide med ufullstendig informasjon",
      "speech_style": "presis, sannsynlighetsorientert og tydelig på forskjellen mellom observasjon og konklusjon",
      "teaches_player": "at mange feltår ikke automatisk gir profesjonell ornitolog-, biolog- eller naturforvaltningsmyndighet"
    },
    {
      "id": "dyrevelferdskontakt",
      "social_function": "representerer riktig videre håndtering når en skadet fugl krever mer enn trygg observasjon",
      "class_position": "person eller tjeneste med situert ansvar eller relevant kompetanse for vilt eller dyrevelferd",
      "status": "operativ autoritet i konkrete hjelpesituasjoner",
      "power_over_player": "kan instruere om avstand, sikring, transport eller at fuglen bør få være i fred",
      "wants": "minst mulig feil håndtering og rask tilgang til riktig hjelp",
      "conceals": "at ikke alle skadde fugler kan eller bør håndteres på samme måte",
      "speech_style": "rolig, handlingsrettet og tydelig på sikkerhet",
      "teaches_player": "at omsorg også innebærer å stoppe der egen kompetanse og rolle stopper"
    }
  ],
