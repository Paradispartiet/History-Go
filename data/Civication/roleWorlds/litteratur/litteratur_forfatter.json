      "status": "markeds- og kontraktsnær status",
      "power_over_player": "kan åpne forhandling og råd, men kan ikke gjøre spillerens livsposisjon til ansettelse",
      "wants": "en avgrenset og forståelig avtale",
      "conceals": "at interesser ikke alltid er identiske",
