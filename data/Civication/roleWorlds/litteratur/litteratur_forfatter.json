      "social_function": "gjør sammenligning, håndverk og feltstatus konkret",
      "class_position": "selvstendig skrivepraksis",
      "status": "varierende feltstatus",
      "power_over_player": "kan påvirke normer og ambisjonsnivå uten formell kontroll",
      "wants": "gjensidig faglig sparring",
      "conceals": "egen usikkerhet bak rutine eller selvsikkerhet",
      "speech_style": "praktisk og tekstnær",
      "teaches_player": "forfatterpraksis er mer enn synlig suksess"
    },
    {
