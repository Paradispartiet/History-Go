  "title": "Forfatter",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å bære et langt manus fra usikker idé gjennom arbeidsrytme, ferdigstillelse, revisjon, respons og publiseringsvalg uten å gjøre synlig status, avslag eller institusjonell bekreftelse til definisjonen av forfatterpraksisen",
    "description": "Forfatter-verdenen undersøker prosjektkjerne, arbeidsrytme, fortellerperspektiv, personvern, scene og forklaring, struktur, førsteutkast, helhetsrevisjon, testlesing, stilvaner, avslag, redaksjonelt samarbeid, rettigheter og overgangen til neste prosjekt. Rollen er en employment-independent professional_practice og gir ingen automatisk jobb eller lønn, ingen redaktør-, forlags-, agent-, lærer-, kritiker- eller institusjonell fullmakt, ingen automatisk publisering eller etablert-forfatterstatus, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "professional_culture",
    "status_anxiety",
    "shame_reputation",
    "class_power",
    "public_private_leakage",
    "care_vs_efficiency"
  ],
  "social_environments": [
    "arbeidsmappen",
    "skrivebordet",
    "manuset",
    "samtalen",
    "strukturveggen",
    "skriveuken",
    "redaksjonen",
    "kontrakten",
    "innboksen",
    "tomt_dokument"
  ],
  "recurring_people_archetypes": [
    {
      "id": "redaktoren",
      "social_function": "gjør redaksjonell motstand og samarbeid konkret",
      "class_position": "forlags- eller redaksjonsrolle",
      "status": "institusjonell situert status",
      "power_over_player": "kan foreslå store endringer og påvirke publiseringsløp, men ikke overføre egen myndighet til spillerens livsposisjon",
      "wants": "et mer sammenhengende og lesbart manus",
      "conceals": "at redaksjonelle mål også påvirkes av format og marked",
      "speech_style": "presis og strukturorientert",
      "teaches_player": "redaksjonelt samarbeid krever fortsatt selvstendig forfatteransvar"
    },
    {
      "id": "testleseren",
      "social_function": "gjør mottakelse synlig før publisering",
      "class_position": "uformell eller invitert leser",
      "status": "ingen institusjonell myndighet",
      "power_over_player": "kan avdekke mønstre i hvor teksten mister leseren",
      "wants": "å forstå og bli berørt av manus på egne premisser",
      "conceals": "at egne preferanser ikke alltid er manusets problem",
      "speech_style": "konkret og erfaringsnær",
      "teaches_player": "respons er data, ikke ordre"
    },
    {
