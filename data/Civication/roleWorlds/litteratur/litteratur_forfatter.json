      "class_position": "publikum",
      "status": "ingen formell fagstatus",
      "power_over_player": "kan avsløre brudd i perspektiv, struktur og forventning gjennom faktisk lesning",
      "wants": "en tekst som holder sine egne løfter",
      "conceals": "at ulike lesere vil ønske forskjellige bøker",
      "speech_style": "spørrende og reaksjonsdrevet",
