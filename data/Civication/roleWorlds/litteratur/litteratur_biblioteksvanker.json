  },
  "title": "Biblioteksvanker",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å bruke biblioteket som delt hverdagssted, kunnskapsinfrastruktur og tilfeldig oppdagelsesrom uten å gjøre fortrolighet til særrett eller lånt bibliotekfaglig myndighet",
    "description": "Biblioteksvanker-verdenen følger en livsposisjon der biblioteket er et faktisk oppholdssted, ikke bare en utlånstjeneste. Spilleren møter knappe sitteplasser, tilfeldig hyllefunn, lesepersonvern, soner og lyd, bibliotekfaglig hjelp, materialgrenser, reservasjonssystemer, programkvelder, digital tilgang, fotografering, gaver, åpningstider og personlige leseanbefalinger. Rollen gir ingen bibliotekar-, arkivar-, konservator-, katalog-, samlings-, forsknings- eller institusjonell myndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "professional_culture",
    "class_power",
    "public_private_leakage",
    "bureaucratic_power",
    "invisible_work",
    "care_vs_efficiency",
    "local_knowledge_vs_system",
    "status_anxiety"
  ],
  "social_environments": [
    "lesesalen der bord, stikkontakter, ro og plass er knappe offentlige ressurser",
    "hyllene der fysisk klassifikasjon og tilfeldighet skaper funn som katalogsøk ikke planla",
    "utlånssonen der lesing og søkehistorikk kan bli synlig uten å bli offentlig samtalestoff",
    "informasjonsskranken der profesjonell hjelp må avgrenses fra ubegrenset personlig research",
    "reservasjonssystemet der upersonlige køregler fordeler populære titler mellom fremmede",
    "programområdet der kulturarrangementer og daglig opphold konkurrerer om det samme huset",
    "digitalsonen der internett, strøm, printer og datamaskiner gjør biblioteket til praktisk infrastruktur",
    "stengningen der åpningstid og fysisk oppholdssted har svært ulik verdi avhengig av brukernes alternativer"
  ],
  "recurring_people_archetypes": [
    {
      "id": "bibliotekaren",
      "social_function": "hjelper med søk, samling og bruk av bibliotekets tjenester innenfor profesjonelle grenser",
      "class_position": "offentlig kunnskapsarbeider med avgrenset bibliotekfaglig mandat",
      "status": "høy i spørsmål om katalog, tjenester og lokale rutiner, ikke personlig autoritet over hva brukeren bør mene",
      "power_over_player": "kan åpne søkestrategier, forklare systemer og avgrense hva personalet kan gjøre",
      "wants": "at brukere finner fram og at fellesressursene fungerer for mange",
      "conceals": "hvor mye prioritering og usynlig vedlikehold som ligger bak et tilsynelatende enkelt møte",
      "speech_style": "presis, hjelpsom og opptatt av å avgrense spørsmålet",
      "teaches_player": "at profesjonell hjelp fungerer best når brukeren også bærer sin del av arbeidet"
    },
    {
      "id": "den_andre_faste_brukeren",
      "social_function": "gjør knappe plasser, rutiner og uformelle territorier synlige",
      "class_position": "jevnlig bruker uten formell særrett",
      "status": "situert status gjennom gjenkjennelse og vane",
      "power_over_player": "kan gjøre rommet inkluderende eller gjøre faste vaner til uformell eiendomsrett",
      "wants": "forutsigbar ro og tilgang til de samme ressursene som andre",
      "conceals": "hvor lett egen rutine oppleves som mer legitim enn andres bruk",
      "speech_style": "kort, stedskjent og oppmerksom på små endringer",
      "teaches_player": "at regelmessig bruk ikke skaper eierskap"
    },
    {
      "id": "forstegangsbrukeren",
      "social_function": "gjør katalog, soner, kort og selvbetjening fremmede igjen",
      "class_position": "ny bruker med lav institusjonskunnskap",
      "status": "lav i lokale koder, men med samme grunnleggende adgang",
      "power_over_player": "avslører om spillerens erfaring brukes til orientering eller portvakt",
      "wants": "å finne fram uten å føle at en enkel feil avslører at hen ikke hører til",
      "conceals": "hvor kostbart det kan føles å stille spørsmål alle andre ser ut til å kjenne svaret på",
      "speech_style": "praktisk, konkret og spørsmålsdrevet",
      "teaches_player": "at offentlige tjenester må være lesbare også for dem som ikke kjenner systemet"
    },
    {
      "id": "programverten",
      "social_function": "holder arrangement, publikum og rombruk sammen under programkvelder",
      "class_position": "arrangementsansvarlig med lokalt mandat for programmet",
      "status": "høy i praktiske spørsmål om kveldens gjennomføring",
      "power_over_player": "kan reservere areal og forklare hvorfor ordinær bruk midlertidig endres",
      "wants": "at arrangementet fungerer uten å gjøre resten av biblioteket ubrukelig",
      "conceals": "hvor mange kompromisser som ligger bak plassering og kapasitet",
      "speech_style": "vennlig, tidsbevisst og praktisk",
      "teaches_player": "at kulturprogram og hverdagsinfrastruktur må forhandles i samme bygg"
    },
    {
      "id": "den_digitale_brukeren",
      "social_function": "synliggjør bibliotekets rolle som internett-, strøm-, printer- og arbeidsinfrastruktur",
      "class_position": "bruker som først og fremst trenger praktiske digitale tjenester",
      "status": "ofte lav symbolsk status i et rom som forbindes med bøker og studier",
      "power_over_player": "utfordrer spillerens forestilling om hvem biblioteket primært er til for",
      "wants": "stabil tilgang til utstyr og nett uten å måtte legitimere behovet sosialt",
      "conceals": "hvor mye små tekniske barrierer kan stenge andre samfunnstjenester ute",
      "speech_style": "oppgaveorientert og konkret",
      "teaches_player": "at bibliotektilgang også handler om materielle og digitale ressurser"
    },
    {
      "id": "lesevennen",
      "social_function": "ber om anbefalinger og gjør skillet mellom personlig erfaring og profesjonell seleksjon tydelig",
      "class_position": "jevnaldrende leser med annen smak og bakgrunn",
      "status": "relasjonell, ikke institusjonell",
      "power_over_player": "kan belønne sikre smaksdommer eller invitere til mer pluralistisk anbefaling",
      "wants": "å finne noe relevant uten å måtte adoptere spillerens smakshierarki",
      "conceals": "hvor annerledes samme bok kan fungere med en annen leserhistorie",
      "speech_style": "nysgjerrig, sammenlignende og personlig",
      "teaches_player": "at anbefaling blir bedre når den begynner med mottakerens behov"
    }
  ],
