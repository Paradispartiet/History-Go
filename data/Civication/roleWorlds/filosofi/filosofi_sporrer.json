  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å utvikle åpne, presise og ansvarlige spørsmål uten å gjøre spørsmålsferdighet til press, skjult råd eller formell intervju-, terapi-, forsknings- eller etterforskningsmyndighet",
    "description": "Spørrer-verdenen undersøker ledende spørsmål, spørsmålsstabler, hvorfor-spørsmål, skjulte premisser, underliggende inquiry, privatliv, retoriske spørsmål, oppfølging, status, kategorier, stillhet, kontekstgjenbruk, indirekte råd og profesjonsgrenser. Spørrer er en inquiry_practice life position. Rollen gir ingen automatisk jobb, lønn, terapeutrolle, psykologrolle, journalistrolle, forskerrolle, etterforskerrolle, profesjonell intervjuerrolle eller institusjonell myndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "social_mask",
    "status_anxiety",
    "public_attention",
    "shame_reputation",
    "public_private_leakage",
    "professional_culture",
    "care_vs_efficiency",
    "bureaucratic_power"
  ],
  "social_environments": [
    "hverdagslige samtaler der spørsmålsform påvirker hva som kan sies",
    "læringssituasjoner der status avgjør hvilke spørsmål som tør stilles",
    "nære relasjoner der privatliv og selvavsløring setter grenser for utspørring",
    "gruppesamtaler der spørsmål kan styre tema og makt uten at det er synlig",
    "beslutningssituasjoner der spørsmål kan fungere som skjult råd",
    "møter med terapi, forskning, journalistikk og etterforskning der samtykke, metode og mandat gjelder"
  ],
  "recurring_people_archetypes": [
    {
      "id": "sporsmalsvennen",
      "social_function": "tester om spørsmål faktisk er åpne nok til å kunne få uventede svar",
      "class_position": "likestilt deltaker uten formell intervjuerrolle",
      "status": "middels uformell innflytelse gjennom språk og spørsmålsform",
      "power_over_player": "kan styre hva som oppleves som relevant ved å definere hvilke spørsmål som regnes som gode",
      "wants": "at spørsmål skal åpne fremfor å skjule svar",
      "conceals": "at også åpne spørsmål alltid velger et perspektiv",
      "speech_style": "kort, presis og undrende",
      "teaches_player": "at spørsmålsform kan bære like mye styring som en påstand"
    },
    {
      "id": "avklaringsvennen",
      "social_function": "synliggjør skjulte premisser, uklare kategorier og hvorfor-spørsmål som skaper forsvar",
      "class_position": "språkbevisst samtaledeltaker",
      "status": "middels uformell begrepsautoritet",
      "power_over_player": "kan gjøre presisjon til barriere hvis hvert spørsmål må perfeksjoneres før det stilles",
      "wants": "at spørsmålet skal være forståelig og korrigerbart",
      "conceals": "at egen preferanse for presisjon kan snevre inn spontan utforskning",
      "speech_style": "rolig, analytisk og omformulerende",
      "teaches_player": "at gode spørsmål ofte krever premisskontroll før svar"
    },
    {
      "id": "rytmevennen",
      "social_function": "holder tempo, én-ting-av-gangen og responsive oppfølgingsspørsmål levende",
      "class_position": "likestilt samtaledeltaker med blikk for flyt",
      "status": "middels sosial innflytelse",
      "power_over_player": "kan avgjøre når et svar har fått nok tid før neste spørsmål",
      "wants": "at spørsmål skal følge samtalen i stedet for et manus",
      "conceals": "at fri flyt også kan gjøre viktige spørsmål uferdige",
      "speech_style": "lett, responsiv og tempobevisst",
      "teaches_player": "at spørrepraksis også handler om timing"
    },
    {
      "id": "grensevennen",
      "social_function": "markerer privatliv, samtykke og kontekst når spørsmål gjelder personlige forhold",
      "class_position": "nær sosial deltaker uten profesjonelt mandat",
      "status": "høy relasjonell sensitivitet og lav institusjonell makt",
      "power_over_player": "kan stoppe spørsmål og gjenbruk av privat kontekst når tillit står på spill",
      "wants": "at folk skal kunne avstå fra å svare uten å måtte forsvare grensen",
      "conceals": "at egne komfortgrenser ikke er universelle",
      "speech_style": "varm, tydelig og grensesettende",
      "teaches_player": "at retten til å spørre ikke gir rett til svar"
    },
    {
      "id": "nybegynnervennen",
      "social_function": "gjør det sosialt mulig å stille grunnleggende spørsmål uten å spille ekspert",
      "class_position": "lærende deltaker uten formell status",
      "status": "lav formell autoritet og høy verdi som korrektiv til gruppens antakelser",
      "power_over_player": "kan synliggjøre kunnskapshull som andre helst vil skjule",
      "wants": "at uvitenhet skal kunne uttales presist",
      "conceals": "at også nybegynnerspørsmål kan brukes performativt",
      "speech_style": "direkte, enkel og konkret",
      "teaches_player": "at et grunnleggende spørsmål kan være metodisk sterkere enn et avansert skinnspørsmål"
    },
    {
      "id": "fagpersonen",
      "social_function": "markerer når spørsmål går over i terapi, intervju, forskning, journalistikk, etterforskning eller annen mandatbærende praksis",
      "class_position": "kvalifisert eller formelt ansvarlig fagrolle i eget område",
      "status": "høy formell autoritet innen avgrenset praksis",
      "power_over_player": "kan kreve samtykke, metode, taushetsplikt eller henvisning før videre utspørring",
      "wants": "at god spørrepraksis ikke kamuflerer roller med sterkere ansvar og rettigheter",
      "conceals": "at også profesjonelle intervjuformer kan ha skjulte premisser",
      "speech_style": "presis, ansvarstydelig og rollebevisst",
      "teaches_player": "at å kunne spørre godt ikke er det samme som å ha intervjumyndighet"
    }
  ],
