  "title": "Fagfilosof",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å utvikle en sterk employment-independent fagidentitet gjennom primærtekster, begrepshistorie, argumentrekonstruksjon, kildearbeid og faglig uenighet uten at praksisen automatisk blir grad, stilling eller institusjonelt mandat",
    "description": "Fagfilosof-verdenen undersøker sitat og argumentkontekst, oversettelse, begrepshistorie, sterk argumentrekonstruksjon, sitatkjeder, kanon, sammenligning mellom tradisjoner, motivspekulasjon, terminologisk uenighet, primær- og sekundærkilder, faglig konsensus, offentlig formidling, tittelbruk og akademisk myndighet. Fagfilosof er en professional_field_identity life position og er employment-independent. Rollen gir ingen automatisk grad, filosofstilling, forskerstilling, foreleserrolle, professortittel, undervisningsmyndighet eller institusjonell talerett, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "professional_culture",
    "status_anxiety",
    "social_mask",
    "public_attention",
    "shame_reputation",
    "local_knowledge_vs_system",
    "bureaucratic_power",
    "invisible_work"
  ],
  "social_environments": [
    "selvorganiserte lesesirkler og faglige samtaler der primærtekster og argumenter diskuteres systematisk",
    "kildearbeid der oversettelser, fotnoter og sekundærlitteratur må holdes metodisk adskilt",
    "begrepshistoriske sammenhenger der samme ord skifter funksjon mellom perioder og tradisjoner",
    "seminarlignende uenighet der definisjoner, rekonstruksjon og faglig konsensus blir synlige",
    "offentlig formidling der faglige forbehold konkurrerer med ønsket om en ren forklaring",
    "møter med formelle akademiske roller som eier grader, stillinger, undervisningsansvar og institusjonelt mandat"
  ],
  "recurring_people_archetypes": [
    {
      "id": "lesepartneren",
      "social_function": "holder primærtekst, argumentstruktur og avgrensninger synlige under nærlesning",
      "class_position": "likestilt faglig leser uten akademisk mandat",
      "status": "middels uformell tekstautoritet",
      "power_over_player": "kan belønne raske sitater eller kreve full argumentrekonstruksjon",
      "wants": "at påstander om teksten skal kunne spores til teksten",
      "conceals": "at egen tolkning også bygger på valgte problemstillinger",
      "speech_style": "tekstnær, rolig og spørsmålsdrevet",
      "teaches_player": "at sitat og argumentkontekst ikke er det samme"
    },
    {
      "id": "tekstvennen",
      "social_function": "gjør oversettelse, ordvalg og tolkning eksplisitt",
      "class_position": "språk- og tekstinteressert deltaker uten filologisk eller akademisk fullmakt",
      "status": "middels uformell språkautoritet",
      "power_over_player": "kan gjøre ett oversettelsesvalg til skjult standard",
      "wants": "at begreper ikke mister viktige nyanser på vei mellom språk",
      "conceals": "at alle oversettelser innebærer prioriteringer",
      "speech_style": "presis, langsom og nyanseorientert",
      "teaches_player": "at oversettelse er en del av tolkningen"
    },
    {
      "id": "historievennen",
      "social_function": "holder begrepshistorie, kanon og intellektuell kontekst synlig",
      "class_position": "historisk orientert fagpersonlighet uten institusjonell rolle",
      "status": "middels uformell kontekstautoritet",
      "power_over_player": "kan gjøre historisk kontekst til altforklaring hvis teksten selv blir sekundær",
      "wants": "at tekster leses i sin tid uten å låses fast der",
      "conceals": "at kanonvalg også former hva som regnes som viktig historie",
      "speech_style": "kronologisk, kontekstuell og kildebevisst",
      "teaches_player": "at samme ord ikke nødvendigvis betyr samme ting på tvers av tid"
    },
    {
      "id": "seminarvennen",
      "social_function": "tester argumenter, definisjoner og uenighet i faglige samtaler",
      "class_position": "deltaker i lesesirkel, seminar eller selvorganisert fagmiljø",
      "status": "varierende symbolsk status gjennom argumentasjon",
      "power_over_player": "kan gjøre skarphet til sosial konkurranse",
      "wants": "at uenighet skal gjelde den sterkeste rimelige versjonen av et syn",
      "conceals": "at definisjonsuenighet noen ganger maskerer reell verdikonflikt",
      "speech_style": "spørrende, kontrasterende og begrepspresis",
      "teaches_player": "at god faglig uenighet krever felles problemforståelse"
    },
    {
      "id": "kildevennen",
      "social_function": "følger fotnoter, sekundærlitteratur og sitatkjeder tilbake til faktisk støtte",
      "class_position": "selvstendig kildeorientert leser uten redaksjonelt eller forskningsmessig mandat",
      "status": "lav synlighet men høy praktisk kildeverdi",
      "power_over_player": "kan forsinke konklusjoner når kildekjeden viser seg svakere enn antatt",
      "wants": "at referanser skal dokumentere mer enn sosial autoritet",
      "conceals": "at komplett kildekontroll aldri er mulig i alle ledd",
      "speech_style": "tålmodig, detaljorientert og etterprøvbar",
      "teaches_player": "at mange sitater kan bygge på én og samme opprinnelige tolkning"
    },
    {
      "id": "fagpersonen",
      "social_function": "markerer skillet mellom employment-independent fagidentitet og formell filosof-, forsker-, foreleser- eller professorrolle",
      "class_position": "kvalifisert eller ansatt akademisk rolle med avgrenset institusjonelt mandat",
      "status": "høy formell myndighet i eget fag- eller undervisningsområde",
      "power_over_player": "kan korrigere tittelbruk og skille hobby-/fagpraksis fra kvalifikasjon og ansettelse",
      "wants": "at sterk selvstendig fagpraksis anerkjennes uten rolleforvirring",
      "conceals": "at akademiske roller også bygger på uformelle lesefellesskap og faglige vaner",
      "speech_style": "presis, kildeorientert og tydelig om kvalifikasjon",
      "teaches_player": "at fagidentitet og formell akademisk rolle er separate lag"
    }
  ],
