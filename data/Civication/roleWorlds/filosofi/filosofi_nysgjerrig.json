  "title": "Nysgjerrig",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å følge spørsmål, usikkerhet, kilder og nye spor systematisk uten å gjøre nysgjerrighet til krav på privatliv, ukritisk novelty-jakt, risikofylt eksperimentering eller ekspertmyndighet",
    "description": "Nysgjerrig-verdenen undersøker spørsmålsfokus, novelty og verifisering, bredde og dybde, privatliv, usikkerhet, kildeuavhengighet, kaninhull, uenighet, nybegynnerspørsmål, sikkerhet, sladder, kontrollarbeid, informert interesse og grensen mot formell ekspertise. Nysgjerrig er en exploration_interest life position. Rollen gir ingen automatisk jobb, lønn, forskerstilling, grad, profesjonskvalifikasjon, behandlingsmandat eller institusjonell ekspertmyndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "status_anxiety",
    "social_mask",
    "public_attention",
    "shame_reputation",
    "local_knowledge_vs_system",
    "care_vs_efficiency",
    "public_private_leakage",
    "invisible_work"
  ],
  "social_environments": [
    "hverdagslige samtaler der et godt spørsmål kan åpne et tema uten at noen må ha et ferdig svar",
    "egenstyrt lesing og søk der kilder, nyhet og dokumentasjon må skilles",
    "læringsfellesskap der bredde, dybde og statuspress påvirker hvilke spørsmål som stilles",
    "digitale og sosiale miljøer der kaninhull, deling og gjentatte kilder kan forveksles med evidens",
    "situasjoner der nysgjerrighet gjelder andre mennesker og derfor møter privatlivs- og relasjonsgrenser",
    "møter med forskning, helse, sikkerhet og andre fagfelt der formell kompetanse og mandat faktisk betyr noe"
  ],
  "recurring_people_archetypes": [
    {
      "id": "sporsmalsvennen",
