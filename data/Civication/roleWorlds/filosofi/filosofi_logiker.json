  "sociological_core": {
    "main_problem": "å analysere slutningsstruktur, premisser, gyldighet, sannhet, kvantorer, betingelser, analogier, bevisbyrde og moteksempler uten å gjøre logisk analyse til empirisk fasit eller beslutningsmyndighet",
    "description": "Logiker-verdenen undersøker premiss-struktur, gyldighet og sannhet, skjulte premisser, nødvendige og tilstrekkelige vilkår, kvantorer, analogier, falske dilemmaer, sirkularitet, bevisbyrde, tvetydighet, moteksempler, formalisering, inferensregler og rollegrenser. Logiker er en logic_specialization life position. Rollen gir ingen automatisk jobb, lønn, akademisk stilling, juridisk mandat, medisinsk mandat, forskermandat eller institusjonell beslutningsmyndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "professional_culture",
    "status_anxiety",
    "social_mask",
    "public_attention",
    "shame_reputation",
    "local_knowledge_vs_system",
    "bureaucratic_power",
    "care_vs_efficiency"
  ],
  "social_environments": [
    "hverdagsdiskusjoner der en plausibel konklusjon skjuler svake eller uuttalte premisser",
    "faglige samtaler der gyldighet og sannhet må vurderes separat",
    "offentlig debatt der kvantorer, bevisbyrde og falske dilemmaer påvirker hva som fremstår overbevisende",
    "sammenligninger og generaliseringer der analogier og moteksempler tester rekkevidden",
    "formelle modeller der abstraksjon gjør strukturen tydeligere men samtidig fjerner kontekst",
    "møter med faglige og institusjonelle roller som eier fakta, evidenskrav og beslutningsmandat"
  ],
