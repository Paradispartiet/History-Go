  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å bygge, teste og revidere argumenter med tydelige premisser, evidens, begreper og motargumenter uten at argumentasjonsferdighet blir ekspertise eller formell beslutningsmyndighet",
    "description": "Argumentbygger-verdenen undersøker premisser, steelmanning, begrepsavklaring, bevisbyrde, korrelasjon og årsak, moteksempler, fakta og verdier, ekspertise, falske dilemmaer, evidensutvalg, revisjon, publikumsadaptasjon, skjulte premisser og formell myndighet. Argumentbygger er en argumentation_practice life position. Rollen gir ingen automatisk ekspertstatus, fagdommerrolle, forskermandat, juridisk autoritet eller beslutningsmyndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "status_anxiety",
    "social_mask",
    "public_attention",
    "shame_reputation",
    "professional_culture",
    "local_knowledge_vs_system",
    "bureaucratic_power",
    "care_vs_efficiency"
  ],
  "social_environments": [
    "hverdagslige diskusjoner der raske retoriske poeng konkurrerer med tydelige premisser",
    "studie- og samtalefellesskap der begreper, evidens og motargument blir testet",
    "analyse-situasjoner der korrelasjon, årsak og utvalg av eksempler må skilles",
    "formidlingssituasjoner der språk forenkles uten at premisser eller usikkerhet bør forsvinne",
    "uenigheter der felles fakta skjuler ulike normative eller metodiske premisser",
    "møter med formelle fagroller der argumentanalyse må skilles fra domeneekspertise og beslutningsmandat"
  ],
  "recurring_people_archetypes": [
    {
      "id": "diskusjonsvennen",
