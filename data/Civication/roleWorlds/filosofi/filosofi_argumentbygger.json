      "class_position": "kvalifisert eller mandatbærende rolle i relevant fagfelt",
      "status": "høy situert fagmyndighet",
      "power_over_player": "kan korrigere når logisk analyse brukes til å overkjøre manglende domeneevidens",
      "wants": "at gode argumenter styrker faglige vurderinger uten å erstatte dem",
      "conceals": "at ekspertise også trenger tydelige premisser og kan argumentere svakt",
      "speech_style": "presis, rollebevisst og evidensorientert",
      "teaches_player": "at logisk styrke og faglig sannhet ikke er identiske størrelser"
    }
