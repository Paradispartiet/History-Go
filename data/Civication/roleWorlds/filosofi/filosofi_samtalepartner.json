  "title": "Samtalepartner",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å utvikle lytting, avklaring, turtaking, uenighet og fortrolighet som hverdagslig dialogpraksis uten å overta andres valg eller gjøre samtalerollen til terapi, mekling, coaching eller profesjonell rådgivning",
    "description": "Samtalepartner-verdenen undersøker lytting, motivtolkning, spørsmål, turtaking, uenighet, følelser, stillhet, parafrasering, selvavsløring, gruppedynamikk, fortrolighet, råd, konsensus og profesjonsgrenser. Samtalepartner er en dialogue_practice life position. Rollen gir ingen automatisk jobb, lønn, terapeutrolle, psykologrolle, meklerrolle, coachrolle, behandlingsmandat eller profesjonell rådgivningsmyndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "emotional_labor",
    "social_mask",
    "status_anxiety",
    "care_vs_efficiency",
    "public_private_leakage",
    "shame_reputation",
    "professional_culture",
    "public_attention"
  ],
  "social_environments": [
    "én-til-én-samtaler der lytting og avklaring betyr mer enn å levere et raskt svar",
    "vennskap og nære relasjoner der selvavsløring, råd og fortrolighet påvirker maktbalansen",
    "gruppesamtaler der taletid, allianser og status former hvem som faktisk får delta",
    "uenighetssituasjoner der forståelse og relasjon må kunne bestå uten tvungen enighet",
    "samtaler om vanskelige følelser der tilstedeværelse ikke automatisk skal bli behandling",
    "møter med terapi, mekling, coaching og rådgivning der formell kompetanse og ansvar faktisk gjelder"
  ],
  "recurring_people_archetypes": [
    {
      "id": "lyttevennen",
      "social_function": "holder oppmerksomheten på hva den andre faktisk sier før svar, råd eller tolkning bygges",
      "class_position": "likestilt deltaker uten formell hjelperrolle",
      "status": "middels relasjonell tillit og lav formell makt",
      "power_over_player": "kan definere god lytting på en måte som gjør samtalen for langsom eller selvbevisst",
      "wants": "at folk skal føle seg hørt uten at samtalen stopper opp",
      "conceals": "at også lytting kan bli en teknikk som brukes mekanisk",
      "speech_style": "rolig, kort og oppsummerende",
      "teaches_player": "at lytting krever kontroll av egen responsimpuls"
    },
    {
      "id": "avklaringsvennen",
      "social_function": "tester tolkninger, parafraser og antatte motiver før de blir stående som fakta",
      "class_position": "språkbevisst samtaledeltaker uten profesjonelt mandat",
      "status": "middels uformell begrepsautoritet",
      "power_over_player": "kan gjøre presisjon til et krav som tapper samtalen for spontanitet",
      "wants": "at uenighet skal handle om det folk faktisk mener",
      "conceals": "at egne formuleringer også kan styre den andres selvforståelse",
      "speech_style": "presis, spørsmålsdrevet og korrigerbar",
      "teaches_player": "at en god parafrase alltid må kunne avvises av den som ble parafrasert"
    },
    {
      "id": "rytmevennen",
      "social_function": "gjør taletid, turtaking og gruppeinkludering synlig uten å gjøre samtalen mekanisk",
      "class_position": "gruppedeltaker med blikk for sosial dynamikk",
      "status": "middels sosial innflytelse",
      "power_over_player": "kan gripe inn i flyten og indirekte bestemme hvem som bør snakke",
      "wants": "at flere skal kunne delta uten å kjempe om ordet",
      "conceals": "at lik taletid ikke alltid er riktig mål",
      "speech_style": "lett, inviterende og tempobevisst",
      "teaches_player": "at samtalerytme også fordeler sosial makt"
    },
    {
      "id": "uenighetsvennen",
      "social_function": "holder konflikt på sak, premiss og perspektiv fremfor poengseier og personvurdering",
      "class_position": "likestilt deltaker i reell uenighet",
      "status": "middels faglig eller sosial selvsikkerhet",
      "power_over_player": "kan eskalere statuskamp hvis uenighet gjøres til prestasjon",
      "wants": "at forskjeller skal bli tydelige uten at relasjonen må brytes",
      "conceals": "at også saklig uenighet kan inneholde behov for å vinne",
      "speech_style": "direkte, konkret og kontrasterende",
      "teaches_player": "at forståelse ikke krever konsensus"
    },
    {
      "id": "grensevennen",
      "social_function": "holder fortrolighet, selvavsløring og gjenbruk av private historier innenfor tydelige relasjonelle grenser",
      "class_position": "nær sosial deltaker uten behandlingsansvar",
      "status": "høy relasjonell sensitivitet og lav institusjonell makt",
      "power_over_player": "kan stoppe deling eller gjenfortelling når tillit står på spill",
      "wants": "at nærhet ikke skal bli press om mer åpenhet enn folk ønsker",
      "conceals": "at egne grenser ikke nødvendigvis er andres",
      "speech_style": "tydelig, varm og grensesettende",
      "teaches_player": "at tillit også består av det man velger å ikke bruke videre"
    },
    {
      "id": "fagpersonen",
      "social_function": "markerer når samtalen går over i behandling, krisehåndtering, formell mekling eller profesjonell rådgivning",
      "class_position": "kvalifisert eller mandatbærende fagrolle i eget område",
      "status": "høy formell autoritet innen avgrenset praksis",
      "power_over_player": "kan kreve henvisning eller stoppe rolleoverskridelse når behovet går utover vanlig samtale",
      "wants": "at god dialog ikke brukes som erstatning for nødvendig faglig hjelp",
      "conceals": "at profesjonelle grenser også må kommuniseres menneskelig og situert",
      "speech_style": "rolig, ansvarstydelig og presis",
      "teaches_player": "at samtalekompetanse og profesjonsmyndighet er forskjellige ting"
    }
  ],
