  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å analysere samtykke, skade, fordelingsprinsipper, rolleplikt, interessekonflikter, usikkerhet og verdikonflikter uten at etisk refleksjon blir profesjonell eller institusjonell beslutningsmyndighet",
    "description": "Etiker-verdenen undersøker frivillighet og press, nytte og byrdefordeling, regler og unntak, rolleplikt, interessekonflikter, irreversibel skade, likhet og behov, intensjon og konsekvens, verdikonflikt, reversibilitet, beslutning under usikkerhet, presedens, moralsk uenighet og formell myndighet. Etiker er en ethics_specialization life position. Rollen gir ingen automatisk fagdommerrolle, juridisk autoritet, behandlingsmandat, forskermandat eller institusjonell beslutningsmyndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "care_vs_efficiency",
    "status_anxiety",
    "social_mask",
    "shame_reputation",
    "bureaucratic_power",
    "professional_culture",
    "local_knowledge_vs_system",
    "public_attention"
  ],
  "social_environments": [
    "hverdagslige relasjoner der samtykke, press og ansvar må vurderes uten formell prosedyre",
    "fordelingssituasjoner der samlet nytte og hvem som bærer kostnaden trekker i ulike retninger",
    "grupper og institusjoner der regler, unntak, roller og presedens former hva som oppleves som rettferdig",
    "samtaler der legitime verdier kolliderer uten at én av dem kan maksimeres fullt ut",
    "beslutninger under usikkerhet der sannsynlighet, alvorlighet og reversibilitet må skilles",
    "møter med faglige, juridiske og institusjonelle roller som faktisk eier formelt ansvar"
  ],
  "recurring_people_archetypes": [
