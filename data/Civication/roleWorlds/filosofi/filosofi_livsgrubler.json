  "title": "Livsgrubler",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å bruke refleksjon, tvil og åpne spørsmål som orientering uten at behovet for sikkerhet gjør tenkning til handlingsstopp eller identitetsdom",
    "description": "Livsgrubler-verdenen er den private og hverdagslige siden av filosofi: spørsmål om mening, valg, ansvar, verdier og tvil følger spilleren gjennom vanlige dager. Den skiller seg fra Sofafilosof ved at sosial argumentasjon ikke er kjernen, og fra Lesesirkelmenneske ved at praksisen ikke er organisert rundt avtalte tekster og møter. Ingen ny runtime opprettes."
  },
  "theme_ids": [
    "status_anxiety",
    "shame_reputation",
    "social_mask",
    "care_vs_efficiency",
    "public_private_leakage",
    "alienation",
    "emotional_labor",
    "body_discipline"
  ],
  "social_environments": [
    "morgener der et åpent spørsmål følger inn i en vanlig dag",
    "private valg der mer analyse ikke fjerner usikkerhet",
    "notater og tidligere formuleringer som viser endring over tid",
    "vennesamtaler der perspektiver må holdes adskilt fra beslutningsmyndighet",
    "lesing og tankeeksperimenter som gir ideer uten automatisk fasit",
    "rolige kvelder der stillhet og mindre input gjør egne tanker tydeligere"
  ],
  "recurring_people_archetypes": [
    {
      "id": "praktisk_venn",
      "social_function": "minner om at et spørsmål også må leve sammen med hverdagslige forpliktelser",
      "class_position": "nær venn uten filosofisk status",
      "status": "likestilt privat relasjon",
      "power_over_player": "kan utfordre overanalyse og be om konkret handling",
      "wants": "at refleksjon skal gjøre livet klarere uten å spise opp alt annet",
      "conceals": "egen usikkerhet når store spørsmål blir abstrakte",
      "speech_style": "kort, varm og konkret",
      "teaches_player": "at handling kan være legitim før total sikkerhet"
    },
    {
      "id": "sporsmalsvenn",
      "social_function": "liker åpne spørsmål og holder dem levende uten å kreve konklusjon",
      "class_position": "jevnaldrende venn med høy nysgjerrighet",
      "status": "likestilt",
      "power_over_player": "kan normalisere usikkerhet og reell revisjon",
      "wants": "samtaler som tåler å ende åpent",
      "conceals": "at åpenhet også kan brukes til å unngå valg",
      "speech_style": "spørrende og langsom",
      "teaches_player": "at et godt spørsmål ikke alltid trenger lukking"
    },
    {
      "id": "besluttsom_venn",
      "social_function": "representerer motsatsen som heller velger og justerer underveis",
      "class_position": "jevnaldrende med lav toleranse for analyseforsinkelse",
      "status": "likestilt",
      "power_over_player": "kan gjøre handlingskostnaden ved videre grubling synlig",
      "wants": "at valg skal bli testet i virkeligheten",
      "conceals": "at raske valg også kan skjule ubehag ved tvil",
      "speech_style": "direkte og løsningsorientert",
      "teaches_player": "at revisjon etter handling også er en måte å tenke på"
    },
    {
