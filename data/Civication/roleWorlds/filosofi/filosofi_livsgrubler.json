      "power_over_player": "kan trekke tillit hvis råd blir overtakelse",
      "wants": "perspektiv uten å miste eierskap til beslutningen",
      "conceals": "hvor mye bekreftelse som egentlig ønskes",
      "speech_style": "personlig og søkende",
