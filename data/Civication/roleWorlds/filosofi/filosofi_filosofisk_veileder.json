      "status": "høy personlig innsats men ingen formell underordning",
      "power_over_player": "kan gi veilederrollen ufortjent autoritet ved å be om fasit eller råd",
      "wants": "å forstå hva som faktisk står på spill uten å få beslutningen tatt fra seg",
      "conceals": "at ønsket om et enkelt svar noen ganger er sterkere enn ønsket om å utforske premissene",
      "speech_style": "personlig, prøvende og konkret",
      "teaches_player": "at klarhet og beslutningseierskap må holdes sammen"
    },
    {
      "id": "begrepsvennen",
      "social_function": "tester ord, definisjoner og skjulte antakelser når samtalen låser seg",
      "class_position": "filosofiinteressert deltaker uten profesjonelt mandat",
      "status": "middels uformell begrepsautoritet",
      "power_over_player": "kan gjøre språklig presisjon til en skjult fasit hvis egne definisjoner får dominere",
      "wants": "at sentrale ord blir tydelige nok til at reell uenighet kan sees",
      "conceals": "at også presise definisjoner er valg som kan favorisere én problemramme",
      "speech_style": "presis, spørrende og langsom",
      "teaches_player": "at begrepsavklaring åpner spørsmål, men ikke eier svarene"
