  "title": "Filosofisk veileder",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å bruke filosofiske spørsmål, begrepsavklaring og verdirefleksjon i samtale uten å overta den andres beslutning eller gjøre praksisen til terapi, behandling eller profesjonell rådgivningsmyndighet",
    "description": "Filosofisk veileder-verdenen undersøker spørsmål bak spørsmål, skjulte antakelser, verdikonflikt, beslutningseierskap, begrepsavklaring, stillhet, teori som perspektiv, uenighet, fortrolighetsgrenser, henvisning, metodebruk, betaling, avslutning og profesjonsgrenser. Filosofisk veileder er en philosophical_practice life position. Praksisen kan i virkeligheten være betalt eller selvstendig, men Badge-posisjonen gir ingen automatisk fast lønn, arbeidsforhold, terapeutrolle, psykologrolle, juridisk rådgiverrolle, behandlingsmandat eller institusjonell myndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "emotional_labor",
    "care_vs_efficiency",
    "social_mask",
    "professional_culture",
    "status_anxiety",
    "shame_reputation",
    "bureaucratic_power",
    "public_private_leakage"
  ],
  "social_environments": [
    "én-til-én-samtaler der personen søker klarhet uten å overlate beslutningen til samtalepartneren",
    "verdikonflikter der flere legitime hensyn må utforskes uten ekstern rangering",
    "begrepssamtaler der definisjoner, antakelser og språk endrer hvordan problemet forstås",
    "fortrolige samtaler der nærhet og tillit krever tydelige grenser for hva praksisen kan bære",
    "betalt eller selvorganisert filosofisk praksis der forventninger om resultat og ekspertise må avklares",
    "møter med terapi, helse, juss og andre profesjoner som faktisk eier behandling, rådgivning eller formelt mandat"
  ],
  "recurring_people_archetypes": [
    {
      "id": "samtalepartneren",
      "social_function": "bringer konkrete livsspørsmål, verdikonflikter og behov for avklaring inn i samtalen",
