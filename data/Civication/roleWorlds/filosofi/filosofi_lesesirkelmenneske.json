  "title": "Lesesirkelmenneske",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å gjøre kollektiv lesing til et faktisk lærende fellesskap uten at forberedelse, kanon, taletid eller tolkningssikkerhet blir skjulte rangsystemer",
    "description": "Lesesirkelmenneske-verdenen handler om å møte opp, lese, tolke og la andre endre det man trodde var ferdig. Kjernen er tekstbelegg, uenighet, revisjon, taletid, nykommerterskel, programvalg, kildeomsorg og realistisk tempo. Den skiller seg fra Sofafilosof ved å være organisert rundt avtalte tekster og gjentatte møter, ikke spontan hverdagsfilosofering, og fra akademisk filosofi ved at fellesskapet ikke gir formell ekspertmyndighet."
  },
  "theme_ids": [
    "status_anxiety",
    "shame_reputation",
    "social_mask",
    "care_vs_efficiency",
    "public_private_leakage",
    "class_power",
    "emotional_labor",
    "public_attention"
  ],
  "social_environments": [
    "lesesirkelmøtet rundt en avtalt tekst",
    "gruppechatten mellom møtene",
    "hjemmelesing med ulik tid og forberedelse",
    "programvalg og planlegging av neste tekst",
    "møter der nye deltakere møter en etablert kultur",
    "etterklangen etter uenighet og revisjon"
  ],
  "recurring_people_archetypes": [
