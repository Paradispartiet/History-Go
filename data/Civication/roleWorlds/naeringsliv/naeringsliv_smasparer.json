{"schema":"civication_role_world_v1","version":1,"category":"naeringsliv","role_scope":"naeringsliv_smasparer","subject_type":"life_position","life_position_ref":{"badge_id":"naeringsliv","id":"smasparer","label":"Småsparer"},"title":"Småsparer","status":"role_world_complete","sociological_core":{"main_problem":"å bygge litt økonomisk handlingsrom gjennom små, gjentatte valg når prisendringer, uforutsette utgifter, ulik inntekt, sosiale sammenligninger og relasjonelle krav kan gjøre enkel sparing til mer enn et regnestykke","description":"Småsparer-verdenen undersøker automatiske små overføringer, buffer, uforutsette regninger, abonnementer, spekulative tips, prisendringer, gjeld og buffer, private låneforespørsler, økonomisk sammenligning, varierende inntekt, sparemål, konto- og rentevilkår, kontrollbehov og grensen mellom privat hverdagsøkonomi og profesjonell finansmyndighet. Småsparer er en financial_identity for egen økonomi. Rollen gir ingen automatisk myndighet som investeringsrådgiver, bankrådgiver, megler, porteføljeforvalter, gjeldsrådgiver eller økonomisk ekspert for andre, og introduserer ingen ny runtime."},"theme_ids":["numerical_control","class_power","precarity","status_anxiety","care_vs_efficiency","invisible_work","public_private_leakage","bureaucratic_power"],"social_environments":["egen nettbank og kontoutskrift","hverdagskjøp og abonnementer","familie og venner som snakker om penger","uventede regninger og reparasjoner","perioder med varierende inntekt","bankvilkår og sparekontoer","private mål og økonomiske rutiner","samtaler om investering, gjeld og økonomisk status"],"recurring_people_archetypes":[{"id":"venn_med_investeringshistorie","social_function":"gjør grensen mellom privat tips og finansråd synlig","class_position":"privatperson med egne investeringserfaringer","status":"uformell sosial troverdighet uten profesjonell finansmyndighet","power_over_player":"kan påvirke risikovilje gjennom entusiasme og fortellinger","wants":"å dele noe som har fungert eller virker spennende","conceals":"hvor selektivt gevinster og tap huskes","speech_style":"sikker, energisk og resultatfokusert","teaches_player":"at nærhet ikke gjør spekulative tips trygge"},{"id":"naer_person_med_felles_utgifter","social_function":"gjør sparingens relasjonelle konsekvenser synlige","class_position":"partner, familie eller annen nær relasjon med berøring mot felles økonomi","status":"høy privat betydning, ingen automatisk rett til spillerens buffer","power_over_player":"kan forhandle om felles prioriteringer og tidsbruk av penger","wants":"forutsigbarhet og rimelig fordeling","conceals":"at eget trygghetsbehov kan trekke i en annen retning","speech_style":"praktisk, personlig og opptatt av konkrete konsekvenser","teaches_player":"at privat sparing eksisterer i relasjoner"},{"id":"bankansatt","social_function":"representerer formelle produktvilkår uten å være universell økonomisk fasit","class_position":"ansatt i finansinstitusjon med avgrenset rolle","status":"formell produkt- og prosedyrekunnskap innen eget mandat","power_over_player":"kan forklare vilkår og prosesser for bankens tjenester","wants":"at valg gjøres på korrekt informasjon om produktet","conceals":"at institusjonens tilbud ikke dekker alle økonomiske behov","speech_style":"betinget, dokumentorientert og produktspesifikk","teaches_player":"at bankinformasjon og personlig økonomisk rådgivning må skilles"},{"id":"kollega_med_annen_okonomi","social_function":"viser hvordan samme spareprat skjer på svært ulike økonomiske utgangspunkt","class_position":"jevnaldrende i arbeid, men med annen inntekt, bolig, gjeld eller familieøkonomi","status":"sosialt sammenlignbar, økonomisk ikke direkte sammenlignbar","power_over_player":"kan skape statuspress gjennom tall og vaner","wants":"å dele erfaring eller bekrefte egne valg","conceals":"hvor mye bakgrunn og risiko som ligger bak tallene","speech_style":"uformell og tallpreget","teaches_player":"at saldo ikke er moralsk rangering"},