  "title": "Investor",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å allokere egen kapital under usikkerhet uten å forveksle investering med operativ ledelse, generelt selskapseierskap eller profesjonell forvaltning av andres penger",
    "description": "Investor er en employment-independent capital_ownership_and_investment-posisjon for egen kapitalallokering: investeringstese, verdsettelse, posisjonsstørrelse, betalingsberedskap, nedside, belåning, informasjonskvalitet, drawdown, minoritetsrettigheter, oppfølgingskapital, eierinnflytelse, exit og kontantreserve. Rollen er forskjellig fra Bedriftseier, Industrieier og Gründer, og fra de formelle karrierene Kapitalforvalter, Finansanalytiker og Daglig leder. Investor gir ingen automatisk operativ instruksjonsmyndighet, arbeidstakerstatus, styreplass, rådgiverautorisasjon, mandat over andres penger eller garanti for avkastning. Ingen ny runtime introduseres."
  },
  "theme_ids": [
    "class_power",
    "professional_culture",
    "invisible_work",
    "status_anxiety",
    "shame_reputation",
    "precarity",
    "care_vs_efficiency",
    "public_private_leakage"
  ],
  "social_environments": [
    "investeringsmøter der tese, pris og nedside prøves mot hverandre",
    "porteføljedialoger om konsentrasjon, betalingsberedskap, reserve og belåning",
    "dokumentgjennomgang der rapporterte tall og estimater får ulik evidensvekt",
    "private transaksjoner der eierrettigheter og utvanning påvirker økonomisk verdi",
    "markedsfall der følelse, pris og underliggende tese må skilles",
    "exit- og oppfølgingsbeslutninger der alternativ bruk av egen kapital blir eksplisitt"
  ],
  "recurring_people_archetypes": [
    {
      "id": "analytikeren",
      "social_function": "gjør investeringshypoteser, verdsettelse og informasjonsgrunnlag etterprøvbart",
      "class_position": "uavhengig analyseperson uten mandat over spillerens kapital",
      "status": "har kunnskapsmakt gjennom modeller og dokumentasjon",
      "power_over_player": "kan avdekke premisser som ikke henger sammen",
      "wants": "at beslutninger kan spores til data, antakelser og falsifikasjonspunkter",
      "conceals": "at modeller kan gi falsk presisjon når input er svak",
      "speech_style": "presis, premissdrevet og opptatt av hva som faktisk kan verifiseres",
      "teaches_player": "å skille investeringscase fra fortelling"
    },
    {
      "id": "portefoljeradgiveren",
      "social_function": "gjør posisjonsstørrelse, betalingsberedskap, reserve og exit sammenlignbart på porteføljenivå",
      "class_position": "rådgiver uten eierskap eller automatisk fullmakt",
      "status": "har påvirkning gjennom rammer for samlet risiko",
      "power_over_player": "kan synliggjøre konsekvenser som ikke finnes i ett enkelt case",
      "wants": "at kapitalbruk passer tidshorisont, betalingsberedskap og risikobæreevne",
      "conceals": "at diversifisering kan brukes mekanisk uten å forstå underliggende risiko",
      "speech_style": "rammeorientert, sannsynlighetsbevisst og rolig",
      "teaches_player": "å se hver investering som del av en samlet kapitalstruktur"
    },
    {
      "id": "bankkontakten",
      "social_function": "gjør belåning, sikkerhetskrav og finansieringsvilkår konkrete",
      "class_position": "långiverpart med kontraktsmakt, ikke eiermyndighet",
      "status": "kan endre handlefrihet gjennom rente, sikkerhet og tvangsvilkår",
      "power_over_player": "kan gjøre ønsket eksponering mulig eller uholdbar",
      "wants": "betjeningsevne og sikkerhet som tåler stress",
      "conceals": "at bankens risikoreduksjon kan øke investorens tvangsrisiko",
      "speech_style": "vilkårsnær, tallorientert og opptatt av sikkerhet",
      "teaches_player": "at finansiering endrer hvem som kontrollerer tidspunktet for beslutninger"
    },
    {
      "id": "revisoren",
      "social_function": "skiller dokumenterte tall fra estimater og presentasjon",
      "class_position": "uavhengig kontrollfunksjon uten investeringsmandat",
      "status": "har troverdighetsmakt over kvaliteten på rapportert informasjon",
      "power_over_player": "kan avdekke svak dokumentasjon og regnskapsmessige forbehold",
      "wants": "at beslutningsgrunnlaget beskriver hva tallene faktisk kan bevise",
      "conceals": "at formell dokumentasjon ikke eliminerer all økonomisk usikkerhet",
      "speech_style": "dokumentorientert, nøktern og presis",
      "teaches_player": "å vekte evidens etter kvalitet"
    },
    {
      "id": "transaksjonsadvokaten",
      "social_function": "gjør eierrettigheter, minoritetsvern og governance-grenser konkrete",
      "class_position": "juridisk rådgiver uten automatisk eier- eller styremyndighet",
      "status": "har ekspertmakt over tolkning av avtaler og rettigheter",
      "power_over_player": "kan vise at like eierprosenter gir ulike økonomiske og styringsmessige posisjoner",
      "wants": "at kapitalen bindes med forståtte rettigheter og ansvar",
      "conceals": "at juridisk ryddighet kan forveksles med økonomisk attraktivitet",
      "speech_style": "klausulnær, konsekvensorientert og tydelig på mandat",
      "teaches_player": "at eierskapets rettigheter må forstås før de prises"
    },
    {
      "id": "medinvestoren",
      "social_function": "speiler markedspress, oppfølgingskapital og følelsene rundt gevinst og tap",
      "class_position": "annen kapitaleier med egne interesser og tidshorisont",
      "status": "har sosial påvirkning, men ingen myndighet over spillerens beslutning",
      "power_over_player": "kan forsterke flokkatferd eller utfordre beslutningsdisiplin",
      "wants": "en beslutning som kan forsvares på egne premisser",
      "conceals": "at egen posisjon kan farge rådene som gis",
      "speech_style": "erfaringsnær, direkte og opptatt av timing",
      "teaches_player": "å skille sosial bekreftelse fra selvstendig kapitalallokering"
    }
  ],
