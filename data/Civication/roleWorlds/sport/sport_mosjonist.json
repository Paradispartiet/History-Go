  "life_position_ref": {
    "badge_id": "sport",
    "id": "mosjonist",
    "label": "Mosjonist"
  },
  "title": "Mosjonist",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å holde lavterskel bevegelse levende i hverdagen uten at mengde, fart, utstyr, aktivitetsdata eller disiplin blir sosial rang, tvang eller skjult konkurranse-, klubb-, trener- eller profesjonell status",
    "description": "Mosjonist er en employment-independent participation_practice for hverdagsbevegelse, enkel kontinuitet og aktivitet som kan tilpasses tid, form og livssituasjon. Rollen er mindre målrettet og sportslig utviklingsorientert enn Aktiv utøver, mindre identitetsbærende enn Søndagsutøver og uten den vedvarende resultat- og rangeringspraksisen som kjennetegner Konkurranseutøver. Den krever heller ikke Klubbspiller-tilhørighet og gir ingen trener-, medisinsk- eller Profesjonell utøver-myndighet."
  },
  "theme_ids": [
    "care_vs_efficiency",
    "status_anxiety",
    "shame_reputation",
    "social_mask",
    "class_power",
    "professional_culture",
    "public_private_leakage",
    "invisible_work"
  ],
  "social_environments": [
    "hverdager der små mengder bevegelse konkurrerer med arbeid, omsorg og praktiske oppgaver",
    "uformelle mosjonsfellesskap med ulik fart, erfaring og sosial trygghet",
    "aktivitetsmåling og utstyrsprat der tall og forbruk lett blir symboler på seriøsitet",
    "pauser, restart og varierende kapasitet der kontinuitet må kunne bygges uten skyld og treningsgjeld",
    "åpne arrangementer som kan gi retning uten å skape konkurransestatus",
    "situasjoner der Mosjonist må holdes tydelig fra Aktiv utøver, Søndagsutøver, Konkurranseutøver, Klubbspiller og Profesjonell utøver"
  ],
  "recurring_people_archetypes": [
    {
      "id": "naerpersonen",
      "social_function": "viser hvordan mosjon må finne plass ved siden av omsorg, arbeid, søvn og andre nære forpliktelser",
      "class_position": "nær relasjon uten sportslig myndighet",
      "status": "høy på kjennskap til spillerens hverdag, lav på idrettslig autoritet",
      "power_over_player": "kan forsterke støtte eller skyld rundt tid brukt på aktivitet",
      "wants": "at bevegelse støtter hverdagen uten å spise opp resten av livet",
      "conceals": "at støtte også kan bli indirekte press om å prestere eller droppe aktivitet",
      "speech_style": "rolig, konkret og hverdagsnær",
      "teaches_player": "at kontinuitet må forhandles med livet rundt, ikke bare med viljestyrke"
    },
    {
      "id": "mosjonspartneren",
      "social_function": "gjør tempo, rutiner og erfaringsutveksling sosialt synlig",
      "class_position": "likestilt deltaker uten formell myndighet",
      "status": "middels på erfaring, uten rett til å definere andres nivå",
      "power_over_player": "kan gjøre fart og oppmøte til sosial rang eller støtte",
      "wants": "at aktivitet sammen oppleves enkel og gjensidig",
      "conceals": "at egen usikkerhet kan ligge bak råd og sammenligning",
      "speech_style": "uformell, direkte og oppmuntrende",
      "teaches_player": "at fellesskap ikke trenger lik fart, like mål eller identisk opplegg"
    },
    {
      "id": "nybegynneren",
      "social_function": "synliggjør hvilke uskrevne krav et lavterskelmiljø faktisk legger på nye deltakere",
      "class_position": "ny deltaker med full rett til respekt",
      "status": "lav på lokal erfaring, ikke lav på verdi",
      "power_over_player": "kan avsløre om gruppa driver gatekeeping",
      "wants": "å forstå nok til trygg deltakelse uten å late som alt er kjent",
      "conceals": "at usikkerhet ofte skjules for å unngå å virke lite seriøs",
      "speech_style": "spørrende, konkret og forsiktig",
      "teaches_player": "at lav terskel også må gjelde sosialt"
    },
    {
      "id": "utstyrsformidleren",
      "social_function": "gjør skillet mellom reelt behov, sikkerhet, komfort og statusforbruk synlig",
      "class_position": "kommersiell eller praktisk rådgiver uten sportslig mandat",
      "status": "høy på produktkunnskap, lav på retten til å definere seriøsitet",
      "power_over_player": "kan gjøre pris og merke til skjult adgangsbillett",
      "wants": "at utstyr løser konkrete behov",
      "conceals": "at salg og statusmarkører kan trekke rådene mot dyrere valg",
      "speech_style": "saklig, sammenlignende og behovsorientert",
      "teaches_player": "at utstyr ikke dokumenterer identitet eller sosial rang"
    },
    {
      "id": "erfaren_mosjonist",
      "social_function": "viser hvordan egen erfaring kan deles uten medisinsk eller trenerfaglig overclaim",
      "class_position": "erfaren deltaker uten formell fagmyndighet",
      "status": "høy på praktisk egen erfaring",
      "power_over_player": "kan normalisere gode grenser eller presse frem selvdiagnose og råd",
      "wants": "at andre får nytte av erfaring uten unødig skade",
      "conceals": "at lang erfaring lett kan føles som mer sikker kunnskap enn den er",
      "speech_style": "jordnær, erfaringsbasert og forsiktig",
      "teaches_player": "å skille personlige erfaringer fra faglig autoritet"
    },
    {
      "id": "rolleavklareren",
      "social_function": "holder Mosjonist adskilt fra Aktiv utøver, Søndagsutøver, Konkurranseutøver, Klubbspiller, Profesjonell utøver og trener",
      "class_position": "metodisk rolleavklarer uten sportslig mandat",
      "status": "høy på begreps- og ansvarsavklaring",
      "power_over_player": "kan stoppe statusinflasjon når enkel mosjon brukes som bredere legitimasjon",
      "wants": "at hverdagsbevegelse beskrives presist uten å bli nedvurdert eller overtolket",
      "conceals": "at samme person kan ha flere idrettsroller samtidig, men at hver trenger eget grunnlag",
      "speech_style": "nøktern, presis og kontrasterende",
      "teaches_player": "at Mosjonist er en selvstendig praksis uten å være en skjult tittelstige"
    }
  ],
