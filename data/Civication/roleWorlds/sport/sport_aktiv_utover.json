  "title": "Aktiv utøver",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å holde en regelmessig og målrettet idrettspraksis levende gjennom læring, belastning, restitusjon og fellesskap uten å gjøre aktivitetsnivå til konkurransestatus, klubbmandat, trenerautoritet eller profesjonelt arbeid",
    "description": "Aktiv utøver er en employment-independent participation_practice: en bred rolle for mennesker som trener eller driver idrett regelmessig og målrettet, lærer teknikk, følger egen belastning og deltar i sosiale treningsmiljøer. Rollen er mer vedvarende og utviklingsorientert enn tilfeldig mosjon, men er ikke i seg selv Konkurranseutøver, Klubbspiller eller Profesjonell utøver. Den gir heller ingen trener-, ernærings-, medisinsk-, anleggs- eller arbeidsgivermyndighet. Søndagsutøver og Mosjonist kan overlappe i faktisk aktivitet, men Aktiv utøver beskriver den regelmessige praksisen uten å kreve deres spesifikke identitetsramme."
  },
  "theme_ids": [
    "care_vs_efficiency",
    "status_anxiety",
    "shame_reputation",
    "social_mask",
    "professional_culture",
    "class_power",
    "public_private_leakage",
    "invisible_work"
  ],
  "social_environments": [
    "treningsuker der aktivitet må konkurrere med søvn, arbeid, familie og andre forpliktelser",
    "uformelle grupper der tempo, erfaring og mål varierer uten én autoritativ trenerrolle",
    "baner, haller, løyper og treningsflater der regelmessige brukere deler plass med nybegynnere og andre aktiviteter",
    "tekniske økter der det å se andre og dele medutøverråd kan hjelpe uten å bli formell coaching",
    "perioder med framgang, tretthet, pause og comeback der identiteten prøves mot faktisk kapasitet",
    "digitale treningsflater der data, personlige rekorder og synlig aktivitet kan støtte eller overta praksisen"
  ],
  "recurring_people_archetypes": [
    {
      "id": "treningspartneren",
