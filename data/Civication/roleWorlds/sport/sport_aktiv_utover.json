      "status": "høy på nærhet til den daglige praksisen",
      "power_over_player": "kan skape sosialt press rundt oppmøte, fart og treningsmengde",
      "wants": "at begge holder aktiviteten i gang på en måte som faktisk fungerer over tid",
      "conceals": "at egen kontinuitet også er en del av selvbildet",
      "speech_style": "direkte, uformell og praktisk",
      "teaches_player": "at stabil praksis kan være forpliktende uten å bli tvang"
    },
    {
      "id": "den_erfarne_medutoveren",
      "social_function": "viser hvordan teknikk og erfaring kan deles uten å bli trener- eller helseautoritet",
      "class_position": "medutøver med mer erfaring i enkelte deler av aktiviteten",
      "status": "lokalt respektert for praksiserfaring",
      "power_over_player": "kan påvirke hvilke løsninger som oppfattes som normale eller riktige",
      "wants": "at gruppen lærer raskere av erfaringer som allerede finnes",
      "conceals": "at egne rutiner ikke alltid passer andre kropper eller mål",
      "speech_style": "konkret, løsningsorientert og erfaren",
      "teaches_player": "å skille nyttig erfaringsdeling fra formell fagmyndighet"
