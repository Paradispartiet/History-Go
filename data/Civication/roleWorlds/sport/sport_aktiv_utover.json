    {
      "id": "naerpersonen",
      "social_function": "viser hvordan trening påvirker søvn, tid, restitusjon og resten av privatlivet",
      "class_position": "nær relasjon uten sportslig myndighet",
      "status": "høy på kjennskap til spillerens hverdag",
      "power_over_player": "kan speile konsekvenser som treningsmiljøet ikke ser",
      "wants": "at aktiviteten skal passe inn i et liv som også inneholder andre forpliktelser",
      "conceals": "at irritasjon over treningstid noen ganger blandes med legitim bekymring",
      "speech_style": "personlig, tydelig og jordnær",
      "teaches_player": "at kontinuitet må vurderes sammen med resten av livet"
