    {
      "id": "rolleavklareren",
      "social_function": "holder Aktiv utøver adskilt fra Mosjonist, Søndagsutøver, Konkurranseutøver, Klubbspiller, Profesjonell utøver, trener og helsefaglige roller",
      "class_position": "metodisk rolleavklarer uten sportslig eller arbeidsgivermessig mandat",
      "status": "høy på begreps- og ansvarsavklaring",
      "power_over_player": "kan stoppe status- og myndighetsinflasjon når treningspraksis gjøres til tittel",
      "wants": "at aktiv idrettspraksis beskrives presist uten å nedvurderes eller overdrives",
      "conceals": "at samme person kan ha flere roller, men at hver rolle fortsatt trenger eget grunnlag",
      "speech_style": "nøktern, kontrasterende og presis",
      "teaches_player": "at Aktiv utøver er en reell praksis uten automatisk konkurranse-, klubb-, trener- eller profesjonell status"
    }
