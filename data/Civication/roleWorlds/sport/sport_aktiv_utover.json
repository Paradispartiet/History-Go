      "class_position": "organiserende deltaker i uformell treningsgruppe",
      "status": "høy på logistikk, lav på formell rang",
      "power_over_player": "kan gjøre tempo og oppmøte til uformelle normer",
      "wants": "at øktene faktisk lar seg gjennomføre for flere",
      "conceals": "at effektiv koordinering lett kan bli til styring",
      "speech_style": "kort, oversiktlig og inkluderende",
      "teaches_player": "at organisering kan være reell uten at koordinatoren blir trener"
    },
    {
      "id": "nybegynneren",
      "social_function": "synliggjør terskler i utstyr, lokale koder, tempo og språk som er usynlige for erfarne",
      "class_position": "ny deltaker uten lavere menneskelig status",
      "status": "lav på lokal erfaring, fullverdig på rett til respekt og trygg deltakelse",
      "power_over_player": "kan avsløre når spillerens praksis har blitt gatekeeping",
      "wants": "å forstå nok til å delta uten å måtte late som alt er kjent",
