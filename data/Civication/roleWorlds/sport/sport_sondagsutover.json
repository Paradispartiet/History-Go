    "label": "Søndagsutøver"
  },
  "title": "Søndagsutøver",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å gjøre mosjon til en stabil kilde til mestring, helse og fellesskap uten at oppmøte, tempo, utstyr, resultatdata eller selvdisiplin blir sosial rang, tvang eller trener-, medisinsk- og profesjonell utøvermyndighet",
    "description": "Søndagsutøver-verdenen undersøker treningsavtaler, personlige rekorder, sammenligning mellom venner, utstyrsterskler, vær og fleksibilitet, kroppssignaler, treningsråd, gruppetempo, treningsdata, uformell konkurranse, tapte uker, comeback, mosjonsarrangementer og rollegrenser. Søndagsutøver er en hobby_identity. Rollen gir ingen automatisk myndighet som trener, behandler, medisinsk fagperson eller profesjonell utøver, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "care_vs_efficiency",
    "status_anxiety",
    "shame_reputation",
    "social_mask",
    "class_power",
    "professional_culture",
    "public_private_leakage",
    "invisible_work"
  ],
  "social_environments": [
    "lokale parker, stier, baner og haller der mosjon skjer uten profesjonelt apparat",
    "vennegrupper der tempo og oppmøte både kan bygge fellesskap og skjult rang",
    "hverdager der trening konkurrerer med søvn, arbeid, familie og andre forpliktelser",
    "digitale treningslogger der data kan støtte vane eller begynne å eie aktiviteten",
    "lokale mosjonsarrangementer med svært ulike mål, kropper og ambisjoner",
    "situasjoner med smerte eller tilbakekomst der hobbyerfaring må skilles fra faglig ansvar"
  ],
  "recurring_people_archetypes": [
    {
      "id": "treningsvennen",
      "social_function": "gjør mosjon til avtale, rutine og sosialt fellesskap uten å eie tempoet",
      "class_position": "likestilt hobbyutøver",
      "status": "stabil treningspartner uten formell myndighet",
      "power_over_player": "kan gjøre oppmøte og fart til sosial plikt",
      "wants": "å holde aktiviteten i gang sammen",
      "conceals": "at egen kontinuitet også er del av selvbildet",
      "speech_style": "praktisk, oppmuntrende og uformell",
      "teaches_player": "at forpliktelse kan være ekte uten å bli tvang"
    },
    {
      "id": "nybegynneren",
      "social_function": "synliggjør terskler rundt tempo, utstyr, råd og gruppetilhørighet",
      "class_position": "ny hobbyutøver",
      "status": "lav erfaringsstatus, full rett til deltakelse",
      "power_over_player": "kan utfordre spillerens vane med å ta egne normer for gitt",
      "wants": "å komme i gang uten å måtte kjøpe eller bevise for mye",
      "conceals": "usikkerhet på om hun er god nok til å delta",
      "speech_style": "spørrende, konkret og åpen",
      "teaches_player": "at erfaring kan deles uten gatekeeping"
    },
    {
      "id": "den_konkurranseglade",
      "social_function": "gjør tider, sammenligning og resultatlister sosialt synlige",
      "class_position": "likestilt mosjonist med sterk prestasjonsorientering",
      "status": "høy uformell prestisje i gruppen, ingen fagmyndighet",
      "power_over_player": "kan gjøre vennskap og trening til kontinuerlig rangering",
      "wants": "målbar framgang og litt konkurranse",
      "conceals": "at egne tall påvirker humøret mer enn ønsket",
      "speech_style": "energisk, tallorientert og ertende",
      "teaches_player": "at konkurranse kan være lek uten å bli sosial rang"
    },
    {
      "id": "arrangoren",
      "social_function": "holder det lokale mosjonsarrangementet praktisk og åpent for ulike nivåer",
      "class_position": "frivillig eller ansatt arrangementsrolle",
      "status": "situasjonsmyndighet for arrangementet, ingen myndighet over spillerens identitet",
      "power_over_player": "kan sette praktiske rammer, startfelt og regler",
      "wants": "trygg og ryddig deltakelse for mange",
      "conceals": "hvor mye usynlig arbeid som ligger bak en enkel løpsdag",
      "speech_style": "tydelig, vennlig og logistisk",
      "teaches_player": "at startnummer er deltakelse, ikke menneskelig rang"
    },
    {
      "id": "naerpersonen",
      "social_function": "viser hvordan treningsvanen møter tid, restitusjon og andre relasjoner",
      "class_position": "nær venn eller partner uten sportsrolle",
      "status": "høy privat relevans, ingen treningsmyndighet",
      "power_over_player": "kan synliggjøre når hobbyen fortrenger resten av livet",
      "wants": "at aktiviteten skal passe inn i et helt liv",
      "conceals": "at irritasjon ofte handler om fravær mer enn om sporten",
      "speech_style": "direkte, hverdagslig og omsorgsfull",
      "teaches_player": "at en god treningsvane må tåle andre forpliktelser"
    },
    {
      "id": "klubbtreneren",
      "social_function": "markerer grensen mellom hobbyerfaring og kvalifisert treneransvar samt behovet for faglig hjelp ved skade",
      "class_position": "trener med faktisk rolle i klubb- eller treningsmiljø",
      "status": "høyere treningsfaglig myndighet i sitt oppdrag, ikke medisinsk behandler",
      "power_over_player": "kan korrigere rolleforvirring og belastningspress",
      "wants": "at mosjonister trener forsvarlig og vet når de trenger annen kompetanse",
      "conceals": "at erfarne mosjonister ofte er vanskeligere å bremse enn nybegynnere",
      "speech_style": "rolig, konkret og grensesettende",
      "teaches_player": "at lang hobbyerfaring ikke automatisk blir profesjonell kompetanse"
    }
  ],
