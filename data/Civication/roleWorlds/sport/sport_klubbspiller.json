  "title": "Klubbspiller",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å delta forpliktende som utøver i en klubbstruktur uten at uttak, spilletid, anciennitet eller medlemskap blir generell sosial rang, trenerautoritet, institusjonell myndighet eller profesjonell status",
    "description": "Klubbspiller er en employment-independent club_participation life-position: spilleren trener og deltar som utøver innenfor en organisert klubbstruktur med faste tider, sportslige roller, uttak, fellesressurser, interne koder og praktisk koordinering. Rollen er mer institusjonelt bundet enn Aktiv utøver alene, men den er ikke automatisk Konkurranseutøver eller Profesjonell utøver. Den er også forskjellig fra Klubbmenneske, som handler om community_identity, frivillig institusjonsliv og drift. Klubbspiller gir ikke i seg selv kapteins-, trener-, styre-, medisinsk- eller talspersonmyndighet."
  },
  "theme_ids": [
    "professional_culture",
    "status_anxiety",
    "shame_reputation",
    "social_mask",
    "class_power",
    "care_vs_efficiency",
    "public_private_leakage",
    "invisible_work"
  ],
  "social_environments": [
    "faste klubbøkter der oppmøte, roller og gruppeinndeling må koordineres over tid",
    "uttak og organisert aktivitet der spilletid eller deltakelse varierer uten å definere menneskeverd",
    "garderobe- og meldingsmiljøer med uskrevne koder, gruppepress og behov for tydelig inkludering",
    "fellesressurser, avgifter og utstyr der økonomi og anciennitet kan bli uformell rang",
    "praktisk kjøring og koordinering der hjelp lett kan gli over i uformell ledelse",
    "situasjoner der klubb-, konkurranse-, kapteins-, trener- og profesjonell status må holdes fra hverandre"
  ],
  "recurring_people_archetypes": [
    {
      "id": "lagkameraten",
      "social_function": "gjør klubbtilhørighet til gjensidig praksis, støtte og sosial sammenligning mellom spillere",
      "class_position": "likestilt klubbspiller uten formell myndighet",
      "status": "høy på nærhet til spillerens liv i gruppa",
      "power_over_player": "kan gjøre spilletid, oppmøte og innsats til sosial rang",
      "wants": "at gruppa fungerer og at forpliktelser oppleves gjensidige",
      "conceals": "at egen plass i gruppa også påvirkes av uttak og anerkjennelse",
      "speech_style": "direkte, lagorientert og uformell",
      "teaches_player": "at lagtilhørighet kan være sterk uten at spillere rangerer hverandres menneskeverd"
    },
    {
      "id": "treneren",
      "social_function": "fordeler sportslige oppgaver, belastning og uttak innenfor en faktisk trenerrolle",
      "class_position": "formell sportslig leder over spillergruppen",
      "status": "høy på sportslig beslutningsmyndighet, avgrenset fra medisinsk og privat myndighet",
      "power_over_player": "kan påvirke uttak, rolle, tilbakemelding og opplevd status",
      "wants": "at spillerne følger et felles sportslig opplegg og utvikler seg",
      "conceals": "at sportslige valg også kan være usikre og situasjonsavhengige",
      "speech_style": "kort, instruktiv og konkret",
      "teaches_player": "å skille legitim trenerautoritet fra egenverdi og andre typer myndighet"
    },
    {
      "id": "laglederen",
      "social_function": "holder praktisk koordinering rundt tider, kjøring og informasjon sammen",
      "class_position": "organisatorisk støttefunksjon uten automatisk trener- eller styremandat",
      "status": "høy på logistikk og praktisk oversikt",
      "power_over_player": "kan gjøre praktiske oppgaver og svarfrister til sosialt press",
      "wants": "at alle vet hvor de skal være og hva som er avtalt",
      "conceals": "at effektiv logistikk lett kan oppfattes som bredere autoritet",
      "speech_style": "presis, planorientert og nøktern",
      "teaches_player": "at praktisk koordinering ikke er det samme som sportslig eller institusjonell ledelse"
    },
    {
      "id": "ny_klubbspiller",
      "social_function": "synliggjør uskrevne koder og terskler som etablerte spillere har sluttet å legge merke til",
      "class_position": "ny spiller med full rett til respekt, men lav lokal erfaring",
      "status": "lav på kjennskap til interne rutiner",
      "power_over_player": "kan avsløre når klubbkulturen har blitt gatekeeping",
      "wants": "å forstå nok til å delta trygt og sosialt uten å late som alt er kjent",
      "conceals": "at usikkerhet ofte skjules for ikke å miste plass eller respekt",
      "speech_style": "spørrende, konkret og forsiktig",
      "teaches_player": "at et inkluderende klubbmiljø må tåle at kodene forklares"
    },
    {
      "id": "material_og_okonomiansvarlig",
      "social_function": "synliggjør hvordan utstyr, avgifter og fellesressurser fordeles uten å gjøre betalingsevne eller anciennitet til rang",
      "class_position": "praktisk klubbfunksjon med avgrenset ressursansvar",
      "status": "høy på oversikt over materielle rammer, ikke på sportslig uttak",
      "power_over_player": "kan påvirke tilgang til utstyr og informasjon om kostnader",
      "wants": "at ressurser brukes ryddig og at økonomiske rammer er forståelige",
      "conceals": "at rutiner som virker nøytrale kan slå ulikt ut sosialt",
      "speech_style": "saklig, detaljorientert og regelbevisst",
      "teaches_player": "at fellesressurser og kostnader må håndteres uten skam eller særrett"
    },
    {
      "id": "rolleavklareren",
      "social_function": "holder Klubbspiller adskilt fra Aktiv utøver, Konkurranseutøver, Klubbmenneske, Profesjonell utøver, kaptein, trener, styre og talsperson",
      "class_position": "metodisk rolleavklarer uten sportslig eller organisatorisk mandat",
      "status": "høy på begreps- og ansvarsavklaring",
      "power_over_player": "kan stoppe statusinflasjon når klubbtilhørighet brukes som generell legitimasjon",
      "wants": "at organisert deltakelse beskrives presist og med respekt for andre roller",
      "conceals": "at samme person kan ha flere klubbroller, men at de fortsatt trenger ulike grunnlag",
      "speech_style": "nøktern, presis og kontrasterende",
      "teaches_player": "at Klubbspiller er en selvstendig deltakelsesrolle, ikke en automatisk tittelstige"
    }
  ],
