  "title": "Profesjonell utøver",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å leve med profesjonell utøverpraksis i et marked av kontrakter, uttak, treningskrav, synlighet og økonomisk risiko uten at life-positionen blandes med konkret Career-ansettelse, generell trener- eller medisinsk myndighet eller automatisk sportsstatus",
    "description": "Profesjonell utøver er en employment-independent professional_practice som beskriver en vedvarende profesjonell idrettspraksis og identitet, mens konkret klubbkontrakt, lønn og stilling fortsatt eies av det separate Career-laget og åpnes gjennom appointment_required career_unlock. Rollen går lenger i markeds-, prestasjons- og tilgjengelighetskrav enn Aktiv utøver og Konkurranseutøver, kan sameksistere med Klubbspiller, men gir ikke automatisk trener- eller medisinsk myndighet og gjør heller ikke spilleren til Landslagsutøver eller Idrettsstjerne."
  },
  "theme_ids": [
    "professional_culture",
    "precarity",
    "status_anxiety",
    "shame_reputation",
    "public_attention",
    "public_private_leakage",
    "loyalty_up_down",
    "care_vs_efficiency",
    "body_discipline",
    "class_power"
  ],
  "social_environments": [
    "profesjonelle prestasjonsmiljøer der life-positionen må skilles fra konkret klubb- eller arbeidsgiveransettelse",
    "kontrakts- og markedsrelasjoner med agent, oppdragsgiver, bonus, overgang og usikker inntekt",
    "trenings- og uttakssituasjoner der trenerautoritet, lagbehov og spillerens egen handlekraft møtes",
    "medisinske og belastningsnære situasjoner der kroppskunnskap må holdes adskilt fra medisinsk fagmyndighet",
    "sponsor- og medieflater der offentlig synlighet møter privatliv, omdømme og kommersielle krav",
    "lagmiljøer og karriereskifter der samarbeid, intern konkurranse og profesjonell identitet fortsetter på tvers av konkrete avtaler"
  ],
  "recurring_people_archetypes": [
    {
      "id": "rolleavklareren",
      "social_function": "holder life-positionen Profesjonell utøver adskilt fra konkret Career-ansettelse, Klubbspiller, Konkurranseutøver, trener, medisinsk rolle og andre sportsstatuser",
      "class_position": "metodisk rolleavklarer uten arbeidsgiver- eller sportslig myndighet",
      "status": "høy på begreps- og systemavklaring",
      "power_over_player": "kan stoppe sammenblanding mellom praksis, kontrakt, status og myndighet",
      "wants": "at profesjonell praksis beskrives presist uten å bli automatisk jobb eller rang",
      "conceals": "at samme person kan ha flere sports- og karriereroller samtidig, men at hver må ha eget grunnlag",
      "speech_style": "nøktern, presis og kontrasterende",
      "teaches_player": "at life-position og career_unlock er separate canonical lag"
    },
    {
      "id": "agenten",
