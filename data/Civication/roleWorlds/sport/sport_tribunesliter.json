  "title": "Tribunesliter",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å leve tett på tribunen over tid og bygge sterk kulturkunnskap, rutine og fellesskap uten at ansiennitet, ståplass, bortereiser eller kodekunnskap blir gatekeeping, lojalitetstest eller uformell arrangements- og sikkerhetsmyndighet",
    "description": "Tribunesliter-verdenen undersøker faste ståplasser, værutholdenhet, sangkultur, bortereiseøkonomi, derbyrivalisering, sikkerhetsbeskjeder, flagg og sikt, nykommertilgang, kulturminner, fysisk slitasje, kollektiv intensitet, supporterfølge i offentlig rom, sesongtretthet og rollegrenser. Tribunesliter er en alternative_life_status. Rollen gir ingen automatisk myndighet som supporterkoordinator, sikkerhetsansvarlig, arrangementsleder, klubbrepresentant eller talsperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "status_anxiety",
    "social_mask",
    "shame_reputation",
    "care_vs_efficiency",
    "professional_culture",
    "public_private_leakage",
    "loyalty_up_down"
  ],
  "social_environments": [
    "ståfelt der faste mønstre, sang og plassering skaper uformelle koder",
    "bortereiser der tid, penger og gruppepress følger supporterlivet utenfor stadion",
    "derbydager der rivalisering, identitet og offentlig omdømme blir ekstra intense",
    "innganger og publikumsflyt der uformell erfaring møter formell sikkerhetsmyndighet",
    "situasjoner der nye gjester prøver å forstå feltets rytme uten å bli testet for tilhørighet",
    "lange sesonger der oppmøte, kropp, økonomi og andre relasjoner trekker i ulike retninger"
  ],
  "recurring_people_archetypes": [
    {
      "id": "feltvennen",
      "social_function": "deler faste rutiner og sosial kontinuitet på tribunen uten å eie plassen eller koden",
      "class_position": "likestilt publikummer med lang erfaring",
      "status": "høy uformell tilhørighet, ingen formell myndighet",
      "power_over_player": "kan gjøre oppmøte, ståplass og utholdenhet til sosial målestokk",
      "wants": "at den kjente gruppa og rytmen på feltet består",
      "conceals": "at egen identitet er blitt tett knyttet til å alltid være der",
      "speech_style": "kort, ertende og praktisk",
      "teaches_player": "at kontinuitet kan være sterk uten å bli adgangskrav"
    },
    {
      "id": "bortekampmakker",
      "social_function": "gjør reise, kostnader og kollektiv gruppestemning konkret",
      "class_position": "erfaren medreisende supporter",
      "status": "høy praktisk reisekunnskap, ingen organisatorisk myndighet",
      "power_over_player": "kan gjøre borteturer til lojalitetstest",
      "wants": "at turene planlegges godt og fortsatt føles som fellesskap",
      "conceals": "hvor mye tid og penger reisevanen faktisk bruker",
      "speech_style": "logistisk, humoristisk og tidsbevisst",
      "teaches_player": "at bortekultur må tåle ulik økonomi og kapasitet"
    },
    {
      "id": "nykommeren",
      "social_function": "synliggjør uformelle koder, terskler og hvem som får tilgang til feltets kultur",
      "class_position": "ny eller sporadisk publikummer",
      "status": "lav kodekunnskap, full rett til egen plass og opplevelse",
      "power_over_player": "kan utfordre veteranens selvbilde som den som kjenner alt",
      "wants": "å forstå nok til å delta uten å måtte bestå en prøve",
      "conceals": "usikkerhet på om feil blir lagt merke til",
      "speech_style": "spørrende, konkret og åpen",
      "teaches_player": "at miljøkunnskap kan deles uten gatekeeping"
    },
    {
      "id": "tribuneveteranen",
      "social_function": "bærer minner, gamle rutiner og kulturell kontinuitet over mange sesonger",
      "class_position": "langvarig supporter uten formelt verv",
      "status": "høy symbolsk status gjennom ansiennitet",
      "power_over_player": "kan definere hva som oppleves som ekte tradisjon",
      "wants": "at historien og egenarten ikke forsvinner",
      "conceals": "at minner også er selektive og påvirket av egen posisjon",
      "speech_style": "anekdotisk, sikker og historiserende",
      "teaches_player": "at lang hukommelse er verdifull uten å være enerett på sannheten"
    },
    {
      "id": "sikkerhetsverten",
      "social_function": "representerer faktisk situasjonsmyndighet for adgang, flyt og sikkerhet",
      "class_position": "ansatt eller oppnevnt vert med avgrenset formell myndighet",
      "status": "høy situert myndighet når sikkerhet og adgang berøres",
      "power_over_player": "kan endre publikumstrøm, gi beskjeder og håndheve arenaens sikkerhetsrammer",
      "wants": "at arrangementet fungerer uten unødvendig konflikt eller risiko",
      "conceals": "at erfarne gjester ofte utfordrer beskjeder med henvisning til hvordan ting pleier å være",
      "speech_style": "kort, tydelig og operativ",
      "teaches_player": "at tribunekunnskap ikke erstatter sikkerhetsansvar"
    },
    {
      "id": "medtilskueren",
      "social_function": "gjør sikt, plass, fysisk belastning og delte publikumsbehov synlige",
      "class_position": "vanlig publikummer med samme grunnleggende adgang som spilleren",
      "status": "ingen særskilt rang",
      "power_over_player": "kan gjøre konsekvensene av gruppens vaner konkrete",
      "wants": "å kunne følge kampen og bruke plassen uten unødvendig press",
      "conceals": "at det kan være vanskelig å si fra i et tett felt",
      "speech_style": "direkte, hverdagslig og situasjonsnær",
      "teaches_player": "at kollektiv kultur også må fungere for enkeltmennesker"
    }
  ],
