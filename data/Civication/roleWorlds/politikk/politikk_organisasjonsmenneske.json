    "label": "Organisasjonsmenneske"
  },
  "title": "Organisasjonsmenneske — struktur, medlemskap og rollegrenser",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å kjenne organisasjonens mennesker, rutiner og maskineri godt uten at fartstid, frivillig arbeid, dokumenttilgang eller uformell innflytelse blir forvekslet med valgt eller profesjonell myndighet",
    "description": "Organisasjonsmenneske-verdenen undersøker vedtekter, medlemsdata, midlertidige grupper, større medlemsmøter, økonomispor, frivillig kapasitet, intern kommunikasjon, samarbeid, taus praksis, intern uenighet, rollefordeling, frister, prosjektansvar og mandatgrenser. Organisasjonsmenneske er en community_identity og levd organisasjonspraksis. Rollen gir ingen automatisk myndighet som valgt representant, valgt styremedlem, profesjonell organisasjonsmedarbeider eller offentlig beslutningstaker, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "professional_culture",
    "bureaucratic_power",
    "loyalty_up_down",
    "care_vs_efficiency",
    "invisible_work",
    "local_knowledge_vs_system",
    "social_mask",
    "shame_reputation"
  ],
  "social_environments": [
    "medlemsmøter og større samlinger der dokumenter, frister og roller avgjør hvor reell deltakelsen blir",
    "arbeidsgrupper og prosjekter der midlertidige mandater kan bli varige uten at strukturen oppdateres",
    "medlems- og kontaktarbeid der praktiske behov må avgrenses mot unødvendig datainnsamling",
    "økonomi- og dokumentasjonsarbeid der små unntak kan bli til faste, usynlige rutiner",
    "interne samtaler og konflikter der sak, person, avsender og offentlighet må holdes fra hverandre",
    "samarbeid med andre aktører der godt forhold ikke opphever behovet for avklart ansvar"
  ],
  "recurring_people_archetypes": [
    {
      "id": "styresekretaeren",
      "social_function": "gjør vedtekter, referater og tidligere beslutninger tilgjengelige når organisasjonen må skille regel fra vane",
      "class_position": "frivillig eller valgt dokumentasjonsrolle med avgrenset ansvar, ikke generell beslutningsmyndighet",
      "status": "høy praktisk betydning fordi institusjonelt minne ofte går gjennom dokumentene",
      "power_over_player": "kan gjøre en rutine sporbar eller la taus praksis fortsette som om den var vedtatt",
      "wants": "at beslutninger, ansvar og versjoner skal kunne finnes igjen",
      "conceals": "at dokumentasjon alltid er et utvalg av det som faktisk skjedde",
      "speech_style": "presis, rolig og opptatt av formuleringer og datoer",
      "teaches_player": "at organisasjonshukommelse bør kunne deles og etterprøves"
    },
    {
      "id": "erfaren_frivillig",
      "social_function": "bærer taus kunnskap om mennesker, rutiner og hva som pleier å fungere",
      "class_position": "langvarig frivillig uten automatisk valgt eller profesjonelt mandat",
      "status": "høy uformell autoritet gjennom fartstid og pålitelighet",
      "power_over_player": "kan sette norm for arbeidsmengde, språk og hva som regnes som realistisk",
      "wants": "at organisasjonen leverer uten å bruke all tid på prosedyre",
      "conceals": "at egen kapasitet lett blir gjort til målestokk for andre",
      "speech_style": "praktisk, erfaringsbasert og lite imponert av unødvendig omvei",
      "teaches_player": "at erfaring bør bli delbar kunnskap fremfor usynlig makt"
    },
    {
      "id": "nytt_medlem",
      "social_function": "viser om organisasjonens innganger, språk og prosesser faktisk er forståelige uten gammel historikk",
      "class_position": "nytt medlem med lav uformell status og samme grunnleggende behov for forståelig prosess",
      "status": "avhengig av hvor mye organisasjonen forklarer eksplisitt",
      "power_over_player": "kan avdekke hvilke rutiner som bare fungerer for de innvidde",
      "wants": "å forstå hvordan man deltar uten å måtte gjette kodene",
      "conceals": "at usikkerhet ofte skjules når andre virker samkjørte",
      "speech_style": "konkret, spørrende og forsiktig med å anta",
      "teaches_player": "at medlemskap blir reelt først når inngangen til deltakelse er lesbar"
    },
    {
      "id": "kassereren",
      "social_function": "gjør økonomiske rutiner, utlegg og ressursgrenser konkrete",
      "class_position": "avgrenset økonomiansvar innen organisasjonen, uten å eie organisasjonens penger personlig",
      "status": "situert autoritet over dokumentasjon og økonomiflyt",
      "power_over_player": "kan be om grunnlag, stoppe ufullstendige utlegg og synliggjøre hva ressursene faktisk tåler",
      "wants": "at penger kan spores uten at små oppgaver blir unødvendig tunge",
      "conceals": "at forenkling av små beløp kan bygge opp store blindsoner over tid",
      "speech_style": "nøktern, tallnær og opptatt av bilag og ansvar",
      "teaches_player": "at økonomisk tillit blir sterkere når den kan etterprøves"
    },
    {
      "id": "prosjektansvarlig",
      "social_function": "representerer midlertidige satsinger som trenger tydelig mandat, leveranse og sluttdato",
      "class_position": "oppgaveansvarlig innen et konkret prosjekt, ikke permanent organisasjonsledelse",
      "status": "høy handlingskraft så lenge prosjektmandatet er aktivt",
      "power_over_player": "kan definere tempo, arbeidsdeling og hva prosjektet mener det trenger",
      "wants": "å få prosjektet ferdig uten å miste retning i intern koordinering",
      "conceals": "at et vellykket prosjekt lett begynner å behandle egen fortsettelse som selvsagt",
      "speech_style": "målrettet, løsningsorientert og leveransefokusert",
      "teaches_player": "at prosjektmakt trenger tydelig start, slutt og mottaker"
    },
    {
      "id": "ekstern_samarbeidspartner",
      "social_function": "viser hvordan samarbeid kan gi ressurser og rekkevidde samtidig som ansvar må forbli avgrenset",
      "class_position": "selvstendig aktør med eget mandat og egne interesser",
      "status": "kan være viktig for gjennomføring uten å være del av organisasjonens interne styring",
      "power_over_player": "kan utvide eller begrense hva som praktisk lar seg gjøre",
      "wants": "et samarbeid der oppgaver og forventninger er forståelige",
      "conceals": "at gode relasjoner også kan gjøre nye forpliktelser vanskeligere å si nei til",
      "speech_style": "konkret, vennlig og opptatt av hvem som gjør hva",
      "teaches_player": "at samarbeid fungerer bedre når partene ikke later som de er samme organisasjon"
    }
  ],
  "slow_axes": [
    {
      "id": "rule_vs_memory",
      "meaning": "om organisasjonen skiller gjeldende regel fra det folk husker at man pleier å gjøre",
      "runtime_binding": "editorial_only_until_governed"
    },
    {
      "id": "structure_vs_informal_power",
      "meaning": "om arbeidsgrupper, fartstid og relasjoner får tydelige grenser mot formell rollefordeling",
      "runtime_binding": "editorial_only_until_governed"
    },
    {
      "id": "trust_vs_traceability",
      "meaning": "om tillit i økonomi, dokumentasjon og medlemsarbeid styrkes av et enkelt etterprøvbart spor",
      "runtime_binding": "editorial_only_until_governed"
    },
    {
      "id": "commitment_vs_capacity",
      "meaning": "om organisasjonen planlegger etter faktisk frivillig kapasitet fremfor å bruke de mest tilgjengelige som permanent reserve",
      "runtime_binding": "editorial_only_until_governed"
    },
    {
      "id": "internal_vs_public",
      "meaning": "om interne arbeidsrom og personlige ytringer holdes adskilt fra organisasjonens formelle avsender",
      "runtime_binding": "editorial_only_until_governed"
    },
    {
      "id": "cooperation_vs_scope",
      "meaning": "om samarbeid og prosjekter beholder synlige ansvars- og beslutningsgrenser når aktiviteten vokser",
      "runtime_binding": "editorial_only_until_governed"
    },
    {
      "id": "practice_vs_formal_authority",
      "meaning": "om omfattende organisasjonserfaring holdes tydelig adskilt fra valgt, ansatt og offentlig myndighet",
      "runtime_binding": "editorial_only_until_governed"
    }
  ],
