  },
  "title": "Kampanjemenneske — organisering, dokumentasjon og rollegrenser",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å få en kampanje til å fungere praktisk og offentlig uten at tempo, synlighet, data, ressurser eller uformell tillit gjør prosessgrenser usynlige eller frivillig erfaring til formelt mandat",
    "description": "Kampanjemenneske-verdenen undersøker kontaktdata, tidsplaner, faktagrunnlag, bildebruk, arbeidsfordeling, tydelig avsender, mediekontakt, støtte og bindinger, referater, arrangementsroller, dataminimering, korreksjoner, samarbeid og grensen mot formelt mandat. Kampanjemenneske er en practice_identity og selvvalgt organisasjonspraksis. Rollen gir ingen automatisk myndighet som valgt representant, profesjonell politisk rådgiver, offentlig saksbehandler eller beslutningstaker, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "professional_culture",
    "bureaucratic_power",
    "public_attention",
    "loyalty_up_down",
    "shame_reputation",
    "social_mask",
    "care_vs_efficiency",
    "local_knowledge_vs_system"
  ],
  "social_environments": [
    "arbeidsmøter og digitale tavler der oppgaver, kapasitet og ansvar må bli konkrete nok til at frivillig arbeid faktisk kan fordeles",
    "kontaktlister, skjemaer og kartverktøy der praktisk organisering raskt kan samle mer personinformasjon enn den trenger",
    "materiell- og dokumentarbeid der korte formuleringer må holdes innenfor det faktagrunnlaget som faktisk finnes",
    "frivillige arbeidsøkter og arrangementer der intern deltakelse, offentlig eksponering og praktiske roller ikke alltid er det samme",
    "mediekontakt og offentlige prosesser der talerolle, avsender og mandat blir mer synlig enn i interne samtaler",
    "samarbeid med eksterne aktører der støtte, ressurser og felles aktivitet kan skape forventninger som må avgrenses"
  ],
  "recurring_people_archetypes": [
    {
      "id": "koordineringsvenn",
      "social_function": "deler planlegging og gjør tidsbruk, oppgavefordeling og interne forventninger synlige",
      "class_position": "likestilt frivillig deltaker uten formelt mandat",
      "status": "høy praktisk betydning når mange små oppgaver skal henge sammen",
      "power_over_player": "kan forsterke tempo og gjennomføringspress eller bidra til realistiske grenser",
      "wants": "at arbeidet faktisk blir gjort uten kaos",
      "conceals": "at egen tilgjengelighet lett blir gjort til standard for andre",
      "speech_style": "kort, praktisk og opptatt av neste leveranse",
      "teaches_player": "at kapasitet og ansvar må designes, ikke bare antas"
    },
    {
      "id": "erfaren_kampanjedeltaker",
      "social_function": "representerer uformell prosesskompetanse om materiell, arrangementer og koordinering",
      "class_position": "erfaren frivillig uten automatisk valgt eller profesjonelt mandat",
      "status": "høy uformell autoritet fordi vedkommende kjenner rutiner og fallgruver",
      "power_over_player": "kan definere hva som oppfattes som normal arbeidsform og nødvendig tempo",
      "wants": "ryddig gjennomføring og få overraskelser",
      "conceals": "at rutine også kan gjøre gamle arbeidsmåter vanskeligere å utfordre",
      "speech_style": "effektiv, erfaringsbasert og prosessorientert",
      "teaches_player": "at erfaring bør oversettes til begrunnelser og delbar kunnskap"
    },
    {
      "id": "ny_frivillig",
      "social_function": "gjør informasjonsbehov, arbeidsterskler og forventningspress synlig fra perspektivet til en ny deltaker",
      "class_position": "ny frivillig med lav uformell status og ingen myndighet",
      "status": "avhengig av om oppgaver og grenser faktisk forklares",
      "power_over_player": "kan vise om kampanjen er forståelig uten taus forkunnskap",
      "wants": "en tydelig oppgave og rett til å si nei uten sosial kostnad",
      "conceals": "at usikkerhet ofte skjules når alle andre virker travle",
      "speech_style": "konkret, spørrende og forsiktig med å forstyrre",
      "teaches_player": "at åpen deltakelse krever mer enn en invitasjon"
    },
    {
      "id": "dokumentasjonsansvarlig",
      "social_function": "gjør kildegrunnlag, referater, korreksjoner og sporbarhet til konkrete arbeidsoppgaver",
      "class_position": "frivillig eller medarbeider med avgrenset dokumentansvar, ikke offentlig myndighet",
      "status": "situert autoritet over arbeidsflyt og dokumentversjoner",
      "power_over_player": "kan stoppe materiale som mangler grunnlag eller kreve synlig korreksjon",
      "wants": "at det som publiseres kan forstås og etterprøves i ettertid",
      "conceals": "at streng dokumentasjon også koster tid når tempoet er høyt",
      "speech_style": "presis, kildeorientert og lite imponert av formuleringer uten grunnlag",
      "teaches_player": "at kampanjearbeid blir mer robust når feil kan finnes og rettes"
    },
    {
      "id": "praktisk_samarbeidspartner",
      "social_function": "representerer eksterne aktører som kan bidra med lokaler, trykk, logistikk eller felles aktivitet",
      "class_position": "selvstendig lokal aktør med egne interesser og eget mandat",
      "status": "kan ha ressurser kampanjen mangler uten å være del av kampanjen",
      "power_over_player": "kan endre hva som er praktisk mulig og skape forventninger om gjensidighet",
      "wants": "et avklart samarbeid med tydelig rolle og begrensning",
      "conceals": "at også praktisk støtte kan påvirke relasjoner og forventninger",
      "speech_style": "konkret, løsningsorientert og opptatt av hvem som gjør hva",
      "teaches_player": "at ressurser og samarbeid trenger eksplisitte grenser"
    },
    {
      "id": "offentlig_kontaktperson",
      "social_function": "gjør skillet mellom frivillig kampanjearbeid og formell offentlig prosess synlig",
      "class_position": "saksbehandler eller annen offentlig kontakt med avgrenset mandat",
      "status": "formell autoritet innen egen prosess, men ikke over kampanjens interne standpunkter",
      "power_over_player": "kan forklare hvilke opplysninger, frister eller formater som faktisk inngår i en offentlig prosess",
      "wants": "presise innspill og tydelig avsender",
      "conceals": "at institusjonelle formater ikke alltid fanger hele bredden i frivillig arbeid",
      "speech_style": "saklig, rolleavgrenset og prosessorientert",
      "teaches_player": "at tilgang til en offentlig kanal ikke er det samme som beslutningsmyndighet"
    }
  ],
  "slow_axes": [
