    "label": "Møtesliter"
  },
  "title": "Møtesliter — møtekultur, ansvar og mandatgrenser",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å delta mye og kjenne møtemaskineriet godt uten at rutine, taletid, dokumentasjon, tidsnød eller uformell innflytelse blir forvekslet med formelt mandat",
    "description": "Møtesliter-verdenen undersøker sakslister, sent underlag, taletid, habilitet, referater, ansvar, digital tilgang, nye stemmer, tidsbelastning, delegasjon, eksterne innspill, hastesaker, oppfølging og grensen mot formelt mandat. Møtesliter er en community_identity og levd møtepraksis. Rollen gir ingen automatisk myndighet som valgt representant, delegert beslutningstaker, profesjonell politisk rådgiver eller offentlig saksbehandler, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "bureaucratic_power",
    "professional_culture",
    "loyalty_up_down",
    "care_vs_efficiency",
    "social_mask",
    "shame_reputation",
    "local_knowledge_vs_system",
    "public_attention"
  ],
  "social_environments": [
    "ordinære møter der agenda, tid og taleliste fordeler oppmerksomhet mellom saker og deltakere",
    "saksforberedelse der dokumenter, frister og tidligere vedtak avgjør hvem som rekker å forstå hva før møtet",
    "små organisasjonsmiljøer der nære relasjoner og lang historikk gjør habilitet og rolleavklaring konkret",
    "referat- og oppfølgingsarbeid der formuleringer, ansvar og frister avgjør hva som faktisk overlever etter møtet",
    "digitale og hybride møter der teknisk tilgang blir en del av deltakelsesbetingelsene",
    "arbeidsutvalg og uformelle mellomrom der forberedelse kan gli over i beslutning dersom mandatet ikke er synlig"
  ],
  "recurring_people_archetypes": [
    {
      "id": "motelederen",
      "social_function": "holder agenda, taleliste og prosedyre synlig når møtet presses av tid eller vane",
      "class_position": "valgt eller utpekt møteleder innen et avgrenset møte, ikke generell politisk myndighet",
      "status": "situert prosessautoritet mens møtet pågår",
      "power_over_player": "kan gi og avgrense taletid, tolke agenda og foreslå prosessuelle grep innen mandatet",
      "wants": "et møte som kommer gjennom sakene uten at prosedyren blir usynlig",
      "conceals": "at effektivitet lett kan bli likestilt med få innvendinger",
      "speech_style": "strukturert, tidsbevisst og opptatt av neste punkt",
      "teaches_player": "at møteledelse er prosessmakt og derfor må være avgrenset"
    },
    {
      "id": "referenten",
      "social_function": "gjør beslutninger, uenighet, ansvar og oppfølging etterprøvbart i ettertid",
      "class_position": "dokumentasjonsrolle med ansvar for referat, ikke beslutningsmyndighet",
      "status": "lav synlighet i rommet, høy betydning for institusjonelt minne",
      "power_over_player": "kan forme hva som blir stående som møtehistorikk dersom formuleringene ikke kontrolleres",
      "wants": "et kort referat som fortsatt er presist nok til å brukes senere",
      "conceals": "at forenkling ofte flytter makt fra samtalen til teksten",
      "speech_style": "presis, oppsummerende og opptatt av formuleringer",
      "teaches_player": "at referatet er en del av styringen, ikke bare et etterarbeid"
    },
    {
      "id": "erfaren_deltaker",
      "social_function": "bærer taus kunnskap om tidligere saker, rutiner og uformelle arbeidsmåter",
      "class_position": "langvarig deltaker uten automatisk valgt eller delegert mandat",
      "status": "høy uformell autoritet fordi vedkommende kjenner historikken",
      "power_over_player": "kan definere hva som oppfattes som vanlig, realistisk eller allerede avklart",
      "wants": "at møtet ikke bruker tid på å gjenoppfinne gamle avklaringer",
      "conceals": "at egen rutine kan gjøre nye stemmer mindre synlige",
      "speech_style": "rask, refererende og trygg på historikken",
      "teaches_player": "at erfaring bør oversettes til delbar kontekst fremfor å bli skjult beslutningsmakt"
    },
    {
      "id": "ny_deltaker",
      "social_function": "viser om språk, dokumenter og taleregler faktisk er forståelige uten tidligere medlemskap",
      "class_position": "ny deltaker med lav uformell status og samme grunnleggende rett til forståelig prosess",
      "status": "avhengig av om andre gjør møtekoden eksplisitt",
      "power_over_player": "kan avdekke hvilke deler av møtekulturen som bare fungerer for de innvidde",
      "wants": "å forstå saken godt nok til å kunne delta uten å late som",
      "conceals": "at usikkerhet ofte skjules når møtet går fort",
      "speech_style": "spørrende, konkret og tilbakeholden med å avbryte",
      "teaches_player": "at inkludering må designes i selve møteformen"
    },
    {
      "id": "sakseier",
      "social_function": "bringer inn underlag, frister og ønsket beslutning for én konkret sak",
      "class_position": "ansvarlig for saksforberedelse innen et avgrenset område",
      "status": "høy informasjonsmakt i egen sak, men ikke enerett til konklusjonen",
      "power_over_player": "kan styre oppmerksomhet gjennom hvilket underlag som kommer når og hvordan alternativer presenteres",
      "wants": "en avklaring som gjør at saken kan gå videre",
      "conceals": "at egen tidsplan kan oppleves som hele gruppens frist",
      "speech_style": "saklig, målrettet og ofte tidspresset",
      "teaches_player": "at god saksbehandling krever mer enn at et dokument finnes"
    },
    {
      "id": "ekstern_innspiller",
      "social_function": "representerer personer eller miljøer som ber møtet ta inn informasjon uten å være del av den interne beslutningsprosessen",
      "class_position": "utenfor møtets formelle rollefordeling, med legitim mulighet til å gi innspill der prosessen åpner for det",
      "status": "kan ha viktig lokal kunnskap uten intern beslutningsmyndighet",
      "power_over_player": "kan endre hva deltakerne vet og hvilke hensyn som blir synlige",
      "wants": "at innspillet faktisk blir lest og behandlet på en forståelig måte",
      "conceals": "at også gode innspill kan presse agenda og tidsbruk",
      "speech_style": "konkret, erfaringsbasert og opptatt av respons",
      "teaches_player": "at åpenhet krever en sporbar vei fra innspill til behandling"
    }
  ],
