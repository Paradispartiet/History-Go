    {
      "id": "access_vs_inclusion",
      "meaning": "om møteform, språk, tidspunkt og oppfølging faktisk gjør flere i stand til å delta",
      "runtime_binding": "editorial_only_until_governed"
    },
    {
      "id": "local_knowledge_vs_informal_power",
      "meaning": "om stedskunnskap brukes som kilde uten å bli uformell beslutningsfullmakt",
      "runtime_binding": "editorial_only_until_governed"
    },
    {
      "id": "resources_vs_independence",
      "meaning": "om penger, praktisk støtte og institusjonell tilgang håndteres med synlige bindinger og avgrenset rolle",
      "runtime_binding": "editorial_only_until_governed"
    },
    {
      "id": "publicity_vs_spokesperson_scope",
      "meaning": "om offentlig synlighet holdes adskilt fra retten til å tale på vegne av andre",
      "runtime_binding": "editorial_only_until_governed"
    },
    {
      "id": "commitment_vs_capacity",
      "meaning": "om frivillig arbeid fordeles slik at ansvar og belastning er synlig og mulig å endre",
      "runtime_binding": "editorial_only_until_governed"
    },
    {
      "id": "practice_vs_formal_mandate",
      "meaning": "om omfattende lokal organisasjonserfaring holdes tydelig adskilt fra valgt, rådgivende og offentlig myndighet",
      "runtime_binding": "editorial_only_until_governed"
    }
  ],
