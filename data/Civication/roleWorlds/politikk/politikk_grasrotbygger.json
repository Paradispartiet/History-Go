    "badge_id": "politikk",
    "id": "grasrotbygger",
    "label": "Grasrotbygger"
  },
  "title": "Grasrotbygger — deltakelse, representasjon og lokalt mandat",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å gjøre lokalt engasjement mer handlingsdyktig uten at aktive nettverk, møtevaner, synlighet, data eller institusjonell tilgang blir forvekslet med bred representasjon eller formelt mandat",
    "description": "Grasrotbygger-verdenen undersøker kontaktlister, representasjon, deltakelsesterskler, lokal erfaring, gruppeidentitet, agendaoversettelse, taleroller, finansiering, dokumentert uenighet, koalisjoner, kontaktdata, frivilligkapasitet, institusjonell tilgang og grensen mot formelt mandat. Grasrotbygger er en practice_identity og selvvalgt organisasjons- og deltakelsespraksis. Rollen gir ingen automatisk myndighet som valgt representant, politisk rådgiver, offentlig saksbehandler eller beslutningstaker, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "bureaucratic_power",
    "public_attention",
    "class_power",
    "loyalty_up_down",
    "shame_reputation",
    "social_mask",
    "care_vs_efficiency"
  ],
  "social_environments": [
    "nabolagsmøter og lokale arbeidsgrupper der sak, deltakelse og praktiske oppgaver må skilles fra påstander om representasjon",
    "gruppechatter og kontaktflater der synlige deltakere lett kan oppfattes som hele lokalmiljøet",
    "referat- og dokumentarbeid der den som oppsummerer også påvirker hva som blir stående",
    "frivillige arbeidsøkter der kapasitet og uformell status former hvem som faktisk får ansvar",
    "mediekontakt og offentlige møter der talerolle og mandat blir mer synlig enn i den interne gruppen",
    "samarbeid med andre lokale grupper og institusjoner der tilgang, finansiering og koalisjoner kan tolkes bredere enn de er"
  ],
  "recurring_people_archetypes": [
    {
      "id": "nabo_og_medarrangor",
      "social_function": "deler lokalt arbeid og gjør representasjon, tempo og uformelle beslutninger synlige",
      "class_position": "likestilt lokal deltaker uten formelt mandat",
      "status": "høy relasjonell betydning i hverdagsorganiseringen",
      "power_over_player": "kan legitimere eller utfordre hvordan gruppen beskriver hvem den representerer",
      "wants": "konkret framdrift og et initiativ som folk kjenner seg igjen i",
      "conceals": "at egen sosiale krets ofte oppleves mer representativ enn den er",
      "speech_style": "praktisk, lokal og løsningsorientert",
      "teaches_player": "at lokal nærhet gir kunnskap, men ikke automatisk bred representasjon"
    },
    {
      "id": "erfaren_frivillig",
      "social_function": "representerer organisasjonserfaring som kan bli læring eller uformell gatekeeping",
      "class_position": "erfaren frivillig uten automatisk valgt eller profesjonelt mandat",
      "status": "høy uformell autoritet i møte- og arbeidsflyt",
      "power_over_player": "kan definere hva som anses realistisk, hvem som bør kontaktes og hvordan møter pleier å foregå",
      "wants": "forutsigbar struktur og at arbeid faktisk blir gjort",
      "conceals": "at vaner fra tidligere grupper ikke alltid passer nye deltakere eller ny sak",
      "speech_style": "kortfattet, prosessorientert og vant til referater og oppgavelister",
      "teaches_player": "at erfaring bør gjøres etterprøvbar og delbar fremfor å bli skjult makt"
    },
    {
      "id": "ny_deltaker",
      "social_function": "gjør språk, møtekultur, tidspunkt og sosiale terskler synlige fra perspektivet til en som nettopp har kommet inn",
      "class_position": "ny deltaker med lav uformell status og ingen formell myndighet",
      "status": "avhengig av om gruppen faktisk gir rom for spørsmål og alternative former for deltakelse",
      "power_over_player": "kan speile om gruppens åpenhet fungerer i praksis",
      "wants": "å forstå saken og bidra uten å måtte kjenne alle kodene på forhånd",
      "conceals": "at usikkerhet ofte ser ut som stillhet i møter",
      "speech_style": "spørrende, konkret og varsom med å avbryte etablerte deltakere",
      "teaches_player": "at deltakelse må designes, ikke bare annonseres"
    },
    {
      "id": "kritisk_lokal_deltaker",
      "social_function": "representerer legitim uenighet innen samme lokale offentlighet",
      "class_position": "lokal deltaker uten plikt til å støtte initiativet",
      "status": "kan ha lav status internt og høy troverdighet hos andre berørte",
      "power_over_player": "kan utfordre påstander om enighet, representasjon og konsekvenser",
      "wants": "at motforestillinger og alternative erfaringer ikke forsvinner i gruppens egen fortelling",
      "conceals": "at motstand også kan være preget av egne interesser eller tidligere konflikter",
      "speech_style": "presis, skeptisk og opptatt av hva gruppen faktisk kan dokumentere",
      "teaches_player": "at motstand ikke gjør noen mindre berørt eller mindre legitim deltaker"
    },
    {
      "id": "kommunal_kontakt",
      "social_function": "gjør skillet mellom innspill, administrativ behandling og formell beslutning tydelig",
      "class_position": "offentlig ansatt eller møtevert med situert rolle og avgrenset mandat",
      "status": "høy institusjonell autoritet innen eget saksområde, men ikke som garantist for utfallet",
      "power_over_player": "kan forklare prosess, frister og hva slags dokumentasjon som faktisk kan behandles",
      "wants": "forståelige innspill, tydelig avsender og realistisk rolleforståelse",
      "conceals": "at institusjonelle prosesser kan være mer oppdelte og langsomme enn lokale aktører forventer",
      "speech_style": "prosessorientert, presis og tydelig på hva møtet ikke beslutter",
      "teaches_player": "at tilgang til en prosess ikke er det samme som beslutningsmyndighet"
    },
    {
      "id": "lokal_journalist",
      "social_function": "gjør offentlig synlighet og talerolle konkret når gruppens budskap møter et bredere publikum",
      "class_position": "uavhengig formidler uten mandat til å representere initiativet",
      "status": "høy oppmerksomhetsmakt, men ingen intern beslutningsmyndighet",
      "power_over_player": "kan gjøre én formulering til den mest synlige beskrivelsen av gruppen",
      "wants": "tydelige sitater, konkrete konflikter og forståelig avsender",
      "conceals": "at korte formater alltid velger bort deler av intern kompleksitet",
      "speech_style": "direkte, tidsbevisst og opptatt av hvem som faktisk kan uttale seg",
      "teaches_player": "at offentlighet forstørrer behovet for klare representasjonsgrenser"
    }
  ],
  "slow_axes": [
    {
      "id": "participation_vs_representation",
      "meaning": "om aktiv deltakelse beskrives presist uten å gjøres til universelt mandat for alle berørte",
      "runtime_binding": "editorial_only_until_governed"
