    {
      "id": "hverdagsvennen",
      "social_function": "viser hvor signaler, friksjon og praktiske omgivelser påvirker om en vane faktisk starter",
      "class_position": "likestilt venn uten profesjonell rolle",
      "status": "troverdig gjennom konkret kjennskap til spillerens rutiner",
      "power_over_player": "kan flytte forklaringen fra viljestyrke til hvordan hverdagen er rigget",
      "wants": "at ønsket atferd skal kreve mindre unødvendig kamp",
      "conceals": "at bekvemmelighet ikke alltid er det samme som verdi",
      "speech_style": "direkte, praktisk og lite interessert i store løfter",
      "teaches_player": "at miljødesign ofte er mer stabilt enn motivasjon"
