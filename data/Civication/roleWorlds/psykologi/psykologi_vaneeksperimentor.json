    {
      "id": "kontekstvennen",
      "social_function": "holder reise, arbeidspress, sted og samtidige endringer synlige når en rutine vurderes",
      "class_position": "nær deltaker med hverdagskunnskap, uten fagmyndighet",
      "status": "lav formell status men høy kunnskap om hva som faktisk var annerledes",
      "power_over_player": "kan vise at samme rutine ikke møter samme betingelser hver uke",
      "wants": "at forsøk tolkes i den hverdagen de faktisk skjer i",
