  "title": "Vaneeksperimentør",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å teste små endringer i egen hverdag uten å forveksle korte oppturer, lett målbare signaler eller egen erfaring med stabile årsaker og generelle regler",
    "description": "Vaneeksperimentør-verdenen undersøker baseline, én endring om gangen, målvalg, kortvarige oppturer, kontekst, praktisk friksjon, enkeltbrudd, nyhetseffekt, belønning, startsignaler, flyttede suksesskriterier, samtidige endringer, generalisering og rollegrenser. Vaneeksperimentør er en practice_identity og selvvalgt hverdagspraksis. Rollen gir ingen automatisk myndighet som psykolog, terapeut, behandler, diagnostiker, forsker eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "numerical_control",
    "local_knowledge_vs_system",
    "care_vs_efficiency",
    "status_anxiety",
    "body_discipline",
    "professional_culture",
    "public_private_leakage",
    "alienation"
  ],
  "social_environments": [
    "private loggbøker og apper der en enkel baseline kan sammenlignes med senere dager",
    "hverdagsrutiner der flere samtidige endringer gjør årsaken uklar",
    "reise, frister og skiftende omgivelser som tester hvor situasjonsbundet en vane er",
    "hjem og arbeidsplass der friksjon, tilgjengelighet og startsignaler former hva som faktisk skjer",
    "vennesamtaler der et personlig resultat frister til å bli en generell anbefaling",
    "situasjoner der hverdagspraksis må holdes tydelig adskilt fra behandling og klinisk vurdering"
  ],
  "recurring_people_archetypes": [
    {
      "id": "loggvennen",
      "social_function": "holder før-bilder, målinger og samtidige notater synlige når resultatet ellers vurderes fra minnet",
