      "status": "uformell troverdighet gjennom praktisk problemløsning",
      "power_over_player": "kan utfordre planer som er for store til å overleve hverdagen",
      "wants": "at første steg skal være enkelt nok til å faktisk bli gjort",
      "conceals": "at forenkling også kan fjerne deler av målet",
      "speech_style": "praktisk, kort og orientert mot neste konkrete handling",
      "teaches_player": "at færre samtidige endringer gir tydeligere læring"
    },
    {
      "id": "tallvennen",
      "social_function": "gjør måling attraktiv og synliggjør både nytten og faren ved å optimalisere for det lett målbare",
      "class_position": "interessert privat deltaker uten analysemandat",
      "status": "høy når data kan vises i en ryddig graf",
      "power_over_player": "kan flytte fokus fra målet til målemetoden",
      "wants": "et enkelt signal på om noe endrer seg",
      "conceals": "at valg av indikator bestemmer hva som ser ut som fremgang",
