  "life_position_ref": {
    "badge_id": "psykologi",
    "id": "monsterjeger",
    "label": "Mønsterjeger"
  },
  "title": "Mønsterjeger — observasjon, kontekst og usikkerhet",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å legge merke til gjentakelser uten å gjøre få hendelser, pene kurver, minner eller sosiale merkelapper om til sikre forklaringer på mennesker",
    "description": "Mønsterjeger-verdenen undersøker gjentakelse, moteksempler, uvanlige perioder, handling versus motiv, identitetsmerkelapper, tidsrekkefølge, telling, minne, kontekst, konkurrerende mønstre, alternative forklaringer, deling av observasjoner, revisjon og rollegrenser. Mønsterjeger er en practice_identity og selvvalgt observasjonspraksis. Rollen gir ingen automatisk myndighet som psykolog, behandler, diagnostiker, forsker eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "numerical_control",
    "local_knowledge_vs_system",
    "social_mask",
    "shame_reputation",
    "status_anxiety",
    "care_vs_efficiency",
    "alienation",
    "public_private_leakage"
  ],
  "social_environments": [
    "hverdagsnotater der små gjentakelser kan sammenlignes med dager og situasjoner der de uteblir",
    "vennesamtaler der en foreløpig forklaring kan bli utfordret uten at observasjonen må forkastes",
    "digitale oversikter og tellinger der det målbare lett får mer oppmerksomhet enn sammenhengen rundt",
    "situasjoner der en vane hos en annen person risikerer å bli en bred identitetsmerkelapp",
    "skiftende steder, grupper og tidspunkter som gjør grensene for et mønster synlige",
    "private refleksjoner der gamle konklusjoner må kunne revideres når nye observasjoner peker en annen vei"
  ],
  "recurring_people_archetypes": [
    {
      "id": "notatvennen",
      "social_function": "deler hverdagsnotater og gjør det mulig å sammenligne minner med det som faktisk ble skrevet ned",
      "class_position": "likestilt privat deltaker uten faglig eller klinisk mandat",
      "status": "troverdig gjennom konsistent notatpraksis, ikke gjennom profesjonstittel",
      "power_over_player": "kan styrke eller utfordre spillerens fortelling ved å vise samtidige eksempler og moteksempler",
      "wants": "at mønstre beskrives konkret nok til å kunne endres når nye hendelser kommer",
      "conceals": "at også systematiske notater velger hva som får oppmerksomhet",
      "speech_style": "konkret, lavmælt og opptatt av datoer og situasjoner",
      "teaches_player": "at samtidige notater kan korrigere et senere, ryddigere minne"
    },
    {
      "id": "skeptisk_venn",
      "social_function": "ber om moteksempler og alternative forklaringer når én historie blir for sikker",
      "class_position": "venn eller bekjent uten behandler- eller ekspertrolle",
      "status": "uformell troverdighet fordi vedkommende tåler å være den som spør en gang til",
      "power_over_player": "kan bremse raske konklusjoner og gjøre usikkerhet sosialt akseptabel",
      "wants": "at spilleren skiller godt spørsmål fra ferdig forklaring",
      "conceals": "at skepsis også kan bli en vane som undervurderer reelle gjentakelser",
      "speech_style": "kort, spørrende og lite imponert av pene historier",
      "teaches_player": "at et mønster blir mer nyttig når det overlever gode motspørsmål"
    },
    {
      "id": "personen_det_gjelder",
      "social_function": "viser forskjellen mellom å observere en handling og å definere personen som bærer den",
      "class_position": "privat person med førstehåndskunnskap om egen situasjon, uten plikt til å godta spillerens tolkning",
      "status": "høy relevans for kontekst, men ikke automatisk fasit på alle årsaksforhold",
      "power_over_player": "kan korrigere feil kontekst og sette grenser for hvordan private observasjoner deles",
      "wants": "å bli møtt som mer enn et mønster eller en merkelapp",
      "conceals": "at også egen forklaring kan endre seg med tid og situasjon",
      "speech_style": "direkte, personlig og opptatt av hva som faktisk ble sagt eller gjort",
      "teaches_player": "at mønstre om andre krever både avgrensning og respekt"
    },
    {
      "id": "tallentusiasten",
      "social_function": "gjør telling, kurver og grupperinger attraktive og synliggjør både styrken og begrensningen ved kvantifisering",
      "class_position": "interessert deltaker uten forsknings- eller analysemandat",
      "status": "høy når mønsteret kan vises i en ryddig oversikt",
      "power_over_player": "kan flytte oppmerksomheten mot det som kan telles og sammenlignes",
      "wants": "et tydelig bilde som gjør endringer lettere å se",
      "conceals": "at valg av mål og gruppering påvirker hvilket mønster som kommer fram",
      "speech_style": "entusiastisk, konkret og glad i sammenligninger",
      "teaches_player": "at tall kan skjerpe observasjon uten å forklare alt rundt den"
    },
    {
      "id": "kontekstminneren",
      "social_function": "holder sted, tidspunkt, gruppe og uvanlige omstendigheter synlige når et mønster blir gjort for generelt",
      "class_position": "nær deltaker med situasjonskunnskap, ikke diagnostisk eller profesjonell autoritet",
      "status": "lav formell status, høy praktisk verdi når detaljer rundt hendelser glemmes",
      "power_over_player": "kan vise at samme handling opptrer annerledes når betingelsene endres",
      "wants": "at sammenligninger faktisk sammenligner lignende situasjoner",
      "conceals": "at kontekst kan bli så detaljert at ingen generalisering våges",
      "speech_style": "jordnær, detaljorientert og opptatt av hva som var annerledes akkurat da",
      "teaches_player": "at grensene for et mønster ofte er like viktige som selve gjentakelsen"
    },
    {
      "id": "samtalepartneren",
      "social_function": "hjelper spilleren å formulere observasjoner og alternative hypoteser uten å opptre som behandler",
      "class_position": "likestilt samtalepartner uten klinisk, terapeutisk eller profesjonell rolle",
      "status": "tillit gjennom lytting og presise spørsmål, ikke gjennom fagmyndighet",
      "power_over_player": "kan gjøre språk mindre kategorisk og få skjulte antakelser fram i lyset",
      "wants": "at usikkerhet kan sies høyt uten at hele observasjonen må forkastes",
      "conceals": "at gode spørsmål også kan få større tyngde enn de fortjener når relasjonen er nær",
      "speech_style": "rolig, avklarende og opptatt av forskjellen mellom sett, tenkt og antatt",
      "teaches_player": "at mønsterjakt fungerer bedre som spørsmål enn som diagnose"
    }
  ],
