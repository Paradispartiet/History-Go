  "title": "Psykologientusiast",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å lære psykologiske begreper og forskningsfunn uten å gjøre forenklede modeller, gruppedata, målinger eller kjent terminologi til sikker forklaring på enkeltmennesker",
    "description": "Psykologientusiast-verdenen undersøker fagbegrep mot hverdagsord, korrelasjon mot årsak, gruppefunn mot individ, effektstørrelse mot overskrift, måling mot antatt essens, eksperiment mot hverdagskontekst, replisering, kildehierarki, populærpsykologiske snarveier, merkelapper, trekk og situasjon, biasbegreper, konkurrerende teorier og revisjon. Psykologientusiast er en knowledge_identity og selvvalgt kunnskapsinteresse. Rollen gir ingen automatisk myndighet som psykolog, behandler, diagnostiker, forsker eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "numerical_control",
    "local_knowledge_vs_system",
    "social_mask",
    "shame_reputation",
    "status_anxiety",
    "care_vs_efficiency",
    "public_attention",
    "professional_culture"
  ],
  "social_environments": [
    "lesesirkler og private samtaler der fagbegreper møter hverdagsord og intuitive forklaringer",
    "podkaster, populærartikler og sosiale medier der forskningsforbehold lett komprimeres til en tydelig historie",
    "fagbøker og forskningssammendrag der definisjoner, målinger og metode må holdes fra hverandre",
    "vennesamtaler der gruppefunn eller biasbegreper frister som forklaring på en bestemt person",
    "diskusjoner om nye og eldre studier der replisering og alternative teorier kan endre hva som virker robust",
    "private refleksjoner der det er mulig å oppdatere eget syn uten å gjøre kunnskapsinteresse til klinisk rolle"
  ],
  "recurring_people_archetypes": [
    {
      "id": "lesesirkelvennen",
      "social_function": "gjør fagbegreper til samtaleemner og oppdager når hverdagsord og forskningsord glir sammen",
      "class_position": "likestilt leser uten klinisk eller akademisk mandat",
      "status": "troverdig gjennom nysgjerrighet og faktisk lesing, ikke tittel",
      "power_over_player": "kan gjøre en enkel forklaring sosialt fristende fordi gruppen ønsker et klart språk",
      "wants": "å forstå vanskelige begreper uten unødig sjargong",
      "conceals": "at forenklingen noen ganger blir viktigere enn definisjonen",
      "speech_style": "nysgjerrig, rask og glad i eksempler",
      "teaches_player": "at presisjon og tilgjengelig språk må holdes sammen"
    },
    {
      "id": "metodevennen",
      "social_function": "spør hvordan et funn ble målt, sammenlignet og testet før konklusjonen blir større",
      "class_position": "metodeinteressert privat deltaker uten forskerrolle",
      "status": "høy i gruppen når spørsmål om design og årsak blir uklare",
      "power_over_player": "kan stoppe en god historie med et enkelt spørsmål om data eller alternativ forklaring",
      "wants": "at påstander skal passe med metoden som faktisk ble brukt",
      "conceals": "at metodekritikk også kan bli en måte å utsette enhver konklusjon",
      "speech_style": "kort, analytisk og opptatt av hva studien faktisk gjorde",
      "teaches_player": "at forskningsdesign setter grenser for hvilke slutninger som er rimelige"
    },
    {
      "id": "kildegranskeren",
      "social_function": "sporer påstander fra overskrift og formidling tilbake til opprinnelig kilde og senere forskning",
      "class_position": "engasjert leser uten profesjonell autoritet",
      "status": "får tillit når kildesporing avdekker manglende forbehold",
      "power_over_player": "kan endre hele diskusjonen ved å finne hva kilden faktisk sier",
      "wants": "at sterke påstander skal kunne spores til et tydelig grunnlag",
      "conceals": "at også gode kilder krever tolkning og kan være ufullstendige",
      "speech_style": "rolig, dokumenterende og skeptisk til sitater uten lenke eller referanse",
      "teaches_player": "at kildehierarki og replisering er del av psykologisk allmennkunnskap"
    },
    {
      "id": "hverdagsvennen",
      "social_function": "holder situasjon, relasjon og hverdagsvariasjon synlig når abstrakte funn blir brukt for bredt",
      "class_position": "nær venn med kontekstkunnskap, uten fagrolle",
      "status": "lav formell status men høy kunnskap om konkrete situasjoner",
      "power_over_player": "kan vise at en pen teori ikke dekker det som faktisk varierer fra sted til sted",
      "wants": "at mennesker ikke reduseres til en modell",
      "conceals": "at nærhet også kan gjøre enkelthendelser for viktige",
      "speech_style": "jordnær, konkret og opptatt av hva som skjedde akkurat da",
      "teaches_player": "at ekstern validitet og individvariasjon får mening i konkrete liv"
    },
    {
      "id": "personen_det_gjelder",
      "social_function": "setter grensen mellom å diskutere forskning og å bruke begreper som ubedt tolkning av et annet menneske",
      "class_position": "privat person med rett til å korrigere kontekst og avvise spillerens fortolkning",
      "status": "avgjørende for egen situasjon, men ikke kilde til universelle årsaksforklaringer",
      "power_over_player": "kan stoppe merkelapper og be om at kliniske spørsmål ikke behandles som hobbyanalyse",
      "wants": "å bli møtt som person fremfor eksempel på et begrep",
      "conceals": "at egen forståelse også kan være usikker og skiftende",
      "speech_style": "direkte, personlig og tydelig på grenser",
      "teaches_player": "at kunnskapsinteresse ikke gir samtykke til å analysere andre"
    },
    {
      "id": "samtalepartneren",
      "social_function": "tester om psykologiske begreper åpner gode spørsmål eller bare avslutter uenighet med en merkelapp",
      "class_position": "likestilt samtalepartner uten behandler- eller ekspertstatus",
      "status": "tillit gjennom å tåle usikkerhet og skifte mening",
      "power_over_player": "kan gjøre det sosialt legitimt å si at en forklaring er foreløpig",
      "wants": "at samtalen beholder flere mulige forklaringer når grunnlaget er tynt",
      "conceals": "at et godt formulert motspørsmål kan få mer autoritet enn det fortjener",
      "speech_style": "rolig, presis og opptatt av forskjellen mellom begrep, observasjon og antakelse",
      "teaches_player": "at psykologi kan brukes til bedre spørsmål uten tankelesing"
    }
  ],
