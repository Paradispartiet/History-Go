  "title": "Relasjonsbygger",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å investere i relasjoner uten at omsorg blir løsningspress, nærhet blir tilgangskrav, konflikt blir persondom eller sosial tillit blir terapeutisk myndighet",
    "description": "Relasjonsbygger-verdenen undersøker lytting mot løsningsrefleks, tolkning mot avklaring, reparasjon mot dom, unnskyldning mot nullstilling, grenser, fortrolighet, tillit og privatliv, gjensidighet, triangulering, timing, råd og autonomi, oppfølging etter konflikt, nærhet og tilgjengelighet samt rollegrenser. Relasjonsbygger er en community_identity og selvvalgt sosial praksis. Rollen gir ingen automatisk myndighet som psykolog, terapeut, behandler, mekler eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "emotional_labor",
    "care_vs_efficiency",
    "social_mask",
    "shame_reputation",
    "invisible_work",
    "status_anxiety",
    "public_private_leakage",
    "alienation"
  ],
  "social_environments": [
    "nære vennskap der lytting, råd og forventninger til tilgjengelighet må avklares",
    "familie- og vennegrupper der konflikter lett kan spre seg gjennom tredjepartsallianser",
    "digitale samtaler der tone, svartid og korte meldinger kan bli overtolket",
    "fortrolige samtaler der behovet for støtte må balanseres mot andres privatliv",
    "relasjoner i reparasjon der unnskyldninger må følges av konkret endring over tid",
    "sosiale fellesskap der spilleren blir kjent som en god samtalepartner uten å få profesjonell myndighet"
  ],
  "recurring_people_archetypes": [
    {
      "id": "den_naere_vennen",
      "social_function": "gjør lytting, råd, tilgjengelighet og gjensidighet konkrete i en relasjon med høy tillit",
      "class_position": "likestilt nær venn uten profesjonell rolle",
      "status": "høy emosjonell betydning, men ingen formell myndighet",
      "power_over_player": "kan gjøre uenighet og avstand særlig merkbar fordi relasjonen betyr mye",
      "wants": "å bli møtt med interesse uten at hvert problem blir overtatt",
      "conceals": "at forventninger til nærhet også kan bli uklare og urealistiske",
      "speech_style": "direkte, personlig og rask til å merke om spilleren lytter eller løser",
      "teaches_player": "at nærhet krever både oppmerksomhet og rom"
    },
    {
      "id": "konfliktparten",
      "social_function": "bærer reelle uenigheter der ansvar, reparasjon og oppfølging må skilles fra persondommer",
      "class_position": "likestilt part i en vedvarende sosial relasjon",
      "status": "varierer med konfliktens publikum og historikk",
      "power_over_player": "kan trekke seg, utfordre spillerens versjon og stille krav om konkret endring",
      "wants": "at konfliktens skade blir tatt alvorlig uten å fryse hele relasjonen fast i den",
      "conceals": "at egen fortelling også forenkler hva som skjedde",
      "speech_style": "presis når rolig, mer kategorisk under press",
      "teaches_player": "at reparasjon krever handling og tid, ikke bare riktig formulering"
    },
    {
      "id": "grensesetteren",
      "social_function": "viser hvordan nei, kapasitet, svartid og privatliv kan eksistere inne i en nær relasjon",
      "class_position": "venn eller familiær relasjon med tydelig behov for autonomi",
      "status": "kan feilaktig oppfattes som avvisende når grensen bryter med gruppens norm",
      "power_over_player": "kan redusere kontakt hvis grenser gjentatte ganger presses",
      "wants": "å beholde relasjonen uten å måtte være konstant tilgjengelig",
      "conceals": "at tydelige grenser også kan være vanskelige å forklare i øyeblikket",
      "speech_style": "kort, vennlig og konkret om hva som går og ikke går",
      "teaches_player": "at respekt for grenser er en del av tillit"
    },
    {
      "id": "den_tredje_vennen",
      "social_function": "gir perspektiv og støtte, men synliggjør risikoen for triangulering og sosiale allianser",
      "class_position": "felles venn uten mandat til å avgjøre konflikten",
      "status": "høy informasjonsposisjon når flere betror seg til samme person",
      "power_over_player": "kan spre eller dempe en konflikt gjennom hva som videreformidles",
      "wants": "å hjelpe uten å bli brukt som dommer eller budbringer",
      "conceals": "at det kan være sosialt fristende å være den som vet mest",
      "speech_style": "forsiktig, nyansert og ofte opptatt av hva som faktisk bør sies videre",
      "teaches_player": "at støtte fra tredjepart ikke erstatter direkte samtale"
    },
    {
      "id": "taushetsbaereren",
      "social_function": "gjør fortrolighet, behov for egen støtte og deling av andres historier til en konkret avveiing",
      "class_position": "betrodd privatperson uten taushetsplikt som profesjon, men med sosialt ansvar",
      "status": "tillit bygges langsomt og kan tapes raskt ved unødvendig deling",
      "power_over_player": "kan sette norm for hva gruppen oppfatter som trygt å fortelle",
      "wants": "at betroelser behandles med omtanke uten at én person må bære alt alene",
      "conceals": "at ønsket om støtte kan gli over i interesse for selve historien",
      "speech_style": "lavmælt, diskret og konkret om hvem som trenger å vite hva",
      "teaches_player": "at fortrolighet kan kombineres med ansvarlig egen støtte"
    },
    {
      "id": "samtalepartneren",
      "social_function": "holder avklaring, råd, autonomi og rollegrenser synlige når spilleren blir den andre søker for gode samtaler",
      "class_position": "likestilt medmenneske uten terapeutisk, klinisk eller rådgivende mandat",
      "status": "høy sosial tillit gjennom lytting, ikke gjennom faglig autoritet",
      "power_over_player": "kan speile når hjelpsomhet begynner å bli kontroll eller ubedt analyse",
      "wants": "at gode samtaler skal gjøre folk friere til å eie egne valg",
      "conceals": "at også den som stiller gode spørsmål kan bli for sikker på sin egen betydning",
      "speech_style": "rolig, avklarende og opptatt av forskjellen mellom støtte og overtakelse",
      "teaches_player": "at relasjonskompetanse ikke er det samme som behandlerrolle"
    }
  ],
