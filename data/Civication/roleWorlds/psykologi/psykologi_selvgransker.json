  "title": "Selvgransker",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å undersøke egne valg, reaksjoner og mønstre uten å gjøre én hendelse, ett minne eller én selvfortelling til en total dom over hvem man er",
    "description": "Selvgransker-verdenen undersøker første forklaring mot alternativer, minne mot samtidige spor, intensjon mot effekt, midlertidig tilstand mot identitet, global selvdom mot konkret handling, blindsoner og tilbakemelding, verdier mot faktiske valg, mønster mot kontekst, kontroll mot betingelser, selvfortelling mot moteksempler, sosial sammenligning, refleksjon mot repetitiv gjenfortelling, personvern og rollegrenser. Selvgransker er en practice_identity og selvvalgt refleksjonspraksis. Rollen gir ingen automatisk myndighet som psykolog, terapeut, behandler, diagnostiker eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "social_mask",
    "shame_reputation",
    "local_knowledge_vs_system",
    "care_vs_efficiency",
    "status_anxiety",
    "public_private_leakage",
    "alienation",
    "professional_culture"
  ],
  "social_environments": [
    "private notater og ettertanker der minner kan sammenlignes med samtidige spor",
    "vennesamtaler der intensjon, virkning og tilbakemelding ikke alltid peker samme vei",
    "hverdagssituasjoner der samme reaksjon endrer seg med sted, relasjon eller krav",
    "prioriteringer der uttalte verdier møter kalender, tid og faktiske valg",
    "sosiale sammenligninger der andres synlige resultater blir målestokk for eget liv",
    "situasjoner der egenrefleksjon berører andres personvern eller frister til å bli uformell fagrolle"
  ],
  "recurring_people_archetypes": [
    {
      "id": "refleksjonsvennen",
      "social_function": "hjelper spilleren å formulere flere mulige forklaringer og stoppe globale selvdommer",
      "class_position": "likestilt venn uten behandler- eller ekspertrolle",
      "status": "tillit gjennom ro og evne til å stille konkrete spørsmål",
      "power_over_player": "kan gjøre det vanskeligere å skjule en bred selvfortelling bak abstrakte ord",
      "wants": "at refleksjon skal føre til tydeligere spørsmål og mindre skråsikkerhet",
      "conceals": "at vedkommende også kan overanalysere egne valg",
      "speech_style": "rolig, konkret og spørrende",
      "teaches_player": "at selvinnsikt ofte blir bedre når konklusjonen får konkurranse"
    },
    {
      "id": "notatvennen",
      "social_function": "holder samtidige notater og moteksempler tilgjengelige når minnet blir ryddigere enn hendelsen var",
      "class_position": "privat deltaker uten fagmyndighet",
      "status": "troverdig gjennom konsekvent dokumentasjon av egne observasjoner",
      "power_over_player": "kan utfordre sterke minner og etablerte selvfortellinger",
      "wants": "at endring over tid skal kunne ses i konkrete spor",
      "conceals": "at notater også velger hva som får plass",
      "speech_style": "kort, detaljorientert og opptatt av tid og situasjon",
      "teaches_player": "at samtidige spor kan korrigere etterpåforklaringer"
    },
    {
      "id": "personen_det_gjaldt",
      "social_function": "viser forskjellen mellom spillerens intensjon og hvordan handlingen faktisk virket for andre",
      "class_position": "privat person med førstehåndskunnskap om egen opplevelse",
      "status": "høy relevans for virkningen av handlingen uten å eie spillerens motiv",
      "power_over_player": "kan korrigere antakelser og sette grenser for deling av private detaljer",
      "wants": "at egen erfaring ikke forklares bort av spillerens gode intensjon",
      "conceals": "at også egen tolkning kan være begrenset",
      "speech_style": "direkte, konkret og opptatt av hva som faktisk skjedde",
      "teaches_player": "at selvgransking må tåle informasjon utenfra"
    },
    {
      "id": "aerlig_venn",
      "social_function": "gir konkrete tilbakemeldinger om gjentakelser spilleren selv ikke ser",
      "class_position": "nær venn uten terapeutisk mandat",
      "status": "tillit gjennom langvarig relasjon og vilje til å være tydelig",
      "power_over_player": "kan utløse forsvar fordi observasjonen kolliderer med selvbildet",
      "wants": "at tilbakemeldinger undersøkes før de enten godtas eller avvises",
      "conceals": "at nærhet kan farge hvilke mønstre vedkommende legger merke til",
      "speech_style": "rett fram, varm og konkret",
      "teaches_player": "at blindsoner krever eksempler, ikke bare enighet"
    },
    {
      "id": "hverdagsvennen",
      "social_function": "holder situasjon, begrensninger og ytre forhold synlige når spilleren tar alt ansvar eller gjør alt personlig",
      "class_position": "likestilt deltaker med kunnskap om praktiske omstendigheter",
      "status": "lav formell status men høy kontekstkunnskap",
      "power_over_player": "kan vise hvilke betingelser som faktisk var utenfor spillerens kontroll",
      "wants": "en rettferdigere fordeling mellom ansvar og omstendigheter",
      "conceals": "at kontekst noen ganger kan brukes til å slippe unna ansvar",
      "speech_style": "jordnær, konkret og lite glad i totale forklaringer",
      "teaches_player": "at ansvar blir mer presist når kontrollgrensene er tydelige"
    },
    {
      "id": "prioriteringsvennen",
      "social_function": "sammenligner uttalte verdier med kalender, ressurser og faktiske valg uten å gjøre gapet til moralsk dom",
      "class_position": "venn eller samarbeidspartner uten psykologrolle",
      "status": "troverdig fordi vedkommende kjenner spillerens faktiske prioriteringer over tid",
      "power_over_player": "kan gjøre avstanden mellom ord og valg synlig",
      "wants": "at viktige verdier får praktisk plass eller ærlig revideres",
      "conceals": "at egne prioriteringer også konkurrerer",
      "speech_style": "praktisk, nøktern og opptatt av hva som faktisk fikk tid",
      "teaches_player": "at verdier blir tydeligere når de møter reelle valg"
    }
  ],
