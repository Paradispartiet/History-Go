  "title": "Labnerd",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å dyrke presis måle- og eksperimentpraksis med kontroll, sporbarhet, replikasjon og sikkerhetsbevissthet uten at hobbykompetanse blir laboratorie-, HMS-, forsker- eller godkjenningsmyndighet",
    "description": "Labnerd-verdenen undersøker instrumentkontroll, kontrollbetingelser, sporbarhet, blinding, kontaminasjonsrisiko, miljøvariabler, outliers, replikasjon, måleusikkerhet, rålogg, sikkerhetsgrenser, data lineage, usikkerhetskommunikasjon og formell myndighet. Labnerd er en alternative_life_status. Rollen gir ingen automatisk laboratorielederrolle, HMS-ansvar, forskerstilling, ingeniørmyndighet eller faglig godkjenningsmandat, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "numerical_control",
    "professional_culture",
    "local_knowledge_vs_system",
    "status_anxiety",
    "invisible_work",
    "care_vs_efficiency",
    "bureaucratic_power",
    "shame_reputation"
  ],
  "social_environments": [
    "hobby- og verkstedmiljøer der små måleoppsett bygges og sammenlignes over tid",
    "måleserier der instrument, nullpunkt, miljø og dokumentasjon kan flytte resultatet",
    "dataarbeid der rådata, transformasjoner, outliers og presisjon må kunne spores",
    "samarbeid der blinding, kontroll og replikasjon utfordrer forventninger og prestisje",
    "situasjoner der rengjøring, separasjon og romkrav setter praktiske sikkerhetsgrenser",
    "møter med formelle laboratorie- og forskningsroller som eier HMS, godkjenning og faglig ansvar"
  ],
  "recurring_people_archetypes": [
    {
      "id": "utstyrsvennen",
      "social_function": "gjør måleutstyr, nullpunkt, kalibrering og miljøbetingelser konkrete",
