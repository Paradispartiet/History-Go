    },
    {
      "id": "hmsvennen",
      "social_function": "markerer sikkerhets-, rom- og håndteringsgrenser uten å gi spilleren risikable prosedyrer",
      "class_position": "person med ansvar eller kompetanse for avgrenset sikkerhetspraksis",
      "status": "høy situert myndighet når sikkerhetsrammer berøres",
      "power_over_player": "kan stoppe oppsett som går utenfor hobby- eller romgrensen",
      "wants": "at nysgjerrighet ikke omgår sikkerhetskrav",
      "conceals": "at sikkerhet ofte oppleves som treghet helt til grensen faktisk blir viktig",
      "speech_style": "kort, tydelig og regelbevisst",
      "teaches_player": "at teknisk mulighet ikke er det samme som tillatt eller forsvarlig praksis"
    },
    {
      "id": "fagpersonen",
      "social_function": "skiller hobbykompetanse fra formelt laboratorie-, forsknings-, HMS- og godkjenningsansvar",
      "class_position": "kvalifisert fagrolle med avgrenset institusjonelt mandat",
      "status": "høy formell myndighet i eget ansvarsområde",
      "power_over_player": "kan avklare hvor hobbypraksis må stoppe eller overleveres",
      "wants": "at gode målevaner brukes uten rolleforvirring",
      "conceals": "at profesjonelle systemer også er avhengige av nøyaktig hverdagsdokumentasjon",
      "speech_style": "presis, ansvarstydelig og nøktern",
      "teaches_player": "at metodekompetanse og institusjonell myndighet er ulike ting"
    }
  ],
