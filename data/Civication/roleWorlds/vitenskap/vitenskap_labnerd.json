      "status": "høy praktisk utstyrskunnskap, ingen formell godkjenningsmyndighet",
      "power_over_player": "kan få instrumentdisplay og teknisk fortrolighet til å se mer presist ut enn metoden er",
      "wants": "at oppsettet skal være stabilt nok til å gi sammenlignbare målinger",
      "conceals": "at eget favorittutstyr også har begrensninger og drift",
      "speech_style": "teknisk, kort og praktisk",
      "teaches_player": "at instrumentet selv er en del av målekjeden"
    },
    {
      "id": "forsoksvennen",
      "social_function": "tester kontroll, blinding og replikasjon i små eksperimentelle oppsett",
      "class_position": "likestilt eksperimententusiast uten forskerstilling",
      "status": "middels uformell metodeautoritet",
      "power_over_player": "kan gjøre første tydelige forskjell til et funn før oppsettet er kontrollert",
      "wants": "at resultater skal tåle en ny runde",
      "conceals": "at forventninger påvirker hvilke mønstre som føles overbevisende",
      "speech_style": "hypotesedrevet, energisk og konkret",
      "teaches_player": "at kontroll og replikasjon utfordrer både funn og ego"
    },
    {
