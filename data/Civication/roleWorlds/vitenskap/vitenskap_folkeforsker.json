  "title": "Folkeforsker",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å bidra med observasjoner, registreringer og datainnsamling som er etterprøvbar og nyttig uten at frivillig praksis blir forskerstilling, godkjenningsmyndighet eller institusjonell representasjon",
    "description": "Folkeforsker-verdenen undersøker protokoll, nullobservasjoner, metadata, duplikater, instrumentdrift, identifikasjonsusikkerhet, dokumentasjon og personvern, tilgjengelighetsbias, manglende data, rådata og bearbeiding, outliers, replikasjon, usikkerhetskommunikasjon og institusjonsgrenser. Folkeforsker er en practice_identity life position. Rollen gir ingen automatisk forskerstilling, etisk godkjenningsmyndighet, prosjektledermandat, faglig garantistrolle eller institusjonell talerett, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "numerical_control",
    "local_knowledge_vs_system",
    "professional_culture",
    "status_anxiety",
    "invisible_work",
    "care_vs_efficiency",
    "public_attention",
    "shame_reputation"
  ],
  "social_environments": [
    "frivillige observasjonsprosjekter der mange små bidrag må følge en felles protokoll",
    "feltarbeid der sted, innsats og tilgjengelighet påvirker hva som blir sett og registrert",
    "databearbeiding der rådata, metadata, duplikater og manglende verdier må håndteres sporbar",
    "enkle målesituasjoner der instrument, kalibrering og kontrollmålinger former resultatet",
    "analyse og deling der outliers, replikasjon og usikkerhet utfordrer ønsket om et tydelig funn",
    "møter med formelle forskningsroller der etikk, godkjenning og institusjonell representasjon har eget mandat"
  ],
  "recurring_people_archetypes": [
    {
      "id": "registreringsvennen",
      "social_function": "holder observasjonsprotokoll, nullfunn og usikkerhet synlig i frivillig datainnsamling",
      "class_position": "likestilt frivillig med høy rutine i registrering, uten formell forskerstilling",
      "status": "middels uformell metodeautoritet",
      "power_over_player": "kan gjøre rutine og skjema til større sikkerhet enn dataene tåler",
      "wants": "at bidragene kan kontrolleres og brukes av andre",
      "conceals": "at egen erfaring kan gjøre avvik fra protokollen fristende når noe spennende skjer",
      "speech_style": "nøktern, detaljert og prosedyreorientert",
      "teaches_player": "at dokumentert metode og nuller er del av funnet"
    },
    {
      "id": "feltvennen",
      "social_function": "gjør sted, innsats, tilgjengelighet og praktiske observasjonsvilkår konkrete",
      "class_position": "frivillig feltobservatør med lokal erfaring",
      "status": "høy lokalkunnskap, ingen institusjonell myndighet",
      "power_over_player": "kan normalisere bekvemmelighetsutvalg og uformelle snarveier",
      "wants": "at feltarbeidet er mulig å gjennomføre over tid",
      "conceals": "at de enkleste rutene også former datasettet",
      "speech_style": "praktisk, stedssensitiv og uformell",
      "teaches_player": "at innsats og tilgjengelighet må registreres sammen med funn"
    },
    {
      "id": "datavennen",
      "social_function": "arbeider med metadata, manglende data, duplikater og skille mellom rå og bearbeidet datasett",
      "class_position": "teknisk interessert bidragsyter uten dataforvaltermandat",
      "status": "middels teknisk status",
      "power_over_player": "kan gjøre ryddighet til viktigere mål enn sporbarhet",
      "wants": "at datasettet er brukbart uten å miste opprinnelig informasjon",
      "conceals": "at opprydding også innebærer tolkning og valg",
      "speech_style": "systematisk, fil- og feltnær",
      "teaches_player": "at bearbeiding må kunne spores tilbake til rådata"
    },
    {
      "id": "utstyrsvennen",
      "social_function": "gjør måleutstyr, kalibrering og kontrollmålinger synlige",
      "class_position": "hobbyutøver med praktisk instrumenterfaring",
      "status": "høy situert utstyrskompetanse",
      "power_over_player": "kan skape overdreven tillit til instrumentet fordi det gir tall",
      "wants": "at målingene er stabile nok til å sammenlignes",
      "conceals": "at selv konsekvent bruk av samme instrument kan gi systematisk drift",
      "speech_style": "teknisk, hands-on og feilsøkende",
      "teaches_player": "at instrumentet også er en del av målesystemet"
    },
    {
      "id": "analysevennen",
      "social_function": "tester outliers, replikasjon og hvor langt et mønster kan generaliseres",
      "class_position": "kunnskapsinteressert bidragsyter uten forsker- eller statistikerstilling",
      "status": "middels analytisk troverdighet",
      "power_over_player": "kan belønne pene mønstre og raske konklusjoner",
      "wants": "at interessante funn skal tåle en ny runde",
      "conceals": "at forventninger påvirker hvilke avvik som oppleves som feil",
      "speech_style": "hypotesedrevet, kritisk og tallbevisst",
      "teaches_player": "at robusthet krever regler som ikke avhenger av ønsket resultat"
    },
    {
      "id": "fagpersonen",
      "social_function": "markerer grensen mellom frivillig datainnsamling og formell forskning, etikk, prosjektledelse og institusjonell representasjon",
      "class_position": "kvalifisert forsker eller mandatbærende prosjektrolle",
      "status": "høy situert fag- og godkjenningsmyndighet",
      "power_over_player": "kan kreve formelle protokoller og stoppe overclaim av institusjonell rolle",
      "wants": "at frivillige bidrag brukes godt uten falsk autoritet",
      "conceals": "at profesjonelle prosjekter også er avhengige av kvaliteten på frivillige bidrag",
      "speech_style": "presis, metodebevisst og tydelig om ansvar",
      "teaches_player": "at verdifull folkeforskning og formell forskermyndighet er ulike roller"
    }
  ],
