  "title": "Stjernekikker",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å bygge sterk observasjonskompetanse om nattehimmel, vær, utstyr og sjeldne fenomener uten at hobbykunnskap blir astronomstilling, observatorieansvar eller institusjonell bekreftelsesmyndighet",
    "description": "Stjernekikker-verdenen undersøker skydekke, månebakgrunn, mørketilpasning, himmelposisjon, identifikasjon av bevegelige lys, nyttig forstørrelse, lokal horisont, observasjonslogg, forventningsbias, råbilder og bearbeiding, kulde og tretthet, stedstilgang, prognoseusikkerhet og profesjonsgrenser. Stjernekikker er en hobby_identity life position. Rollen gir ingen automatisk astronomstilling, observatorieansvar, forskermandat eller institusjonell talerett, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "status_anxiety",
    "social_mask",
    "professional_culture",
    "care_vs_efficiency",
    "public_attention",
    "shame_reputation",
    "invisible_work"
  ],
  "social_environments": [
    "lokale observasjonssteder der vær, lys og horisont bestemmer hva som faktisk kan ses",
    "natteøkter der mørketilpasning, kulde og tretthet påvirker både observasjon og vurdering",
    "hobbyfellesskap der sjeldne fenomener og sosial forventning kan gjøre svake signaler mer overbevisende",
    "utstyrssituasjoner der optikk, forstørrelse og praktisk kontrast konkurrerer med spesifikasjoner",
    "logging og bildearbeid der tidspunkt, råfiler og bearbeiding må kunne spores",
    "møter med formelle astronomi- og observatorieroller som eier faglige og institusjonelle bekreftelser"
  ],
  "recurring_people_archetypes": [
