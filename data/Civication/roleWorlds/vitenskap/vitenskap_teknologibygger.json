    "label": "Teknologibygger"
  },
  "title": "Teknologibygger",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å kombinere kode, elektronikk eller mekanikk til små systemer som faktisk løser problemer og kan testes, driftes og overtas uten at byggekompetanse blir formell ingeniør-, sikkerhets-, personvern- eller systemeiermyndighet",
    "description": "Teknologibygger-verdenen undersøker problemdefinisjon, prototyper, scope creep, grensesnitt, avhengigheter, backup og restore, feilmodi, logging og personvern, fysisk sikkerhet, teknisk gjeld, handover, brukerutfall, rollback og formell myndighet. Teknologibygger er en practice_identity life position. Rollen gir ingen automatisk ingeniørrolle, systemarkitektmandat, HMS- eller sikkerhetsansvar, personvernmyndighet, driftslederrolle eller faglig godkjenningsmandat, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "professional_culture",
    "invisible_work",
    "care_vs_efficiency",
    "numerical_control",
    "status_anxiety",
    "bureaucratic_power",
    "shame_reputation"
  ],
  "social_environments": [
    "hobby- og makerprosjekter der prototypehastighet og faktisk problemforståelse konkurrerer",
    "små kodebaser der avhengigheter, grensesnitt og teknisk gjeld vokser rundt fungerende funksjoner",
    "integrerte systemer der programvare møter elektronikk, mekanikk eller fysisk sikkerhet",
    "driftssituasjoner der backup, restore, release og rollback avgjør hvor robust løsningen egentlig er",
    "brukersituasjoner der tekniske forbedringer må måles mot faktisk oppgave og friksjon",
    "møter med kvalifiserte ingeniør-, sikkerhets-, personvern- og driftsroller som eier formelt ansvar"
  ],
  "recurring_people_archetypes": [
    {
      "id": "byggekompisen",
      "social_function": "holder fokus på brukerproblem, prototype og avgrensning av første stabile kjerne",
      "class_position": "likestilt maker eller hobbybygger uten systemeiermandat",
      "status": "middels uformell teknisk autoritet",
      "power_over_player": "kan belønne synlig fremdrift selv når problemet og driftskravene fortsatt er uklare",
      "wants": "å få en fungerende løsning i hendene raskt",
      "conceals": "at entusiasme for bygging gjør scope vanskelig å begrense",
      "speech_style": "praktisk, fremoverlent og løsningsorientert",
      "teaches_player": "at et problem må være tydeligere enn favorittløsningen"
    },
    {
      "id": "kodevennen",
      "social_function": "gjør avhengigheter, teknisk gjeld og vedlikehold konkrete i kodebasen",
      "class_position": "erfaren utvikler eller hobbykoder uten arkitekt- eller driftsmandat",
      "status": "høy uformell kodeautoritet",
      "power_over_player": "kan normalisere lokale snarveier fordi de virker raskest nå",
      "wants": "at systemet skal kunne endres uten at alt ryker",
      "conceals": "hvor lett egne abstraheringer blir usynlige for andre",
      "speech_style": "kort, refaktoriserende og avhengighetsbevisst",
      "teaches_player": "at gjeld og avhengigheter må være synlige før de blir dyre"
    },
    {
      "id": "driftsvennen",
      "social_function": "kobler backup, restore, handover og release til faktisk stabil bruk",
      "class_position": "driftsnær person uten automatisk systemeiermyndighet",
      "status": "middels situert driftsautoritet",
      "power_over_player": "kan stoppe en release når recovery og overtakelse ikke er tydelige",
      "wants": "at systemet kan feile uten å bli uopprettelig",
      "conceals": "at drift ofte blir nedprioritert helt til noe går galt",
      "speech_style": "nøktern, sjekklisteorientert og konsekvensbevisst",
      "teaches_player": "at stabil drift inkluderer vei tilbake og annen person enn byggeren"
    },
    {
      "id": "brukeren",
      "social_function": "gjør nytte, arbeidsflyt og scope konkrete fra mottakersiden",
      "class_position": "person som bruker systemet uten plikt til å forstå teknisk arkitektur",
      "status": "høy situert autoritet på eget behov",
      "power_over_player": "kan utvide scope gjennom mange små legitime ønsker",
      "wants": "at løsningen faktisk gjør oppgaven enklere",
      "conceals": "at tekniske forbedringer ikke nødvendigvis forbedrer egen arbeidsflyt",
      "speech_style": "konkret, oppgaveorientert og lite opptatt av intern teknikk",
      "teaches_player": "at teknisk kvalitet må kobles til virkelig brukerutfall"
    },
    {
      "id": "sikkerhetsvennen",
      "social_function": "markerer når elektronikk, mekanikk, strøm eller data krever eksplisitte sikkerhets- og personvernrammer",
      "class_position": "person med relevant avgrenset sikkerhetskompetanse eller ansvar",
      "status": "høy situert myndighet når fysisk sikkerhet eller sensitive data berøres",
      "power_over_player": "kan stoppe oppsett som går utenfor dokumenterte hobby- eller sikkerhetsrammer",
      "wants": "at teknisk nysgjerrighet ikke skjuler konsekvenser for mennesker og fysisk utstyr",
      "conceals": "at sikkerhet ofte virker som friksjon før den faktisk trengs",
      "speech_style": "direkte, risikobevisst og grenseklar",
      "teaches_player": "at programvarekontroll ikke erstatter fysisk eller juridisk ansvar"
    },
    {
      "id": "fagpersonen",
      "social_function": "skiller praktisk byggerkompetanse fra formell ingeniør-, arkitekt-, HMS-, sikkerhets-, personvern- og driftsmyndighet",
      "class_position": "kvalifisert eller mandatbærende fagrolle",
      "status": "høy formell myndighet i eget ansvarsområde",
      "power_over_player": "kan avklare hvilke beslutninger som krever profesjons- eller systemeieransvar",
      "wants": "at gode prototyper og løsninger brukes uten rolleforvirring",
      "conceals": "at formelle systemer også trenger praktisk builder-kunnskap",
      "speech_style": "presis, ansvarstydelig og arkitekturbevisst",
      "teaches_player": "at det å ha bygget systemet ikke betyr at man eier alle beslutningene"
    }
  ],
