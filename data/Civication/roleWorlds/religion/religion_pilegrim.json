  "title": "Pilegrim",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å gjennomføre en meningsbærende reise der sted, praksis, kropp og fellesskap betyr mer enn effektiv transport, uten å gjøre erfaringen til status, eierskap over andres ritual eller religiøs autoritet",
    "description": "Pilegrim-verdenen undersøker rute mot mål, kropp mot plan, deltakelse mot appropriasjon, dokumentasjon mot tilstedeværelse, identitetsmerkelapper, kommersialisering, ulikt tempo, tradisjon mot historisk påstand, vertskap, ulike tros- og livssynsmotiver, sertifikater, rolleprestasjon, offentlig deling og hjemkomst. Pilegrim er en self_selected_identity. Rollen gir ingen automatisk myndighet som trosrepresentant, geistlig, teolog, historiker, guide eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "social_mask",
    "care_vs_efficiency",
    "shame_reputation",
    "status_anxiety",
    "public_private_leakage",
    "professional_culture",
    "alienation"
  ],
  "social_environments": [
    "ruter og etapper der tempo, kropp og plan må justeres mot hverandre",
    "tros- og livssynssteder der lokale normer styrer deltakelse og dokumentasjon",
    "enkle vertshus og fellesskapsdrevne overnattingssteder med andre forventninger enn kommersiell service",
    "reisefellesskap der mennesker går samme vei av ulike religiøse, sekulære og personlige grunner",
    "lokale fortellinger, symboler og tradisjoner som kan ha mening uten at alle detaljer er historisk dokumentert",
    "hjemkomsten der sterke erfaringer skal møte vanlig tid, relasjoner og prioriteringer"
  ],
  "recurring_people_archetypes": [
    {
      "id": "rutevennen",
      "social_function": "holder rute, tempo og dokumentasjon i balanse med det som faktisk skjer underveis",
      "class_position": "medreisende uten religiøs eller profesjonell myndighet",
      "status": "erfaring fra flere etapper, men ingen rett til å definere andres reise",
      "power_over_player": "kan gjøre logistikk til usynlig norm hvis rådene blir fasit",
      "wants": "en gjennomførbar reise med plass til steder og pauser",
      "conceals": "at effektivitet også frister vedkommende",
      "speech_style": "praktisk, rolig og detaljorientert",
      "teaches_player": "at ruten er del av praksisen, ikke bare avstanden til målet"
    },
    {
      "id": "turkameraten",
      "social_function": "synliggjør forskjeller i kropp, tempo og motivasjon i et felles reisefølge",
      "class_position": "likestilt medreisende",
      "status": "troverdig gjennom faktisk delt reise",
      "power_over_player": "kan presse gruppen mot enten for høyt eller for lavt tempo",
      "wants": "at fellesskapet holder uten at alle må gjøre alt likt",
      "conceals": "egen frykt for å være den som forsinker andre",
      "speech_style": "direkte, varm og konkret",
      "teaches_player": "at kollektiv reise krever justering, ikke uniformitet"
    },
    {
      "id": "verten",
      "social_function": "representerer lokale regler, gjestfrihet og kontekst rundt ritual og overnatting",
      "class_position": "lokal vert med ansvar for stedet, ikke for spillerens identitet",
      "status": "høy situasjonsmyndighet på eget sted",
      "power_over_player": "kan sette grenser for deltakelse, dokumentasjon og bruk av rommet",
      "wants": "respekt for stedets praksis og bærekraft",
      "conceals": "at vertskap også kan være slitsomt og ujevnt fordelt",
      "speech_style": "vennlig, tydelig og lite opptatt av symbolsk status",
      "teaches_player": "at gjestfrihet ikke er det samme som kjøpt service"
    },
    {
      "id": "medreisende",
      "social_function": "viser at samme rute kan bæres av religiøse, sekulære og personlige motiver",
      "class_position": "privat reisende uten representasjonsmandat",
      "status": "likestilt i reisen, ulik i begrunnelse",
      "power_over_player": "kan utfordre behovet for én riktig forklaring på reisen",
      "wants": "å få eie sin egen mening uten å bli kategorisert",
      "conceals": "at også vedkommende vurderer andres motiver",
      "speech_style": "åpen, nøktern og personlig",
      "teaches_player": "at felles praksis ikke krever felles tro"
    },
    {
      "id": "kildevennen",
      "social_function": "skiller lokal tradisjon, dokumentert historie og offentlig formidling",
      "class_position": "kunnskapsinteressert privatperson uten teologisk eller historikerautoritet",
      "status": "tillit gjennom kildebevissthet",
      "power_over_player": "kan bremse en god fortelling med spørsmål om dokumentasjon og samtykke",
      "wants": "at sterke historier formidles presist",
      "conceals": "at kildesjekk også kan bli en måte å holde avstand til opplevelsen",
      "speech_style": "nøyaktig, rolig og respektfull",
      "teaches_player": "at mening og historisk dokumentasjon kan holdes fra hverandre"
    },
    {
      "id": "hjemmevennen",
      "social_function": "møter spilleren etter reisen og tester hva som faktisk lar seg overføre til hverdagen",
      "class_position": "nær venn uten del i reisen",
      "status": "lav symbolsk pilegrimsstatus, høy kunnskap om spillerens hverdagsliv",
      "power_over_player": "kan punktere store løfter med konkrete spørsmål om tid og praksis",
      "wants": "at reisen får betydning uten å velte alt i etterglød",
      "conceals": "egen skepsis til reiser som identitetsmarkør",
      "speech_style": "jordnær, varm og konkret",
      "teaches_player": "at hjemkomsten også er del av reisen"
    }
  ],
