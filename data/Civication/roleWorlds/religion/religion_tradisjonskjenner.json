  "title": "Tradisjonskjenner",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å forstå hvordan religiøse tradisjoner overføres, endres, standardiseres og lokaliseres gjennom historie, familie, språk, migrasjon og institusjoner uten å gjøre historisk oversikt til ritualmyndighet, tolkningsmonopol eller representasjonsrett",
    "description": "Tradisjonskjenner er en employment-independent tradition_literacy som organiserer gjentatt arbeid med overføring, historiske lag, lokale og generasjonelle variasjoner, kanon og sedvane, migrasjon, språk, reform og gjenoppliving. Rollen er ikke Ritualkjenner, som kan konkrete ritualforløp og deltakelsesgrenser; ikke Symboltolker, som arbeider med tegn, bilder og fortolkningslag; og ikke Troslivskjenner, som retter seg mot levd religion og personlige erfaringer. Tradisjonskunnskap gir heller ikke medlemskap, teologisk autoritet, ritualmyndighet, forskerstatus eller mandat til å definere andres trosliv."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "social_mask",
    "shame_reputation",
    "public_private_leakage",
    "status_anxiety",
    "public_attention",
    "bureaucratic_power",
    "professional_culture"
  ],
  "social_environments": [
    "familier og generasjonsfellesskap der tradisjon videreføres gjennom minner, vaner, språk og selektiv praksis",
    "religiøse institusjoner der formell undervisning, standardisering og lokal sedvane møtes",
    "migrasjons- og diasporamiljøer der tradisjoner bevares, oversettes og bygges om i nye omgivelser",
    "arkiv, historiske kilder og muntlige minner der kontinuitet og endring må skilles analytisk",
    "reform- og revivalmiljøer der aktører legitimerer endring gjennom bestemte fortellinger om fortiden",
    "høytids- og hverdagsarenaer der synlig offentlig tradisjon og mindre privat praksis vedlikeholder ulike deler av samme arv"
  ],
  "recurring_people_archetypes": [
    {
      "id": "historievennen",
      "social_function": "følger tradisjonens tidslag og skiller dokumentert kontinuitet fra ettertidens forenklinger",
      "class_position": "historisk interessert kildebruker uten religiøst mandat",
      "status": "høy på kronologi og kildesammenheng",
      "power_over_player": "kan utfordre påstander om uforandret eller tidløs tradisjon",
      "wants": "at kontinuitet og endring beskrives med faktiske overføringsledd",
      "conceals": "at skriftlige kilder bevarer institusjonelle former bedre enn hverdagspraksis",
      "speech_style": "kronologisk, kildeorientert og nøktern",
      "teaches_player": "at tradisjon må spores gjennom overføring, ikke bare alder"
    },
    {
      "id": "den_lokale_kjenneren",
      "social_function": "viser hvordan lokal sedvane kan være legitim tradisjonspraksis uten å være universell standard",
      "class_position": "lokalt forankret deltaker uten plikt til å representere hele tradisjonen",
      "status": "høy på situert og lokal kunnskap",
      "power_over_player": "kan korrigere når en formell norm feilaktig gjøres universell",
      "wants": "at lokal variasjon tas alvorlig uten å bli gjort til hele tradisjonen",
      "conceals": "at lokal normalitet kan gjøre andre miljøers former mindre synlige",
      "speech_style": "konkret, stedbundet og korrigerende",
      "teaches_player": "at variasjon er del av tradisjonens sosiale historie"
    },
    {
      "id": "sprakbroen",
      "social_function": "synliggjør hvordan språk, oversettelse og generasjon påvirker hva som videreføres",
      "class_position": "tospråklig eller flerspråklig mellomposisjon mellom generasjoner",
      "status": "høy på begreps- og oversettelsesforskjeller",
      "power_over_player": "kan vise når tilsynelatende samme tradisjon endrer nyanse gjennom språk",
      "wants": "at språkskifte behandles som innholdsrik overføring, ikke bare logistikk",
      "conceals": "at ingen oversettelse fullt ut representerer alle generasjoners assosiasjoner",
      "speech_style": "forklarende, kontrasterende og kontekstuell",
      "teaches_player": "at språk er en del av tradisjonens overføringsmekanisme"
    },
    {
      "id": "familievennen",
      "social_function": "viser hvordan tradisjon lever i hjem, minner og generasjonelle valg ved siden av institusjonell lære",
      "class_position": "nær hverdagslig familiepraksis uten formell autoritet",
      "status": "høy på privat overføring og minne",
      "power_over_player": "kan utfordre institusjonssentrerte beskrivelser av hva tradisjon faktisk er",
      "wants": "at familietradisjon behandles som empirisk praksis uten å bli universalisert",
      "conceals": "at sterke minner kan glatte over historiske endringer",
      "speech_style": "personlig, fortellende og relasjonell",
      "teaches_player": "å skille kollektivt minne fra kronologisk historie"
    },
    {
      "id": "migrasjonshistorikeren",
      "social_function": "sporer hvordan tradisjon endrer form når mennesker, språk og institusjoner flytter",
      "class_position": "kunnskapsrik observatør av migrasjon og diasporadannelse",
      "status": "høy på mobilitet og tilpasningshistorie",
      "power_over_player": "kan avvise opprinnelsesstedet som eneste målestokk for autentisitet",
      "wants": "at nye lokale former beskrives som historiske utviklinger med konkrete årsaker",
      "conceals": "at begrepet diaspora selv kan skjule store interne forskjeller",
      "speech_style": "sammenlignende, mobilitetsorientert og historisk",
      "teaches_player": "at flytting både kan styrke bevaring og skape nye tradisjonsformer"
    },
    {
      "id": "reformstemmen",
      "social_function": "viser hvordan reform og gjenoppliving legitimerer endring gjennom bestemte bilder av fortiden",
      "class_position": "engasjert deltaker eller formidler i endringsorientert miljø uten universelt mandat",
      "status": "høy på bevegelsens egen selvforståelse",
      "power_over_player": "kan vise hvorfor aktører opplever ny praksis som gjenopprettet kontinuitet",
      "wants": "at reformens egne historiske argumenter tas alvorlig",
      "conceals": "at tilbakevendingsspråk også kan skjule reelle institusjonelle nyvinninger",
      "speech_style": "normativ, historiserende og overbevisende",
      "teaches_player": "å skille aktørens selvfortelling fra analytisk historiebeskrivelse"
    }
  ],
