  },
  "title": "Besøkende",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å gå inn i religiøse og livssynsrelaterte sosiale sammenhenger som gjest med nysgjerrighet, samtidig som invitasjonens ramme, deltakelsesgrenser, frivillig forklaring og begrenset slutningsrett respekteres",
    "description": "Besøkende er en lavterskel visitor_practice: en situasjonsbundet gjesterolle i en konkret samling eller aktivitet. Den er smalere enn Trosstedsvandrer, som bygger flerbesøkskompetanse rundt tros- og livssynssteder; den er ikke Pilegrim, som organiserer en reisepraksis rundt mening; og den er ikke Livssynsutforsker, som sammenligner livssyn og fortolkninger. Gjentatte invitasjoner gir ikke i seg selv medlemskap, representasjonsmyndighet, religiøs autoritet eller profesjonell status. Verden bruker eksisterende scene- og konsekvensflater og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "social_mask",
    "care_vs_efficiency",
    "bureaucratic_power",
    "shame_reputation",
    "public_private_leakage",
    "professional_culture",
    "status_anxiety"
  ],
  "social_environments": [
    "åpne samlinger der en vert gjør deler av aktiviteten tilgjengelig for nye gjester",
    "inngang og plassering der lokale signaler må leses før gjesten tar rom eller rolle",
    "seremonielle sekvenser der observasjon og deltakelse har ulike grenser",
    "pauser, kaffe og måltider der spørsmål, gjestfrihet og personlige behov forhandles sosialt",
    "hverdagsarbeid med rydding, barn, frivillige og praktiske oppgaver som gjør miljøet mindre eksotisk",
    "etterarbeid og deling der én konkret erfaring lett kan bli gjort til en for bred forklaring"
  ],
  "recurring_people_archetypes": [
    {
      "id": "verten",
      "social_function": "avgrenser invitasjonen og gjør gjesterollen forståelig uten å kreve forhåndskunnskap",
      "class_position": "lokal vert med situasjonsmyndighet for den konkrete samlingen",
      "status": "høy på praktisk gjestekunnskap, ikke automatisk talsperson for hele tradisjonen",
      "power_over_player": "kan åpne, avgrense eller avslutte gjestens tilgang til aktiviteter",
      "wants": "at nye gjester kan være trygge uten å forstyrre andre",
      "conceals": "at gjestearbeid kan kreve mer emosjonelt og praktisk arbeid enn gjesten ser",
      "speech_style": "varm, konkret og grensesettende",
      "teaches_player": "at en invitasjon alltid har en faktisk sosial ramme"
    },
    {
      "id": "medlemmet",
      "social_function": "viser hvordan personlige erfaringer kan være informative uten å være universelle",
      "class_position": "deltaker eller medlem med førstehåndserfaring fra eget miljø",
      "status": "legitim stemme om egen erfaring, men ikke nødvendig autoritet for alle",
      "power_over_player": "kan velge om spørsmål besvares og korrigere overgeneralisering",
      "wants": "å delta på egne premisser uten å bli gjort til obligatorisk informant",
      "conceals": "at egen praksis også kan avvike fra andres",
      "speech_style": "personlig, presis og tidvis utålmodig",
      "teaches_player": "at nærhet til én person ikke gir en fasit på en hel tradisjon"
    },
    {
      "id": "frivilligen",
      "social_function": "synliggjør logistikk, mat, rydding og praktisk omsorg bak arrangementet",
      "class_position": "frivillig med konkret arbeidsansvar, uten formell profesjonsmyndighet",
      "status": "høy lokal kunnskap om hvordan samlingen faktisk fungerer",
      "power_over_player": "kan styre praktisk flyt og be gjester bidra eller trekke seg tilbake",
      "wants": "at hverdagsarbeidet fordeles uten at gjester skaper merarbeid",
      "conceals": "at frivillig innsats ofte tas som en usynlig selvfølge",
      "speech_style": "praktisk, humoristisk og direkte",
      "teaches_player": "at religiøse miljøer også består av ordinært sosialt arbeid"
    },
    {
      "id": "medbesokeren",
      "social_function": "speiler gjestens usikkerhet, prestasjonspress og trang til raske konklusjoner",
      "class_position": "likestilt gjest uten intern status",
      "status": "ingen formell autoritet, men kan påvirke hvordan nye gjester tolker situasjonen",
      "power_over_player": "kan normalisere både forsiktig observasjon og sosial overprestasjon",
      "wants": "å gjøre et godt inntrykk og forstå hva som skjer",
      "conceals": "at ønsket om å virke respektfull kan bli en ny form for selvopptatthet",
      "speech_style": "nysgjerrig, rask og litt selvbevisst",
      "teaches_player": "at også gjester skaper sosiale normer for hverandre"
    },
    {
      "id": "arrangementsansvarlig",
      "social_function": "holder grensen mellom offentlig adgang, program, personvern og praktisk sikkerhet",
      "class_position": "person med delegert ansvar for den konkrete aktiviteten",
      "status": "høy situasjonsmyndighet, men ikke nødvendigvis teologisk eller faglig autoritet",
      "power_over_player": "kan fastsette foto-, plass- og deltakelsesgrenser",
      "wants": "at arrangementet skal være åpent uten at åpenheten brukes til å overskride andres grenser",
      "conceals": "at regler ofte er kompromisser mellom ulike hensyn",
      "speech_style": "kort, tydelig og prosedyreorientert",
      "teaches_player": "at offentlig adgang ikke betyr fri bruk av alt som skjer"
    },
    {
      "id": "kildevennen",
      "social_function": "hjelper spilleren å skille observasjon, lokal forklaring og egen tolkning etter besøket",
      "class_position": "kunnskapsinteressert privatperson uten religiøs eller profesjonell myndighet",
      "status": "troverdighet gjennom presise forbehold og kildegrenser",
      "power_over_player": "kan utfordre en elegant, men for bred fortelling",
      "wants": "at besøket blir husket presist fremfor spektakulært",
      "conceals": "at overdreven forsiktighet også kan gjøre erfaringer flate",
      "speech_style": "rolig, konkret og analytisk",
      "teaches_player": "at gjesteerfaring gir situert kunnskap, ikke representasjonsrett"
    }
  ],
