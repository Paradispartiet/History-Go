    "label": "Feltarbeider"
  },
  "title": "Feltarbeider",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å følge religiøse og livssynsrelaterte sosiale sammenhenger over tid med avtalt tilgang, sporbare feltnotater og respekt for menneskers kontroll, uten å gjøre nærhet, mengde materiale eller metodisk disiplin til automatisk forskningsautoritet",
    "description": "Feltarbeider er en employment-independent fieldwork_practice. Rollen handler om avtalt tilgang, feltnotater, løpende samtykke, identifiserbarhet, posisjonalitet, portvoktergrenser, språklig tolking, opptaksgrenser, gjensidighet, utvalgsskjevhet, tidskontekst, feltavslutning og videre bruk av materiale. Den er mer systematisk og relasjonelt langvarig enn Trosstedsvandrerens besøkspraksis, men er ikke Religion/Forskning: den gir ingen akademisk stilling, forskningsetisk godkjenning, institusjonelt mandat, profesjonell metodeautoritet, lønn eller rett til å kalle egne påstander forskningsfunn. Den er også ulik Natur/Feltobservatør, som følger sted- og naturforhold fremfor menneskelige tros- og livssynsmiljøer. Ingen ny runtime introduseres."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "professional_culture",
    "care_vs_efficiency",
    "bureaucratic_power",
    "public_private_leakage",
    "shame_reputation",
    "social_mask",
    "status_anxiety"
  ],
  "social_environments": [
    "avtalte feltperioder der adgang må forhandles konkret og kan endres",
    "sosiale aktiviteter der feltnotater og opptak må avgrenses mot menneskers kontroll",
    "gjentatte feltøkter der nærhet og fortrolighet kan skape falsk innsiderstatus",
    "språklige situasjoner der lokale begreper ikke lar seg redusere til én enkel oversettelse",
    "feltmateriale der synlige deltakere lett kan bli feilaktig behandlet som hele miljøet",
    "etterarbeid der videre bruk, sitater og påstander må holdes innenfor tilgangens og materialets faktiske grenser"
  ],
  "recurring_people_archetypes": [
    {
      "id": "kontaktpersonen",
      "social_function": "åpner og avgrenser praktisk tilgang uten å kunne samtykke på vegne av alle",
      "class_position": "lokal kontakt med organisatorisk oversikt",
      "status": "høy på praktisk adgang, begrenset over andres personlige grenser",
      "power_over_player": "kan invitere, avgrense eller avslutte feltadgang",
      "wants": "forutsigbar feltpraksis som ikke skaper merarbeid eller uro",
      "conceals": "at egne interesser påvirker hvilke personer og situasjoner feltarbeideren får se",
      "speech_style": "praktisk, kort og løsningsorientert",
      "teaches_player": "at portvoktertilgang aldri erstatter individuell kontroll"
    },
    {
      "id": "deltakeren",
      "social_function": "viser hvordan samtykke, identifiserbarhet og videre bruk oppleves fra den som faktisk inngår i materialet",
      "class_position": "person i det sosiale miljøet uten ansvar for feltarbeideren",
      "status": "full myndighet over egen medvirkning, ikke nødvendigvis over miljøet som helhet",
      "power_over_player": "kan trekke seg, korrigere eller begrense hva som brukes",
      "wants": "å kunne delta i eget miljø uten å miste kontroll over personlige opplysninger",
      "conceals": "at grensene kan endres med tema og dagsform",
      "speech_style": "personlig, konkret og grensesettende",
      "teaches_player": "at samtykke er situert og reversibelt"
    },
    {
      "id": "feltvennen",
      "social_function": "utfordrer etterpåklokskap, skjeve utsnitt og ideen om at feltarbeideren er nøytral",
      "class_position": "likestilt privat feltpraktiker uten profesjonell autoritet",
      "status": "troverdig gjennom ryddige notater og selverkjente grenser",
      "power_over_player": "kan avsløre svake slutninger før de blir til bastante påstander",
      "wants": "at materialet forblir sporbarere enn minnet",
      "conceals": "at også egen metode har blinde soner",
      "speech_style": "nøktern, kollegial og korrigerende",
      "teaches_player": "at feltpraksis må tåle usikkerhet"
    },
    {
      "id": "sprakbroen",
      "social_function": "viser hvor oversettelse hjelper og hvor den samtidig kan forflate lokale begreper",
      "class_position": "person med språk- og kontekstkunnskap, uten automatisk tolkningsmonopol",
      "status": "høy på språklig nyanse i konkrete sammenhenger",
      "power_over_player": "kan endre hvordan et begrep eller sitat forstås",
      "wants": "at språklige forskjeller ikke blir visket bort for enkelhets skyld",
      "conceals": "at egne oversettelsesvalg også er fortolkninger",
      "speech_style": "presis, sammenlignende og forbeholden",
      "teaches_player": "at oversettelse er en kunnskapsgrense"
    },
    {
      "id": "den_skeptiske",
      "social_function": "tester om feltarbeideren faktisk respekterer opptaksgrenser, ny bruk og retten til å si nei",
      "class_position": "deltaker som ikke tar feltarbeiderens gode intensjon for gitt",
      "status": "lav formell makt, høy kontroll over eget materiale",
      "power_over_player": "kan nekte opptak, sitat eller videre medvirkning",
      "wants": "at kontrollmuligheter skal være reelle, ikke bare høflige formuleringer",
      "conceals": "at skepsisen også bygger på tidligere dårlige erfaringer",
      "speech_style": "direkte, knapp og prøvende",
      "teaches_player": "at tillatelse må tåle et faktisk nei"
    },
    {
      "id": "notatpartneren",
      "social_function": "skiller feltpraksis fra profesjonell forskning når materialet skal oppsummeres",
      "class_position": "kunnskapsinteressert privatperson uten akademisk mandat",
      "status": "tillit gjennom presise avgrensninger",
      "power_over_player": "kan presse brede formuleringer tilbake til det materialet faktisk støtter",
      "wants": "at påstander ikke får høyere status enn praksisen",
      "conceals": "at sterke forbehold kan gjøre formidlingen mindre imponerende",
      "speech_style": "rolig, analytisk og konkret",
      "teaches_player": "at feltmateriale ikke automatisk er forskningsfunn"
    }
  ],
