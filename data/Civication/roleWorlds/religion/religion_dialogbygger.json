  "title": "Dialogbygger",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å skape møte og samarbeid mellom ulike tros- og livssynsperspektiver uten å presse fram falsk enighet, gjøre enkeltpersoner til grupperepresentanter eller skjule ulik makt og belastning",
    "description": "Dialogbygger-verdenen undersøker invitasjon, rammer, representasjon, begrepsoversettelse, uenighet, fortrolighet, status, broarbeid, konflikt, vertskapsnormer, samarbeid uten konsensus, offentlighet, oppfølging og rollegrenser. Dialogbygger er en community_identity og selvvalgt fellesskapspraksis. Rollen gir ingen automatisk myndighet som trosrepresentant, teolog, jurist, terapeut, profesjonell megler eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "social_mask",
    "care_vs_efficiency",
    "bureaucratic_power",
    "shame_reputation",
    "professional_culture",
    "loyalty_up_down",
    "public_private_leakage"
  ],
  "social_environments": [
    "lokale møteplasser der ulike tros- og livssynsmiljøer inviteres inn på samme arrangement",
    "planleggingsmøter der regler, språk og praktiske rammer kan belaste deltakerne ulikt",
    "samtaler der personlige erfaringer lett blir gjort til representasjon for en hel gruppe",
    "vanskelige diskusjoner der respekt må skilles fra krav om enighet",
    "institusjonelle sammenhenger der offentlig kommunikasjon og omdømme møter fortrolighet",
    "oppfølging over tid der tillit avhenger av små løfter, gjentakelse og delt arbeid"
  ],
  "recurring_people_archetypes": [
    {
      "id": "verten",
      "social_function": "holder praktiske rammer, invitasjon og tilgjengelighet tydelige uten å bestemme hva deltakerne skal mene",
      "class_position": "lokal arrangør eller frivillig uten tros- eller fagmyndighet over deltakerne",
      "status": "synlig gjennom vertskapsrollen, men avhengig av deltakernes tillit",
      "power_over_player": "kan prioritere tid, rom og format og dermed ubevisst favorisere enkelte former for deltakelse",
      "wants": "et trygt møte som faktisk kan gjennomføres",
      "conceals": "at arrangørens standardløsninger ofte oppleves som mer nøytrale enn de er",
      "speech_style": "praktisk, vennlig og opptatt av logistikk",
      "teaches_player": "at god dialog begynner før selve samtalen"
    },
    {
      "id": "den_inviterte",
      "social_function": "viser forskjellen mellom personlig erfaring og å bli gjort til representant for en hel gruppe",
      "class_position": "deltaker med egen tros- eller livssynserfaring uten automatisk representasjonsmandat",
      "status": "høy relevans for egen erfaring, men ikke universell talsperson",
      "power_over_player": "kan korrigere generalisering og sette grenser for hva som kan deles videre",
      "wants": "å bli hørt som person uten å bære hele gruppens forklaringsansvar",
      "conceals": "at også eget miljø kan være internt uenig og sammensatt",
      "speech_style": "personlig, konkret og tydelig når representasjonskrav blir for brede",
      "teaches_player": "at nærhet til et miljø ikke betyr mandat til å representere alle"
    },
    {
      "id": "skeptikeren",
      "social_function": "tester om dialogen tåler reell uenighet og vanskelige tema uten å gå over i prestisjedebatt",
      "class_position": "deltaker som ikke lar høflig konsensus stå uimotsagt",
      "status": "kan oppfattes som krevende, men får verdi når gruppen unngår reelle konflikter",
      "power_over_player": "kan tvinge fram tydeligere formål og skille respekt fra enighet",
      "wants": "at forskjeller skal kunne sies høyt uten at møtet kollapser",
      "conceals": "at skepsis også kan bli en identitet som overser faktisk tillitsbygging",
      "speech_style": "direkte, kritisk og lite imponert av symbolsk enighet",
      "teaches_player": "at dialog uten uenighet lett blir representasjonsteater"
    },
    {
      "id": "institusjonskontakten",
      "social_function": "kobler møteplassen til en større organisasjon, offentlighet og ressurser",
      "class_position": "formell representant med mer institusjonell status enn mange andre deltakere",
      "status": "høy gjennom tittel, tilgang og kommunikasjonskanaler",
      "power_over_player": "kan åpne ressurser men også trekke dialogen mot omdømme, rapportering og synlighet",
      "wants": "at dialogarbeidet skal være synlig, ryddig og legitimt",
      "conceals": "at kommunikasjonshensyn kan gjøre deltakerne til symboler",
      "speech_style": "formell, løsningsorientert og opptatt av ansvar og dokumentasjon",
      "teaches_player": "at institusjonell støtte og relasjonell tillit ikke alltid følger samme logikk"
    },
    {
      "id": "brobyggerkollegaen",
      "social_function": "deler oppklarings-, oversettelses- og reparasjonsarbeid og merker når belastningen blir skjev",
      "class_position": "likestilt frivillig eller deltaker uten profesjonelt meklingsmandat",
      "status": "uformell tillit gjennom evne til å holde flere perspektiver i rommet",
      "power_over_player": "kan avdekke usynlig emosjonelt og språklig arbeid",
      "wants": "at broarbeid blir delt og ikke tas for gitt",
      "conceals": "at også brobyggere kan begynne å definere hva andre egentlig mener",
      "speech_style": "rolig, presis og opptatt av hvem som gjør arbeidet",
      "teaches_player": "at tillit krever delt ansvar, ikke én permanent oversetter"
    },
    {
      "id": "oppfolgingspartneren",
      "social_function": "holder trådene etter møtet og gjør tillit til noe som må vedlikeholdes gjennom konkrete handlinger",
      "class_position": "lokal deltaker uten høy formell status",
      "status": "vokser gjennom pålitelig oppfølging over tid",
      "power_over_player": "kan synliggjøre avstanden mellom gode arrangementer og faktisk relasjon",
      "wants": "små løfter som blir fulgt opp",
      "conceals": "at kontinuitet krever tid og kapasitet som ikke alltid finnes",
      "speech_style": "lavmælt, konkret og opptatt av hvem som gjør hva etterpå",
      "teaches_player": "at dialog først blir relasjon når noen kommer tilbake"
    }
  ],
