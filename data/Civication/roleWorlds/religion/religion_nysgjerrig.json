  },
  "title": "Nysgjerrig",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å utforske religion gjennom spørsmål, kilder, samtaler og sammenligning uten å gjøre nysgjerrighet til medlemskap, privat tilgang, fagstatus eller tolkningsmyndighet",
    "description": "Nysgjerrig er en lavterskel exploration_interest som organiserer de første gjentatte spørsmålene om religion rundt begreper, kilder, intern variasjon, historiske lag og grensen mellom personlig erfaring og bredere påstander. Rollen er ikke Besøkende, som er bundet til en konkret gjestesituasjon; ikke Livssynsutforsker, som sammenligner livssyn og meningssystemer mer systematisk; og ikke Tradisjonskjenner, Ritualkjenner, Symboltolker eller Troslivskjenner, som forutsetter dypere akkumulert literacy. Den er heller ikke Feltarbeider, som har en eksplisitt feltpraksis med tilgang, samtykke og dokumentasjonsansvar. Opparbeidet interesse gir aldri medlemskap, religiøs representasjonsrett, teologisk autoritet, forskerstatus eller profesjonelt mandat."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "social_mask",
    "shame_reputation",
    "public_private_leakage",
    "status_anxiety",
    "public_attention",
    "bureaucratic_power",
    "professional_culture"
  ],
  "social_environments": [
    "privat lesing, oppslag og kildesøk der et spørsmål kan bli mer presist eller bare mer selvsikkert",
    "samtaler med praktiserende, venner og lokale kjennere der personlig erfaring og representasjon må skilles",
    "bibliotek, museum og åpne kunnskapsflater der teksttyper, historiske lag og begreper kan sammenlignes",
    "digitale strømmer og korte forklaringsformater der synlighet, algoritmer og forenkling former hva spilleren møter",
    "foredrag, åpne arrangementer og offentlige samtaler der institusjonell autoritet har et faktisk, men avgrenset virkeområde",
    "etterarbeid og deling der notater, sammenligninger og helhetsinntrykk må få en påstandsstyrke som kildene faktisk bærer"
  ],
  "recurring_people_archetypes": [
    {
      "id": "kildevennen",
      "social_function": "presser gode spørsmål tilbake mot kildetype, belegg og eksplisitte kunnskapsgrenser",
      "class_position": "kunnskapsinteressert privatperson uten religiøst eller profesjonelt mandat",
      "status": "troverdighet gjennom presise forbehold og vilje til å korrigere egne førsteinntrykk",
      "power_over_player": "kan utfordre brede formuleringer og kreve at kildene faktisk bærer påstanden",
      "wants": "at nysgjerrighet skal føre til bedre spørsmål i stedet for sikrere tonefall",
      "conceals": "at egen forkjærlighet for forbehold noen ganger gjør formidlingen unødvendig forsiktig",
      "speech_style": "rolig, kildebevisst og konkret",
      "teaches_player": "at interesse får verdi når påstanden ikke blir sterkere enn grunnlaget"
    },
    {
      "id": "den_praktiserende",
      "social_function": "viser hvordan førstehåndserfaring kan være viktig uten å representere alle som deler en tradisjon",
      "class_position": "deltaker eller troende som taler fra eget liv, ikke på vegne av en hel kategori",
      "status": "høy på egen erfaring og lavere på påtvunget representasjonsansvar",
      "power_over_player": "kan velge hva som deles, avvise private spørsmål og korrigere overgeneralisering",
      "wants": "å bli hørt som person fremfor brukt som illustrasjon av en hel tradisjon",
      "conceals": "at egne erfaringer også er preget av miljø, generasjon og personlige valg",
      "speech_style": "personlig, tydelig og avgrensende",
      "teaches_player": "at én sann erfaring fortsatt bare er én erfaring"
    },
    {
      "id": "bibliotekaren",
      "social_function": "skiller mellom oppslagsverk, historiske kilder, normative tekster og beskrivelser av levd praksis",
      "class_position": "formidler med tilgang til kilder og kataloger, uten teologisk eller trosmessig autoritet",
      "status": "høy på kildeorientering og sjangerforståelse",
      "power_over_player": "kan åpne nye kilder og avsløre at to tilsynelatende like tekster besvarer ulike spørsmål",
      "wants": "at spilleren bruker riktig kildetype til riktig påstand",
      "conceals": "at katalogens orden kan få kunnskapsfeltet til å virke mer ryddig enn det er",
      "speech_style": "nøktern, hjelpsom og klassifiserende",
      "teaches_player": "at tekst, historie og praksis må dokumenteres med forskjellige typer kilder"
    },
    {
      "id": "sprakbroen",
      "social_function": "viser hvor oversettelse gjør forståelse mulig og hvor den samtidig innfører nye assosiasjoner",
      "class_position": "person med språk- og kontekstkunnskap uten monopol på tradisjonens betydning",
      "status": "høy på nyanser i konkrete ord og situasjoner",
      "power_over_player": "kan stoppe en tilsynelatende enkel sammenligning ved å vise hva oversettelsen mister",
      "wants": "at begrepsforskjeller bevares når de faktisk endrer forståelsen",
      "conceals": "at også egne oversettelsesvalg er fortolkninger",
      "speech_style": "presis, sammenlignende og forbeholden",
      "teaches_player": "at et kjent ord ikke alltid betyr at et kjent fenomen er funnet"
    },
    {
      "id": "medleseren",
      "social_function": "speiler spillerens raske funn, kaninhull, delingslyst og behov for en enkel forklaring",
      "class_position": "likestilt nysgjerrig uten formell fag- eller trosstatus",
      "status": "sosial innflytelse gjennom entusiasme, ikke gjennom mandat",
      "power_over_player": "kan forsterke både kildekritikk og fristelsen til å dele en elegant forklaring før den er kontrollert",
      "wants": "at utforskningen skal være levende nok til å fortsette",
      "conceals": "at nyhet ofte føles sannere når den også er overraskende",
      "speech_style": "rask, engasjert og assosiativ",
      "teaches_player": "at entusiasme er drivstoff, ikke dokumentasjon"
    },
    {
      "id": "den_lokale_kjenneren",
      "social_function": "viser at praksis, ritual og autoritet alltid får en konkret lokal og institusjonell form",
      "class_position": "lokal deltaker med erfaring fra eget miljø, uten automatisk representasjonsrett utover det",
      "status": "høy på lokal praksiskunnskap og lavere på universaliserende utsagn",
      "power_over_player": "kan forklare lokale variasjoner og avgrense hvilke regler, autoriteter og betydninger som faktisk gjelder her",
      "wants": "at lokale forskjeller ikke skal reduseres til avvik fra en påstått universell standard",
      "conceals": "at sterk lokal fortrolighet også kan gjøre andre varianter mindre synlige",
      "speech_style": "situert, eksemplifiserende og tidvis korrigerende",
      "teaches_player": "at en tradisjon alltid er større enn ett miljø og samtidig finnes gjennom konkrete miljøer"
    }
  ],
