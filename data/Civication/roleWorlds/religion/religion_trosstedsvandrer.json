  "title": "Trosstedsvandrer",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å besøke tros- og livssynssteder med nysgjerrighet og respekt uten å behandle åpne rom som regeløse, mennesker som informanter på krav eller gjentatte besøk som innsiderstatus",
    "description": "Trosstedsvandrer-verdenen undersøker adgangsregler, klær, fotografering, observasjon mot ritualdeltakelse, spørsmål, hverdagsbruk, kalender og rytme, donasjoner, lokal sosial kode, tilgjengelighet, representasjon, sammenligning, offentlig deling og gjentatte besøk. Trosstedsvandrer er en practice_identity. Rollen gir ingen automatisk myndighet som medlem, trosrepresentant, geistlig, teolog, historiker, guide eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "social_mask",
    "care_vs_efficiency",
    "bureaucratic_power",
    "shame_reputation",
    "public_private_leakage",
    "professional_culture",
    "status_anxiety"
  ],
  "social_environments": [
    "inngangssoner der gjester må lese lokale regler før de beveger seg videre",
    "ritual- og samlingsrom der observasjon, deltakelse og fotografering har ulike grenser",
    "hverdagsarealer med mat, barn, frivillighet og praktisk arbeid som utfordrer et rent høytidsblikk",
    "eldre eller komplekse bygg der fysisk tilgjengelighet og bevaring møtes",
    "samtaler med medlemmer, frivillige og andre besøkende der representasjon og forklaringsplikt må avgrenses",
    "etterarbeid og sosial deling der én observasjon lett kan bli til en for bred påstand"
  ],
  "recurring_people_archetypes": [
    {
      "id": "verten",
      "social_function": "forklarer lokale regler, adgang og hva gjester kan delta i",
      "class_position": "lokal vert eller ansvarlig med situasjonsmyndighet på stedet",
      "status": "høy på egne regler, ikke automatisk representant for hele tradisjonen",
      "power_over_player": "kan åpne eller avgrense rom og aktiviteter",
      "wants": "at besøkende forstår stedet uten å forstyrre praksisen",
      "conceals": "at gjestearbeid kan være slitsomt og ujevnt fordelt",
      "speech_style": "vennlig, tydelig og konkret",
      "teaches_player": "at etikette er lokal og situasjonsbundet"
    },
    {
      "id": "praktikeren",
      "social_function": "viser forskjellen mellom å være synlig i et rom og å være tilgjengelig som informant eller representant",
      "class_position": "person som bruker stedet for egen praksis",
      "status": "førstehåndskunnskap om egen erfaring, ikke universell autoritet",
      "power_over_player": "kan avvise spørsmål, foto eller generaliseringer",
      "wants": "å kunne bruke stedet uten å bli gjort til undervisningsobjekt",
      "conceals": "at også egen praksis kan være utypisk",
      "speech_style": "personlig, nøktern og grensesettende",
      "teaches_player": "at enkeltpersoner ikke skylder besøkende forklaringer"
    },
    {
      "id": "frivilligverten",
      "social_function": "synliggjør hverdagsarbeid, logistikk og fellesskapsfunksjoner bak det høytidelige rommet",
      "class_position": "frivillig med praktisk ansvar",
      "status": "høy lokal kunnskap om drift og rutiner",
      "power_over_player": "kan styre gjesteflyt og praktiske forventninger",
      "wants": "at stedet skal fungere for både brukere og besøkende",
      "conceals": "at frivillig arbeid ofte tas for gitt",
      "speech_style": "praktisk, varm og lite seremoniell",
      "teaches_player": "at trossteder også er hverdagslige sosiale infrastrukturer"
    },
    {
      "id": "medbesokeren",
      "social_function": "speiler besøksblikket og gjør stereotype forventninger eller rangeringer synlige",
      "class_position": "likestilt gjest uten lokal myndighet",
      "status": "ingen formell status, men påvirker gruppens tone",
      "power_over_player": "kan normalisere både respektfulle og forbrukerorienterte vaner",
      "wants": "å forstå og oppleve noe nytt",
      "conceals": "at jakten på sterke opplevelser kan styre vurderingene",
      "speech_style": "nysgjerrig, rask og sammenlignende",
      "teaches_player": "at gjester også former hverandres blikk"
    },
    {
      "id": "tilgjengelighetsgjesten",
      "social_function": "viser hvem rom, trapper, informasjon og praksiser faktisk er tilgjengelige for",
      "class_position": "besøkende med konkrete tilgjengelighetsbehov",
      "status": "førstehåndskunnskap om egen tilgangssituasjon",
      "power_over_player": "kan utfordre en ren estetisk eller symbolsk beskrivelse av stedet",
      "wants": "forutsigbar informasjon og reell tilgang der det er mulig",
      "conceals": "at det er slitsomt å måtte spørre om samme forhold gjentatte ganger",
      "speech_style": "presis, praktisk og direkte",
      "teaches_player": "at respekt for sted også inkluderer hvem som faktisk kan bruke det"
    },
    {
      "id": "kildevennen",
      "social_function": "skiller observasjon, lokal forklaring og generalisering i etterarbeidet",
      "class_position": "kunnskapsinteressert privatperson uten teologisk eller historisk autoritet",
      "status": "tillit gjennom presise kilder og forbehold",
      "power_over_player": "kan endre en elegant bildetekst til en mer nøktern beskrivelse",
      "wants": "at besøkskunnskap ikke blir til overdrevne universelle påstander",
      "conceals": "at presisjon også kan gjøre formidling mindre umiddelbar",
      "speech_style": "rolig, kildebevisst og konkret",
      "teaches_player": "at stedskunnskap krever kontekst"
    }
  ],
