  "title": "Livssynsutforsker",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å sammenligne hvordan mennesker gir mening til liv, død, fellesskap og ritualer uten å gjøre grupper homogene, ytre praksis til sikker privat tro eller sammenligning til rangering",
    "description": "Livssynsutforsker-verdenen undersøker begrepsbetydning, lære mot levd praksis, ritual mot antatt overbevisning, gruppelabel mot person, historiske kilder mot nåtid, majoritets- og minoritetsposisjon, analytiske kategorier, innenfra- og utenfraspråk, sammenligning uten rangering, kildetyper, endring over tid, offentlig identitet mot privat overbevisning, samtaleetikk og rollegrenser. Livssynsutforsker er en knowledge_identity og selvvalgt kunnskapsinteresse. Rollen gir ingen automatisk myndighet som trosrepresentant, prest, imam, teolog, humanistisk talsperson, jurist, religionsforsker eller annen fagperson, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "social_mask",
    "shame_reputation",
    "bureaucratic_power",
    "public_private_leakage",
    "professional_culture",
    "class_power",
    "public_attention"
  ],
  "social_environments": [
    "lesesirkler der like ord brukes i ulike tradisjoner og må forstås i sin egen sammenheng",
    "tros- og livssynssteder der lokale regler, rom og ritualer kan observeres uten at privat tro antas",
    "samtaler der selvbeskrivelse, gruppetilhørighet og personlig endring ikke alltid peker samme vei",
    "historiske og institusjonelle kilder som beskriver andre tidspunkter eller andre formål enn levd praksis i dag",
    "nabolag der majoritetsvaner og minoritetsposisjoner påvirker synlighet og praktiske rammer",
    "private refleksjoner der sammenligning kan gi ny forståelse uten å bli en rangering av mennesker eller livssyn"
  ],
  "recurring_people_archetypes": [
    {
      "id": "lesesirkelvennen",
      "social_function": "sammenligner tekster og begreper på tvers av tradisjoner uten å kreve at like ord betyr det samme",
      "class_position": "likestilt leser uten teologisk eller religionsvitenskapelig mandat",
      "status": "troverdig gjennom faktisk lesing og vilje til å slå opp begreper",
      "power_over_player": "kan gjøre elegante likheter fristende før kildegrunnlaget er kontrollert",
      "wants": "et språk for sammenligning som ikke visker ut forskjeller",
      "conceals": "at egne favoritttekster får mer oppmerksomhet enn andre kilder",
      "speech_style": "nysgjerrig, tekstnær og glad i presise definisjoner",
      "teaches_player": "at sammenligning begynner med å forstå ordene lokalt"
    },
    {
      "id": "praksisvennen",
      "social_function": "holder levd hverdagspraksis synlig når spilleren fokuserer for mye på normative tekster og institusjoner",
      "class_position": "privat deltaker med situasjonskunnskap, ikke representant for en hel gruppe",
      "status": "høy relevans for egen erfaring og miljøet vedkommende faktisk kjenner",
      "power_over_player": "kan vise avstanden mellom offisiell framstilling og hverdagsliv",
      "wants": "at praksis beskrives som variert og konkret",
      "conceals": "at egen erfaring heller ikke representerer alle andre",
      "speech_style": "jordnær, personlig og konkret",
      "teaches_player": "at levd religion og livssyn ikke kan utledes fullstendig fra lære"
    },
    {
      "id": "besoksverten",
      "social_function": "forklarer lokale regler, rom og ritualer uten å kreve at alle deltakere deler samme mening",
      "class_position": "lokal vert eller frivillig med stedskunnskap, ikke automatisk tros- eller fagautoritet",
      "status": "praktisk autoritet i det konkrete besøket",
      "power_over_player": "kan sette grenser for fotografering, spørsmål og hvordan rommet brukes",
      "wants": "et respektfullt besøk med tydelige forventninger",
      "conceals": "at lokale rutiner kan være særpregede og ikke universelle",
      "speech_style": "vennlig, praktisk og tydelig på etikette",
      "teaches_player": "at respekt begynner med konkrete lokale normer"
    },
    {
      "id": "kildegranskeren",
      "social_function": "skiller historiske, institusjonelle, personlige og akademiske kilder og undersøker rekkevidden deres",
      "class_position": "kildeinteressert deltaker uten profesjonell forskerrolle",
      "status": "troverdig når avsender, dato og formål blir uklare",
      "power_over_player": "kan stoppe brede påstander ved å spørre hvem kilden faktisk beskriver",
      "wants": "sporbare påstander med tydelig tid og avsender",
      "conceals": "at også gode kilder krever fortolkning",
      "speech_style": "nøktern, dokumenterende og kildeorientert",
      "teaches_player": "at kildepluralitet er nødvendig når fenomenet selv er mangfoldig"
    },
    {
      "id": "samtalepartneren",
      "social_function": "viser hvordan personlig livssyn kan endres og hvordan gruppelabel og selvbeskrivelse ikke alltid overlapper",
      "class_position": "privat person med myndighet over egen selvbeskrivelse, ikke over hele tradisjonen",
      "status": "førstehåndskilde til egen erfaring",
      "power_over_player": "kan korrigere kategorier, avvise spørsmål og endre hvordan egen historie formuleres",
      "wants": "å bli møtt som person og ikke eksempel",
      "conceals": "at egen forståelse også kan være i bevegelse",
      "speech_style": "personlig, nyansert og tydelig på grenser",
      "teaches_player": "at individets egen beskrivelse må få plass ved siden av analytiske kategorier"
    },
    {
      "id": "nabolagsvennen",
      "social_function": "holder majoritetsvaner, minoritetsposisjon, offentlig synlighet og praktiske rammer med i sammenligningen",
      "class_position": "lokal observatør uten mandat til å rangere miljøer",
      "status": "troverdig gjennom langvarig kjennskap til nærmiljøet",
      "power_over_player": "kan vise hvordan samme formelle regel møter ulike sosiale utgangspunkt",
      "wants": "at institusjoner og hverdagsliv ses sammen",
      "conceals": "at lokal kjennskap kan bli for generell når byen endrer seg",
      "speech_style": "konkret, stedfestet og lite glad i abstrakte totalbilder",
      "teaches_player": "at livssyn også har en sosial og romlig kontekst"
    }
  ],
