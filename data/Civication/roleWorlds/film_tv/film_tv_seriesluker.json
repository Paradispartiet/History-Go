  "title": "Seriesluker",
  "status": "role_world_draft",
  "sociological_core": {
    "main_problem": "å balansere lange serieløp, fullføring, utgivelsesrytme og sosialt tempo",
    "description": "Seriesluker handler om fortløpende serieforbruk: neste episode, sesonglengde, finaler, recaps, spoilere, delt tempo, se-lister, tilgang og retten til å slutte. Den skiller seg fra Seer ved at lange serieløp og episodisk kontinuitet er kjernen. Ingen ny runtime opprettes."
  },
  "theme_ids": [
    "consumption",
    "care_vs_efficiency",
    "public_private_leakage",
    "alienation",
    "social_mask",
    "class_power",
    "precarity",
    "status_anxiety",
    "shame_reputation"
  ],
  "social_environments": [
    "hjemmekvelder med autoplay og cliffhangere",
    "venne- og parforhold med delt serietempo",
    "gruppechatter med ulike spoilergrenser",
    "plattformvalg med katalog- og abonnementsfriksjon",
    "fanprat om sesonglengde og finaler",
    "private se-lister som kan bli backlog"
  ],
  "recurring_people_archetypes": [
    {
      "id": "medseer_som_vil_vente",
      "social_function": "gjør delt tempo konkret",
      "class_position": "jevnaldrende seer",
      "status": "likestilt",
      "power_over_player": "kan påvirke felles tempo",
      "wants": "å dele serien i avtalt tempo",
      "conceals": "egen usikkerhet",
      "speech_style": "direkte",
      "teaches_player": "at felles seing krever avtale"
    },
    {
      "id": "ferdig_forst",
      "social_function": "gjør spoilerpress synlig",
      "class_position": "jevnaldrende seer",
      "status": "likestilt",
      "power_over_player": "kan sette samtaletempo",
      "wants": "å diskutere det siste",
      "conceals": "egen utålmodighet",
      "speech_style": "ivrig",
      "teaches_player": "at tempo kan bli sosial rang"
    },
    {
      "id": "recap_brukeren",
      "social_function": "normaliserer recap",
      "class_position": "jevnaldrende seer",
      "status": "likestilt",
      "power_over_player": "kan påvirke samtalen",
      "wants": "å huske hovedlinjene",
      "conceals": "egen glemsel",
      "speech_style": "kortfattet",
      "teaches_player": "at recap er legitimt"
    },
    {
      "id": "plattformhopperen",
      "social_function": "gjør tilgang synlig",
      "class_position": "jevnaldrende seer",
      "status": "likestilt",
      "power_over_player": "kan påvirke tilgangsvalg",
      "wants": "relevant tilgang",
      "conceals": "egne impulskjøp",
      "speech_style": "praktisk",
      "teaches_player": "at tilgang er del av praksisen"
    },
    {
      "id": "finalediskutanten",
      "social_function": "gjør finaleuenighet konkret",
      "class_position": "erfaren seer",
      "status": "likestilt",
      "power_over_player": "kan utfordre vurderingen",
      "wants": "å diskutere avslutningen",
      "conceals": "egen investering",
      "speech_style": "engasjert",
      "teaches_player": "at en finale kan vurderes separat fra helheten"
    },
    {
      "id": "venn_som_sluttet",
      "social_function": "viser at det er legitimt å stoppe",
      "class_position": "tidligere medseer",
      "status": "likestilt",
      "power_over_player": "kan utfordre fullføringsnormen",
      "wants": "å bruke fritiden på noe som fortsatt gir verdi",
      "conceals": "egen nøling før stopp",
      "speech_style": "avklart",
      "teaches_player": "at tidligere investering ikke krever videre seing"
    }
