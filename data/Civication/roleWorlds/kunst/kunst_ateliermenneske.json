  "title": "Ateliermenneske",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å holde en delt skapende atelierpraksis åpen, gjensidig og materiell bærekraftig når plass, verktøy, kritikk, samarbeid, økonomi og sosial status hele tiden frister til uformelt eierskap eller lånt autoritet",
    "description": "Ateliermenneske-verdenen følger en livsposisjon der spilleren henger i og rundt atelierer, materialer og halvferdige verk uten at kunst nødvendigvis er jobben. Spilleren møter delte rom, materialgrenser, kollegial kritikk, uferdig arbeid, verktøysikkerhet, åpne atelierer, husleie, dokumentasjon, samarbeid, kreditering og usynlig vedlikeholdsarbeid. Rollen gir ingen profesjonell kunstnerstatus, ingen kurator-, gallerist-, konservator-, verkstedfaglig eller institusjonell myndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "professional_culture",
    "class_power",
    "status_anxiety",
    "shame_reputation",
    "precarity",
    "invisible_work",
    "care_vs_efficiency",
    "local_knowledge_vs_system"
  ],
  "social_environments": [
    "det delte atelieret der lys, flater, lagring og ro er knappe ressurser som må fordeles sosialt",
    "materialhyllen der felleseie, lån, forbruk og privat eierskap må skilles uten formelle kontrakter",
    "arbeidsbordet der kollegial kritikk kan utvikle arbeid uten å bli en uoppnevnt jury",
    "verkstedsonen der tilgang til utstyr må holdes adskilt fra faktisk opplæring og sikkerhetskompetanse",
    "studiobesøket der privat skapende praksis blir midlertidig offentlig uten at medbrukernes arbeid blir sosial valuta",
    "åpent atelier der kulturelle koder, språk og nettverk avgjør hvor åpen en åpen dør faktisk oppleves",
    "ateliermøtet der husleie, kvadratmeter og ulik betalingsevne former hvem som kan opprettholde praksisen",
    "kveldens rydding der den kreative identiteten møter vedlikehold, avfall og annet usynlig arbeid"
  ],
  "recurring_people_archetypes": [
    {
      "id": "ateliernaboen",
      "social_function": "deler rom, rytmer og uformell kritikk med spilleren",
      "class_position": "medbruker med varierende økonomisk og kunstfaglig bakgrunn uten myndighet over fellesskapet",
      "status": "situert status gjennom erfaring og tilstedeværelse, men ikke formell autoritet",
      "power_over_player": "kan åpne samarbeid, kritikk og hverdagsinformasjon eller gjøre plassen sosialt vanskelig å bruke",
      "wants": "et rom der egen praksis får tid samtidig som fellesskapet fungerer",
      "conceals": "hvor ofte egne vaner også legger arbeid og plasskostnader over på andre",
      "speech_style": "direkte, prosessorientert og full av små praktiske observasjoner",
      "teaches_player": "at deling av rom krever eksplisitte grenser selv mellom mennesker som liker hverandre"
    },
    {
      "id": "verkstedansvarlig",
      "social_function": "holder sikkerhet, opplæring og vedlikehold rundt felles utstyr samlet",
      "class_position": "funksjonell kunnskapsbærer med situert ansvar for verkstedsbruk, uten kuratorisk eller kunstnerisk myndighet",
      "status": "høy når sikkerhet og verktøybruk står på spill",
      "power_over_player": "kan stoppe bruk, kreve opplæring og prioritere vedlikehold foran tempo",
      "wants": "at utstyr og mennesker skal tåle at mange eksperimenterer i samme rom",
      "conceals": "hvor mye rutinearbeid som kreves for at verkstedet skal oppleves spontant",
      "speech_style": "kort, konkret og opptatt av rekkefølge, vern og hva som faktisk er avtalt",
      "teaches_player": "at tilgang aldri er det samme som kompetanse"
    },
    {
      "id": "den_nye_medbrukeren",
      "social_function": "gjør uskrevne atelierkoder synlige ved å ikke kjenne dem ennå",
      "class_position": "ny deltaker med lav intern status, men samme grunnleggende rett til plass og informasjon",
      "status": "lav eller uavklart i nettverket",
      "power_over_player": "avslører om spillerens erfaring brukes til vertskap eller gatekeeping",
      "wants": "å finne en måte å delta på uten å måtte gjette alle sosiale regler",
      "conceals": "hvor kostbart det føles å spørre om ting alle andre later som er selvsagte",
      "speech_style": "forsiktig, praktisk og spørsmålsdrevet",
      "teaches_player": "at inkluderende praksis krever mer enn en fysisk åpen dør"
    },
    {
      "id": "atelierforvalteren",
      "social_function": "forvalter kontrakt, husleie, nøkler og arealfordeling rundt atelieret",
      "class_position": "institusjonell eller eiendomsnær aktør med materiell makt over hvem som får bli",
      "status": "høy i spørsmål om kostnad, adgang og areal",
      "power_over_player": "kan endre pris, plass og tilgang uten å definere verdien av arbeidet som skjer der",
      "wants": "at lokalet skal være økonomisk og praktisk bærekraftig",
      "conceals": "hvordan nøytrale kostnadsmodeller kan favorisere dem med mest kapital",
      "speech_style": "saklig, budsjettorientert og opptatt av kvadratmeter, drift og frister",
      "teaches_player": "at kreativ autonomi alltid er forankret i materielle vilkår"
    },
    {
      "id": "den_kritiske_vennen",
      "social_function": "tester hvordan spilleren forklarer, dokumenterer og verdsetter atelierpraksisen utenfra",
      "class_position": "nær relasjon uten intern atelierrolle",
      "status": "høy privat betydning, lav formell innflytelse i atelieret",
      "power_over_player": "kan trigge behov for å virke mer profesjonell, nettverkssterk eller sikker enn spilleren er",
      "wants": "å forstå hva spilleren faktisk gjør og om det kan bli noe mer",
      "conceals": "at spørsmål om verdi og karriere også kan være omsorg blandet med statusforventning",
      "speech_style": "nysgjerrig, direkte og rask til å spørre om hvem som har laget hva og om noen vil kjøpe",
      "teaches_player": "at privat anerkjennelse ikke bør presses om til profesjonell status"
    },
    {
      "id": "samarbeidspartneren",
      "social_function": "gjør bidrag, kreditering og opphav konkrete når et arbeid ikke lenger er entydig individuelt",
      "class_position": "jevnaldrende med reelt bidrag til ett eller flere arbeider",
      "status": "forhandles gjennom bidrag og synlighet snarere enn tittel",
      "power_over_player": "kan kreve tydelig kreditering, trekke samtykke eller endre hvordan et felles arbeid kan deles",
      "wants": "at samarbeidets faktiske bidrag skal være synlige og forståelige",
      "conceals": "hvor ulikt partene kan huske når et råd ble til et medskapende valg",
      "speech_style": "prosessnær, konkret og opptatt av hvem som gjorde hvilke valg",
      "teaches_player": "at kreditering må avklares før offentligheten tvinger fram et enkelt navn"
    }
  ],
