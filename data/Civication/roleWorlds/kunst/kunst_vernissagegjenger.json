  },
  "title": "Vernissagegjenger",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å navigere kunståpningenes invitasjoner, nettverk, sladder, synlighet og status uten å gjøre sosial tilgang til eierskap, økonomisk rådgivning eller lånt faglig autoritet",
    "description": "Vernissagegjenger-verdenen følger en sosial livsposisjon rundt kunståpninger: invitasjoner, ankomstkoder, introduksjoner, navnekunnskap, kunstnergrenser, fotografering, omdømme, usynlig arrangementsarbeid, nykommerterskler, markedssnakk, kritikk og overgangen fra offentlig åpning til privat etterrom. Rollen gir ingen kurator-, gallerist-, kunsthandler-, kritiker-, proveniens-, salgs- eller institusjonell myndighet. Et avgrenset betalt arrangementsskift endrer heller ikke dette, og verden introduserer ingen ny runtime."
  },
  "theme_ids": [
    "professional_culture",
    "class_power",
    "status_anxiety",
    "shame_reputation",
    "public_private_leakage",
    "public_attention",
    "invisible_work",
    "care_vs_efficiency"
  ],
  "social_environments": [
    "inngangen der invitasjoner, gjestelister og uskrevne regler avgjør hvem som føler seg velkommen",
    "det fulle åpningsrommet der grupper, navn og blikk gjør nettverk til synlig sosial kapital",
    "kunstnersamtalen der offentlig oppmerksomhet møter personens rett til tid og grenser",
    "bakrommet der rykter og uformell informasjon kan flytte omdømme raskere enn noen tar ansvar",
    "garderoben og serveringssonen der usynlig arbeid bærer arrangementets prestisje",
    "markedssamtalen der pris, samlerinteresse og sosial hype lett forveksles med økonomisk kunnskap",
    "veien videre etter åpningen der det offentlige arrangementet glir over i private adresser og nye adgangsgrenser",
    "det avgrensede ekstraskiftet der praktisk arrangementsarbeid ikke blir en snarvei til kunstfaglig myndighet"
  ],
  "recurring_people_archetypes": [
    {
      "id": "nettverksgjengangeren",
      "social_function": "gjør navn, invitasjoner og sosial gjenkjennelse til synlig kapital",
      "class_position": "ressurssterk gjenganger med stort uformelt nettverk uten formell myndighet",
      "status": "høy uformell status fordi personen kjenner mange og blir gjenkjent raskt",
      "power_over_player": "kan åpne introduksjoner eller gjøre sosial tilhørighet til opptaksprøve",
      "wants": "å være sentral uten å miste oversikt over hvem som beveger seg hvor",
      "conceals": "hvor avhengig statusen er av at andre fortsatt oppfatter nettverket som verdifullt",
      "speech_style": "rask, navnetett og oppdatert på hvem som kommer videre",
      "teaches_player": "at nettverk kan fungere som både infrastruktur og rang"
    },
    {
      "id": "kunstneren_pa_apning",
      "social_function": "gjør kunstnerens tid, oppmerksomhet og private grenser konkrete",
      "class_position": "opphaver med høy symbolsk synlighet under arrangementet",
      "status": "høy i rommet, men samtidig utsatt for kontinuerlige krav på kontakt",
      "power_over_player": "kan åpne eller lukke samtaler og definere hva som er privat eller offentlig fra egen side",
      "wants": "å møte publikum uten å bli sosial ressurs for alle samtidig",
      "conceals": "hvor utmattende offentlig tilgjengelighet kan være",
      "speech_style": "kort eller varm avhengig av kapasitet, men tydelig når grensen er nådd",
      "teaches_player": "at offentlig synlighet ikke betyr ubegrenset tilgjengelighet"
    },
    {
      "id": "forstegangsbesokende",
      "social_function": "gjør de uskrevne reglene synlige ved å spørre om dem",
      "class_position": "ny deltaker med lav intern kunstfeltkapital",
      "status": "lav eller uavklart i nettverket",
      "power_over_player": "avslører om erfaring brukes som vertskap eller gatekeeping",
      "wants": "å delta uten å måtte bevise riktig smak, språk eller kontakter",
      "conceals": "hvor lett usikkerhet blir til tilbaketrekning i et ellers åpent rom",
      "speech_style": "praktisk, forsiktig og spørsmålsdrevet",
      "teaches_player": "at sosial tilgjengelighet må produseres aktivt"
    },
    {
      "id": "arrangementsverten",
      "social_function": "holder gjesteliste, publikumsflyt og praktiske grenser sammen",
      "class_position": "frontlinjearbeider eller arrangør med situert arrangementsmyndighet",
      "status": "høy i praktiske spørsmål, ikke automatisk kuratorisk eller salgsfaglig",
      "power_over_player": "kan avklare adgang, kapasitet og hvem som håndterer andre spørsmål",
      "wants": "at åpningen fungerer uten konflikter, overfylte rom eller feilrepresentasjon",
      "conceals": "hvor mye improvisasjon som ligger bak et tilsynelatende uformelt arrangement",
      "speech_style": "vennlig, tydelig og praktisk",
      "teaches_player": "at vertskap og faglig kunstmyndighet er ulike roller"
    },
    {
      "id": "samleren",
      "social_function": "gjør pris, status og forventninger om framtidig verdi synlige",
      "class_position": "kapitalsterk deltaker med markedsmakt, men uten rett til å definere kunsthistorisk verdi alene",
      "status": "høy fordi kjøpekraft og relasjoner påvirker feltet",
      "power_over_player": "kan gjøre markedsprat sosialt overbevisende og presse spilleren til å gi økonomiske vurderinger",
      "wants": "å oppdage arbeid tidlig og forstå hvor oppmerksomheten beveger seg",
      "conceals": "hvor usikkert eget markedsspråk også kan være",
      "speech_style": "selvsikker, komparativ og opptatt av priser, navn og momentum",
      "teaches_player": "at markedsnærhet ikke er det samme som investeringskunnskap"
    },
    {
      "id": "den_praktiske_koordinatoren",
      "social_function": "tilbyr og avgrenser et lite betalt arrangementsskift",
      "class_position": "lokal oppdragsgiver med kontroll over praktiske oppgaver på én åpning",
      "status": "funksjonell status gjennom logistikk, ikke kunstfaglig mandat",
      "power_over_player": "kan tilby arbeid og definere oppgaver, men ikke gjøre spilleren til kurator, selger eller institusjonell representant",
      "wants": "at arrangementet flyter trygt og ryddig",
      "conceals": "hvor lett intern tilgang kan oppleves som høyere faglig status enn oppdraget faktisk gir",
      "speech_style": "kort, praktisk og tydelig på scope",
      "teaches_player": "at betaling og bakromstilgang ikke skaper profesjonell kunstautoritet"
    }
  ],
