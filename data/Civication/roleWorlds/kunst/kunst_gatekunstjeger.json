  },
  "title": "Gatekunstjeger",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å dokumentere forgjengelig gatekunst med sporbarhet, lokal kontekst og respekt for sted, mennesker og rettigheter uten å gjøre samlingen til fasit eller egen interesse til profesjonell myndighet",
    "description": "Gatekunstjeger-verdenen følger en spiller som leter etter vegger, underganger og midlertidige uttrykk før de forsvinner. Praksisen trener datering, attribusjonsforsiktighet, foto- og stedskontekst, personvern, tilgangsgrenser, geotagging, lokal kunnskap, overmaling, kommersialisering, materialomsorg, kartleggingsbias og rettighetsskiller. Rollen gir ingen kunsthistoriker-, autentisator-, kurator-, konservator-, politi-, saksbehandler-, rettighetshaver- eller offentlig registratormyndighet, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "public_attention",
    "professional_culture",
    "class_power",
    "shame_reputation",
    "bureaucratic_power",
    "care_vs_efficiency",
    "public_private_leakage"
  ],
  "social_environments": [
    "undergangen der et nytt lag kan være synlig én dag og overmalt den neste",
    "gatehjørnet der dokumentasjon av et verk samtidig fanger mennesker, trafikk og privatliv",
    "bakgårdsgrensen der et synlig motiv ikke gjør privat eller avstengt område offentlig tilgjengelig",
    "nabolagssamtalen der muntlige minner og lokale konflikter endrer hvordan en vegg kan forstås",
    "kartappen der presise lokasjoner kan spre oppmerksomhet raskere enn stedet tåler",
    "det private bildearkivet der utvalg, ruter og manglende metadata former hva som senere fremstår som byens historie",
    "den sosiale plattformen der usikre attribusjoner kan bli hardere fakta for hver deling",
    "rettighetsforespørselen der fotografens fil, kunstverkets opphav og brukstillatelser må holdes fra hverandre"
  ],
  "recurring_people_archetypes": [
    {
      "id": "nabolagsbeboeren",
      "social_function": "bærer stednære minner om vegger, overmalinger og lokale hendelser",
      "class_position": "lokal deltaker med erfaringskunnskap uten formell kunstfaglig myndighet",
      "status": "høy når tidslinjer og endringer i nærmiljøet skal forstås",
      "power_over_player": "kan åpne kontekst som ikke finnes i bildearkivet og korrigere samlerens utenfrablikk",
      "wants": "at stedet og menneskene rundt veggen ikke reduseres til kulisse",
      "conceals": "hvor mye eget minne også er formet av senere fortellinger og konflikt",
      "speech_style": "stedsspesifikk, episodisk og full av før-og-etter-referanser",
      "teaches_player": "at lokalkunnskap er en kilde som må kontekstualiseres, ikke pynt"
    },
    {
      "id": "kunstneren_med_pseudonym",
      "social_function": "gjør spørsmål om attribusjon, anonymitet og kontroll over eget arbeid konkrete",
      "class_position": "opphaver med situert kunnskap om egen praksis, men ikke nødvendigvis offentlig identitet",
      "status": "kan være høy symbolsk status samtidig som identiteten er skjult eller omstridt",
      "power_over_player": "kan bekrefte, avvise eller la attribusjon forbli uavklart og sette grenser for deling",
      "wants": "å beholde kontroll over hva som faktisk kan knyttes til personen eller pseudonymet",
      "conceals": "hvor strategisk anonymitet, crews og skiftende signaturer kan være",
      "speech_style": "knapp, selektiv og tydelig på hva som ikke skal kobles sammen",
      "teaches_player": "at et gjenkjennelig uttrykk ikke opphever retten til attribusjonsforsiktighet"
    },
    {
      "id": "bildearkivaren",
      "social_function": "viser hvordan metadata, filnavn, datoer og utvalg gjør private bilder etterprøvbare eller villedende",
      "class_position": "erfaren dokumentasjonsutøver uten automatisk museum-, arkiv- eller registratormandat",
      "status": "høy i spørsmål om sporbar dokumentasjon, begrenset utenfor eget materiale",
      "power_over_player": "kan lære bort kildepraksis og synliggjøre hull i spillerens samling",
      "wants": "at bilder skal kunne forstås også etter at veggen og minnene har endret seg",
      "conceals": "hvor mye også et ryddig arkiv bærer samlerens egne ruter og preferanser",
      "speech_style": "metadataorientert, konkret og skeptisk til sikre påstander uten dato og kontekst",
      "teaches_player": "at dokumentasjon alltid er et utvalg"
    },
    {
      "id": "gaardeieren",
      "social_function": "representerer materiell rådighet, vedlikehold og adgang rundt en vegg",
      "class_position": "eier eller forvalter med kontroll over fysisk tilgang, men ikke automatisk kunstfaglig autoritet",
      "status": "høy i spørsmål om adgang, vedlikehold og bruk av eiendommen",
      "power_over_player": "kan åpne eller stenge tilgang og beslutte vedlikehold innenfor sin faktiske rådighet",
      "wants": "at eiendommen skal fungere uten uavklarte kostnader, risiko eller trafikk",
      "conceals": "at økonomiske og praktiske valg også former hvilke kulturelle spor som overlever",
      "speech_style": "praktisk, eiendomsorientert og opptatt av ansvar, skade og tilgang",
      "teaches_player": "at offentlig synlighet og fysisk eierskap er ulike lag"
    },
    {
      "id": "den_andre_gatekunstjegeren",
      "social_function": "tester status, konkurranse, attribusjon og delingsnormer mellom samlere",
      "class_position": "jevnaldrende hobby- eller praksisutøver med eget bildearkiv og nettverk",
      "status": "uformell status gjennom hvor tidlig og bredt personen oppdager spor",
      "power_over_player": "kan spre metadata, utfordre attribusjoner og gjøre oppdagelser til sosial valuta",
      "wants": "å være tidlig ute og ha den mest interessante oversikten uten å miste tillit",
      "conceals": "hvor ofte sikkerheten i påstandene øker når konkurransen om kreditering blir sterkere",
      "speech_style": "rask, stedskjent og referansetett",
      "teaches_player": "at samlerstatus kan presse usikkerhet ut av dokumentasjonen"
    },
    {
      "id": "kulturforvalteren",
      "social_function": "kobler offentlige regler, vedlikehold og kulturminnehensyn til konkrete steder uten å gjøre spilleren til saksbehandler",
      "class_position": "institusjonell aktør med avgrenset offentlig mandat",
      "status": "høy i formelle spørsmål om kommunale eller forvaltede flater",
      "power_over_player": "kan forklare prosedyrer, ansvar og hvorfor enkelte spor dokumenteres eller fjernes",
      "wants": "at påstander om offentlig praksis skilles fra antakelser og rykter",
      "conceals": "hvor fragmentert ansvaret kan være mellom eiendom, drift, kultur og andre enheter",
      "speech_style": "presis, prosedyreorientert og forsiktig med å love mer enn eget mandat",
      "teaches_player": "at offentlig systemkunnskap ikke kan erstattes av å lese tegn på veggen"
    }
  ],
