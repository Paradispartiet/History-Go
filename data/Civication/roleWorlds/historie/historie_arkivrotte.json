  "title": "Arkivrotte",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å finne, lese og koble historiske spor uten å rive dokumenter løs fra proveniens, samlingshistorie, materialitet, adgangsregler og usikkerhet",
    "description": "Arkivrotte-verdenen følger en historieinteresse som trives mellom kataloger, mapper, mikrofilm og gamle dokumenter. Spilleren lærer å gjøre kildejakt sporbar: dokumentere signaturer, kontrollere proveniens, håndtere mangler, transkripsjon og motstridende kilder og respektere lesesalens regler. Rollen gir ingen profesjonell arkivmyndighet, ingen rett til å endre samlinger eller overskride tilgangs- og personvernregler, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "invisible_work",
    "local_knowledge_vs_system",
    "bureaucratic_power",
    "professional_culture",
    "public_attention",
    "status_anxiety",
    "shame_reputation",
    "social_mask"
  ],
  "social_environments": [
    "lesesalen der stillhet, rutiner og materialhensyn legger rammene for nysgjerrigheten",
    "katalogsøket der administrative beskrivelser og signaturer avgjør om et spor kan finnes igjen",
    "den private notatboka der hypoteser, usikre transkripsjoner og kontrollspor må holdes fra hverandre",
    "samtalen med andre historieinteresserte der sjeldne funn gir status og fristelse til å konkludere raskt",
    "den digitale samlingen der kopier er lett tilgjengelige, men fysisk kontekst og baksider kan forsvinne",
    "etterkantssituasjonen der et gammelt funn bare er nyttig dersom referansen fortsatt leder tilbake til kilden"
  ],
  "recurring_people_archetypes": [
    {
      "id": "lesesalsvert",
      "social_function": "forklarer regler, bestillingsrutiner og materialhensyn i samlingen",
      "class_position": "institusjonell kunnskapsforvalter med ansvar for tilgang og bevaring",
      "status": "høy i lesesalen fordi personen kjenner systemet og materialets vilkår",
      "power_over_player": "kan åpne eller avgrense praktisk tilgang innen gjeldende regler",
      "wants": "at materialet skal kunne brukes uten å miste sporbarhet eller ta skade",
      "conceals": "hvor mye usynlig logistikk som ligger bak en enkel bestilling",
      "speech_style": "rolig, presis og orientert mot signaturer, prosedyrer og materialtype",
      "teaches_player": "at tilgang er en forvaltet relasjon, ikke eierskap"
    },
    {
      "id": "funnjegeren",
      "social_function": "søker aktivt etter ukjente detaljer og elsker øyeblikket der noe uventet dukker opp",
      "class_position": "engasjert amatør med mye tid og høy symbolsk gevinst av originale funn",
      "status": "stigende når personen kan vise til sjeldne dokumenter andre har oversett",
      "power_over_player": "kan gjøre fart og originalitet mer attraktivt enn kontroll og kontekst",
      "wants": "å finne noe som endrer en kjent historie",
      "conceals": "hvor ofte ønsket om et stort funn styrer hvilke tolkninger som føles plausible",
      "speech_style": "entusiastisk, detaljert og rask til å se mønstre",
      "teaches_player": "at et sjeldent funn krever mer kontroll, ikke mindre"
    },
    {
      "id": "katalogkjenner",
      "social_function": "ser serier, arkivskapere og metadata der andre bare ser enkeltdokumenter",
      "class_position": "erfaren bruker med høy institusjonell alfabetisering, uten å eie samlingen",
      "status": "høy blant dem som trenger å finne fram i komplekse arkivsystemer",
      "power_over_player": "kan avgjøre hvilke søkeveier som blir synlige eller oversett",
      "wants": "at spørsmål formuleres så de faktisk kan spores gjennom katalog og proveniens",
      "conceals": "at katalogsystemet også bærer eldre beskrivelser og feil",
      "speech_style": "systematisk, referansetung og opptatt av nivå, serie og signatur",
      "teaches_player": "at katalogdata både er verktøy og kilde"
    },
    {
      "id": "lokalhistorikeren",
      "social_function": "kobler dokumenter til steder, slekter og hendelser som ikke alltid er godt beskrevet i sentrale systemer",
      "class_position": "kunnskapsrik lokal deltaker med sterk erfarings- og stedsforankring",
      "status": "høy i lokale nettverk, men varierende i formelle kunnskapsmiljøer",
      "power_over_player": "kan gi kontekst som endrer tolkningen av et ellers anonymt dokument",
      "wants": "at lokal kunnskap skal bli kontrollert og brukt, ikke oversett",
      "conceals": "at nærhet til en historie også kan gjøre enkelte tolkninger følelsesmessig attraktive",
      "speech_style": "navnesterk, konkret og rik på stedlige forbindelser",
      "teaches_player": "å kombinere lokal kunnskap med sporbar dokumentasjon"
    },
    {
      "id": "kildekritikeren",
      "social_function": "spør konsekvent hvem som skrev, for hvem, når og gjennom hvilken prosess",
      "class_position": "kunnskapsorientert deltaker med høy metodisk kapital",
      "status": "moderat til høy fordi personen kan svekke både populære og akademiske påstander",
      "power_over_player": "kan bremse en fristende historie ved å kreve eksplisitt proveniens og alternativ forklaring",
      "wants": "at en kilde brukes til det den faktisk kan bære",
      "conceals": "at kritikk også kan bli en vane som gjør det vanskelig å erkjenne når evidensen faktisk er sterk",
      "speech_style": "spørrende, avgrensende og opptatt av sammenheng",
      "teaches_player": "at kildekritikk er sterkest når den er proporsjonal"
    },
    {
      "id": "digitalisatoren",
      "social_function": "gjør eldre materiale søkbart og tilgjengelig gjennom skanning, metadata og digitale grensesnitt",
      "class_position": "teknisk kunnskapsarbeider mellom fysisk samling og digital bruker",
      "status": "ofte lavt synlig selv når arbeidet bestemmer hva som kan finnes på nett",
      "power_over_player": "kan påvirke hvilke sider, utsnitt og metadata som blir tilgjengelige digitalt",
      "wants": "at digitale representasjoner skal være nyttige, konsistente og sporbare til originalen",
      "conceals": "hvor mye fysisk informasjon som kan gå tapt i en flat digital kopi",
      "speech_style": "praktisk, formatbevisst og opptatt av oppløsning, metadata og filstruktur",
      "teaches_player": "at digital tilgang er en representasjon av materialet, ikke materialet selv"
    }
  ],
