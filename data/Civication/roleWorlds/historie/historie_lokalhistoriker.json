  "title": "Lokalhistoriker",
  "status": "role_world_complete",
  "sociological_core": {
    "main_problem": "å bygge stednær historie av minner, kart, fotografier, foreningsmateriale og offentlige kilder uten å gjøre lokal nærhet om til ubegrunnet sikkerhet eller eierskap til fortiden",
    "description": "Lokalhistoriker-verdenen følger en historieinteresse som arbeider tett på konkrete steder, mennesker og lokale minnefellesskap. Spilleren lærer å kombinere muntlige kilder, mikrohistorie, kart, bilder, slekts- og kommunale spor med tydelig kildekritikk, interessebevissthet og sporbar dokumentasjon. Rollen gir ingen profesjonell historiker- eller arkivmyndighet, ingen særrett til å definere lokalsamfunnets fortid, og introduserer ingen ny runtime."
  },
  "theme_ids": [
    "local_knowledge_vs_system",
    "public_attention",
    "professional_culture",
    "shame_reputation",
    "bureaucratic_power",
    "invisible_work",
    "social_mask",
    "class_power"
  ],
  "social_environments": [
    "historielaget der frivillig kunnskap, kanon og lokale prioriteringer møtes",
    "nabolagsrunden der bygninger, gatenavn og minner må kobles til daterbare spor",
    "kjøkkenbordet der muntlige kilder gir detaljer som sjelden finnes i formelle arkiver",
    "lokalbiblioteket der småtrykk, aviser og eldre publikasjoner binder sammen fragmenter",
    "kommunearkivet der vedtak og saksforløp er presise, men institusjonens blikk er begrenset",
    "folkemøtet der fortiden blir argument i aktuelle konflikter om vern, utvikling og identitet"
  ],
  "recurring_people_archetypes": [
    {
      "id": "historielagsveteranen",
      "social_function": "bærer langvarig lokal organisasjons- og stedskunnskap",
      "class_position": "frivillig kunnskapsforvalter med høy symbolsk kapital i historielaget",
      "status": "høy lokalt når kontinuitet og navn er viktig",
      "power_over_player": "kan åpne private samlinger og etablere hvilke fortellinger som oppfattes som lokale standarder",
      "wants": "at stedets historie skal bli tatt på alvor og ført videre",
      "conceals": "hvor mye kanon som er formet av tidligere styres prioriteringer",
      "speech_style": "navnesterk, kronologisk og full av lokale referanser",
      "teaches_player": "at lang erfaring er en kilde som også må kontekstualiseres"
    },
    {
      "id": "naboen_med_minne",
      "social_function": "gir muntlige erfaringer fra hverdagsliv, steder og mennesker",
      "class_position": "lokal deltaker med erfaringsbasert kunnskap uten formell historiefaglig autoritet",
      "status": "høy når få andre husker miljøet direkte",
      "power_over_player": "kan gjøre enkelte tolkninger levende og sosialt overbevisende",
      "wants": "at egne og andres erfaringer ikke skal forsvinne",
      "conceals": "hvordan senere fortellinger og fellesskap har påvirket minnet",
      "speech_style": "konkret, episodisk og knyttet til personer og steder",
      "teaches_player": "å bruke muntlige kilder som situerte vitnesbyrd"
    },
