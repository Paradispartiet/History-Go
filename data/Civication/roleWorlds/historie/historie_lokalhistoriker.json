      "status": "høy når administrative forløp og proveniens skal spores",
      "power_over_player": "kan synliggjøre både dokumenterte forløp og grensene for hva kommunen faktisk registrerte",
      "wants": "at kilder brukes presist og kan finnes igjen",
      "conceals": "hvor mye hverdagsliv som aldri ble en kommunal sak",
      "speech_style": "presis, serieorientert og opptatt av saksnummer, periode og arkivskaper",
      "teaches_player": "at institusjonelle kilder har et bestemt blikk"
    },
    {
      "id": "slektsgranskeren",
      "social_function": "kobler personer gjennom navn, familie, adresser og livsløp",
      "class_position": "erfaren amatør med høy teknisk kildekompetanse på individnivå",
      "status": "høy når identiteter og familieforbindelser skal verifiseres",
      "power_over_player": "kan både løse og forsterke identitetskoblinger avhengig av hvor strengt kildene holdes fra hverandre",
      "wants": "å bygge sammenhengende og dokumenterte personforløp",
      "conceals": "hvor fristende det er å velge den mest elegante forbindelsen",
      "speech_style": "detaljert, navneorientert og kildehenvisende",
      "teaches_player": "at samme navn ikke er samme person uten forbindende evidens"
    },
    {
      "id": "utbyggeren",
      "social_function": "gjør lokalhistorie relevant i konflikter om vern, ombruk og utbygging",
      "class_position": "ressurssterk aktør med økonomisk og institusjonell kapasitet til å forme stedet",
      "status": "høy i beslutningsprosesser, omstridt i lokale minnefellesskap",
      "power_over_player": "kan løfte enkelte historiske lag og nedtone andre gjennom prosjektfortellinger og dokumentasjon",
      "wants": "å gjøre en framtidig endring legitim og forståelig",
      "conceals": "hvordan historisk utvalg kan være strategisk",
      "speech_style": "framtidsorientert, profesjonell og opptatt av helhet, verdi og gjennomførbarhet",
      "teaches_player": "at fortiden ofte brukes i nåtidige interessekonflikter"
    },
    {
      "id": "lokalbibliotekaren",
      "social_function": "binder sammen trykte lokalhistorier, aviser, småskrifter og publikums spørsmål",
      "class_position": "offentlig kunnskapsarbeider mellom samling og lokalsamfunn",
      "status": "stabil fordi personen kjenner mange kildeveier uten å eie én fortelling",
      "power_over_player": "kan synliggjøre glemte kilder og alternative innganger",
      "wants": "at lokal kunnskap skal være tilgjengelig, etterprøvbar og flerfoldig",
      "conceals": "hvor mye viktig materiale som finnes i svakt katalogiserte småtrykk",
      "speech_style": "orienterende, søkende og god til å foreslå neste kilde",
      "teaches_player": "at lokal historie ofte bygges gjennom mange små kildetyper"
