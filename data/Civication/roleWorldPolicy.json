{
  "schema": "civication_role_world_policy_v1",
  "version": 1,
  "status": "canonical_editorial_completion_contract",
  "effective_date": "2026-08-25",
  "standard": "docs/CIVICATION_ROLE_WORLD_STANDARD.md",
  "authoring_guide": "docs/CIVICATION_ROLE_WORLD_AUTHORING_GUIDE.md",
  "authoring_checklist": "data/Civication/roleWorldAuthoringChecklist.json",
  "schema_path": "data/Civication/roleWorldV1.schema.json",
  "index_path": "data/Civication/roleWorlds/index.json",
  "theme_bank": "data/Civication/roleWorldThemeBank.json",
  "runtime_boundary": {
    "editorial_layer_only": true,
    "new_runtime_allowed": false,
    "new_parallel_scene_format_allowed": false,
    "role_world_declared_runtime_capabilities_allowed": false,
    "governed_additive_runtime_capabilities_allowed": true,
    "governed_capability_requirements": [
      "existing_scene_pipeline_remains_canonical",
      "capability_has_explicit_runtime_owner",
      "capability_is_additive_for_existing_saves_and_roles",
      "schema_or_state_contract_is_versioned_or_strictly_bounded",
      "permanent_tests_prove_legacy_roles_remain_compatible",
      "role_world_complete_semantics_are_unchanged"
    ],
    "canonical_scene_schema": "data/Civication/sceneContractV1.schema.json",
    "compiled_registry": "data/Civication/compiledSceneRegistryV1.json",
    "scene_catalog": "CivicationSceneCatalog",
    "scene_director": "CivicationSceneDirector",
    "choice_director": "CivicationChoiceDirector",
    "rule": "Role World-filer kan ikke opprette runtime-capabilities. Nye additive capabilities må innføres gjennom ordinær runtime-governance og fortsatt materialiseres gjennom den canonicale Scene Pipeline."
  },
  "career_status_boundary": {
    "career_reference_status": "reference_complete",
    "career_policy": "data/Civication/careerGameplayPolicy.json",
    "not_equivalent_to": "role_world_complete",
    "reason": "reference_complete beviser 15 career-komponenter, Life Story, praksisdybde og to uker, men ikke den strengere sosiale serie-/Role World-standarden."
  },
  "realism_matrix_gate": {
    "path": "data/Civication/roleWorldRealismMatrix.json",
    "schema": "civication_role_world_realism_matrix_v1",
    "status": "gate_green_controlled_rollout_open",
    "broad_rollout_allowed": true,
    "completion_statuses_unchanged": true,
    "new_runtime_allowed": false,
    "rule": "Matrixen og readiness-auditen åpner bare kontrollert rolle-for-rolle rollout. De kan ikke omskrive reference_complete, role_world_complete, Scene Pipeline-eierskap, authority-grenser eller rolle-nivå blockers.",
    "readiness_path": "data/Civication/roleWorldRolloutReadiness.json"
  },
  "role_world_statuses": [
    "role_world_not_started",
    "role_world_in_production",
    "role_world_complete"
  ],
  "player_life_context_axes": [
    "badge_progression",
    "life_position",
    "formal_work_status",
    "livelihood",
    "economy_capital",
    "psyche",
    "relationships_network",
    "housing_life_situation",
    "benefits_work_ability_when_available",
    "reputation_status"
  ],
  "season_contract": {
    "days": 14,
    "day_phases": [
      "morning",
      "lunch",
      "afternoon",
      "evening"
    ],
    "required_unique_coverage_slots_for_complete": 56,
    "coverage_is_dramaturgical_not_decision_quota": true,
    "allowed_beat_types": [
      "info",
      "conversation",
      "relationship",
      "social",
      "task",
      "decision",
      "consequence",
      "private_consequence"
    ],
    "active_strategic_decisions_per_day_target": {
      "min": 1,
      "max": 2,
      "hard_gate": false
    }
  },
  "thread_contract": {
    "primary_relational_threads_required": true,
    "primary_thread_beats_min": 5,
    "primary_thread_beats_max": 10,
    "interpretation": "5–10 gjelder utvikling over beats/scener/meldinger, ikke antall klikk i én scene."
  },
  "npc_required_fields": [
    "id",
    "social_function",
    "class_position",
    "status",
    "power_over_player",
    "wants",
    "conceals",
    "speech_style",
    "teaches_player"
  ],
  "required_editorial_sections": [
    "sociological_core",
    "theme_ids",
    "social_environments",
    "recurring_people_archetypes",
    "slow_axes",
    "season",
    "primary_threads",
    "private_aftermath",
    "delayed_consequences",
    "materialization"
  ],
  "theme_rules": {
    "editorial_only": true,
    "theme_ids_may_be_gameplay_state": false,
    "theme_ids_may_be_scene_ids": false,
    "copy_plot_forbidden": true,
    "copy_character_forbidden": true,
    "copy_dialogue_forbidden": true,
    "reconstruct_specific_scene_forbidden": true
  },
  "materialization": {
    "allowed_existing_sources": [
      "roleModel",
      "workGrammar",
      "mailPlan",
      "mailFamilies",
      "private",
      "life",
      "social",
      "narrative"
    ],
    "must_compile_or_adapt_to_civication_scene_v1": true,
    "raw_mailfamilies_runtime_fallback_allowed": false,
    "role_storylet_runtime_fallback_allowed": false,
    "jobbmails_runtime_fallback_allowed": false
  },
  "completion_requirements": {
    "exact_14x4_coverage": true,
    "valid_theme_ids": true,
    "complete_npc_social_fields": true,
    "primary_threads_with_5_to_10_beat_refs": true,
    "private_aftermath_required": true,
    "delayed_consequence_arc_required": true,
    "materialization_refs_required": true,
    "no_new_runtime_true": true
  },
  "first_reference_world": {
    "category": "naeringsliv",
    "role_scope": "ekspeditor",
    "status": "role_world_complete"
  },
  "second_reference_world": {
    "category": "naeringsliv",
    "role_scope": "renholder",
    "status": "role_world_complete"
  },
  "next_reference_world": null,
  "later_reference_candidates": [],
  "third_reference_world": {
    "category": "by",
    "role_scope": "by_radgiver_plan",
    "status": "role_world_complete"
  },
  "fourth_reference_world": {
    "category": "naeringsliv",
    "role_scope": "controller",
    "status": "role_world_complete"
  },
  "fifth_reference_world": {
    "category": "sport",
    "role_scope": "sport_utover",
    "status": "role_world_complete"
  },
  "reference_wave_complete": true,
  "broad_rollout_governance": {
    "mode": "controlled_role_by_role",
    "one_role_per_pr": true,
    "blocked_roles_may_roll_out": false,
    "authority_must_not_be_inferred": true,
    "cross_role_links_only_when_genuinely_shared": true,
    "full_civication_suite_required": true,
    "compiled_registry_parity_required": true,
    "realism_matrix_gate_required": true,
    "provenance_required": true,
    "existing_scene_pipeline_remains_canonical": true,
    "parallel_scene_engine_allowed": false,
    "employment_conditions_global_runtime_field": false,
    "professional_culture_global_runtime_field": false,
    "rollout_queue_path": "data/Civication/roleWorldRolloutReadiness.json",
    "rule": "Bred rollout betyr ikke masse-materialisering: hver canonical rolle leveres i egen PR, må være rollout_ready eller få eksplisitt authored debt lukket, og kan ikke omgå blockers, authority, provenance eller registry-paritet."
  }
}
