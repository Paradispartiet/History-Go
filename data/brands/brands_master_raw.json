ata_bad","name":"Torggata Bad","brand_type":"venue_name","sector":"hospitality","state":"move_to_places"},\n{"id":"mathallen","name":"Mathallen","brand_type":"venue_name","sector":"food_and_drink","state":"move_to_places"},\n{"id":"dansens_hus","name":"Dansens Hus","brand_type":"institution_name","sector":"culture","state":"move_to_places"},\n{"id":"smelteverket","name":"Smelteverket","brand_type":"legendary_venue","sector":"nightlife","state":"catalog"},\n{"id":"palmen","name":"Palmen","brand_type":"legacy_brand","sector":"hospitality","state":"strong"},\n{"id":"paulus_sofienberg_menighet","name":"Paulus og Sofienberg menighet","brand_type":"parish_identity","sector":"religion","state":"catalog"},\n{"id":"schous_bryggeri_historisk","name":"Schous Bryggeri","brand_type":"historic_brewery","sector":"beverages","state":"catalog"},\n{"id":"myrens_verksted_company","name":"Myrens Verksted","aliases":["Myrens mekaniske Værksted","J. & A. Jensen og Dahl, Myrens Verksted","Myrens Verksted A/S"],"brand_group":"legacy_brand","brand_type":"historic_company","brand_kind":"brand","sector":"mechanical_industry","state":"catalog","status":"historical","verification":"verified_legacy","popupdesc":"Myrens Verksted er den historiske virksomhetsidentiteten som fulgte maskiner, eksport og industrikunnskap langt utover fabrikkbygningene ved Akerselva. Industriselskapet ble avviklet i Oslo i 1988, mens navnet og det autentiske M-merket fortsatt brukes som identitet for næringsområdet.","desc":"Historisk maskinindustrinavn fra 1848, videreført som identitet for næringsområdet ved Akerselva.","tags":["brand","legacy_brand","mechanical_industry","oslo","akerselva","myrens_verksted"]},\n{"id":"alunverket_company","name":"Christian og Sophia Magdalenas Alunverk","aliases":["Alunverket","Christians og Sophia Magdalenas Alunverk","Alum Verket ved Egeberg"],"brand_group":"legacy_brand","brand_type":"historic_company","brand_kind":"brand","sector":"chemical_industry","state":"catalog","status":"historical","verification":"verified_legacy","popupdesc":"Christian og Sophia Magdalenas Alunverk var virksomhetsnavnet ved opprettelsen i 1737. Navnet viste til kongen og dronningen og knyttet verket til merkantilistisk næringspolitikk. Brandkortet bruker den samtidige håndskrevne tittelen «Alum Verket ved Egeberg» fra John William Edys akvatint omkring 1800; den er beskåret fra originalen, ikke rekonstruert.","desc":"Historisk virksomhetsnavn fra 1737, dokumentert med et samtidig ordmerke på Edys akvatint omkring 1800.","tags":["brand","legacy_brand","chemical_industry","oslo","ekeberg","alunverket"]},\n{"id":"lilleborg_fabrikker_company","name":"Lilleborg","aliases":["A/S Lilleborg Fabriker","Lilleborg Fabrikker","Lilleborg AS"],"brand_group":"legacy_brand","brand_type":"historic_company_and_product_mark","brand_kind":"brand","sector":"soap_and_cleaning_products","state":"catalog","status":"historical_site_current_company_lineage","verification":"verified_legacy","popupdesc":"Lilleborg-navnet ble knyttet til såpe, vaskemidler og andre forbruksvarer produsert ved Sandaker. Det autentiske grønnsåpeskiltet dokumenterer hvordan virksomhetsnavn og produktbudskap ble presentert for markedet. Produksjonen på Sandaker sluttet i 1997; den senere profesjonelle rengjøringsvirksomheten ble solgt av Orkla til Solenis i 2024.","desc":"Historisk virksomhets- og produktmerke fra olje-, såpe- og vaskemiddelindustrien ved Akerselva.","tags":["brand","legacy_brand","soap","cleaning_products","oslo","akerselva","lilleborg_fabrikker"]},\n{"id":"egal_teater","name":"Égal Teater","brand_type":"theatre","sector":"performing_arts","state":"catalog"},\n{"id":"stiftelsen_oslo_hospital","name":"Stiftelsen Oslo Hospital","aliases":["Oslo Hospital"],"brand_group":"institutional_brand","brand_type":"foundation","brand_kind":"brand","sector":"care_and_property","state":"catalog","status":"current","verification":"verified_current","popupdesc":"Stiftelsen Oslo Hospital ble etablert ved kongelig ordre i 1538 og er den institusjonelle identiteten som har forvaltet hospitalets eiendom og arv. Brandkortet bruker det autentiske ordmerket fra Oslo Hospitals offisielle nettsted. Merket er ikke generert eller rekonstruert, og kortet innebærer ingen endorsement.","desc":"Institusjonell identitet fra 1538, vist med autentisk ordmerke fra den offisielle nettsiden.","tags":["brand","institution","foundation","care_history","oslo","oslo_hospital"]},\n{"id":"vi_vii","name":"VI, VII","aliases":["VI VII","VI,VII"],"brand_group":"institution_brand","brand_type":"gallery_brand","brand_kind":"gallery","sector":"art","state":"verified_unmapped","status":"active_identity_current_location_unverified","verification":"verified_brand_identity","popupdesc":"VI, VII er en galleriaktør med egen identitet og skiftende visningssteder. Nedre Slottsgate 8 var et tidsavgrenset showroom i 2025 og er ikke registrert som permanent kartsted.","desc":"Oslo-basert samtidskunstgalleri grunnlagt i 2012, bevart som Brand uten uverifisert aktiv stedsmarkør.","tags":["brand","gallery","contemporary_art","oslo"]},\n{"id":"norske_grafikeres_fond","name":"Norske Grafikeres Fond","aliases":["NGF"],"brand_group":"institutional_brand","brand_type":"fund","brand_kind":"brand","sector":"art_funding","state":"catalog","status":"current","verification":"verified_current","popupdesc":"Norske Grafikeres Fond bygger på bibliotekvederlagsloven fra 1987. Fondet deler ut stipend og prosjektmidler og forvalter en årlig grafikkpris. Styret velges av Norske Grafikeres generalforsamling, men fondet vises som egen aktør og ikke som foreningens selv-brand.","desc":"Fond for stipend, prosjektmidler og grafikkpris, knyttet til men adskilt fra Norske Grafikere.","tags":["brand","fund","art","grants","oslo","norske_grafikere"]},\n{"id":"norsk_billedhoggerforening","name":"Norsk Billedhoggerforening","aliases":["NBF"],"brand_group":"institutional_brand","brand_type":"artist_association","brand_kind":"brand","sector":"visual_art","state":"catalog","status":"current","verification":"verified_current","popupdesc":"Norsk Billedhoggerforening var prosjektpart for Skulptursonen sammen med Kulturetaten og Bymiljøetaten. Foreningen publiserer den offisielle prosjektoversikten og katalogen over de dokumenterte utstillingsrundene. Den vises som en selvstendig institusjonell identitet, ikke som et navn på selve gatestrekket.","desc":"Kunstnerorganisasjonen som samarbeidet med Kulturetaten og Bymiljøetaten om Skulptursonen.","tags":["brand","artist_association","sculpture","public_art","oslo","skulptursonen_ovre_slottsgate"]},\n{"id":"den_norske_kirke","name":"Den norske kirke","brand_group":"institution_brand","brand_type":"church_institution","brand_kind":"institution","sector":"religion","state":"catalog"},\n{"id":"sparebankstiftelsen_dnb","name":"Sparebankstiftelsen DNB","brand_type":"philanthropic_foundation","sector":"philanthropy","state":"catalog"},\n{"id":"podium_oslo","name":"Podium","aliases":["Podium Oslo"],"brand_group":"cultural_institution_brand","brand_type":"artist_run_exhibition_space","brand_kind":"venue_identity","sector":"culture","state":"catalog","status":"current","verification":"verified","popupdesc":"Podium er et kunstnerdrevet utstillings- og arrangementssted i Hausmania. Brandkortet identifiserer den selvstendige organisasjonen og skal ikke leses som om Podium og Hausmania er samme virksomhet.","desc":"Kunstnerdrevet visningssted i Hausmania med historie fra 2003.","tags":["brand","artist_run","art","subkultur","hausmania","hausmania"]},\n{"id":"oslo_glass_studio","name":"Oslo Glass Studio","aliases":[],"brand_group":"cultural_institution_brand","brand_type":"glassblowing_studio","brand_kind":"venue_identity","sector":"culture","state":"catalog","status":"current","verification":"verified","popupdesc":"Oslo Glass Studio holder til i Kirkeristen og drives av Ina Kristine Hove, Kjersti Johannessen og Jeanne-Sophie Aas. Brandkortet representerer dagens glassvirksomhet og skal ikke leses som basarenes historiske opprinnelsesfunksjon.","desc":"Glassblåseri, galleri og butikk som åpnet i Kirkeristen i 2023.","tags":["brand","glassblowing","glasskunst","kirkeristen","kirkeristen_basarene_brannvakten"]},\n{"id":"oslo_bors_marketplace","name":"Oslo Børs","aliases":["Christiania Børs","Euronext Oslo Børs"],"brand_group":"institutional_brand","brand_type":"stock_exchange","brand_kind":"brand","sector":"financial_market","state":"catalog","status":"active","verification":"verified_current","popupdesc":"Oslo Børs er den norske regulerte verdipapir- og derivatmarkedsplassen som siden 2019 inngår i Euronext. Brandkortet bruker et dokumentarfoto av den navngitte børsfasaden, ikke et rekonstruert varemerke.","desc":"Norsk børsinstitusjon fra 1819, del av Euronext siden 2019.","tags":["brand","stock_exchange","finance","oslo","tollbugata","borsen_oslo"],"place_ids":["borsen_oslo"],"source_urls":["https://www.euronext.com/en/about/our-organisation","https://oslobyleksikon.no/side/B%C3%B8rsen","https://commons.wikimedia.org/wiki/File:B%C3%98RSEN%20Oslo%20b%C3%B8rs%20B%C3%B8rsbygningen%20(Oslo%20Stock%20Exchange%20building)%20Tollbugata%20Street%20NORWAY%20built%201829%2C%201911%20Fasade%20mot%20nord%20(Lettered%20facade%20facing%20north)%20S%C3%B8yler%20(Doric%20columns)%20Veggur%20(gable%20clock)%20Sunny%20Summer%20etc%202023-07-29%20IMG%209743.jpg"],"logo":"bilder/kort/brands/oslo_bors_marketplace.webp","imageMeta":{"source":"wikimedia_commons","sourcePage":"https://commons.wikimedia.org/wiki/File:B%C3%98RSEN%20Oslo%20b%C3%B8rs%20B%C3%B8rsbygningen%20(Oslo%20Stock%20Exchange%20building)%20Tollbugata%20Street%20NORWAY%20built%201829%2C%201911%20Fasade%20mot%20nord%20(Lettered%20facade%20facing%20north)%20S%C3%B8yler%20(Doric%20columns)%20Veggur%20(gable%20clock)%20Sunny%20Summer%20etc%202023-07-29%20IMG%209743.jpg","creator":"Wolfmann","credit":"Wolfmann / Wikimedia Commons","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/