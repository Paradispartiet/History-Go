async function fetchBuffer(url) {
  let lastStatus = 0;
  for (let attempt = 0; attempt < 6; attempt += 1) {
    const response = await fetch(url, { redirect: "follow", headers: { "user-agent": "History-Go-place-production/1.0" } });
    lastStatus = response.status;
    if (response.ok) return Buffer.from(await response.arrayBuffer());
    if (![429, 500, 502, 503, 504].includes(response.status)) break;
    await new Promise((resolve) => setTimeout(resolve, Math.min(1500 * (2 ** attempt), 20000)));
  }
  throw new Error(`Kunne ikke hente bilde (${lastStatus}): ${url}`);
}
async function outputImage({ url, file, width, height, fit = "cover", position = "centre", background = "#ffffff" }) {
  const target = path.join(root, file);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  await sharp(await fetchBuffer(url)).rotate().resize(width, height, { fit, position, background }).webp({ quality: 84, effort: 5 }).toFile(target);
}

