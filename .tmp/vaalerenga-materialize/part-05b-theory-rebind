
// Resolve final-phase theory bindings from the active By fagkart instead of hard-coding invalid hook/emne pairs.
const activeByFagkart = read("data/fag/by/fagkart_by.json");
const activeByHooks = (activeByFagkart.categories || []).flatMap((category) => category.topic_hooks || []);
const hookSupports = (hook, emneId) => (hook.emne_ids || []).includes(emneId);
const thinkerRecord = (hook, thinkerId) => (hook?.canon?.thinkers || []).find((thinker) => thinker.id === thinkerId);
const theoryPreferenceByQuestion = {
  vaalerenga_quiz_32: ["kevin_lynch", "walter_benjamin"],
  vaalerenga_quiz_34: ["kevin_lynch", "walter_benjamin"],
  vaalerenga_quiz_35: ["walter_benjamin", "kevin_lynch"]
};

for (const question of questions.filter((row) => row.question_type === "concept")) {
  const validHooks = activeByHooks.filter((hook) => hookSupports(hook, question.emne_id) && (hook?.canon?.thinkers || []).length);
  if (!validHooks.length) throw new Error(`No canonical By theory hook owns ${question.emne_id} for ${question.id}`);

  const currentHook = validHooks.find((hook) => hook.id === question.topic_hook_id);
  const currentThinker = currentHook ? thinkerRecord(currentHook, question.thinker_id) : null;
  const currentWorkValid = currentThinker && (currentThinker.works || []).includes(question.work);
  if (currentHook && currentThinker && currentWorkValid) continue;

  let chosenHook = validHooks.find((hook) => thinkerRecord(hook, question.thinker_id));
  const preferences = theoryPreferenceByQuestion[question.id] || [];
  if (!chosenHook) {
    chosenHook = validHooks.find((hook) => preferences.some((thinkerId) => thinkerRecord(hook, thinkerId))) || validHooks[0];
  }
  let chosenThinker = thinkerRecord(chosenHook, question.thinker_id);
  if (!chosenThinker) {
    for (const thinkerId of preferences) {
      chosenThinker = thinkerRecord(chosenHook, thinkerId);
      if (chosenThinker) break;
    }
  }
  if (!chosenThinker) chosenThinker = (chosenHook.canon?.thinkers || [])[0];
  if (!chosenThinker || !(chosenThinker.works || []).length) {
    throw new Error(`Canonical hook ${chosenHook.id} lacks a usable thinker/work for ${question.id}`);
  }

  question.topic_hook_id = chosenHook.id;
  question.thinker_id = chosenThinker.id;
  question.work = chosenThinker.works[0];
  question.theory_ref = {
    topic_hook_id: chosenHook.id,
    thinker_id: chosenThinker.id,
    work: chosenThinker.works[0],
    why_it_helps: `${chosenThinker.name} brukes som et avgrenset canonicalt perspektiv på spørsmålets byfaglige emne; Vålerengas konkrete påstander må fortsatt dokumenteres med lokale kilder.`
  };
}

const reboundCurriculum = {
  module_ids: [...curriculum.module_ids],
  emne_ids: [...new Set(questions.map((q) => q.emne_id))],
  topic_hook_ids: [...new Set(questions.map((q) => q.topic_hook_id).filter(Boolean))],
  method_ids: [...new Set(questions.map((q) => q.method_id).filter(Boolean))],
  thinker_ids: [...new Set(questions.map((q) => q.thinker_id).filter(Boolean))],
  works: [...new Set(questions.map((q) => q.work).filter(Boolean))]
};
Object.assign(curriculum, reboundCurriculum);

const reboundBrief = read(briefFile);
reboundBrief.selected_curriculum = reboundCurriculum;
for (const claim of reboundBrief.claims || []) {
  const question = questions.find((row) => row.claim_id === claim.claim_id);
  if (!question) continue;
  if (question.method_id) claim.method_id = question.method_id; else delete claim.method_id;
  if (question.topic_hook_id) {
    claim.topic_hook_id = question.topic_hook_id;
    claim.thinker_id = question.thinker_id;
    claim.work = question.work;
  } else {
    delete claim.topic_hook_id;
    delete claim.thinker_id;
    delete claim.work;
  }
}
write(briefFile, reboundBrief);

const reboundQuiz = read(quizFile);
const reboundById = new Map(questions.map((question) => [question.id, question]));
for (const set of reboundQuiz.sets || []) {
  set.questions = (set.questions || []).map((question) => reboundById.get(question.id) || question);
}
if (reboundQuiz.production_context) {
  reboundQuiz.production_context.pensum_module_ids = reboundCurriculum.module_ids;
  reboundQuiz.production_context.emne_ids = reboundCurriculum.emne_ids;
  reboundQuiz.production_context.topic_hook_ids = reboundCurriculum.topic_hook_ids;
  reboundQuiz.production_context.method_ids = reboundCurriculum.method_ids;
  reboundQuiz.production_context.thinker_ids = reboundCurriculum.thinker_ids;
  reboundQuiz.production_context.works = reboundCurriculum.works;
}
write(quizFile, reboundQuiz);
