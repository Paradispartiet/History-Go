# History GO backend runtime configuration.
# Copy to backend/.env for local development. Never commit real secrets.

HG_BACKEND_ENVIRONMENT=development
HG_BACKEND_DOCS_ENABLED=true

# PostgreSQL / Supabase database connection. Prefer a server-side connection string.
# HG_BACKEND_DATABASE_URL=postgresql://postgres:password@host:5432/postgres
HG_BACKEND_READINESS_REQUIRE_DATABASE=false

# Supabase Auth project URL. Asymmetric access tokens are verified via the project's JWKS.
# Legacy HS256 token verification also needs the public/publishable project key.
# HG_BACKEND_SUPABASE_URL=https://project-ref.supabase.co
# HG_BACKEND_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
HG_BACKEND_SUPABASE_JWT_AUDIENCE=authenticated
HG_BACKEND_READINESS_REQUIRE_AUTH=false
