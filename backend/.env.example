# History GO backend runtime configuration.
# Copy to backend/.env for local development. Never commit real secrets.

HG_BACKEND_ENVIRONMENT=development
HG_BACKEND_DOCS_ENABLED=true

# PostgreSQL / Supabase database connection. Prefer a server-side connection string.
# HG_BACKEND_DATABASE_URL=postgresql://postgres:password@host:5432/postgres
HG_BACKEND_READINESS_REQUIRE_DATABASE=false

# Supabase Auth project URL. Asymmetric access tokens are verified via the project's JWKS.
# Legacy HS256 token verification also needs the public/publishable project key.
# HG_BACKEND_SUPABASE_URL=https://project-ref.supabase.co
# HG_BACKEND_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
HG_BACKEND_SUPABASE_JWT_AUDIENCE=authenticated
HG_BACKEND_READINESS_REQUIRE_AUTH=false

# Social Meet deployment kill switches. Production invite writes and discovery are
# fail-closed until explicitly enabled. Discovery also requires the private
# PostgreSQL feature flag/cohort rollout from migration 007.
HG_BACKEND_SPOTMEETING_INVITE_WRITES_ENABLED=false
HG_BACKEND_SPOTMEETING_DISCOVERY_ENABLED=false
HG_BACKEND_SPOTMEETING_DISCOVERY_MAX_CANDIDATES=20
HG_BACKEND_SPOTMEETING_DISCOVERY_STALE_AFTER_SECONDS=300

# Social Meet retention. These are conservative operational defaults, not a legal
# determination. Production apply remains fail-closed until explicitly enabled and
# the deployed policy has been reviewed for the actual jurisdiction/use case.
HG_BACKEND_SOCIAL_MEET_RETENTION_APPLY_ENABLED=false
HG_BACKEND_SOCIAL_MEET_RETENTION_TERMINAL_INVITE_DAYS=180
HG_BACKEND_SOCIAL_MEET_RETENTION_REMOVED_BLOCK_DAYS=180
HG_BACKEND_SOCIAL_MEET_RETENTION_CLOSED_REPORT_DAYS=730
HG_BACKEND_SOCIAL_MEET_RETENTION_CLOSED_MODERATION_DAYS=730
HG_BACKEND_SOCIAL_MEET_RETENTION_INACTIVE_RESTRICTION_DAYS=730
HG_BACKEND_SOCIAL_MEET_RETENTION_CLOSED_APPEAL_DAYS=365
HG_BACKEND_SOCIAL_MEET_RETENTION_SAFETY_AUDIT_DAYS=1095
HG_BACKEND_SOCIAL_MEET_RETENTION_RELEASED_HOLD_DAYS=365
