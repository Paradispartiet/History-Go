  {
    "id": "6eae9cea8dd04b9f80e9f0f3fbf35f24",
    "metadata": {
      "id": "6eae9cea8dd04b9f80e9f0f3fbf35f24",
      "owner": "haakon.olsvold@pbe.oslo.kommune.no_OsloKommune",
