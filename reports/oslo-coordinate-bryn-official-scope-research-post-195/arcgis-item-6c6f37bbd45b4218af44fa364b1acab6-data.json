{"root":"n-sgR3OY","nodes":{"n-9A790o":{"type":"image","data":{"image":"r-3yWiRl","isExpandable":false,"attribution":"Intility arena. Foto: Olav Helland / Oslo kommune"},"config":{"placement":{"type":"fit","fit":{"color":"backgroundColor"},"fill":{"x":0.5,"y":0.5}}}},"n-OFoQV1":{"type":"storycover","data":{"type":"card","title":"Hasle og Valle Hovin","summary":"Bymiljø og idrettsanlegg","byline":"","titlePanelVerticalPosition":"top","titlePanelHorizontalPosition":"start","titlePanelStyle":"gradient"},"config":{"isHidden":false},"children":["n-9A790o"]},"n-DxaQHp":{"type":"navigation","data":{"links":[{"nodeId":"n-oUMyg2"},{"nodeId":"n-BmGuyH"},{"nodeId":"n-Uk4eLq"}]},"config":{"isHidden":false}},"n-oUMyg2":{"type":"text","data":{"type":"h2","text":"Status"}},"n-j1s1qW":{"type":"image","data":{"image":"r-p050nL"}},"n-cp3q9W":{"type":"carousel","children":["n-j1s1qW"]},"n-nXe5Bs":{"type":"text","data":{"text":"Nye tilskudd","type":"h3"},"config":{"size":"wide"}},"n-FeIgBC":{"type":"text","data":{"text":"Området rundt Hasle og Valle Hovin har allerede utviklet seg mye.\n\nI 2005 kom det på Hasle nye boliger og Hasle torg senter ved T-banestasjonen. I 2011 begynte utviklingen av Vinmonopolets gamle område, «Hasle Linje», og stedet ble endret til et boligområde og nye næringslokaler. \n\nDet er også kommet nye tilskudd av grøntområder, skole og barnehage: \n- Teglverksdammen og Hovinbekken (2015) \n- Teglverket skole (2015)\n- Teglverket barnehage (2017)\n\nValle Hovin er Hovinbyens grønne hjerte, med et stort grøntanlegg som er omkranset av utviklingsområdene.\n","type":"paragraph"},"config":{"size":"wide"}},"n-h0q8mB":{"type":"image","data":{"image":"r-ldV7Xv"}},"n-S7vpej":{"type":"carousel","children":["n-h0q8mB"]},"n-TmDc8V":{"type":"text","data":{"text":"Mer bygging og mer grønt","type":"h3"},"config":{"size":"wide"}},"n-q3dKuU":{"type":"text","data":{"text":"Oslo kommune har definert området fra Grenseveien og østover mot Økern som et utviklingsområde. \n\nDet er ventet at stedet skal endre seg fra bilforhandlere, industri og lagervirksomhet til å få bybebyggelse med et stort antall boliger. Samtidig vil området endre karakter fra å være grått til mer grønt. ","type":"paragraph"},"config":{"size":"wide"}},"n-UkgDp2":{"type":"image","data":{"image":"r-hnVIGp"}},"n-dC3CsX":{"type":"carousel","children":["n-UkgDp2"]},"n-1Eg5CM":{"type":"text","data":{"text":"Styrke park og idrett","type":"h3"},"config":{"size":"wide"}},"n-CKcWwo":{"type":"text","data":{"text":"Oslo kommune ønsker å styrke Valle Hovin som det største park- og idrettsområdet i Hovinbyen, og som et viktig idrettsområde i Oslo. ","type":"paragraph"},"config":{"size":"wide"}},"n-8Fxuxf":{"type":"button","data":{"text":"Les om ny kunstgressbane","link":"https://www.oslo.kommune.no/slik-bygger-vi-oslo/oppgradering-ny-kunstgressbane-pa-valle-hovin/"},"config":{"size":"wide"}},"n-a89eQE":{"type":"image","data":{"image":"r-TRFV1f","isExpandable":false,"attribution":"Foto: Øivind Aamodt / Oslo kommune"}},"n-NPIVvf":{"type":"carousel","children":["n-a89eQE"]},"n-Je8fkY":{"type":"text","data":{"text":"Vinslottet","type":"h3"},"config":{"size":"wide"}},"n-shkUm8":{"type":"text","data":{"text":"Vinmonopolets sentralanlegg ble oppført på Hasle i 1933 og ble benyttet som tapperi og lager frem til 2011. \n\nSamme år ble anlegget vernet av Plan- og bygningsetaten, og det ble startet et arbeid for å bygge om til leiligheter og kjøpesenter. Bygget stod klar til ny bruk i 2019.  ","type":"paragraph"},"config":{"size":"wide"}},"n-gnriTx":{"type":"text","data":{"text":"Hasle T-banestasjon","type":"h3"},"config":{"size":"wide"}},"n-KCb71W":{"type":"text","data":{"text":"Hasle T-banestasjon ble oppført i 1966 og oppgradert i 2009. ","type":"paragraph"},"config":{"size":"wide"}},"n-161prY":{"type":"text","data":{"text":"Tegleverket skole","type":"h3"},"config":{"size":"wide"}},"n-VkdatQ":{"type":"text","data":{"text":"Tegleverket skole åpnet i 2015, og er en skole for 1-10 trinn. \n\nSkolen er bygget på det gamle området til Hovin Tegleverk (1893-1967), som er bakgrunnen for navnet. ","type":"paragraph"},"config":{"size":"wide"}},"n-lDuezo":{"type":"image","data":{"image":"r-iozxjc","isExpandable":false,"attribution":"Foto: Ida Rydeng / Oslo kommune"}},"n-Q9vYRY":{"type":"carousel","children":["n-lDuezo"]},"n-ZKme4b":{"type":"text","data":{"text":"Hovinbekken","type":"h3"},"config":{"size":"wide"}},"n-tp8ctb":{"type":"text","data":{"text":"Hovinbekken starter i Nordmarka og er et av Oslos sentrale elveløp. I 2015 ble bekken åpnet på Hasle og ned til Ensjø (fra å ligge i rør), og denne delen av elveløpet ble tildelt Oslo bys arkitekturpris i 2023. ","type":"paragraph"},"config":{"size":"wide"}},"n-uFKXtX":{"type":"image","data":{"image":"r-KMjpMT","isExpandable":false,"attribution":"Teglverksdammen på Hasle. Foto: Svein Olav Traa Langseth / Oslo kommune"}},"n-BMA3WD":{"type":"carousel","children":["n-uFKXtX"]},"n-e6RsJe":{"type":"text","data":{"text":"Tegleverksdammen","type":"h3"},"config":{"size":"wide"}},"n-qP2ROH":{"type":"text","data":{"text":"Grøntområdet åpnet i 2015 og er et naturlig renseanlegg for Hovinbekken. Området har gang- og sykkelveger og broer med belysning, og kan brukes som et vanlig friområde.","type":"paragraph"},"config":{"size":"wide"}},"n-aR1vSe":{"type":"text","data":{"text":"Hovin barnehage","type":"h3"},"config":{"size":"wide"}},"n-oZcwzj":{"type":"text","data":{"text":"Hovin barnehage holder til våningshuset til tidligere Søndre Hovin gård, oppført på 1800-tallet. Huset står på Byantikvarens gule liste (verneverdig). \n\nDen opprinnelige Hovin gård var en av de største gårdene i Groruddalen. Hovin gård ble etter hvert delt i sju bruk og et av disse var Søndre Hovin.","type":"paragraph"},"config":{"size":"wide"}},"n-SXQuyK":{"type":"image","data":{"image":"r-FXwybr","expressImage":"r-b54kUk","expressImageDataId":"r-54TRQb"}},"n-2s7qru":{"type":"carousel","children":["n-SXQuyK"]},"n-GhenQl":{"type":"text","data":{"text":"Valle Hovin idrettspark","type":"h3"},"config":{"size":"wide"}},"n-ZAMQOO":{"type":"text","data":{"text":"Sammen med Valhall Arena og Intility Arena utgjør utendørsområdene Valle Hovin idrettspark.  Utendørs består anlegget av fotballbaner (naturgress og kunstgress), en petanquebane og en idrettslekepark. \n\nVed siden av idrettsparken ligger kunstisbanen på Valle Hovin stadion. ","type":"paragraph"},"config":{"size":"wide"}},"n-gldlPs":{"type":"text","data":{"text":"Hovindammen","type":"h3"},"config":{"size":"wide"}},"n-MLafWD":{"type":"text","data":{"text":"Hovindammen er en kunstig dam som ble anlagt  i 1907. Hovin ismagasin benyttet dammen til å skjære is om vinteren for å selge til bønder, butikker, restuaranter, sykehus og priovatpersoner. Da kjøleskap og fryser etter hvert ble vanlig fra 1950-tallet, forsvant virksomheten.\n\nHovindammen har utløp gjennom Lillebergbekken som renner ned mot Ensjø. ","type":"paragraph"},"config":{"size":"wide"}},"n-n5ztnb":{"type":"text","data":{"text":"Valle barnehage","type":"h3"},"config":{"size":"wide"}},"n-TOfQHn":{"type":"text","data":{"text":"Valle barnehage holder til i det tidligere våningshuset til Øvre Valle gård. Huset ble ominnredet til barnehaget i 1954, og står på Byantikvarens gule liste (verneverdig). ","type":"paragraph"},"config":{"size":"wide"}},"n-NHJrau":{"type":"image","data":{"image":"r-ZZBKTC","expressImage":"r-5KTYER","expressImageDataId":"r-Zc0KUF","isExpandable":false,"attribution":"Foto: Nikolai Kobets Freund / Oslo kommune"}},"n-1Hucv0":{"type":"carousel","children":["n-NHJrau"]},"n-QR77M8":{"type":"text","data":{"text":"Valhall Arena","type":"h3"},"config":{"size":"wide"}},"n-qkJUFD":{"type":"text","data":{"text":"Valhall Arena er en av Skandinavias største fotballhaller. I tillegg til idrett, benyttes hallen til større messer og konserter. ","type":"paragraph"},"config":{"size":"wide"}},"n-dZ9nLw":{"type":"image","data":{"image":"r-D1WokY","isExpandable":false,"attribution":"Foto: Bymiljøetaten / Oslo kommune"}},"n-xuKxQ8":{"type":"carousel","children":["n-dZ9nLw"]},"n-vVhmT2":{"type":"text","data":{"text":"Valle Hovin Stadion","type":"h3"},"config":{"size":"wide"}},"n-ORxIR9":{"type":"text","data":{"text":"Valle Hovin stadion er et kommunalt kunstisanlegg. Tilbudet er gratis og tilgjengelig for publikum det meste av tiden. \n\nAnlegget ble rehabilitert i 2021-2023 og hadde offisiell gjenåpning 10. februar 2024. ","type":"paragraph"},"config":{"size":"wide"}},"n-ExoBnR":{"type":"image","data":{"image":"r-EHQ6GP","isExpandable":false,"attribution":"Foto: Olav Helland / Oslo kommune"}},"n-l2qUX3":{"type":"carousel","children":["n-ExoBnR"]},"n-kGqaN4":{"type":"text","data":{"text":"Intility Arena","type":"h3"},"config":{"size":"wide"}},"n-ZOULhq":{"type":"text","data":{"text":"Intility Arena åpnet i 2017 og er hjemmebane for Vålerenga Fotball. \n\nUtdanningsetaten i Oslo leier plass langs en av langsidene til Valle Hovin videregående skole.\n\n\n","type":"paragraph"},"config":{"size":"wide"}},"n-f7J7VB":{"type":"tour-map","data":{"geometries":{"dc500f0a-e029-4d78-bbcf-43c128ae37b9":{"id":"dc500f0a-e029-4d78-bbcf-43c128ae37b9","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.795779080476935,"lat":59.922913137768745}],"scale":5000},"88e8a373-783e-4a34-b203-a05554357f7e":{"id":"88e8a373-783e-4a34-b203-a05554357f7e","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.793997566585,"lat":59.926979974809996}],"scale":5000},"fbd81fe7-e766-463d-8456-d8fc8580877c":{"id":"fbd81fe7-e766-463d-8456-d8fc8580877c","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.806707067068288,"lat":59.91785648588167}],"scale":5000},"05f26e38-0ae8-43e1-aa6c-9699ff24b609":{"id":"05f26e38-0ae8-43e1-aa6c-9699ff24b609","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.800280448523502,"lat":59.92026971940026}],"scale":5000},"30eaab5f-baa2-41bd-a663-0f7a490ac73a":{"id":"30eaab5f-baa2-41bd-a663-0f7a490ac73a","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.796656795382258,"lat":59.924187447161486}],"scale":5000},"0dc4d0bc-0a66-4712-9e3c-9d29891d0dfa":{"id":"0dc4d0bc-0a66-4712-9e3c-9d29891d0dfa","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.794860062568649,"lat":59.92387105656988}],"scale":5000},"9c1a7a18-735c-49af-944d-76b0f5ed0917":{"id":"9c1a7a18-735c-49af-944d-76b0f5ed0917","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.794709520036337,"lat":59.92431570572196}],"scale":5000},"e287bbe9-d495-444d-9287-c3d3ed216e51":{"id":"e287bbe9-d495-444d-9287-c3d3ed216e51","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.804237099563236,"lat":59.91844225597623}],"scale":5000},"ae1ef930-4f86-4e5d-a906-86990128ca7a":{"id":"ae1ef930-4f86-4e5d-a906-86990128ca7a","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.806181301857656,"lat":59.92048346837931}],"scale":5000},"e532fbce-d8fb-46be-ae43-7162b7981efe":{"id":"e532fbce-d8fb-46be-ae43-7162b7981efe","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.803201495406917,"lat":59.92237783498865}],"scale":5000},"de65bc94-1708-42ac-bcba-3b73b27afa4c":{"id":"de65bc94-1708-42ac-bcba-3b73b27afa4c","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.801818460479808,"lat":59.919241911353225}],"scale":5000},"76668583-3910-4ca6-b69a-c874d619ad31":{"id":"76668583-3910-4ca6-b69a-c874d619ad31","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.79825555392455,"lat":59.92233603517104}],"scale":5000}},"mode":"2d","basemap":{"type":"resource","value":"r-sTavX8"},"defaultScale":10000}},"n-Ny9XE8":{"type":"tour","data":{"type":"explorer","subtype":"grid","narrativePanelPosition":"start","places":[{"id":"n-Jdg8qh","contents":["n-FeIgBC"],"media":"n-cp3q9W","title":"n-nXe5Bs"},{"id":"n-ZwBGUc","contents":["n-q3dKuU"],"media":"n-S7vpej","title":"n-TmDc8V"},{"id":"n-hG2FD0","contents":["n-CKcWwo","n-8Fxuxf"],"media":"n-dC3CsX","title":"n-1Eg5CM"},{"id":"n-bRVfLx","featureId":"88e8a373-783e-4a34-b203-a05554357f7e","contents":["n-shkUm8"],"media":"n-NPIVvf","title":"n-Je8fkY"},{"id":"n-ZjsW2B","featureId":"9c1a7a18-735c-49af-944d-76b0f5ed0917","contents":["n-KCb71W"],"title":"n-gnriTx"},{"id":"n-y0uaYq","featureId":"0dc4d0bc-0a66-4712-9e3c-9d29891d0dfa","contents":["n-VkdatQ"],"title":"n-161prY"},{"id":"n-xGfFpl","featureId":"30eaab5f-baa2-41bd-a663-0f7a490ac73a","contents":["n-tp8ctb"],"media":"n-Q9vYRY","title":"n-ZKme4b"},{"id":"n-xAMkUB","featureId":"dc500f0a-e029-4d78-bbcf-43c128ae37b9","contents":["n-qP2ROH"],"media":"n-BMA3WD","title":"n-e6RsJe"},{"id":"n-ZBR9f0","featureId":"76668583-3910-4ca6-b69a-c874d619ad31","contents":["n-oZcwzj"],"title":"n-aR1vSe"},{"id":"n-SnSWbb","featureId":"e532fbce-d8fb-46be-ae43-7162b7981efe","contents":["n-ZAMQOO"],"media":"n-2s7qru","title":"n-GhenQl"},{"id":"n-EYUNuN","featureId":"05f26e38-0ae8-43e1-aa6c-9699ff24b609","contents":["n-MLafWD"],"title":"n-gldlPs"},{"id":"n-cVrImo","featureId":"de65bc94-1708-42ac-bcba-3b73b27afa4c","contents":["n-TOfQHn"],"title":"n-n5ztnb"},{"id":"n-xZJHPS","featureId":"ae1ef930-4f86-4e5d-a906-86990128ca7a","contents":["n-qkJUFD"],"media":"n-1Hucv0","title":"n-QR77M8"},{"id":"n-pJOf2a","featureId":"e287bbe9-d495-444d-9287-c3d3ed216e51","contents":["n-ORxIR9"],"media":"n-xuKxQ8","title":"n-vVhmT2"},{"id":"n-VFQfrS","featureId":"fbd81fe7-e766-463d-8456-d8fc8580877c","contents":["n-ZOULhq"],"media":"n-l2qUX3","title":"n-kGqaN4"}],"narrativePanelSize":"small","map":"n-f7J7VB","accentColor":"themeColor2"}},"n-tyJo6V":{"type":"text","data":{"type":"paragraph","text":""}},"n-G5xgL5":{"type":"separator"},"n-BmGuyH":{"type":"text","data":{"type":"h2","text":"Om Hasle og Valle Hovin"}},"n-dzSxEU":{"type":"image","data":{"image":"r-o2WOsM"}},"n-ooxcCO":{"type":"text","data":{"text":"Fra jordbruk til teglverk og småhus","type":"h3"},"config":{"size":"wide"}},"n-XBzOwT":{"type":"text","data":{"text":"Hasle har navn etter gården og et eldre navn på Hovinbekken Hasla - som sikter til treslaget hassel. Hasle ligger i bydel Grünerløkka og grenser til Valle Hovin, som ligger på grensen mellom bydelene Grünerløkka og Gamle Oslo. Historisk har området tilhørt gårdene Hasle og Hovin.\n\nOmrådet var et rent jordbruksland inntil teglverkene mot slutten av århunderet dominerte og formet landskapet ved at det ble tatt ut store volumer av leire. Samtidig ble det bygget småhusbebyggelse langs Økernveien, og området fikk karakter av å være en forstad til byen som formelt strakte seg til Grenseveien. ","type":"paragraph"},"config":{"size":"wide"}},"n-0qz46q":{"type":"timeline-event","children":["n-dzSxEU","n-ooxcCO","n-XBzOwT"]},"n-lluv5I":{"type":"image","data":{"image":"r-gaon4b"}},"n-0eYbHH":{"type":"text","data":{"text":"Industri og vinmonopol","type":"h3"},"config":{"size":"wide"}},"n-9KoZKl":{"type":"text","data":{"text":"I 1918 ble Hasle avsatt som et industriområde knyttet til Alnabanen, og Vinmonopolets sentralanlegg ble oppført i 1933. Mange bedrifter flyttet ut fra små tomter i sentrum, og med tida ble området preget av at flere bilforhandlere etablerte seg. I småhusområdene på Hasle ble det bygget boliger for arbeidene og funksjonærer i tråd med tidas skiftende hagebyidealer.   ","type":"paragraph"},"config":{"size":"wide"}},"n-2lPR6S":{"type":"timeline-event","children":["n-lluv5I","n-0eYbHH","n-9KoZKl"]},"n-2NzkyZ":{"type":"image","data":{"image":"r-x6ZXMS"}},"n-aFvyNG":{"type":"text","data":{"text":"Idretts-anlegg","type":"h3"},"config":{"size":"wide"}},"n-Jij21n":{"type":"text","data":{"text":"På 1960-tallet ble det anlagt et idrettsanlegg der det inntil da hadde vært jorder som tilhørte gårdene Valle og Hovin. Norges første kunstisbane åpnet i 1969 og heter nå offisielt Valle Hovin stadion. Etter at stadionet er lagt ned som konsertarena, har området blitt rehabilitert til å fungere som en moderne kunstisbane og et fremtidig idrettsanlegg for bandy og hurtigløp på skøyter. \n\nI 2001 kom idrettshallen Valhall Arena, og i 2017 åpnet Intility Arena (Vålerenga stadion). På Hasle er det også viktige idrettsanlegg: Haslehallen for turn (1999) og Riksanlegget for tennis (2000). ","type":"paragraph"},"config":{"size":"wide"}},"n-lgnUlc":{"type":"timeline-event","children":["n-2NzkyZ","n-aFvyNG","n-Jij21n"]},"n-l2QmnQ":{"type":"timeline","data":{"type":"condensed"},"children":["n-0qz46q","n-2lPR6S","n-lgnUlc"]},"n-4qnZdD":{"type":"text","data":{"type":"paragraph","text":""}},"n-7ecKdJ":{"type":"separator"},"n-Uk4eLq":{"type":"text","data":{"text":"Dokumenter","type":"h2"}},"n-X5kLXO":{"type":"text","data":{"text":"Planer","type":"h3"},"config":{"size":"wide"}},"n-6W3q1W":{"type":"text","data":{"text":"En <em>plan</em> er et dokument som gir føringer eller bestemmer hva som er tillatt å bygge i et område. Reguleringsplaner gjelder for et avgrenset område, og kan være laget på ulike nivåer. Noen er overordnet og generelle for et større område, mens andre er veldig detaljerte for et mindre nabolag.","type":"paragraph"},"config":{"size":"wide"}},"n-H0FoCe":{"type":"timeline-event","children":["n-X5kLXO","n-6W3q1W"]},"n-yf3Ob9":{"type":"text","data":{"text":"Hvem bestemmer planene?","type":"h3"},"config":{"size":"wide"}},"n-1qv9mK":{"type":"text","data":{"text":"Et forslag til en ny reguleringsplan lages av utviklere, privatpersoner eller av kommunen. Alle forslag skal behandles av Plan- og bygningsetaten. Når Plan- og bygningsetaten har behandlet forslaget til ny plan, sendes det til politisk behandling. \n\nAlle forslag til nye planer skal godkjennes av de folkevalgte i bystyret før de er gyldige.","type":"paragraph"},"config":{"size":"wide"}},"n-ZQPKxV":{"type":"timeline-event","children":["n-yf3Ob9","n-1qv9mK"]},"n-J4mB25":{"type":"timeline","data":{"type":"condensed"},"children":["n-H0FoCe","n-ZQPKxV"]},"n-7mCyWq":{"type":"text","data":{"type":"paragraph","text":""}},"n-2mm1Uw":{"type":"button","data":{"text":"Planprogram Hasle og Valle Hovin","link":"https://innsyn.pbe.oslo.kommune.no/saksinnsyn/showfile.asp?jno=2022044437&fileid=10150831"}},"n-HnMmRT":{"type":"text","data":{"type":"paragraph","text":""}},"n-CEHN45":{"type":"text","data":{"text":"","type":"h4"}},"n-0nQbzl":{"type":"text","data":