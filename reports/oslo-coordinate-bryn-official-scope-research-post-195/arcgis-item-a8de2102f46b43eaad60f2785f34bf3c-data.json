{"root":"n-lyeDp2","nodes":{"n-WJ7k8d":{"type":"image","data":{"image":"r-iMxRY1"}},"n-R5ssrl":{"type":"storycover","data":{"type":"card","title":"Om Hovinbyen","summary":"Fra grått til grønt","byline":"","titlePanelVerticalPosition":"top","titlePanelHorizontalPosition":"start","titlePanelStyle":"gradient","titlePanelSize":"small"},"config":{"isHidden":false},"children":["n-WJ7k8d"]},"n-S2d2r9":{"type":"navigation","data":{"links":[{"nodeId":"n-J49SmR","customText":"Hovinbyen"},{"nodeId":"n-ctvTOI"},{"nodeId":"n-qw39Wn","customText":"Kort historie"},{"nodeId":"n-F4QoHT"}]},"config":{"isHidden":false}},"n-J49SmR":{"type":"text","data":{"text":"Hva er Hovinbyen?","type":"h2"}},"n-E5AGvd":{"type":"image","data":{"image":"r-QJSv3I"}},"n-bwKmqP":{"type":"carousel","children":["n-E5AGvd"]},"n-adL7HG":{"type":"text","data":{"text":"Hovinbyen er et utviklingsområde","type":"h3"},"config":{"size":"wide"}},"n-eqAxLT":{"type":"text","data":{"text":"Hovinbyen er et <strong>byutviklingsområde </strong>som strekker seg over fire ulike bydeler: Alna, Bjerke, Gamle Oslo og Grünerløkka. \n\nNoen områder i Hovinbyen har vært utviklingsområder i over 20 år (Løren og Hasle), mens andre områder står midt i store endringer nå (Økern og Bryn). Det er også noen områder som ikke vil ha en synlig utvikling før flere år frem i tid (Breivoll). \n\nHovin var den største gården i området og ga navn til Hovinbekken som renner gjennom området, derav navnet Hovinbyen. ","type":"paragraph"},"config":{"size":"wide"}},"n-lH0dub":{"type":"image","data":{"image":"r-LyeRnr","expressImage":"r-OcIhcJ","expressImageDataId":"r-Mm5aEN","isExpandable":false,"attribution":"Byggeplass, regjeringskvartalet. Foto: Marcin Wojciech Sliwa / Oslo kommune"}},"n-h7MMEx":{"type":"carousel","children":["n-lH0dub"]},"n-4EhQY9":{"type":"text","data":{"text":"Hva er byutvikling?","type":"h3"},"config":{"size":"wide"}},"n-QXN7Eg":{"type":"text","data":{"text":"Byutvikling er en langsiktig prosess for å forme og utvikle et område. \n\nByutvikling involverer å planlegge, fysisk bygge og forbedre sosiale tjenester for å skape gode levekår for innbyggerne. Det omfatter alt fra å bestemme hvor gater, boliger og grøntområder skal ligge, til å ta hensyn til klima, helse og infrastruktur for å møte fremtidige behov. ","type":"paragraph"},"config":{"size":"wide"}},"n-QdfMiw":{"type":"tour-map","data":{"geometries":{"17356b67-9bc4-4d50-a05b-05b3f6d586c6":{"id":"17356b67-9bc4-4d50-a05b-05b3f6d586c6","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.807678700135321,"lat":59.922575001049765}],"scale":20000},"9096a1f7-8cbf-4f06-a13b-9ca5b939524e":{"id":"9096a1f7-8cbf-4f06-a13b-9ca5b939524e","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.810083987893057,"lat":59.927722192289195}],"scale":80000},"f066e532-4835-462b-9fe0-b9bdeca0189b":{"id":"f066e532-4835-462b-9fe0-b9bdeca0189b","type":"POINT_NUMBERED_TOUR","nodes":[{"long":10.831455935553592,"lat":59.90928061731095}],"scale":80000}},"mode":"2d","basemap":{"type":"resource","value":"r-wcvj8J"},"defaultScale":80000}},"n-DY2DX7":{"type":"tour","data":{"type":"guided-tour","subtype":"map-focused","narrativePanelPosition":"start","places":[{"id":"n-loJ0j4","featureId":"f066e532-4835-462b-9fe0-b9bdeca0189b","contents":["n-eqAxLT"],"media":"n-bwKmqP","title":"n-adL7HG"},{"id":"n-E1DRJG","featureId":"17356b67-9bc4-4d50-a05b-05b3f6d586c6","contents":["n-QXN7Eg"],"media":"n-h7MMEx","title":"n-4EhQY9"}],"narrativePanelSize":"small","accentColor":"backgroundColor","map":"n-QdfMiw"}},"n-ctvTOI":{"type":"text","data":{"type":"h2","text":"Nøkkeltall"}},"n-XQvkUk":{"type":"text","data":{"text":"Siden 2010 er det bygget omtrent 14 000 boliger og 16 000 nye arbeidsplasser i Hovinbyen. ","type":"quote","attribution":"Plan- og bygningsetatens tall per mars 2026"}},"n-BFxCVE":{"type":"text","data":{"type":"paragraph","text":"Under kan du se boligtall og arbeidsplasser inndelt etter hvert enkelt utviklingsområde.\nTallene er fra mai 2026."}},"n-ebV3WH":{"type":"image","dat