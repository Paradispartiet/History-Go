ype":"grid","narrativePanelPosition":"start","places":[{"id":"n-tuqTAB","featureId":"d85b36b2-c1f0-47ad-aa54-2468b9a6eb4f","contents":["n-qSmtIe"],"media":"n-L69wNP","title":"n-5d2Ji2"},{"id":"n-906Jq4","featureId":"0630460e-adca-457b-a8f8-5000b88b2aa2","contents":["n-1lOuhm"],"media":"n-xGr4ni","title":"n-4toSyX"},{"id":"n-yNANQJ","featureId":"44719693-cbf0-4976-aa13-040ecbd9f31b","contents":["n-UK9Oll","n-D7pFd9"],"media":"n-9rs6Aa","title":"n-8BkK4r"},{"id":"n-5ouoLg","featureId":"b59a9b9d-5e46-4ab3-b855-ff41131022b3","contents":["n-3q3bqi"],"media":"n-oLKLSh","title":"n-r6WgFJ"},{"id":"n-AVwwrE","featureId":"d13f6bde-fc73-4986-aea4-1084466625a2","contents":["n-FnlgKe"],"media":"n-bJPh1Y","title":"n-GolQr2"},{"id":"n-QOiVPh","featureId":"7a032655-37e4-4290-831b-733bcc841ae8","contents":["n-tvaHCh"],"media":"n-d0Y447","title":"n-wlz67a"},{"id":"n-TaAjjt","featureId":"52400b5f-aacd-4a11-bd08-184f531e89a0","contents":["n-SzmHYt"],"media":"n-ghHojh","title":"n-eJoZvU"},{"id":"n-KMQwMk","featureId":"0c6d9141-758f-43e5-a9e0-9e0076630131","contents":["n-vc3LMl"],"media":"n-rPLHwr","title":"n-EX7UnB"},{"id":"n-LzAGLb","featureId":"83094942-d248-458b-8ae1-500c9db4b53f","contents":["n-lxg5XD"],"media":"n-O0WBij","title":"n-H0Loqe"},{"id":"n-MZZr5W","featureId":"7ef2866a-c8ce-4e1c-8a76-ed28204be2f7","contents":["n-vZZse0"],"media":"n-z4Rb07","title":"n-bP7LTv"},{"id":"n-HFsHMW","featureId":"b3d8a32d-c347-400c-aec4-6b91c118262f","contents":["n-T32ehL"],"media":"n-zJS6Ap","title":"n-oAlWqI"}],"narrativePanelSize":"small","map":"n-yYEh8R","accentColor":"themeColor2"}},"n-KTLp97":{"type":"separator"},"n-qw39Wn":{"type":"text","data":{"type":"h2","text":"Kort historie om området"}},"n-m95qTF":{"type":"image","data":{"image":"r-DBnex5"}},"n-JotH2J":{"type":"text","data":{"text":"Jordbruk og byløkker","type":"h3"},"config":{"size":"wide"}},"n-kXR096":{"type":"text","data":{"type":"paragraph","text":"Mange av stedsnavnene i Hovinbyen kommer fra gårder som ble ryddet i århundrene før vikingtiden. Landskapet i bygda Aker var preget av jordbruk helt fram til midten av 1900-tallet. \n\nI områder som lå nær byen ble tidlig oppført fritids- og sommerhus, kalt løkker, av borgerskapet i byen. "}},"n-DdWqSB":{"type":"timeline-event","children":["n-m95qTF","n-JotH2J","n-kXR096"]},"n-m742z4":{"type":"image","data":{"image":"r-u6AFj0"}},"n-CExecE":{"type":"text","data":{"text":"Industri og jernbane","type":"h3"},"config":{"size":"wide"}},"n-ZQ5Mzb":{"type":"text","data":{"text":"1800-tallets industrialisering påvirket områdene. Særlig teglverk, mekanisk industri og fyrstikkfabrikker skapte tidlig mange arbeidsplasser. Da Norges første jernbanestrekning stod ferdig i 1854, ble jernbanen en viktig drivkraft for industriutvikling. \n \nUtover 1900-tallet fortsatte etableringen av industrivirksomheter, og boligbyggingen fulgte på.  ","type":"paragraph"},"config":{"size":"wide"}},"n-Q4bs97":{"type":"timeline-event","children":["n-m742z4","n-CExecE","n-ZQ5Mzb"]},"n-0IBPSZ":{"type":"image","data":{"image":"r-76oRxj"}},"n-G67Cvs":{"type":"text","data":{"text":"Ny kommune og ny plan","type":"h3"},"config":{"size":"wide"}},"n-Rra2EG":{"type":"text","data":{"text":"I 1948 ble Aker og Oslo slått sammen til én kommune, og det ble behov for nye arealer til både bolig og industri. Kommunens <em>Generalplan</em> (1950) la nye føringer for hvordan områdene skulle benyttes. \n\nNoen områder ble avsatt til industriformål mens andre ble avsatt til boligområder. Det var disse fordelingene som formet områdene frem mot 2000-tallet.","type":"paragraph"},"config":{"size":"wide"}},"n-k4ziR8":{"type":"timeline-event","children":["n-0IBPSZ","n-G67Cvs","n-Rra2EG"]},"n-VFWcS0":{"type":"image","data":{"image":"r-hGz1A5"}},"n-NlgV5l":{"type":"text","data":{"text":"Hovinbyen som begrep","type":"h3"},"config":{"size":"wide"}},"n-G1GZpM":{"type":"text","data":{"text":"Oslo fortsette å vokse utover 2000-tallet. Det var blant annet behov for flere boliger, og kommunen utpekte derfor området mellom sentrum og Groruddalen til et sted hvor byen kunne utvikle seg. Dette byutviklingsområdet fikk navnet Hovinbyen etter bekken som renner gjennom denne delen av byen og den tidligere store gården Hovin som strakte seg fra Lilleberg til Alnabru.\n\nI 2018 startet arbeidet med å utvikle områdene. <em>Strategisk plan for Hovinbyen</em> ble vedtatt, og planen har en tidshorisont på 50 år.","type":"paragraph"},"config":{"size":"wide"}},"n-trz0jK":{"type":"timeline-event","children":["n-VFWcS0","n-NlgV5l","n-G1GZpM"]},"n-nFRfdQ":{"type":"timeline","data":{"type":"condensed"},"children":["n-DdWqSB","n-Q4bs97","n-k4ziR8","n-trz0jK"]},"n-FZq8wI":{"type":"separator"},"n-F4QoHT":{"type":"text","data":{"type":"h2","text":"Mer informasjon"}},"n-3nItlY":{"type":"text","data":{"type":"h3","text":"Oslo kommunes nettsider"}},"n-1bxUHs":{"type":"text","data":{"type":"paragraph","text":"Det foregår mange prosjekter på tvers av fagetatene i Oslo kommune. Du kan finne informasjon om spesifikke prosjekter ved å søke på prosjektnavnet eller stedet på Oslo kommunes nettside. "}},"n-pKnPrM":{"type":"button","data":{"text":"Søk på nettsiden til Oslo kommune","link":""}},"n-ST0cx5":{"type":"text","data":{"type":"h3","text":"Byplan Oslo"}},"n-hEDUWy":{"type":"text","data":{"type":"paragraph","text":"ByplanOslo er Oslo kommunes magasin om byutvikling. Her kan du lese artikler om utvikling av Hovinbyen. Mange av artiklene er flere år gamle, men de bidrar likevel til å skape et bilde av hvordan utviklingen har foregått siden oppstarten i 2018.  "}},"n-NSHQ1m":{"type":"button","data":{"text":"Les artikler i Byplan Oslo","link":""}},"n-nZmSUk":{"type":"text","data":{"type":"paragraph","text":""}},"n-hzOA6o":{"type":"text","data":{"text":"","type":"h4","textAlignment":"start"}},"n-NFUaIb":{"type":"text","data":{"text":"Plan- og bygningsetaten\nTelefon: 2180 2180\nE-post: postmottak@pbe.oslo.kommune.no \n\n<a href=\"https://www.oslo.kommune.no/plan-og-bygningsetaten\" rel=\"noopener noreferrer\" target=\"_blank\">www.oslo.kommune.no/plan-og-bygningsetaten</a>","type":"paragraph"}},"n-ql2UQz":{"type":"attribution","data":{"content":"","attribution":""}},"n-qLIWh2":{"type":"credits","children":["n-hzOA6o","n-NFUaIb","n-ql2UQz"]},"n-lyeDp2":{"type":"story","data":{"storyTheme":"r-UGvF0D"},"config":{"coverDate":"none","isSocialIconsHidden":false,"shouldHideSimilarItems":true,"scriptEmbedDomains":[],"isScriptEmbedEnabled":false,"storyLocale":"nb"},"children":["n-R5ssrl","n-S2d2r9","n-J49SmR","n-DY2DX7","n-ctvTOI","n-XQvkUk","n-BFxCVE","n-PcVDzM","n-KTLp97","n-qw39Wn","n-nFRfdQ","n-FZq8wI","n-F4QoHT","n-3nItlY","n-1bxUHs","n-pKnPrM","n-ST0cx5","n-hEDUWy","n-NSHQ1m","n-nZmSUk","n-qLIWh2"]}},"resources":{"r-iMxRY1":{"type":"image","data":{"resourceId":"B1G60VAJP5sA7GnULkfIF.jpg","provider":"item-resource","height":1082,"width":2090}},"r-QJSv3I":{"type":"image","data":{"resourceId":"OleKL041W5HioeTl5KUku.jpg","provider":"item-resource","height":1082,"width":2090}},"r-LyeRnr":{"type":"image","data":{"resourceId":"FvozVY8AWP3EBYoe0Xwbz.jpg","provider":"item-resource","height":891,"width":1200}},"r-OcIhcJ":{"type":"image","data":{"resourceId":"EEPuHjRb0oyHQr8BIZs76.jpeg","provider":"item-resource","height":675,"width":1200}},"r-Mm5aEN":{"type":"express-image-data","data":{"itemId":"expressimage_1774874896704.json","provider":"item-resource"}},"r-wcvj8J":{"type":"webmap","data":{"type":"minimal","itemType":"Web Map","itemId":"ab325cb2e4174dc9895340fab01f2496"}},"r-Y5GRKe":{"type":"image","data":{"resourceId":"ZqV9Wek43UcuhEksJRk-2.jpg","provider":"item-resource","height":1233,"width":1851}},"r-t0hwO4":{"type":"image","data":{"resourceId":"OX5zN90skoTL7Ew6e76S9.jpg","provider":"item-resource","height":1333,"width":2000}},"r-fM9kh8":{"type":"image","data":{"resourceId":"amvjLlbipQtkISViByH6g.jpg","provider":"item-resource","height":1336,"width":2000}},"r-TTlmnV":{"type":"image","data":{"resourceId":"egoXC9N5sjXOfZKvKm9HG.jpg","provider":"item-resource","height":1333,"wi