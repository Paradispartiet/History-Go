n-8en3ed","title":"n-bWPZpx"},{"id":"n-gsUecG","featureId":"4c4f7c51-37cf-48ea-8853-e3e5d6558f9a","contents":["n-M3JJcE"],"media":"n-PO9CTN","title":"n-lrfDkx"},{"id":"n-vie5sA","featureId":"83770507-3f8b-4a31-a105-d49fcb6879df","contents":["n-fME9Ve"],"media":"n-57b1PH","title":"n-Z9bK6p"},{"id":"n-6BTKKj","featureId":"d9cfcc9d-0787-4c54-8d4d-800533185898","contents":["n-YXV5bY","n-ZIkVVB"],"media":"n-wkjRXV","title":"n-5M8JKS"},{"id":"n-NT9KV0","featureId":"feac3376-437e-4e31-bf68-13ada5fdca61","contents":["n-FpZ1pi"],"media":"n-JEDPAe","title":"n-PkgJRI"},{"id":"n-wI8Yrc","featureId":"df54db5f-c84b-4a67-a486-53472237a687","contents":["n-763cv7"],"media":"n-sOCBX9","title":"n-ee6wOM"},{"id":"n-9xC7Zn","featureId":"8be91235-995b-4dbf-9242-7fb164dff4f3","contents":["n-Dxa6oD"],"media":"n-bFkXVq","title":"n-GcWk7A"},{"id":"n-XTj6uU","featureId":"6222e8db-afd4-4f1d-8b2c-11b784697bca","contents":["n-2R90l4"],"media":"n-Z4pBdj","title":"n-azXuPH"},{"id":"n-dlwjVv","featureId":"ad8ea06a-be06-4218-9774-0bd96c3c9005","contents":["n-NFydH4"],"media":"n-PGOxmd","title":"n-sIwbGN"}],"narrativePanelSize":"medium","map":"n-8ZP8ye","accentColor":"themeColor2"}},"n-tAmBGp":{"type":"text","data":{"type":"paragraph","text":""}},"n-c90YFK":{"type":"text","data":{"type":"paragraph","text":""}},"n-oT9bRD":{"type":"separator"},"n-axq5Jn":{"type":"text","data":{"type":"h2","text":"Om Ensjø"}},"n-NWMNq2":{"type":"image","data":{"image":"r-DlGfix"}},"n-RVvkCZ":{"type":"text","data":{"text":"Teglverk","type":"h3"},"config":{"size":"wide"}},"n-SckVlz":{"type":"text","data":{"text":"Ensjø ligger i bydel Gamle Oslo, og området har navnet sitt etter gården Ensjø, opprinnelig kalt nedre Valle. \n\nPå Ensjø var det store forekomster av leire i grunnen, og på 1800-tallet var Ensjø preget av teglverksindustri med flere teglverk. Ensjø teglverk leverte murstein fra 1852 til 1916. ","type":"paragraph"},"config":{"size":"wide"}},"n-2JteX7":{"type":"timeline-event","children":["n-NWMNq2","n-RVvkCZ","n-SckVlz"]},"n-3cftfw":{"type":"image","data":{"image":"r-yKRw8B"}},"n-xCuGq1":{"type":"text","data":{"text":"Fra bilby til byliv","type":"h3"},"config":{"size":"wide"}},"n-pFvola":{"type":"text","data":{"text":"Fra 1960-tallet ble området kjent som Oslos «bilby» med over 40 bilforretninger etablert i området. I 2004 vedtok Oslo bystyre en strategisk plan for å endre området fra næring til en boligbydel. ","type":"paragraph"},"config":{"size":"wide"}},"n-Xyo7Bd":{"type":"timeline-event","children":["n-3cftfw","n-xCuGq1","n-pFvola"]},"n-eBRuxI":{"type":"image","data":{"image":"r-078r4z"}},"n-p8cjDZ":{"type":"text","data":{"text":"Grønne parker og åpne bekker","type":"h3"},"config":{"size":"wide"}},"n-GJXMAd":{"type":"text","data":{"text":"Parallelt med bygging av nye boliger blir det etablert møteplasser og grønne områder. Et viktig grep var å åpne opp Hovinbekken som nå renner gjennom området og ender opp i et vannspeil som har fått navnet Ensjøen. ","type":"paragraph"},"config":{"size":"wide"}},"n-gfPtCk":{"type":"timeline-event","children":["n-eBRuxI","n-p8cjDZ","n-GJXMAd"]},"n-s2iMRO":{"type":"timeline","data":{"type":"condensed"},"children":["n-2JteX7","n-Xyo7Bd","n-gfPtCk"]},"n-dFBH9H":{"type":"text","data":{"type":"paragraph","text":""}},"n-K1nVm6":{"type":"separator"},"n-Lp3Zoj":{"type":"text","data":{"text":"Dokumenter","type":"h2"}},"n-NmIFei":{"type":"text","data":{"text":"Planer","type":"h3"},"config":{"size":"wide"}},"n-e9OqZx":{"type":"text","data":{"text":"En <em>plan</em> er et dokument som gir føringer eller bestemmer hva som er tillatt å bygge i et område. Reguleringsplaner gjelder for et avgrenset område, og kan være laget på ulike nivåer. Noen er overordnet og generelle for et større område, mens andre er veldig detaljerte for et mindre nabolag. ","type":"paragraph"},"config":{"size":"wide"}},"n-4Xn2Vq":{"type":"timeline-event","children":["n-NmIFei","n-e9OqZx"]},"n-5EJqFV":{"type":"text","data":{"text":"Hvem bestemmer planene?","type":"h3"},"config":{"size":"wide"}},"n-6iXlbJ":{"type":"text","data":{"text":"Et forslag til en ny reguleringsplan lages av utviklere, privatpersoner eller av kommunen. Alle forslag skal behandles av Plan- og bygningsetaten. Når Plan- og bygningsetaten har behandlet forslaget til ny plan, sendes det til politisk behandling. \n\nAlle forslag til nye planer skal godkjennes av de folkevalgte i bystyret før de er gyldige.","type":"paragraph"},"config":{"size":"wide"}},"n-Labtik":{"type":"timeline-event","children":["n-5EJqFV","n-6iXlbJ"]},"n-OFkaq4":{"type":"timeline","data":{"type":"condensed"},"children":["n-4Xn2Vq","n-Labtik"]},"n-3aKbSx":{"type":"text","data":{"type":"paragraph","text":""}},"n-2mm1Uw":{"type":"button","data":{"text":"Veiledende plan for offentlig rom","link":"https://innsyn.pbe.oslo.kommune.no/saksinnsyn/showfile.asp?jno=2006015060&fileid=1010050"}},"n-ojzejm":{"type":"button","data":{"text":"Planleggingsprogrammet for Ensjø ","link":"https://www.oslo.kommune.no/get-file/109953/91a91efa821e8c1abae99e1819e6e22dc61f1860ec51102e7b10652d7d11ddf2"}},"n-Qrbcml":{"type":"grid","data":{"cols":2,"rows":1,"items":[{"colStart":0,"colEnd":1,"rowStart":0,"rowEnd":1},{"colStart":1,"colEnd":2,"rowStart":0,"rowEnd":1}]},"children":["n-2mm1Uw","n-ojzejm"]},"n-HnMmRT":{"type":"text","data":{"type":"paragraph","text":""}},"n-CEHN45":{"type":"text","data":{"text":"","type":"h4"}},"n-0nQbzl":{"type":"text","data":{"text":"Plan- og bygningsetaten\nTelefon: 2180 2180\nE-post: postmottak@pbe.oslo.kommune.no \n\n<a href=\"https://www.oslo.kommune.no/plan-og-bygningsetaten\" rel=\"noopener noreferrer\" target=\"_blank\"> www.oslo.kommune.no/plan-og-bygningsetaten</a>","type":"paragraph"}},"n-vRlkUC":{"type":"attribution","data":{"content":"","attribution":""}},"n-Eofi7e":{"type":"credits","config":{"isHidden":false},"children":["n-CEHN45","n-0nQbzl","n-vRlkUC"]},"n-sgR3OY":{"type":"story","data":{"storyTheme":"r-Y6HW5h"},"config":{"coverDate":"none","isSocialIconsHidden":false,"shouldHideSi