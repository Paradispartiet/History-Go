59.74964892054123],[10.797146690917716,59.74965240809211],[10.797148505648561,59.74965696199314]]]]},"properties":{"navn":"Nøstvedt","opphav":"Akershus fylkeskommune","informasjon":"Rydningsrøysa ligger delvis bygd opp mot berg i nord-nordøst. Den er måneformet og 2,7 x 4 meter i omkrets. Høyden på den er 40 cm og steinene er fra hodestore til 55 cm. Rydningsrøysa ligger på en åkerholme, den er mosegrodd, men ser ut til å være fra nyere tid.","førsteDigitaliseringsdato":"2010-12-21T13:29:21Z","kommune":"3218","kulturminneId":"140662-1","antallEnkeltminner":1,"linkAskeladden":"https://askeladden.ra.no/askeladden/?kid=140662-1","linkKulturminnesøk":"https://kulturminnesok.no/ra/lokalitet/140662","lokalId":"140662-1","lokalitetsart":"20114","lokalitetskategori":"L-ARK","målemetode":99,"navnerom":"http://skjema.geonorge.no/SOSI/produktspesifikasjon/LokaliteterEnkeltminnerOgSikringssoner/20210217","versjonId":"20210217","nøyaktighet":500,"nåværendeFunksjon":null,"områdefredning":null,"synlig":true,"vernetype":"IKKEV","vernedato":"1900-01-01T00:00:00Z","vernelov":null,"verneparagraf":null,"opprinneligFunksjon":"2500","datafangstdato":"2010-12-21T00:00:00Z","opprettet":"2010-12-21T13:29:21Z","oppdateringsdato":"2025-06-24T11:43:56Z","senterpunkt":{"type":"Point","coordinates":[10.797130759521693,59.749656393072236]}}},{"type":"Feature","id":"140663-1","geometry":{"type":"MultiPolygon","coordinates":[[[[10.799456619749645,59.74919768296335],[10.799453678848318,59.74920208456597],[10.799446771743089,59.74920515431892],[10.799437747877704,59.7492060702661],[10.799429025748791,59.74920458614537],[10.79942294278919,59.74920110048951],[10.799421127769229,59.74919654661659],[10.79942406867431,59.74919214501473],[10.79943097577882,59.749189075262954],[10.799439999639759,59.74918815931622],[10.79944872176494,59.74918964343616],[10.799454804725256,59.749193129090855],[10.799456619749645,59.74919768296335]]]]},"properties":{"navn":"Nøstvedt","opphav":"Akershus fylkeskommune","informasjon":"Rydningsøysa er 3 x 5 meter i omkrets og 90 cm høy. Den er avlang og består av neve- og hodestore stein, samt enkelte opp i 40 cm store. Den ligger på en knaus eller åkerholme som skråner mot øst.","førsteDigitaliseringsdato":"2010-12-21T13:31:27Z","kommune":"3218","kulturminneId":"140663-1","antallEnkeltminner":1,"linkAskeladden":"https://askeladden.ra.no/askeladden/?kid=140663-1","linkKulturminnesøk":"https://kulturminnesok.no/ra/lokalitet/140663","lokalId":"140663-1","lokalitetsart":"20114","lokalitetskategori":"L-ARK","målemetode":99,"navnerom":"http://skjema.geonorge.no/SOSI/produktspesifikasjon/LokaliteterEnkeltminnerOgSikringssoner/20210217","versjonId":"20210217","nøyaktighet":500,"nåværendeFunksjon":null,"områdefredning":null,"synlig":true,"vernetype":"IKKEV","vernedato":"1900-01-01T00:00:00Z","vernelov":null,"verneparagraf":null,"opprinneligFunksjon":"2500","datafangstdato":"2010-12-21T00:00:00Z","opprettet":"2010-12-21T13:31:27Z","oppdateringsdato":"2025-06-24T11:43:56Z","senterpunkt":{"type":"Point","coordinates":[10.799438873759089,59.74919711479116]}}},{"type":"Feature","id":"174581-1","geometry":{"type":"MultiPolygon","coordinates":[[[[10.786765997457493,59.757897734186],[10.78676205492655,59.75789547569183],[10.786763976400387,59.7578924361883],[10.786769812453544,59.757891848499604],[10.786773395978543,59.75789390124812],[10.786772671639374,59.757896591652326],[10.786765997457493,59.757897734186]]]]},"properties":{"navn":"Nøstvedt","opphav":"Akershus fylkeskommune","informasjon":null,"førsteDigitaliseringsdato":"2014-01-14T15:43:04Z","kommune":"3218","kulturminneId":"174581-1","antallEnkeltminner":1,"linkAskeladden":"https://askeladden.ra.no/askeladden/?kid=174581-1","linkKulturminnesøk":"https://kulturminnesok.no/ra/lokalitet/174581","lokalId":"174581-1","lokalitetsart":"20159","lokalitetskategori":"L-ARK","målemetode":96,"navnerom":"http://skjema.geonorge.no/SOSI/produktspesifikasjon/LokaliteterEnkeltminnerOgSikringssoner/20210217","versjonId":"20210217","nøyaktighet":40,"nåværendeFunksjon":null,"områdefredning":null,"synlig":false,"vernetype":"IKKEV","vernedato":"1900-01-01T00:00:00Z","vernelov":null,"verneparagraf":null,"opprinneligFunksjon":"9900","datafangstdato":"2014-01-14T00:00:00Z","opprettet":"2014-01-14T15:43:04Z","oppdateringsdato":"2024-01-06T13:35:47Z","senterpunkt":{"type":"Point","coordinates":[10.786767851883404,59.75789473983332]}}},{"type":"Feature","id":"89248","geometry":{"type":"MultiPolygon","coordinates":[[[[10.78418241917615,59.74724302205333],[10.784195897962297,59.74712206845085],[10.784256675424823,59.746979256591004],[10.784405556226858,59.74691480533125],[10.784592663685391,59.746914523480406],[10.784697336431583,59.74697453391481],[10.784712669587158,59.7471072032189],[10.784683401746337,59.74719797721013],[10.784577479383094,59.74724672508797],[10.784368943495242,59.74730386468804],[10.78418241917615,59.74724302205333]]]]},"properties":{"navn":"Nøstvedt","opphav":"Akershus fylkeskommune","informasjon":"Boplassen ligger på en sørvestvendt hellende flate, ca. 15 m i ø-v retning og 35 m i n-s retning, ca. 80-85 moh. Flaten overskjæres av en skogsvei i øst. Den avgrenses i vest av en bratt helling og stup, av brattere og kupert skråning i sør og av berg og kupert skrånende terreng i øst. I nord er flaten uklart avgrensa, men den smalner og blir mer kupert og steinete. Det ble gravd 13 prøvestikk hvorav 5 var positive. Det ble funnet fragmenter og avslag av flint, en knakkestein, og en slått bergkrystall, et bergartsavslag og en knakkestein. lokaliteten er ca. 500 kvadratmeter.    \n\nKontrollregistrering 2015: Veien over lokaliteten er oppgradert og i den forbindelse er det fylt på masser 10 m mot vest. Deler av boplassen er dermed tildekket og ødelagt.","førsteDigitaliseringsdato":"2004-09-16T15:17:16Z","kommune":"3218","kulturminneId":"89248","antallEnkeltminner":4,"linkAskeladden":"https://askeladden.ra.no/askeladden/?kid=89248","linkKulturminnesøk":"https://kulturminnesok.no/ra/lokalitet/89248","lokalId":"89248","lokalitetsart":"20159","lokalitetskategori":"L-ARK","målemetode":99,"navnerom":"http://skjema.geonorge.no/SOSI/produktspesifikasjon/LokaliteterEnkeltminnerOgSikringssoner/20210217","versjonId":"20210217","nøyaktighet":500,"nåværendeFunksjon":null,"områdefredning":null,"synlig":false,"vernetype":"AUT","vernedato":"2003-10-01T00:00:00Z","vernelov":"KML","verneparagraf":"4 (Automatisk fredning)","opprinneligFunksjon":null,"datafangstdato":"2003-10-01T00:00:00Z","opprettet":"2004-09-16T15:17:16Z","oppdateringsdato":"2025-06-24T11:43:56Z","senterpunkt":{"type":"Point","coordinates":[10.784449839503868,59.74710275623297]}}},{"type":"Feature","id":"89249","geometry":{"type":"MultiPolygon","coordinates":[[[[10.783909621709011,59.76284638290984],[10.78416152015189,59.76284188718792],[10.784442015733642,59.76285089785174],[10.784790018805442,59.76288995024428],[10.784953279071004,59.76292396722219],[10.784983857765564,59.76299238634689],[10.784885983003706,59.763089948572976],[10.784702767078091,59.76314340819064],[10.784413145184264,59.763192550367926],[10.784122673279692,59.763177824251564],[10.783851910652466,59.76313405840641],[10.783630585697765,59.76306580473176],[10.783571525841838,59.76298298274385],[10.783610977907378,59.762910519165075],[10.783755556342745,59.762866609636454],[10.783909621709011,59.76284638290984]]]]},"properties":{"navn":"Nøstvedt","opphav":"Akershus fylkeskommune","informasjon":"Boplassen ligger på en liten flate, ca 7 m i NV-SØ lig retning og ca 15 m SV-NØ retning. Det ble gravd ca 35 prøvestikk hvorav fire var positive, 40-45 cm dype.","førsteDigitaliseringsdato":"2004-09-16T15:31:17Z","kommune":"3218","kulturminneId":"89249","antallEnkeltminner":4,"linkAskeladden":"https://askeladden.ra.no/askeladden/?kid=89249","linkKulturminnesøk":"https://kulturminnesok.no/ra/lokalitet/89249","lokalId":"89249","lokalitetsart":"20159","lokalitetskategori":"L-ARK","målemetode":99,"navnerom":"http://skjema.geonorge.no/SOSI/produktspesifikasjon/LokaliteterEnkeltminnerOgSikringssoner/20210217","versjonId":"20210217","nøyaktighet":500,"nåværendeFunksjon":null,"områdefredning":null,"synlig":true,"vernetype":"UAV","vernedato":"2003-10-01T00:00:00Z","vernelov":null,"verneparagraf":null,"opprinneligFunksjon":null,"datafangstdato":"2003-10-01T00:00:00Z","opprettet":"2004-09-16T15:31:17Z","oppdateringsdato":"2025-06-24T11:43:56Z","senterpunkt":{"type":"Point","coordinates":[10.784270420677034,59.763006250969006]}}},{"type":"Feature","id":"89251-1","geometry":null,"properties":{"navn":"Nøstvedt","opphav":"Akershus fylkeskommune","informasjon":"Hulvei går over en flate rett over E6, like øst for Tusenfryd, ca 60 moh. Den har en tydelig fordypning, opp til 0,3 m dyp, er ca 1,5 m bred og er godt synlig i ca 25 m lengde NØ-SV. Den forsvinner ut over flaten i sørvest. I nordøst fortsetter vein opp en smal kløft hvor et mulig forsvarsanlegg ligger på toppen på begge sider.. Det kan se ut som om veifaret fortsetter nedover langs vestsiden av Østre Fålesloråsen, men den er ikke tydelig som hulvei andre steder.","førsteDigitaliseringsdato":"2004-09-16T15:48:27Z","kommune":"3218","kulturminneId":"89251-1","antallEnkeltminner":1,"linkAskeladden":"https://askeladden.ra.no/askeladden/?kid=89251-1","linkKulturminnesøk":"https://kulturminnesok.no/ra/lokalitet/89251","lokalId":"89251-1","lokalitetsart":"20106","lokalitetskategori":"L-ARK","målemetode":null,"navnerom":"http://skjema.geonorge.no/SOSI/produktspesifikasjon/LokaliteterEnkeltminnerOgSikringssoner/20210217","versjonId":"20210217","nøyaktighet":null,"nåværendeFunksjon":null,"områdefredning":null,"synlig":true,"vernetype":"AUT","vernedato":"2003-10-01T00:00:00Z","vernelov":"KML","verneparagraf":"4 (Automatisk fredning)","opprinneligFunksjon":"2000","datafangstdato":"2003-10-01T00:00:00Z","opprettet":"2004-09-16T15:48:27Z","oppdateringsdato":"2024-01-06T13:35:47Z"}}],"links":[{"href":"https://api.ra.no/LokaliteterEnkeltminnerOgSikringssoner/collec